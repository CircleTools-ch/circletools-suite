<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>dce9e719-99ba-4322-9816-3676d788349d</UserSecretsId>
    <!-- Aspire 13.6 warns (ASPIRE010) when the AppHost does not use the Aspire CLI bundle. We start the
         AppHost with plain `dotnet run` (CLAUDE.md, CI E2E) and need no Aspire CLI install, so the
         package-provided orchestration stays in use and the notice is silenced. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Apps\Main\CircleTools.Main.Service\CircleTools.Main.Service.csproj" />
    <ProjectReference Include="..\..\Apps\Main\CircleTools.Main.WebApp\CircleTools.Main.WebApp.csproj" />
    <ProjectReference Include="..\..\Apps\SecretSanta\CircleTools.SecretSanta.WebApp\CircleTools.SecretSanta.WebApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

</Project>
