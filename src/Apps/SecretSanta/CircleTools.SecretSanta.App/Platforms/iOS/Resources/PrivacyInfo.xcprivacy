<?xml version="1.0" encoding="UTF-8"?>
<!--
This is the minimum required version of the Apple Privacy Manifest for .NET MAUI apps.
The contents below are needed because of APIs that are used in the .NET framework and .NET MAUI SDK.

You are responsible for adding extra entries as needed for your application.

More information: https://aka.ms/maui-privacy-manifest
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app does no tracking (no ads/analytics/third-party SDKs, no cross-app/website linking of
         user or device data), so NSPrivacyTracking is false and there is no NSPrivacyTrackingDomains
         array. This must stay consistent with the App Store Connect App Privacy label. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <!-- NSPrivacyCollectedDataTypes is intentionally omitted here and declared in the App Store Connect
         App Privacy label at submission instead (they must match): on-device-only data is "not
         collected", but the OPTIONAL account + cloud sync collects an email address (account) and user
         content (group/member data synced to api.circletools.ch), linked to identity, not used for
         tracking. Populate the label accordingly; see the mobile-apps runbook. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
            </array>
        </dict>
        <!-- User defaults (CA92.1 — "access user defaults in just your app"). The MAUI runtime and
             Plugin.LocalNotification (ADR-0060) read/write NSUserDefaults on iOS even though our own
             code stores state via FileKeyValueStore; declared so a required-reason use never trips
             App Review. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
