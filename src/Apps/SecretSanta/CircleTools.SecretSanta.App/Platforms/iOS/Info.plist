<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
    <!-- The app's top strip is the neutral accent safe-area (wwwroot/app.css .status-bar-safe-area,
         #5b7cc4 from CircleToolsTheme), so the status bar renders white/light content over it, in both
         light and dark (ADR-0040). -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <!-- Export/encryption compliance: the app uses only exempt encryption (HTTPS/URLSession and the
         OS passkey/keystore APIs), no proprietary cryptography. Declaring NO here avoids the
         per-upload encryption questionnaire in App Store Connect. Re-evaluate if custom crypto is ever
         added (Apple export-compliance guidance). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Location purpose strings (Apple ITMS-90683). The app itself uses NO location APIs, but the MAUI
         Essentials framework links CoreLocation (its Geolocation binding) into every iOS binary, and
         Apple's static scanner requires a purpose string for the referenced API even when it is never
         invoked. The API is never called, so iOS never prompts and no location is collected (keep the
         App Privacy label free of location). Remove these if the CoreLocation reference is ever trimmed
         out. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Secret Santa does not use your location. This entry is required because a system framework references location APIs.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Secret Santa does not use your location. This entry is required because a system framework references location APIs.</string>
</dict>
</plist>
