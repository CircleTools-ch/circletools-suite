<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- UIScene lifecycle adoption (required when building against the iOS/iPadOS 26+ SDK, ADR-0065).
         UIKit traps at launch — EXC_BREAKPOINT, _UIApplicationEvaluateRuntimeIssueForNoSceneLifecycleAdoption
         — if a multitasking-capable app does not adopt scenes. MAUI provides the runtime; this manifest
         opts in and points at the SceneDelegate (dotnet/maui#38601). Single scene only. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>__MAUI_DEFAULT_SCENE_CONFIGURATION__</string>
                    <key>UISceneDelegateClassName</key>
                    <string>SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
    <!-- The fixed app bar grows up into the top safe area (wwwroot/app.css insets .mud-appbar-fixed-top
         by env(safe-area-inset-top)), so its own branded app-bar background fills the status-bar strip.
         That background is dark (the per-app brand colour), so the status bar renders white/light content
         over it, in both light and dark (ADR-0040). -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <!-- Export/encryption compliance: the app uses only exempt encryption (HTTPS/URLSession and the
         OS passkey/keystore APIs), no proprietary cryptography. Declaring NO here avoids the
         per-upload encryption questionnaire in App Store Connect. Re-evaluate if custom crypto is ever
         added (Apple export-compliance guidance). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Location purpose strings (Apple ITMS-90683). The app itself uses NO location APIs, but the MAUI
         Essentials framework links CoreLocation (its Geolocation binding) into every iOS binary, and
         Apple's static scanner requires a purpose string for the referenced API even when it is never
         invoked. The API is never called, so iOS never prompts and no location is collected (keep the
         App Privacy label free of location). Remove these if the CoreLocation reference is ever trimmed
         out. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Secret Santa does not use your location. This entry is required because a system framework references location APIs.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Secret Santa does not use your location. This entry is required because a system framework references location APIs.</string>
</dict>
</plist>
