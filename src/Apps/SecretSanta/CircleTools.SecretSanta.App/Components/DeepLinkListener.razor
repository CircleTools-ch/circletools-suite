@implements IDisposable
@inject DeepLinkService DeepLinks
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

@* Non-visual (ADR-0053): routes an incoming reveal App Link to the in-app /r page, which renders it
   offline from the baked-in UI. Mounted once, outside the culture boundary, so it subscribes a single
   time for the app's life. A link that arrived on a cold start is consumed on first render. *@

@code {
    protected override void OnInitialized() => DeepLinks.LinkReceived += OnLink;

    protected override void OnAfterRender(bool firstRender)
    {
        // Only after the first render is the router mounted and ready to react to the navigation.
        if (firstRender && DeepLinks.ConsumePending() is { } pending)
        {
            OnLink(pending);
        }
    }

    private void OnLink(string relativeUrl) =>
        _ = InvokeAsync(() => Navigation.NavigateTo(Distinct(relativeUrl)));

    // A second reveal link arriving while one is open differs only in its #fragment, and Blazor treats such a
    // navigation as an in-page scroll that raises no LocationChanged — the open reveal would never switch.
    // A query that changes per link makes it a real navigation; the reveal page ignores the query.
    private static long _sequence;

    private static string Distinct(string relativeUrl)
    {
        var hash = relativeUrl.IndexOf('#', StringComparison.Ordinal);
        if (hash < 0)
        {
            return relativeUrl;
        }

        var path = relativeUrl[..hash];
        var separator = path.Contains('?', StringComparison.Ordinal) ? '&' : '?';
        return $"{path}{separator}open={Interlocked.Increment(ref _sequence)}{relativeUrl[hash..]}";
    }

    public void Dispose() => DeepLinks.LinkReceived -= OnLink;
}
