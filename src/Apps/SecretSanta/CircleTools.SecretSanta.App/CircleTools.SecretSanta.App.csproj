<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- The repo Directory.Build.props defaults TargetFramework=net10.0 (it is imported before
             this csproj sets TargetFrameworks). For a multi-targeted MAUI head that leaked single
             TF would win over TargetFrameworks, so clear it here. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <!-- iOS/MacCatalyst can only be built on macOS, so scope them to osx to keep the
             Windows/Linux solution build green. On a Mac these heads still build. -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>CircleTools.SecretSanta.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name — the label shown under the launcher icon (naming.md: the app brand). -->
        <ApplicationTitle>Secret Santa</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>ch.circletools.secretsanta</ApplicationId>

        <!-- Versions: local-dev defaults only. Store releases (release-mobile.yml, ADR-0047) OVERRIDE
             both on the command line: ApplicationDisplayVersion = the nbgv suite SemVer, and
             ApplicationVersion (the Android versionCode) = the git commit count (monotonic). Do not
             treat these literals as the release version. -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <!-- The unpackaged Windows head is a RID-specific build; declaring the RID here (per-TF)
             makes restore emit the win-x64 asset target without leaking to the Android head. -->
        <RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- iOS code-signing entitlements: the Associated Domains entitlement that makes reveal/event
         Universal Links open the app (ADR-0053, ADR-0065 follow-up #3). Scoped to the iOS head; the
         signed store build (release-mobile.yml) picks it up automatically. The App ID must also have
         the capability enabled and the provisioning profile regenerated (see the entitlements file). -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    </PropertyGroup>

    <!-- Reveal/API origins baked into the build (ADR-0053). A Release build defaults to the production
         origins so a store build never ships a dev URL; Debug keeps the local device-testing defaults.
         release-mobile.yml overrides on the command line (-p:RevealBaseUrl=…). Surfaced to the app as
         assembly metadata and read in MauiProgram. -->
    <PropertyGroup>
        <RevealBaseUrl Condition="'$(RevealBaseUrl)' == '' and '$(Configuration)' == 'Release'">https://secretsanta.circletools.ch</RevealBaseUrl>
        <RevealBaseUrl Condition="'$(RevealBaseUrl)' == ''">http://192.168.100.122:5081</RevealBaseUrl>
        <ApiBaseUrl Condition="'$(ApiBaseUrl)' == '' and '$(Configuration)' == 'Release'">https://api.circletools.ch</ApiBaseUrl>
        <ApiBaseUrl Condition="'$(ApiBaseUrl)' == ''">https://10.0.2.2:7080</ApiBaseUrl>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyMetadata Include="RevealBaseUrl" Value="$(RevealBaseUrl)" />
        <AssemblyMetadata Include="ApiBaseUrl" Value="$(ApiBaseUrl)" />
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon — Secret-Santa: burgundy ground behind a white gift ring, the ribbon cut out in the
             ground colour so it reads as a wrapped present (mirrors the main app's white people on blue; see naming.md). -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#7a1f2b" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#7a1f2b" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <!-- MudBlazor (ADR-0040): direct reference so the WebView host serves its static assets and
             can call AddMudServices; components come from CircleTools.Ui.Shared. -->
        <PackageReference Include="MudBlazor" />
    </ItemGroup>

    <!-- Device-local reminders (MNF-8, ADR-0060): the local-notification plugin, on the mobile heads
         only. The Windows head schedules no reminders (its scheduler no-ops), so it needs no reference. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <PackageReference Include="Plugin.LocalNotification" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CircleTools.SecretSanta.Ui\CircleTools.SecretSanta.Ui.csproj" />
        <ProjectReference Include="..\CircleTools.SecretSanta.LocalStore\CircleTools.SecretSanta.LocalStore.csproj" />
        <!-- The shared account/session block and the authorized-HTTP plumbing it needs (ADR-0034,
             ADR-0021). These bring web parity to the device head: sign-in, sync, claim and linking.
             The browser web host references CircleTools.Ui.Web for its storage/passkey seams; this head
             supplies the device equivalents itself (FileKeyValueStore + a MAUI passkey ceremony). -->
        <ProjectReference Include="..\..\..\BuildingBlocks\CircleTools.ApiClient\CircleTools.ApiClient.csproj" />
        <ProjectReference Include="..\..\..\BuildingBlocks\CircleTools.Ui.Account\CircleTools.Ui.Account.csproj" />
    </ItemGroup>

</Project>
