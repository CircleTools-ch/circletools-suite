@page "/"
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject ClaimableGroupsService Claimable
@inject SyncService Sync
@inject ILinkingApi Linking
@inject LinkResolutionApplier Resolutions
@inject BookmarkService Bookmarks

<PageTitle>@L["GroupsTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["GroupsTitle"]</MudText>

<div class="d-flex gap-2 align-start flex-wrap mb-4">
    <MudTextField @bind-Value="_newName" Immediate="true" OnKeyDown="OnNewNameKeyDown"
                  Label="@L["NewGroupPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Class="flex-grow-1" Style="min-width:12rem;" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync"
               StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
               Disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">
        @L["CreateGroup"]
    </MudButton>
</div>

@* Create a group from a circle (FR-027): only offered while signed in, since it reads the account's
   circles. The account-free flow above is unchanged. *@
<AuthorizeView>
    <Authorized>
        <MudButton Href="groups/from-circle" Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.GroupAdd" Class="mb-4">
            @L["CreateFromCircleAction"]
        </MudButton>
    </Authorized>
</AuthorizeView>

@if (_groups is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_groups.Count == 0)
{
    <MudText Class="mud-text-secondary">@L["NoGroups"]</MudText>
}
else
{
    <MudStack Spacing="2">
        @foreach (var group in _groups)
        {
            <MudCard Elevation="1">
                <MudCardContent Class="pb-2">
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                        <div class="d-flex align-center flex-wrap gap-2">
                            <MudText Typo="Typo.subtitle1"><strong>@group.Name</strong></MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @L["MembersColumn"]: @group.MemberCount
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @L["EventsColumn"]: @group.EventCount
                            </MudText>
                            @if (group.HasAnyDraw)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["DrawCompleteBadge"]</MudChip>
                            }
                            else if (group.AnyDrawInvalidated)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawInvalidatedBadge"]</MudChip>
                            }
                            @if (IsOnAccount(group.Id))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@L["SyncedBadge"]</MudChip>
                            }
                        </div>
                        <div class="d-flex align-center gap-1">
                            <AuthorizeView>
                                <Authorized>
                                    @{
                                        var isPinned = _pinned.Contains(group.Id);
                                    }
                                    <MudIconButton Size="Size.Small"
                                                   Icon="@(isPinned ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                                   Color="@(isPinned ? Color.Warning : Color.Default)"
                                                   OnClick="() => TogglePinAsync(group.Id)"
                                                   aria-label="@(isPinned ? L["UnpinGroup"] : L["PinGroup"])" />
                                </Authorized>
                            </AuthorizeView>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="() => Open(group.Id)">@L["Open"]</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       OnClick="() => AskDelete(group.Id)">@L["Delete"]</MudButton>
                        </div>
                    </div>

                    @if (_pendingDeleteId == group.Id)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                            <MudText Class="mb-2">@L["ConfirmDeleteGroup", group.Name]</MudText>
                            <div class="d-flex gap-1">
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                           OnClick="() => DeleteAsync(group.Id)">@L["ConfirmYes"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="CancelDelete">@L["Cancel"]</MudButton>
                            </div>
                        </MudAlert>
                    }

                    @* Un-claim (FR-026): only for a group on the account, and only while signed in. Kept
                       visually and textually distinct from Delete — it removes the group from the account
                       but keeps the copy on this device. *@
                    @if (_accountId != Guid.Empty && IsOnAccount(group.Id))
                    {
                        @if (_pendingUnclaimId == group.Id)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                                <MudText Typo="Typo.body2" Class="mb-1">@L["UnclaimConfirmPrompt", group.Name]</MudText>
                                <MudText Typo="Typo.caption" Class="d-block mb-1">@L["UnclaimKeepsLocalCopyNote"]</MudText>
                                <MudText Typo="Typo.caption" Class="d-block mb-2">@L["UnclaimDistinctFromDeleteNote"]</MudText>
                                <div class="d-flex gap-1">
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                               OnClick="() => UnclaimAsync(group.Id)">@L["UnclaimConfirm"]</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="CancelUnclaim">@L["Cancel"]</MudButton>
                                </div>
                            </MudAlert>
                        }
                        else
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Class="mt-1 px-1"
                                       OnClick="() => AskUnclaim(group.Id)">@L["UnclaimAction"]</MudButton>
                        }
                    }

                    @if (_unclaimMessageId == group.Id && _unclaimStatus is not null)
                    {
                        <MudAlert Severity="@UnclaimSeverity" Class="mt-2" Dense="true" role="@UnclaimRole">@UnclaimText</MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<GroupSummaryDto>? _groups;
    private HashSet<Guid> _onAccount = [];
    private HashSet<Guid> _pinned = [];
    private Guid _accountId;
    private string _displayName = string.Empty;
    private string _newName = string.Empty;
    private bool _busy;
    private Guid? _pendingDeleteId;
    private Guid? _pendingUnclaimId;
    private Guid? _unclaimMessageId;
    private SyncStatus? _unclaimStatus;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            _accountId = state.User.UserId();
            _displayName = state.User.DisplayName();
        }
    }

    private async Task LoadAsync()
    {
        _groups = await Sender.Send(new GetGroupsQuery());

        // The account scope is sync metadata, so it comes from the LocalStore read-model rather than
        // the domain summary (ADR-0016). A storage failure just leaves the badges off — the list still
        // renders from the domain query.
        try
        {
            var claimable = await Claimable.GetAllAsync();
            _onAccount = [.. claimable.Where(g => !g.IsAccountFree).Select(g => g.Id)];
        }
        catch (StorageUnavailableException)
        {
            _onAccount = [];
        }

        // Pinned groups are a per-account preference (FR-033); empty when signed out. A storage failure
        // just leaves the pins off, like the account badges above.
        try
        {
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
        }
        catch (StorageUnavailableException)
        {
            _pinned = [];
        }
    }

    private bool IsOnAccount(Guid id) => _onAccount.Contains(id);

    private async Task TogglePinAsync(Guid id)
    {
        try
        {
            await Bookmarks.ToggleAsync(id);
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
        }
        catch (StorageUnavailableException)
        {
            // The pin could not be written; leave the current state. Nothing else is affected.
        }
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        _busy = true;
        try
        {
            var name = _newName.Trim();
            var id = await Sender.Send(new CreateGroupCommand(name));

            // The organizer is a member of the group they create. Signed in, add them and link their own
            // account so their membership, wishlist and (once drawn) assignment are theirs on the My*
            // screens (FR-032). Signed out there is no identity to add, so the group starts empty as before.
            if (_accountId != Guid.Empty && !string.IsNullOrWhiteSpace(_displayName))
            {
                await AddSelfAsync(id, name, _displayName.Trim());
            }

            _newName = string.Empty;
            Open(id);
        }
        finally
        {
            _busy = false;
        }
    }

    // Add the organizer as the first member and link their own account. Best-effort: the self-link needs
    // the server, so an unreachable server just leaves them an unlinked member — still in the group, with
    // the link applying on a later "Sync now". Applying the resolution here sets Member.UserId at once so
    // the roster shows the link immediately rather than only after the next sync.
    private async Task AddSelfAsync(Guid groupId, string groupName, string displayName)
    {
        try
        {
            var memberId = await Sender.Send(new AddMemberCommand(groupId, displayName));
            var link = await Linking.SelfLinkAsync(new SelfLinkRequest(groupId, groupName, memberId, displayName));
            if (link.IsSuccess)
            {
                await Resolutions.ApplyPendingAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // A duplicate name (the organizer somehow already present) is not worth surfacing at create.
        }
    }

    private void AskDelete(Guid id)
    {
        _pendingDeleteId = id;
        _pendingUnclaimId = null;
    }

    private void CancelDelete() => _pendingDeleteId = null;

    private async Task DeleteAsync(Guid id)
    {
        _pendingDeleteId = null;
        await Sender.Send(new DeleteGroupCommand(id));
        await LoadAsync();
    }

    private void AskUnclaim(Guid id)
    {
        _pendingUnclaimId = id;
        _pendingDeleteId = null;
        _unclaimMessageId = null;
        _unclaimStatus = null;
    }

    private void CancelUnclaim() => _pendingUnclaimId = null;

    private async Task UnclaimAsync(Guid id)
    {
        _pendingUnclaimId = null;
        _unclaimMessageId = id;

        var outcome = await Sync.UnclaimAsync(_accountId, id);
        _unclaimStatus = outcome.Status;

        // On success the group is account-free again; refresh the badges. Nothing local was removed.
        if (outcome.IsSuccess)
        {
            await LoadAsync();
        }
    }

    private string UnclaimText => _unclaimStatus switch
    {
        SyncStatus.Synced => L["UnclaimSuccess"],
        SyncStatus.Offline => L["UnclaimOfflineUnavailable"],
        SyncStatus.StorageUnavailable => L["SyncStatusStorageUnavailable"],
        _ => L["UnclaimFailed"],
    };

    private Severity UnclaimSeverity => _unclaimStatus == SyncStatus.Synced ? Severity.Success : Severity.Warning;

    private string UnclaimRole => _unclaimStatus == SyncStatus.StorageUnavailable ? "alert" : "status";

    private void Open(Guid id) => Navigation.NavigateTo($"groups/{id}");
}
