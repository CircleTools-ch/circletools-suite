@page "/"
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject VisibleGroupsService VisibleGroups
@inject ILinkingApi Linking
@inject LinkResolutionApplier Resolutions
@inject BookmarkService Bookmarks
@inject AutoSyncService AutoSync
@inject IHapticFeedback Haptics
@inject IDialogService Dialogs
@implements IDisposable

<PageTitle>@L["GroupsTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["GroupsTitle"]</MudText>

<div class="d-flex gap-2 align-start flex-wrap mb-4">
    <MudTextField @bind-Value="_newName" Immediate="true" OnKeyDown="OnNewNameKeyDown"
                  Label="@L["NewGroupPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Class="flex-grow-1" Style="min-width:12rem;" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync"
               StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
               Disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">
        @L["CreateGroup"]
    </MudButton>
</div>

@* Create a group from a circle (FR-027): only offered while signed in, since it reads the account's
   circles. The account-free flow above is unchanged. *@
<AuthorizeView>
    <Authorized>
        <MudButton Href="groups/from-circle" Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.GroupAdd" Class="mb-4">
            @L["CreateFromCircleAction"]
        </MudButton>
    </Authorized>
</AuthorizeView>

@if (_groups is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_groups.Count == 0)
{
    <AuthorizeView>
        <Authorized>
            @* Signed in with nothing on the account yet: point at the create field and the
               from-circle shortcut above rather than re-selling the account (UX-003). *@
            <MudText Class="mud-text-secondary">@L["EmptyStateSignedInHint"]</MudText>
        </Authorized>
        <NotAuthorized>
            @* First run (UX-003): say what the app does, nudge to the create field above, and sell
               the account at the point of choice (sync, own assignment, own wishlist). *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-2">
                <div class="d-flex flex-column align-center text-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Redeem" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["EmptyStateHeadline"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateExplainer"]</MudText>
                    <MudDivider Class="my-2" Style="width:100%;" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateAccountSell"]</MudText>
                    <MudButton Href="/account/login" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login">@L["EmptyStateSignIn"]</MudButton>
                </div>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
}
else
{
    <MudStack Spacing="2">
        @foreach (var group in _groups)
        {
            <MudCard Elevation="1">
                <MudCardContent Class="pb-2">
                    <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                        <div class="d-flex align-center flex-wrap gap-2">
                            @* The name opens the group, the same as the Open button, so the whole row reads
                               as a link — with keyboard support to match the button. *@
                            <div class="ct-openable" role="button" tabindex="0"
                                 @onclick="() => Open(group.Id)" @onkeydown="@(e => OpenOnEnter(e, group.Id))">
                                <MudText Typo="Typo.subtitle1"><strong>@group.Name</strong></MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @L["MembersColumn"]: @group.MemberCount
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @L["EventsColumn"]: @group.EventCount
                            </MudText>
                            @if (group.AnyDrawInvalidated)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawInvalidatedBadge"]</MudChip>
                            }
                            else if (group.HasAnyDraw)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["DrawCompleteBadge"]</MudChip>
                            }
                        </div>
                        <div class="d-flex align-center gap-1">
                            <AuthorizeView>
                                <Authorized>
                                    @{
                                        var isPinned = _pinned.Contains(group.Id);
                                    }
                                    <MudIconButton Icon="@(isPinned ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                                   Color="@(isPinned ? Color.Warning : Color.Default)"
                                                   OnClick="() => TogglePinAsync(group.Id)"
                                                   aria-label="@(isPinned ? L["UnpinGroup"] : L["PinGroup"])" />
                                </Authorized>
                            </AuthorizeView>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       OnClick="() => Open(group.Id)">@L["Open"]</MudButton>
                            @* Delete is destructive and rare, so it moves out of the row into an overflow
                               menu — keeping a phone row to pin + Open + a single kebab. *@
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default"
                                     AriaLabel="@L["MoreActions"]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                             OnClick="() => AskDeleteAsync(group.Id, group.Name)">@L["Delete"]</MudMenuItem>
                            </MudMenu>
                        </div>
                    </div>

                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<GroupSummaryDto>? _groups;
    private HashSet<Guid> _pinned = [];
    private Guid _accountId;
    private bool _accountKnown;
    private string _displayName = string.Empty;
    private string _newName = string.Empty;
    private bool _busy;

    protected override void OnInitialized() => AutoSync.SyncCompleted += OnSyncCompleted;

    // The cascading auth state re-runs this on every sign-in and sign-out. Reload when the account
    // actually changed, so the visible set switches at once — account groups appear on sign-in and are
    // hidden again on sign-out (ADR-0044) — without a manual refresh.
    protected override async Task OnParametersSetAsync()
    {
        var accountId = Guid.Empty;
        var displayName = string.Empty;
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            accountId = state.User.UserId();
            displayName = state.User.DisplayName();
        }

        var changed = !_accountKnown || accountId != _accountId;
        _accountId = accountId;
        _displayName = displayName;
        _accountKnown = true;

        if (changed)
        {
            await LoadAsync();
        }
    }

    // A background sync may have pulled or claimed groups; refresh the list so they appear on their own.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => AutoSync.SyncCompleted -= OnSyncCompleted;

    private async Task LoadAsync()
    {
        // Signed in: every group (all synced). Signed out: only account-free groups — account data is
        // hidden from the offline view but kept on the device (ADR-0044).
        _groups = await VisibleGroups.GetVisibleAsync();

        // Pinned groups are a per-account preference (FR-033); empty when signed out. A storage failure
        // just leaves the pins off.
        try
        {
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
        }
        catch (StorageUnavailableException)
        {
            _pinned = [];
        }
    }

    private async Task TogglePinAsync(Guid id)
    {
        try
        {
            await Bookmarks.ToggleAsync(id);
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
            // A confirmation buzz on the pin/unpin (FEAT-008 W3); a no-op on the web head.
            await Haptics.TapAsync();
        }
        catch (StorageUnavailableException)
        {
            // The pin could not be written; leave the current state. Nothing else is affected.
        }
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        _busy = true;
        try
        {
            var name = _newName.Trim();
            var id = await Sender.Send(new CreateGroupCommand(name));

            // The organizer is a member of the group they create. Signed in, add them and link their own
            // account so their membership, wishlist and (once drawn) assignment are theirs on the My*
            // screens (FR-032). Signed out there is no identity to add, so the group starts empty as before.
            if (_accountId != Guid.Empty && !string.IsNullOrWhiteSpace(_displayName))
            {
                await AddSelfAsync(id, name, _displayName.Trim());
            }

            _newName = string.Empty;
            Open(id);
        }
        finally
        {
            _busy = false;
        }
    }

    // Add the organizer as the first member and link their own account. Best-effort: the self-link needs
    // the server, so an unreachable server just leaves them an unlinked member — still in the group, with
    // the link applying on a later "Sync now". Applying the resolution here sets Member.UserId at once so
    // the roster shows the link immediately rather than only after the next sync.
    private async Task AddSelfAsync(Guid groupId, string groupName, string displayName)
    {
        try
        {
            var memberId = await Sender.Send(new AddMemberCommand(groupId, displayName));
            var link = await Linking.SelfLinkAsync(new SelfLinkRequest(groupId, groupName, memberId, displayName));
            if (link.IsSuccess)
            {
                await Resolutions.ApplyPendingAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // A duplicate name (the organizer somehow already present) is not worth surfacing at create.
        }
    }

    // Confirm a delete in a bottom sheet (FEAT-008 W4) rather than an inline warning that reflows the card.
    private async Task AskDeleteAsync(Guid id, string name)
    {
        if (await Dialogs.ShowConfirmSheetAsync(L["ConfirmDeleteGroup", name], L["ConfirmYes"], L["Cancel"]))
        {
            await DeleteAsync(id);
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        await Sender.Send(new DeleteGroupCommand(id));
        // A confirmation buzz on delete (FEAT-008 W3); a no-op on the web head.
        await Haptics.TapAsync();
        await LoadAsync();
    }

    private void Open(Guid id) => Navigation.NavigateTo($"groups/{id}");

    // Keyboard parity for the clickable name (Enter or Space opens, like the Open button).
    private void OpenOnEnter(KeyboardEventArgs args, Guid id)
    {
        if (args.Key is "Enter" or " ")
        {
            Open(id);
        }
    }
}
