@page "/"
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore
@using CircleTools.SecretSanta.LocalStore.Online
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject VisibleGroupsService VisibleGroups
@inject BookmarkService Bookmarks
@inject AutoSyncService AutoSync
@inject OnlineGroupSync Online
@inject IGroupRecordStore Records
@inject IHapticFeedback Haptics
@inject IDialogService Dialogs
@inject StorageModePreferences StoragePrefs
@inject ISnackbar Snackbar
@inject CreateFromCircleService Circles
@inject GroupRemoval Removal
@implements IDisposable

<PageTitle>@L["GroupsTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["GroupsTitle"]</MudText>

@* A create failure is shown here rather than silently freezing the page. The detail is the exception
   text, which is what makes a device-only write failure diagnosable without attached logs. *@
@if (_createError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
              CloseIconClicked="@(() => _createError = null)">
        @L["CreateGroupFailed"] <code>@_createError</code>
    </MudAlert>
}

@* The inline create field is the wide-screen path; on a phone it moves behind the "+" FAB (like adding
   members) so the list of groups leads. *@
<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudPaper Outlined="true" Class="pa-3 mb-4">
        <div class="d-flex gap-2 align-start flex-wrap mb-2">
            <MudTextField @bind-Value="_newName" Immediate="true" OnKeyDown="OnNewNameKeyDown"
                          Label="@L["NewGroupPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="flex-grow-1" Style="min-width:12rem;" id="new-group-name" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync"
                       StartIcon="@Icons.Material.Filled.Add" Class="mt-1" id="create-group-btn"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">
                @L["CreateGroup"]
            </MudButton>
        </div>
        @* Compact place affordance (ADR-0073, ADR-0086): show where the group will be kept — the default from
           Settings, same icon as the list — with a "Change" for this group, instead of an always-open picker. *@
        <StorageModeField Value="_createPlace" ValueChanged="@(p => _createPlace = p)"
                          AccountEnabled="@(_accountId != Guid.Empty)" Expanded="_explainStorage" />
        @* Circles are a secondary way into "Create group" (FR-027), offered only when the account has a circle
           with two or more people — for everyone else the old list-page button was a dead end (T1, Q36). *@
        @if (_hasCircle)
        {
            <MudButton Href="groups/from-circle" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.GroupAdd" Class="mt-1" id="from-circle-link">@L["CreateFromCircleAction"]</MudButton>
        }
    </MudPaper>
</MudHidden>

@* Invitations waiting for the signed-in account's answer (ADR-0086): accepting makes the group appear below. *@
@if (_invitations.Count > 0)
{
    <MudText Typo="Typo.overline" Class="d-block mb-1">@L["InvitationsTitle"]</MudText>
    <MudStack Spacing="2" Class="mb-4" id="invitations">
        @foreach (var invitation in _invitations)
        {
            <MudCard Elevation="1">
                <MudCardContent Class="py-2">
                    <MudText Typo="Typo.body1">@L["InvitationText", invitation.GroupName, invitation.MemberName ?? string.Empty]</MudText>
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy"
                                   OnClick="() => AnswerAsync(invitation, accept: true)">@L["InvitationAccept"]</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_busy"
                                   OnClick="() => AnswerAsync(invitation, accept: false)">@L["InvitationDecline"]</MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@* Groups this device takes part in without organizing them (ADR-0086, decision D3): opening one shows the
   person's own assignment and lets them keep their own wishlist and gift note. *@
@if (_takingPart.Count > 0)
{
    <MudText Typo="Typo.overline" Class="d-block mb-1">@L["TakingPartTitle"]</MudText>
    <MudStack Spacing="2" Class="mb-4" id="taking-part">
        @foreach (var view in _takingPart)
        {
            <MudCard Elevation="1">
                <MudCardContent Class="py-2 pr-1">
                    <div class="d-flex align-center gap-1">
                        <div class="ct-openable flex-grow-1" role="button" tabindex="0" style="min-width:0;"
                             aria-label="@L["OpenNamed", view.GroupName]"
                             @onclick="() => OpenTakingPart(view.GroupId)" @onkeydown="@(e => OpenTakingPartOnEnter(e, view.GroupId))">
                            <MudText Typo="Typo.subtitle1"><strong>@view.GroupName</strong></MudText>
                            <div class="d-flex align-center gap-1 mud-text-secondary">
                                <MudIcon Icon="@StorageModeDisplay.Icon(StorageKind.TakingPart)" Size="Size.Small" aria-hidden="true" />
                                <MudText Typo="Typo.body2">@L["TakingPartAs", view.MemberName]</MudText>
                            </div>
                        </div>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default"
                                 AriaLabel="@L["MoreActionsFor", view.GroupName]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error"
                                         OnClick="() => AfterMenu(() => AskDeleteAsync(view.GroupId, view.GroupName))">@L["LeaveGroup"]</MudMenuItem>
                        </MudMenu>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
    @if (_groups is { Count: > 0 })
    {
        <MudText Typo="Typo.overline" Class="d-block mb-1">@L["OrganizedTitle"]</MudText>
    }
}

@if (_groups is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_groups.Count == 0 && _takingPart.Count > 0)
{
    @* Taking part and organizing nothing yet: the section above is the page; creating stays one tap away. *@
}
else if (ShowsEmptyState)
{
    @* First run (UX-003): say what the app does and nudge to the create field. Signed in it is the same card
       (Q23), without the account sell. *@
    <AuthorizeView>
        <Authorized>
            <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-2" id="empty-state">
                <div class="d-flex flex-column align-center text-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Redeem" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["EmptyStateHeadline"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateExplainer"]</MudText>
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudButton OnClick="CreateViaFabAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Add">@L["EmptyStateCreateGroup"]</MudButton>
                    </MudHidden>
                </div>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-2">
                <div class="d-flex flex-column align-center text-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Redeem" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["EmptyStateHeadline"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateExplainer"]</MudText>
                    @* The primary first-run action is creating a group — a real, labelled button, so it is
                       not left to the bare "+" FAB (UX-council #1). Opens the same name sheet the FAB does.
                       Shown only on narrow, where the inline create field above is hidden; wide screens
                       already lead with that field, so a second create button there would be redundant. *@
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudButton OnClick="CreateViaFabAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Add">@L["EmptyStateCreateGroup"]</MudButton>
                    </MudHidden>
                    <MudDivider Class="my-2" Style="width:100%;" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateAccountSell"]</MudText>
                    @* Sign-in is the optional upsell, so it reads as secondary (a text link), not the
                       card's visual anchor — it no longer competes with the primary create action. *@
                    <MudButton Href="/account/login" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login">@L["EmptyStateSignIn"]</MudButton>
                    @* Set the expectation up front on the web head: groups live in this browser only (FEAT-017).
                       Device heads store natively and durably, so the note would mislead there. *@
                    @if (OperatingSystem.IsBrowser())
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="max-width:34rem;">
                            @L["EmptyStateLocalDataNote"]
                        </MudText>
                    }
                </div>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
}
else
{
    <MudStack Spacing="2">
        @foreach (var group in _groups)
        {
            @* One compact card per group (UX review U7): the whole card opens the group (a separate "Open"
               button only repeated it), the facts sit on one line under the name, and pin + kebab are the
               only controls. *@
            <MudCard Elevation="1">
                <MudCardContent Class="py-2 pr-1">
                    <div class="d-flex align-center gap-1">
                        <div class="ct-openable flex-grow-1" role="button" tabindex="0" style="min-width:0;"
                             aria-label="@L["OpenNamed", group.Name]"
                             @onclick="() => Open(group.Id)" @onkeydown="@(e => OpenOnEnter(e, group.Id))">
                            <div class="d-flex align-center flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle1"><strong>@group.Name</strong></MudText>
                                @if (group.AnyDrawInvalidated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawInvalidatedBadge"]</MudChip>
                                }
                                else if (group.HasAnyDraw)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["DrawCompleteBadge"]</MudChip>
                                }
                            </div>
                            <div class="d-flex align-center flex-wrap gap-x-3 mud-text-secondary" style="column-gap:12px;">
                                <MudText Typo="Typo.body2">@L["GroupCardCounts", group.MemberCount, group.EventCount]</MudText>
                                @* Per-group place indicator (FR-048, ADR-0086): on this device or online, with its
                                   label. Read from the group record, not the domain summary. *@
                                @if (_modeByGroup.TryGetValue(group.Id, out var mode))
                                {
                                    <span class="d-inline-flex align-center gap-1">
                                        <MudIcon Icon="@StorageModeDisplay.Icon(mode)" Size="Size.Small" aria-hidden="true" />
                                        <MudText Typo="Typo.body2">@L[StorageModeDisplay.LabelKey(mode)]</MudText>
                                    </span>
                                }
                            </div>
                        </div>
                        <AuthorizeView>
                            <Authorized>
                                @{
                                    var isPinned = _pinned.Contains(group.Id);
                                }
                                <MudIconButton Icon="@(isPinned ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                               Color="@(isPinned ? Color.Warning : Color.Default)"
                                               OnClick="() => TogglePinAsync(group.Id)"
                                               aria-label="@(isPinned ? L["UnpinGroup"] : L["PinGroup"])" />
                            </Authorized>
                        </AuthorizeView>
                        @* The group's actions (Q34): rename, pin, sharing, use as a template — and, set apart at the
                           end, delete. *@
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default"
                                 AriaLabel="@L["MoreActionsFor", group.Name]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => AfterMenu(() => RenameAsync(group.Id, group.Name))">@L["Rename"]</MudMenuItem>
                            @if (_accountId != Guid.Empty)
                            {
                                <MudMenuItem Icon="@(_pinned.Contains(group.Id) ? Icons.Material.Filled.StarBorder : Icons.Material.Filled.Star)"
                                             OnClick="() => TogglePinAsync(group.Id)">@(_pinned.Contains(group.Id) ? L["UnpinGroup"] : L["PinGroup"])</MudMenuItem>
                            }
                            <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="@(() => Navigation.NavigateTo($"groups/{group.Id}/sharing"))">@L["SharingRow"]</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="() => AfterMenu(() => UseAsTemplateAsync(group.Id, group.Name))">@L["UseAsTemplate"]</MudMenuItem>
                            <MudDivider Class="my-1" />
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                         OnClick="() => AfterMenu(() => AskDeleteAsync(group.Id, group.Name))">@L["Delete"]</MudMenuItem>
                        </MudMenu>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@* "Get the app" links on the web landing page (ADR-0065). Web-only and self-hiding: it renders nothing
   on the MAUI heads (no links registered) and nothing on the web until the store listings are configured,
   so it is safe to mount unconditionally here. *@
<AppStoreLinks />

@* Create a group via a FAB on phones (like adding members); the inline field owns it on wide.
   The spacer reserves scroll room so the FAB never traps the last group card's controls. The first-run card has
   its own labelled create button, so the FAB stays away there: two create buttons, and the FAB covered the card's
   sign-in link on a phone (S24 device test, 2026-10-25). *@
@if (!ShowsEmptyState)
{
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <div class="ct-fab-spacer"></div>
        <div class="ct-fab">
            @* Extended FAB (icon + label): the "+" alone reads the same on every screen, so the label says
               what it creates here — a group (UX-council #3). *@
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="@L["CreateGroup"]"
                    aria-label="@L["CreateGroup"]" OnClick="CreateViaFabAsync" />
        </div>
    </MudHidden>
}

@code {
    // The first-run card: nothing organized, nothing taken part in.
    private bool ShowsEmptyState => _groups is { Count: 0 } && _takingPart.Count == 0;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<GroupSummaryDto>? _groups;
    // The first group a device creates gets the storage options explained (ADR-0071 amendment).
    private bool _explainStorage;

    // "?template=<id>": the group page's "Use as template" (Q34) — create flows live here.
    [SupplyParameterFromQuery(Name = "template")]
    public Guid? TemplateGroupId { get; set; }

    private IReadOnlyDictionary<Guid, StorageKind> _modeByGroup = new Dictionary<Guid, StorageKind>();
    private HashSet<Guid> _pinned = [];
    private Guid _accountId;
    private bool _accountKnown;
    private string _displayName = string.Empty;
    private string _newName = string.Empty;
    // The create picker / phone FAB seed from the user's device-local default (FR-048), re-seeded when the
    // account changes.
    private GroupPlace _createPlace = GroupPlace.Device;
    private bool _busy;
    // Surfaces a create failure instead of letting the exception escape the event handler (which tears
    // down the Blazor render and freezes the page). Carries the exception detail so a device-only failure
    // (e.g. the iOS write path) is diagnosable from the screen rather than needing attached logs.
    private string? _createError;
    // Groups taken part in and invitations waiting for an answer (ADR-0086).
    private IReadOnlyList<ParticipantView> _takingPart = [];
    private IReadOnlyList<MyGroup> _invitations = [];
    // The account has a circle with 2+ people, so "Take members from a circle" is worth offering (T1).
    private bool _hasCircle;

    protected override void OnInitialized()
    {
        AutoSync.SyncCompleted += OnSyncCompleted;
        // Also on a local change (e.g. the sign-in import just claimed groups): the list follows at once
        // instead of waiting for the network cycle to finish (ADR-0044 amendment 2026-10-15, D2).
        AutoSync.LocalChanged += OnSyncCompleted;
    }

    // The cascading auth state re-runs this on every sign-in and sign-out. Reload when the account
    // actually changed, so the visible set switches at once — account groups appear on sign-in and are
    // hidden again on sign-out (ADR-0044) — without a manual refresh.
    protected override async Task OnParametersSetAsync()
    {
        var accountId = Guid.Empty;
        var displayName = string.Empty;
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            accountId = state.User.UserId();
            displayName = state.User.DisplayName();
        }

        var changed = !_accountKnown || accountId != _accountId;
        _accountId = accountId;
        _displayName = displayName;
        _accountKnown = true;

        if (changed)
        {
            // Seed the create picker / phone FAB from the user's default place (FR-048), re-seeded when the account
            // changes so the chosen default takes effect.
            _createPlace = await StoragePrefs.GetDefaultAsync();
            await LoadAsync();
            _ = RefreshAccountHintsAsync();
        }
    }

    // Best-effort, after the list is shown: whether to offer circles. Offline or failing, it stays hidden.
    private async Task RefreshAccountHintsAsync()
    {
        var hasCircle = false;
        if (_accountId != Guid.Empty)
        {
            try
            {
                var circles = await Circles.GetCirclesAsync();
                hasCircle = circles.IsSuccess && circles.Value!.Any(c => c.PeopleCount >= 2);
            }
            catch
            {
                // Hints only.
            }
        }

        _hasCircle = hasCircle;
        await InvokeAsync(StateHasChanged);
    }

    // No first-run storage dialog (ADR-0071 amendment, Q24): the choice is explained in "Create group" the
    // first time.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _explainStorage = !await StoragePrefs.IsOnboardedAsync();
        if (TemplateGroupId is { } templateId)
        {
            Navigation.NavigateTo(string.Empty, replace: true);
            var source = await Sender.Send(new GetGroupQuery(templateId));
            if (source is not null)
            {
                await UseAsTemplateAsync(templateId, source.Name);
            }

            return;
        }

        StateHasChanged();
    }

    // A background sync may have pulled or claimed groups; refresh the list so they appear on their own.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        AutoSync.SyncCompleted -= OnSyncCompleted;
        AutoSync.LocalChanged -= OnSyncCompleted;
    }

    private async Task LoadAsync()
    {
        // Signed in: device groups, link-held groups and this account's online groups. Signed out: no account's
        // groups — they stay on the device but hidden (ADR-0044, ADR-0086).
        _groups = await VisibleGroups.GetVisibleAsync();

        _takingPart = await VisibleGroups.GetTakingPartAsync();
        _invitations = await VisibleGroups.GetInvitationsAsync();

        // Each group's place for the per-group list chip (FR-048), read from the group record. A storage failure
        // just drops the chips; the list still renders.
        try
        {
            _modeByGroup = (await Records.LoadAsync()).Records.ToDictionary(r => r.Id, StorageModeDisplay.KindOf);
        }
        catch (StorageUnavailableException)
        {
            _modeByGroup = new Dictionary<Guid, StorageKind>();
        }

        // Pinned groups are a per-account preference (FR-033); empty when signed out. A storage failure
        // just leaves the pins off.
        try
        {
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
        }
        catch (StorageUnavailableException)
        {
            _pinned = [];
        }

        // Pinned first, then newest first (GuidV7 ids are time-ordered), so the group just created is at
        // the top instead of below everything else (UX review U7).
        _groups = [.. _groups.OrderByDescending(g => _pinned.Contains(g.Id)).ThenByDescending(g => g.Id)];
    }

    private async Task TogglePinAsync(Guid id)
    {
        try
        {
            await Bookmarks.ToggleAsync(id);
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
            // A confirmation buzz on the pin/unpin (FEAT-008 W3); a no-op on the web head.
            await Haptics.TapAsync();
        }
        catch (StorageUnavailableException)
        {
            // The pin could not be written; leave the current state. Nothing else is affected.
        }
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    // The inline field (wide screens) creates from the bound value + the compact place field.
    private Task CreateAsync() => CreateNamedAsync(_newName, _createPlace);

    // The phone FAB opens the "New group" sheet (name + storage mode, ADR-0073), pre-selecting the
    // default, then creates with the name and mode the user confirmed there.
    // "Use as template for a new group" (Q34): the same create sheet, prefilled, then a copy of the members and
    // exclusions (no events, wishlists or draw) stored the way the person chose.
    private async Task UseAsTemplateAsync(Guid sourceId, string sourceName)
    {
        var result = await Dialogs.ShowNewGroupDialogAsync(
            _createPlace, _accountId != Guid.Empty, _explainStorage, initialName: L["TemplateNewName", sourceName], fromTemplate: true);
        if (result is { } created)
        {
            await CreateNamedAsync(created.Name, created.Place, name => Sender.Send(new CopyGroupCommand(sourceId, name)));
        }
    }

    private async Task RenameAsync(Guid id, string current)
    {
        var name = await Dialogs.ShowTextInputSheetAsync(L["Rename"], L["NameLabel"], L["Save"], L["Cancel"], current);
        if (!string.IsNullOrWhiteSpace(name))
        {
            await Sender.Send(new RenameGroupCommand(id, name));
            AutoSync.RequestSync();
            await LoadAsync();
        }
    }

    private async Task CreateViaFabAsync()
    {
        var result = await Dialogs.ShowNewGroupDialogAsync(_createPlace, _accountId != Guid.Empty, _explainStorage, _hasCircle);
        if (result is { FromCircle: true })
        {
            Navigation.NavigateTo("groups/from-circle");
        }
        else if (result is { } created)
        {
            await CreateNamedAsync(created.Name, created.Place);
        }
    }

    private async Task CreateNamedAsync(string rawName, GroupPlace place, Func<string, Task<Guid>>? create = null)
    {
        if (_busy || string.IsNullOrWhiteSpace(rawName))
        {
            return;
        }

        _busy = true;
        _createError = null;
        try
        {
            var name = rawName.Trim();
            var id = create is null ? await Sender.Send(new CreateGroupCommand(name)) : await create(name);

            // The organizer is a member of the group they create (FR-032). Signed out there is no name to add.
            var ownMember = _accountId != Guid.Empty && !string.IsNullOrWhiteSpace(_displayName)
                ? await AddSelfAsync(id, _displayName.Trim())
                : null;

            // Online (ADR-0086): one upload makes it online — owned by the account while signed in, by a
            // management link this device keeps while signed out. Signed in, the organizer's own member is then
            // connected to their account, so the overview on their other devices shows it. Best-effort offline:
            // the group stays on this device, and the person can put it online later from Sharing & sync.
            if (place == GroupPlace.Online)
            {
                var account = _accountId == Guid.Empty ? (Guid?)null : _accountId;
                var online = await Online.MakeOnlineAsync(id, account, joinEnabled: false);
                if (online.IsSuccess && account is not null && ownMember is { } memberId)
                {
                    await Online.AddParticipantAsync(id, new AddParticipantRequest(memberId, ParticipantRoute.OwnMember));
                }
                else if (!online.IsSuccess)
                {
                    Snackbar.Add(L["StorageModeChangeFailed"], Severity.Warning);
                }
            }

            _newName = string.Empty;
            await StoragePrefs.MarkOnboardedAsync(); // the place choice has been explained once
            _explainStorage = false;
            Open(id);
        }
        catch (Exception ex)
        {
            // A create that throws must not take the whole page down with it. Show that it failed and keep
            // the exception detail visible so a platform-specific failure (seen on the iOS head, where the
            // first local write threw and froze the screen) can be diagnosed on the device itself.
            _createError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // Add the organizer as the first member; a copy of a group they were already in (Q34) keeps that member.
    private async Task<Guid?> AddSelfAsync(Guid groupId, string displayName)
    {
        try
        {
            return await Sender.Send(new AddMemberCommand(groupId, displayName));
        }
        catch (CircleTools.SecretSanta.Core.Domain.DuplicateMemberNameException)
        {
            return (await Sender.Send(new GetGroupQuery(groupId)))?.Members
                .FirstOrDefault(m => string.Equals(m.Name.Trim(), displayName, StringComparison.OrdinalIgnoreCase))?.Id;
        }
        catch (InvalidOperationException)
        {
            return null; // Not worth surfacing at create.
        }
    }

    // Accept or decline an invitation; an accepted group appears under "Groups you take part in".
    private async Task AnswerAsync(MyGroup invitation, bool accept)
    {
        _busy = true;
        try
        {
            var answered = await Online.AnswerInvitationAsync(invitation.GroupId, accept, _accountId);
            if (!answered.IsSuccess)
            {
                Snackbar.Add(L["InvitationFailed"], Severity.Warning);
            }
            else if (accept)
            {
                Snackbar.Add(L["InvitationAccepted", invitation.GroupName], Severity.Success);
            }
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
    }

    private void OpenTakingPart(Guid id) => Navigation.NavigateTo($"groups/{id}/me");

    private void OpenTakingPartOnEnter(KeyboardEventArgs args, Guid id)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenTakingPart(id);
        }
    }

    // Confirm a delete (or a leave, for a group taken part in) in a bottom sheet (FEAT-008 W4), then reload (Q34: the
    // same flow serves the group page's menu).
    private async Task AskDeleteAsync(Guid id, string name)
    {
        if (await Removal.AskAndRemoveAsync(id, name))
        {
            await LoadAsync();
        }
    }

    private void Open(Guid id) => Navigation.NavigateTo($"groups/{id}");

    // Keyboard parity for the clickable name (Enter or Space opens, like the Open button).
    private void OpenOnEnter(KeyboardEventArgs args, Guid id)
    {
        if (args.Key is "Enter" or " ")
        {
            Open(id);
        }
    }

    // A menu item that opens a sheet starts it only after the menu has closed: the item's handler returns at
    // once, so the menu is gone before the sheet slides in rather than staying open behind it (Q12). Running outside
    // the item's event handler, it renders itself when done: freeing a spot left "Connected" on screen until the
    // next sync otherwise (S24 device test, 2026-10-25).
    private void AfterMenu(Func<Task> action) => _ = InvokeAsync(async () =>
    {
        await Task.Yield();
        try
        {
            await action();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    });
}
