@page "/"
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject VisibleGroupsService VisibleGroups
@inject ILinkingApi Linking
@inject LinkResolutionApplier Resolutions
@inject BookmarkService Bookmarks
@inject AutoSyncService AutoSync
@inject SharedSyncService SharedSync
@inject SyncService Sync
@inject IHapticFeedback Haptics
@inject IDialogService Dialogs
@inject StorageModePreferences StoragePrefs
@inject ClaimableGroupsService Claimable
@inject KeptLocalGroups KeptLocal
@implements IDisposable

<PageTitle>@L["GroupsTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["GroupsTitle"]</MudText>

@* A create failure is shown here rather than silently freezing the page. The detail is the exception
   text, which is what makes a device-only write failure diagnosable without attached logs. *@
@if (_createError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
              CloseIconClicked="@(() => _createError = null)">
        @L["CreateGroupFailed"] <code>@_createError</code>
    </MudAlert>
}

@* The inline create field is the wide-screen path; on a phone it moves behind the "+" FAB (like adding
   members) so the list of groups leads. *@
<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudPaper Outlined="true" Class="pa-3 mb-4">
        <div class="d-flex gap-2 align-start flex-wrap mb-2">
            <MudTextField @bind-Value="_newName" Immediate="true" OnKeyDown="OnNewNameKeyDown"
                          Label="@L["NewGroupPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Class="flex-grow-1" Style="min-width:12rem;" id="new-group-name" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync"
                       StartIcon="@Icons.Material.Filled.Add" Class="mt-1" id="create-group-btn"
                       Disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">
                @L["CreateGroup"]
            </MudButton>
        </div>
        @* Compact storage affordance (ADR-0073): show how the group will be stored — the default from
           onboarding/Settings, same icon as the list — with a "Change" for this group, instead of an
           always-open radio picker. The default is the single source of truth; this just surfaces it. *@
        <StorageModeField Value="_createMode" ValueChanged="@(m => _createMode = m)"
                          AccountEnabled="@(_accountId != Guid.Empty)" />
    </MudPaper>
</MudHidden>

@* Create a group from a circle (FR-027): only offered while signed in, since it reads the account's
   circles. The account-free flow above is unchanged. *@
<AuthorizeView>
    <Authorized>
        <MudButton Href="groups/from-circle" Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.GroupAdd" Class="mb-4">
            @L["CreateFromCircleAction"]
        </MudButton>
    </Authorized>
</AuthorizeView>

@if (_groups is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_groups.Count == 0)
{
    <AuthorizeView>
        <Authorized>
            @* Signed in with nothing on the account yet: point at the create field and the
               from-circle shortcut above rather than re-selling the account (UX-003). *@
            <MudText Class="mud-text-secondary">@L["EmptyStateSignedInHint"]</MudText>
        </Authorized>
        <NotAuthorized>
            @* First run (UX-003): say what the app does, nudge to the create field above, and sell
               the account at the point of choice (sync, own assignment, own wishlist). *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-6 mt-2">
                <div class="d-flex flex-column align-center text-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Redeem" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["EmptyStateHeadline"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateExplainer"]</MudText>
                    @* The primary first-run action is creating a group — a real, labelled button, so it is
                       not left to the bare "+" FAB (UX-council #1). Opens the same name sheet the FAB does.
                       Shown only on narrow, where the inline create field above is hidden; wide screens
                       already lead with that field, so a second create button there would be redundant. *@
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudButton OnClick="CreateViaFabAsync" Variant="Variant.Filled" Color="Color.Primary"
                                   Size="Size.Large" StartIcon="@Icons.Material.Filled.Add">@L["EmptyStateCreateGroup"]</MudButton>
                    </MudHidden>
                    <MudDivider Class="my-2" Style="width:100%;" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:34rem;">@L["EmptyStateAccountSell"]</MudText>
                    @* Sign-in is the optional upsell, so it reads as secondary (a text link), not the
                       card's visual anchor — it no longer competes with the primary create action. *@
                    <MudButton Href="/account/login" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login">@L["EmptyStateSignIn"]</MudButton>
                    @* Set the expectation up front on the web head: groups live in this browser only (FEAT-017).
                       Device heads store natively and durably, so the note would mislead there. *@
                    @if (OperatingSystem.IsBrowser())
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="max-width:34rem;">
                            @L["EmptyStateLocalDataNote"]
                        </MudText>
                    }
                </div>
            </MudPaper>
        </NotAuthorized>
    </AuthorizeView>
}
else
{
    <MudStack Spacing="2">
        @foreach (var group in _groups)
        {
            @* One compact card per group (UX review U7): the whole card opens the group (a separate "Open"
               button only repeated it), the facts sit on one line under the name, and pin + kebab are the
               only controls. *@
            <MudCard Elevation="1">
                <MudCardContent Class="py-2 pr-1">
                    <div class="d-flex align-center gap-1">
                        <div class="ct-openable flex-grow-1" role="button" tabindex="0" style="min-width:0;"
                             aria-label="@L["OpenNamed", group.Name]"
                             @onclick="() => Open(group.Id)" @onkeydown="@(e => OpenOnEnter(e, group.Id))">
                            <div class="d-flex align-center flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle1"><strong>@group.Name</strong></MudText>
                                @if (group.AnyDrawInvalidated)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawInvalidatedBadge"]</MudChip>
                                }
                                else if (group.HasAnyDraw)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["DrawCompleteBadge"]</MudChip>
                                }
                            </div>
                            <div class="d-flex align-center flex-wrap gap-x-3 mud-text-secondary" style="column-gap:12px;">
                                <MudText Typo="Typo.body2">@L["GroupCardCounts", group.MemberCount, group.EventCount]</MudText>
                                @* Per-group storage indicator (FR-048): where this group lives — device / link /
                                   cloud — now with its label, not an unexplained icon. Mode is read from the sync
                                   record (ClaimableGroups), not the domain summary. *@
                                @if (_modeByGroup.TryGetValue(group.Id, out var mode))
                                {
                                    <span class="d-inline-flex align-center gap-1">
                                        <MudIcon Icon="@StorageModeDisplay.Icon(mode)" Size="Size.Small" aria-hidden="true" />
                                        <MudText Typo="Typo.body2">@L[StorageModeDisplay.LabelKey(mode)]</MudText>
                                    </span>
                                }
                            </div>
                        </div>
                        <AuthorizeView>
                            <Authorized>
                                @{
                                    var isPinned = _pinned.Contains(group.Id);
                                }
                                <MudIconButton Icon="@(isPinned ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)"
                                               Color="@(isPinned ? Color.Warning : Color.Default)"
                                               OnClick="() => TogglePinAsync(group.Id)"
                                               aria-label="@(isPinned ? L["UnpinGroup"] : L["PinGroup"])" />
                            </Authorized>
                        </AuthorizeView>
                        @* Delete is destructive and rare, so it lives in an overflow menu. *@
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default"
                                 AriaLabel="@L["MoreActionsFor", group.Name]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                         OnClick="() => AskDeleteAsync(group.Id, group.Name)">@L["Delete"]</MudMenuItem>
                        </MudMenu>
                    </div>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@* "Get the app" links on the web landing page (ADR-0065). Web-only and self-hiding: it renders nothing
   on the MAUI heads (no links registered) and nothing on the web until the store listings are configured,
   so it is safe to mount unconditionally here. *@
<AppStoreLinks />

@* Create a group via a FAB on phones (like adding members); the inline field owns it on wide.
   The spacer reserves scroll room so the FAB never traps the last group card's controls. *@
<MudHidden Breakpoint="Breakpoint.MdAndUp">
    <div class="ct-fab-spacer"></div>
    <div class="ct-fab">
        @* Extended FAB (icon + label): the "+" alone reads the same on every screen, so the label says
           what it creates here — a group (UX-council #3). *@
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="@L["CreateGroup"]"
                aria-label="@L["CreateGroup"]" OnClick="CreateViaFabAsync" />
    </div>
</MudHidden>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IReadOnlyList<GroupSummaryDto>? _groups;
    private IReadOnlyDictionary<Guid, StorageMode> _modeByGroup = new Dictionary<Guid, StorageMode>();
    private HashSet<Guid> _pinned = [];
    private Guid _accountId;
    private bool _accountKnown;
    private string _displayName = string.Empty;
    private string _newName = string.Empty;
    // The create picker / phone FAB seed from the user's device-local default (FR-048), re-seeded when the
    // account changes and clamped for the current sign-in state.
    private StorageMode _createMode = StorageMode.OnThisDevice;
    private bool _busy;
    // Surfaces a create failure instead of letting the exception escape the event handler (which tears
    // down the Blazor render and freezes the page). Carries the exception detail so a device-only failure
    // (e.g. the iOS write path) is diagnosable from the screen rather than needing attached logs.
    private string? _createError;

    protected override void OnInitialized() => AutoSync.SyncCompleted += OnSyncCompleted;

    // The cascading auth state re-runs this on every sign-in and sign-out. Reload when the account
    // actually changed, so the visible set switches at once — account groups appear on sign-in and are
    // hidden again on sign-out (ADR-0044) — without a manual refresh.
    protected override async Task OnParametersSetAsync()
    {
        var accountId = Guid.Empty;
        var displayName = string.Empty;
        if (AuthStateTask is not null)
        {
            var state = await AuthStateTask;
            accountId = state.User.UserId();
            displayName = state.User.DisplayName();
        }

        var changed = !_accountKnown || accountId != _accountId;
        _accountId = accountId;
        _displayName = displayName;
        _accountKnown = true;

        if (changed)
        {
            // Seed the create picker / phone FAB from the user's default storage mode (FR-048), re-seeded
            // when the account changes (e.g. after signing in from the onboarding) so the chosen default
            // takes effect. Clamp "My account" to "On this device" while signed out — no account to attach
            // to yet; the group auto-claims into the account on the next sync after sign-in (ADR-0017).
            _createMode = ClampForAccount(await StoragePrefs.GetDefaultAsync());
            await LoadAsync();
        }
    }

    // "My account" needs a live session; without one, fall back to "On this device" (auto-claims later).
    private StorageMode ClampForAccount(StorageMode mode) =>
        mode == StorageMode.Account && _accountId == Guid.Empty ? StorageMode.OnThisDevice : mode;

    // Show the one-time storage onboarding on first render if it has not been shown (FR-048, ADR-0071).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || await StoragePrefs.IsOnboardedAsync())
        {
            return;
        }

        var chosen = await Dialogs.ShowStorageOnboardingAsync(_createMode, _accountId != Guid.Empty);
        await StoragePrefs.MarkOnboardedAsync();
        if (chosen is not { } mode)
        {
            return;
        }

        await StoragePrefs.SetDefaultAsync(mode);

        // Choosing "My account" while signed out: take the user to sign in / register (FR-048). The
        // default is already saved, so on return (the login page lands back on this home screen) the
        // account change re-seeds the create mode to "My account".
        if (mode == StorageMode.Account && _accountId == Guid.Empty)
        {
            Navigation.NavigateTo("account/login");
            return;
        }

        _createMode = ClampForAccount(mode);
        StateHasChanged();
    }

    // A background sync may have pulled or claimed groups; refresh the list so they appear on their own.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => AutoSync.SyncCompleted -= OnSyncCompleted;

    private async Task LoadAsync()
    {
        // Signed in: every group (all synced). Signed out: only account-free groups — account data is
        // hidden from the offline view but kept on the device (ADR-0044).
        _groups = await VisibleGroups.GetVisibleAsync();

        // Each group's storage mode for the per-group list icon (FR-048), read from the sync record. A
        // storage failure just drops the icons; the list still renders. A group claimed into the account
        // is authoritative by its AccountScope (IsAccountFree == false); the Mode field is only set to
        // Account on the shared-by-link→account transitions, so a normally-claimed group still carries
        // Mode=OnThisDevice. Derive the shown mode from the account scope first so an account-synced group
        // reads as "My account", not "device-only".
        try
        {
            _modeByGroup = (await Claimable.GetAllAsync())
                .ToDictionary(g => g.Id, g => g.IsAccountFree ? g.Mode : StorageMode.Account);
        }
        catch (StorageUnavailableException)
        {
            _modeByGroup = new Dictionary<Guid, StorageMode>();
        }

        // Pinned groups are a per-account preference (FR-033); empty when signed out. A storage failure
        // just leaves the pins off.
        try
        {
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
        }
        catch (StorageUnavailableException)
        {
            _pinned = [];
        }

        // Pinned first, then newest first (GuidV7 ids are time-ordered), so the group just created is at
        // the top instead of below everything else (UX review U7).
        _groups = [.. _groups.OrderByDescending(g => _pinned.Contains(g.Id)).ThenByDescending(g => g.Id)];
    }

    private async Task TogglePinAsync(Guid id)
    {
        try
        {
            await Bookmarks.ToggleAsync(id);
            _pinned = [.. await Bookmarks.GetPinnedAsync()];
            // A confirmation buzz on the pin/unpin (FEAT-008 W3); a no-op on the web head.
            await Haptics.TapAsync();
        }
        catch (StorageUnavailableException)
        {
            // The pin could not be written; leave the current state. Nothing else is affected.
        }
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    // The inline field (wide screens) creates from the bound value + the compact storage field's mode.
    private Task CreateAsync() => CreateNamedAsync(_newName, _createMode);

    // The phone FAB opens the "New group" sheet (name + storage mode, ADR-0073), pre-selecting the
    // default, then creates with the name and mode the user confirmed there.
    private async Task CreateViaFabAsync()
    {
        var result = await Dialogs.ShowNewGroupDialogAsync(_createMode, _accountId != Guid.Empty);
        if (result is { } created)
        {
            await CreateNamedAsync(created.Name, created.Mode);
        }
    }

    private async Task CreateNamedAsync(string rawName, StorageMode chosenMode)
    {
        if (_busy || string.IsNullOrWhiteSpace(rawName))
        {
            return;
        }

        _busy = true;
        _createError = null;
        try
        {
            var name = rawName.Trim();
            var id = await Sender.Send(new CreateGroupCommand(name));
            var mode = ClampForAccount(chosenMode);

            // The organizer is a member of the group they create. Signed in, add them; for a group that
            // leaves the device (shared by link, my account) also link their own account so their
            // membership, wishlist and (once drawn) assignment are theirs on the My* screens (FR-032).
            // "On this device" is private (ADR-0073): a self-link would put the group's name, events and the
            // organizer's assignment on the server, so it is not made automatically (ADR-0077) — the
            // organizer can still link explicitly from Members. Signed out there is no identity to add.
            if (_accountId != Guid.Empty && !string.IsNullOrWhiteSpace(_displayName))
            {
                await AddSelfAsync(id, name, _displayName.Trim(), link: mode != StorageMode.OnThisDevice);
            }

            // Apply the chosen storage mode (FR-038/ADR-0073): the picker value on wide screens, or the
            // seeded default on the phone FAB. "Shared by link" uploads and mints its links now (ADR-0058);
            // "My account" marks the group for the account so the next sync cycle claims it (and it is NOT
            // just left as a plain local group, which now stays local); "On this device" stays local.
            // Account while signed out is clamped to local.
            if (mode == StorageMode.SharedByLink)
            {
                await SharedSync.ShareByLinkAsync(id);
            }
            else if (mode == StorageMode.OnThisDevice && _accountId != Guid.Empty)
            {
                // Chosen "On this device" while signed in: an explicit decision, so the sign-in
                // reconciliation must not later ask to import it as if it were made while signed out.
                await KeptLocal.AddAsync([id]);
            }
            else if (mode == StorageMode.Account)
            {
                await Sync.MarkForAccountAsync(id);
            }

            _newName = string.Empty;
            Open(id);
        }
        catch (Exception ex)
        {
            // A create that throws must not take the whole page down with it. Show that it failed and keep
            // the exception detail visible so a platform-specific failure (seen on the iOS head, where the
            // first local write threw and froze the screen) can be diagnosed on the device itself.
            _createError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    // Add the organizer as the first member and, when asked, link their own account. Best-effort: the
    // self-link needs the server, so an unreachable server just leaves them an unlinked member — still in
    // the group, with the link applying on a later "Sync now". Applying the resolution here sets
    // Member.UserId at once so the roster shows the link immediately rather than only after the next sync.
    private async Task AddSelfAsync(Guid groupId, string groupName, string displayName, bool link)
    {
        try
        {
            var memberId = await Sender.Send(new AddMemberCommand(groupId, displayName));
            if (!link)
            {
                return;
            }

            var selfLink = await Linking.SelfLinkAsync(new SelfLinkRequest(groupId, groupName, memberId, displayName));
            if (selfLink.IsSuccess)
            {
                await Resolutions.ApplyPendingAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // A duplicate name (the organizer somehow already present) is not worth surfacing at create.
        }
    }

    // Confirm a delete in a bottom sheet (FEAT-008 W4) rather than an inline warning that reflows the card.
    private async Task AskDeleteAsync(Guid id, string name)
    {
        if (await Dialogs.ShowConfirmSheetAsync(L["ConfirmDeleteGroup", name], L["ConfirmYes"], L["Cancel"]))
        {
            await DeleteAsync(id);
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        await Sender.Send(new DeleteGroupCommand(id));
        // A confirmation buzz on delete (FEAT-008 W3); a no-op on the web head.
        await Haptics.TapAsync();
        await LoadAsync();
    }

    private void Open(Guid id) => Navigation.NavigateTo($"groups/{id}");

    // Keyboard parity for the clickable name (Enter or Space opens, like the Open button).
    private void OpenOnEnter(KeyboardEventArgs args, Guid id)
    {
        if (args.Key is "Enter" or " ")
        {
            Open(id);
        }
    }
}
