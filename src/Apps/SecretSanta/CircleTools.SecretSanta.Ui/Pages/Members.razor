@page "/groups/{GroupId:guid}/members"
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.Core.Domain
@using CircleTools.SecretSanta.LocalStore
@using CircleTools.SecretSanta.LocalStore.Linking
@using Microsoft.Extensions.DependencyInjection
@inject ISender Sender
@inject ILinkingApi Linking
@inject IServiceProvider Services
@inject IStringLocalizer<AppStrings> L
@inject IDialogService Dialogs
@inject ISyncSignals SyncSignals
@implements IDisposable

<PageTitle>@L["MembersTitle"]</PageTitle>

<GroupBackNav GroupId="GroupId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["MembersTitle"]</MudText>

@if (_hasCurrentDraw)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true" role="alert">@L["RemoveMemberVoidsDrawWarning"]</MudAlert>
}

@* The add-member form is the inline card on wide screens; on a phone it moves behind the "+" FAB
   (FEAT-008 W4) to declutter the top of the list. *@
@if (_readOnly)
{
    <MudAlert Severity="Severity.Normal" Class="mb-4" Dense="true">@L["ParticipantReadOnlyNote"]</MudAlert>
}
else
{
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudCard Elevation="1" Class="mb-4">
            <MudCardContent>
                <MudStack Spacing="2">
                    <MudTextField @bind-Value="_newName" Immediate="true" OnKeyDown="OnNewNameKeyDown" Label="@L["NameLabel"]"
                                  Placeholder="@L["MemberNamePlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense" id="new-member-name" />
                    <div>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddAsync"
                                   StartIcon="@Icons.Material.Filled.PersonAdd" id="add-member-btn"
                                   Disabled="@string.IsNullOrWhiteSpace(_newName)">@L["AddMember"]</MudButton>
                    </div>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudHidden>
}

@if (_error is not null && _editingId is null)
{
    <MudAlert Severity="Severity.Error" Dense="true" role="alert" Class="mb-4">@_error</MudAlert>
}

@if (_members is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_members.Count == 0)
{
    <MudText Class="mud-text-secondary">@L["NoMembers"]</MudText>
}
else
{
    <MudStack Spacing="2">
        @foreach (var member in _members)
        {
            <MudCard Elevation="1">
                <MudCardContent Class="py-2">
                    @if (_editingId == member.Id)
                    {
                        <MudStack Spacing="2">
                            @* A rename's error belongs under the field being edited, not at the top of the page (Q10). *@
                            <MudTextField @bind-Value="_editName" Immediate="true" Label="@L["NameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Error="@(_error is not null)" ErrorText="@_error" />
                            @* The gift note is a stable per-person hint the giver sees on the reveal (FR-037):
                               allergies, dietary/lifestyle needs, things not to buy. Capped to protect the
                               encoded reveal link (ADR-0014). *@
                            @* A member who keeps their own entry — joined (ADR-0080) or from their reveal link (ADR-0084) —
                               keeps their own gift note: the organizer sees it but can't change it. *@
                            <MudTextField @bind-Value="_editGiftNote" Label="@L["GiftNoteLabel"]"
                                          HelperText="@(_connected.KeepsOwnEntry(member.Id) ? L["MemberKeepsOwnEntry", member.Name] : L["GiftNoteHint"])"
                                          ReadOnly="@_connected.KeepsOwnEntry(member.Id)"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                          MaxLength="Member.MaxGiftNoteLength" Counter="Member.MaxGiftNoteLength" />
                            <div class="d-flex gap-1">
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                           OnClick="SaveEditAsync" Disabled="@string.IsNullOrWhiteSpace(_editName)">@L["Save"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CancelEdit">@L["Cancel"]</MudButton>
                            </div>
                        </MudStack>
                    }
                    else
                    {
                        <div class="d-flex justify-space-between align-center gap-2">
                            <div class="d-flex align-center flex-wrap gap-2" style="min-width:0;">
                                <MudText Typo="Typo.subtitle1"><strong>@member.Name</strong></MudText>
                                @* One badge for "sees the assignment in the app" (Q30), however they got there; the
                                   tooltip says how. Members without it need a reveal link. *@
                                @if (_connected.Contains(member.Id))
                                {
                                    <MudTooltip Text="@(_connected.Joined.Contains(member.Id) ? L["MemberConnectedJoined"] : L["MemberConnectedLinked"])">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                                                 Icon="@Icons.Material.Filled.PhoneIphone">@L["MemberConnectedBadge"]</MudChip>
                                    </MudTooltip>
                                }
                                @if (!string.IsNullOrWhiteSpace(member.GiftNote))
                                {
                                    @* A stable per-person note the giver sees on the reveal (FR-037). *@
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="flex-basis:100%;">@L["GiftNoteLabel"]: @member.GiftNote</MudText>
                                }
                            </div>
                            @* Every per-person action lives in one overflow menu, so a row is just the name and a
                               kebab - one clean line on a phone. Linking an account is an occasional, advanced
                               step (and account-only, since it calls the authorized server API), so it sits in
                               the menu rather than as a prominent button on every row. *@
                            @if (!_readOnly)
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default"
                                         AriaLabel="@L["MoreActionsFor", member.Name]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => BeginEdit(member)">@L["Edit"]</MudMenuItem>
                                    <AuthorizeView>
                                        @if (member.UserId is not null)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.LinkOff" Disabled="@_linkBusy"
                                                         OnClick="() => UnlinkAsync(member.Id)">@L["MemberUnlink"]</MudMenuItem>
                                        }
                                        else
                                        {
                                            @* The one-click self-link is the simplest way to become this member: no
                                               address, no email confirmation, and - because one account backs at most
                                               one member per group - offered only while none of my members is me yet. *@
                                            @if (!_iAmLinkedInGroup)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle" Disabled="@_linkBusy"
                                                             OnClick="() => LinkWithMyAccountAsync(member)">@L["MemberLinkWithMyAccount"]</MudMenuItem>
                                            }
                                            <MudMenuItem Icon="@Icons.Material.Filled.Link"
                                                         OnClick="() => BeginLink(member.Id)">@L["MemberLink"]</MudMenuItem>
                                        }
                                    </AuthorizeView>
                                    @if (_isSharedAdmin && _claimedMembers.Contains(member.Id))
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Filled.PersonOff" OnClick="() => AfterMenu(() => ReleaseMemberAsync(member.Id, member.Name))">@L["ReleaseMember"]</MudMenuItem>
                                    }
                                    else if (_canTakeOverEntries && _connected.SelfMaintained.Contains(member.Id))
                                    {
                                        @* Someone who keeps their wishlist from their reveal link has no spot to free (ADR-0084); the
                                           organizer can still take the fields back. *@
                                        <MudMenuItem Icon="@Icons.Material.Filled.EditNote" OnClick="() => AfterMenu(() => TakeOverEntryAsync(member.Id, member.Name))">@L["TakeOverEntry"]</MudMenuItem>
                                    }
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => AfterMenu(() => AskRemoveAsync(member.Id, member.Name))">@L["Remove"]</MudMenuItem>
                                </MudMenu>
                            }
                        </div>

                        @* Send a member-link request: the member owns their wishlist and sees their own
                           assignment once they accept. The response reveals nothing about the address. *@
                        @if (_linkingMemberId == member.Id)
                        {
                            <MudAlert Severity="Severity.Normal" Class="mt-3" Dense="true">
                                <div class="d-flex gap-2 align-start flex-wrap">
                                    <MudTextField @bind-Value="_linkEmail" Immediate="true" InputType="InputType.Email"
                                                  Label="@L["MemberLinkEmailLabel"]" Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Class="flex-grow-1" />
                                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-1"
                                               OnClick="() => SendLinkAsync(member)"
                                               Disabled="@(_linkBusy || string.IsNullOrWhiteSpace(_linkEmail))">
                                        @L["MemberLinkSend"]
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Class="mt-1" OnClick="CancelLink">@L["Cancel"]</MudButton>
                                </div>
                            </MudAlert>
                        }

                        @if (_linkMessageId == member.Id && _linkMessage is not null)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2" Dense="true" role="status">@_linkMessage</MudAlert>
                        }

                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@* Primary add action as a floating action button on phones (FEAT-008 W4); the inline card owns it on wide.
   The spacer reserves scrollable room so the FAB never traps the last member row's overflow menu. *@
@if (!_readOnly)
{
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <div class="ct-fab-spacer"></div>
        <div class="ct-fab">
            @* Extended FAB (icon + label) so the action names itself — add a member (UX-council #3). *@
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" Label="@L["AddMember"]"
                    aria-label="@L["AddMember"]" OnClick="AddViaFabAsync" />
        </div>
    </MudHidden>
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    // Read to catch the one case where a link silently does nothing: linking your own member to your own
    // still-unverified address (the server matches verified addresses only).
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<MemberDto>? _members;
    private bool _isSharedAdmin;

    // A join-link participant sees the roster but only the organizer changes it (ADR-0058).
    private bool _readOnly;
    private HashSet<Guid> _claimedMembers = [];

    // Whether this device may hand a self-maintained entry back to the organizer (ADR-0084): the admin-link
    // holder of a Shared-by-link group, or the owner of a My account · shared group.
    private bool _canTakeOverEntries;
    private ConnectedMembers _connected = ConnectedMembers.None;
    private string _newName = string.Empty;
    private string? _error;

    private Guid? _editingId;
    private string _editName = string.Empty;
    private string _editGiftNote = string.Empty;
    private bool _hasCurrentDraw;
    private string _groupName = string.Empty;

    private Guid? _linkingMemberId;
    private string _linkEmail = string.Empty;
    private bool _linkBusy;
    private Guid? _linkMessageId;
    private string? _linkMessage;
    private Guid _myUserId;

    // My account already backs a member of this group. One account backs at most one member per group, so
    // once it does the "Link with my account" affordance disappears everywhere — only inviting an address remains.
    private bool _iAmLinkedInGroup =>
        _myUserId != Guid.Empty && (_members?.Any(m => m.UserId == _myUserId) ?? false);

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    // A background sync (ADR-0044) may have pulled a co-organizer's roster edits into the local store
    // (shared-by-link, FEAT-013); reload so they appear without a manual refresh. The add/edit fields are
    // separate state, so an in-progress add or open edit form is not disturbed.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncSignals.SyncCompleted -= OnSyncCompleted;

    private async Task LoadAsync()
    {
        if (AuthState is not null)
        {
            _myUserId = (await AuthState).User.UserId();
        }

        _readOnly = (await GroupAccess.ForAsync(Services, GroupId)).ReadOnly;

        var group = await Sender.Send(new GetGroupQuery(GroupId));
        _members = group?.Members ?? [];
        _hasCurrentDraw = group?.Events.Any(e => e.HasCurrentDraw) ?? false;
        _groupName = group?.Name ?? string.Empty;

        // For a shared-by-link group this device administers, load which members are claimed so the
        // admin can see who has joined and free a spot (ADR-0058, the sole recovery path). Resolved
        // defensively: a host without the sync engine (or a component test) simply omits the feature.
        var local = Services.GetService<ILocalSyncStore>();
        var sharedSync = Services.GetService<SharedSyncService>();
        if (local is not null && sharedSync is not null)
        {
            var record = (await local.LoadGroupsAsync()).FirstOrDefault(r => r.State.Id == GroupId);
            _isSharedAdmin = record is { Mode: StorageMode.SharedByLink, Tokens.AdminToken: not null };
            _claimedMembers = _isSharedAdmin ? [.. await sharedSync.GetClaimedMembersAsync(GroupId)] : [];
            _canTakeOverEntries = _isSharedAdmin || (record?.IsAdminClaimedShared() ?? false);
        }

        _connected = group is null ? ConnectedMembers.None : await ConnectedMembers.ForAsync(Services, group);
    }

    private async Task ReleaseMemberAsync(Guid memberId, string name)
    {
        if (Services.GetService<SharedSyncService>() is { } sharedSync
            && await Dialogs.ShowConfirmSheetAsync(L["ReleaseMemberConfirm", name], L["ReleaseMemberConfirmYes"], L["Cancel"], Color.Primary))
        {
            await sharedSync.ReleasePersonAsync(GroupId, memberId);
            await LoadAsync();
        }
    }

    // Hands a reveal-link holder's own entry back to the organizer (ADR-0084): the server drops the entry, so
    // the fields are editable here again. What they wrote stays in the group.
    private async Task TakeOverEntryAsync(Guid memberId, string name)
    {
        if (Services.GetService<SharedSyncService>() is { } sharedSync
            && await Dialogs.ShowConfirmSheetAsync(L["TakeOverEntryConfirm", name], L["TakeOverEntryConfirmYes"], L["Cancel"], Color.Primary))
        {
            await sharedSync.ReleasePersonAsync(GroupId, memberId);
            await LoadAsync();
        }
    }

    // The simple self-link: no address and no email confirmation. Establish it on the server (which takes
    // the account from the bearer token), then set Member.UserId locally so the roster reflects it at once;
    // the local edit rides the ordinary auto-sync, and the server's own resolution re-applies idempotently.
    private async Task LinkWithMyAccountAsync(MemberDto member)
    {
        if (_linkBusy || _iAmLinkedInGroup)
        {
            return;
        }

        _linkBusy = true;
        _linkMessageId = member.Id;
        var result = await Linking.SelfLinkAsync(new SelfLinkRequest(GroupId, _groupName, member.Id, member.Name));

        if (result.IsSuccess)
        {
            await Sender.Send(new LinkMemberCommand(GroupId, member.Id, _myUserId));
            _linkMessage = L["MemberLinkSelfLinked"];
        }
        else
        {
            _linkMessage = L["MemberLinkFailed"];
        }

        _linkBusy = false;
        await LoadAsync();
    }

    private void BeginLink(Guid memberId)
    {
        _linkingMemberId = memberId;
        _linkEmail = string.Empty;
        _linkMessage = null;
    }

    private void CancelLink() => _linkingMemberId = null;

    private async Task SendLinkAsync(MemberDto member)
    {
        if (_linkBusy || string.IsNullOrWhiteSpace(_linkEmail))
        {
            return;
        }

        var email = _linkEmail.Trim();

        // A self-link to your own address only resolves once the address is confirmed — otherwise the
        // server can't match it and the request quietly goes nowhere. There is no enumeration risk in
        // telling you about your *own* unverified address, so say so plainly instead of "request sent".
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (!user.IsEmailVerified() && string.Equals(email, user.Email(), StringComparison.OrdinalIgnoreCase))
            {
                _linkingMemberId = null;
                _linkMessageId = member.Id;
                _linkMessage = L["MemberLinkVerifyEmailFirst"];
                return;
            }
        }

        _linkBusy = true;
        var result = await Linking.SendMemberLinkAsync(
            new SendMemberLinkRequest(GroupId, _groupName, member.Id, member.Name, email));
        _linkBusy = false;
        _linkingMemberId = null;
        _linkMessageId = member.Id;

        // "Request sent" whether or not the address has an account (NFR-005). A self-link says so and
        // will apply on the next sync. A duplicate — the address already backs a member of this group —
        // is refused at send time with an explicit error (ADR-0044).
        _linkMessage = result.IsSuccess
            ? result.Value!.Outcome switch
            {
                MemberLinkOutcome.SelfLinked => L["MemberLinkSelfLinked"],
                MemberLinkOutcome.AlreadyLinkedInGroup => L["MemberLinkAlreadyInGroup"],
                _ => L["MemberLinkRequestSent"],
            }
            : L["MemberLinkFailed"];
    }

    private async Task UnlinkAsync(Guid memberId)
    {
        _linkBusy = true;
        _linkMessageId = memberId;

        // Tell the server (it clears the account's rows and emits the unlink resolution), then clear the
        // link locally now so the roster reflects it immediately; the resolution re-applies idempotently.
        var result = await Linking.UnlinkMemberAsync(GroupId, memberId);
        if (result.IsSuccess)
        {
            await Sender.Send(new UnlinkMemberCommand(GroupId, memberId));
            _linkMessage = L["MemberUnlinked"];
        }
        else
        {
            _linkMessage = L["MemberLinkFailed"];
        }

        _linkBusy = false;
        await LoadAsync();
    }

    private async Task OnNewNameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_newName))
        {
            await AddAsync();
        }
    }

    // The inline card (wide screens) adds from the bound field.
    private Task AddAsync() => AddNamedAsync(_newName);

    // The phone FAB (FEAT-008 W4) collects names in one sheet that stays open: a family is 6-12 people, so
    // after each add it clears for the next name and says who was just added; "Done" ends it. A duplicate
    // name keeps the sheet open with the error under the field and a suggestion (Q10).
    private async Task AddViaFabAsync()
    {
        await Dialogs.ShowTextInputSheetAsync(
            L["AddMember"], L["NameLabel"], L["AddMember"], L["Cancel"],
            submitting: async name =>
            {
                var added = await AddNamedAsync(name);
                StateHasChanged();
                var error = added ? null : _error;
                if (!added)
                {
                    _error = null; // shown in the sheet, not behind it
                }

                return error;
            },
            continueWith: name => L["MemberAddedAddAnother", name],
            doneLabel: L["Done"]);
    }

    // "Anna" is taken: suggest "Anna B." (the first free letter), so the two can be told apart (Q10).
    private string DuplicateMessage(string name)
    {
        var taken = (_members ?? []).Select(m => m.Name.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var suggestion = Enumerable.Range('B', 25).Select(c => $"{name.Trim()} {(char)c}.").FirstOrDefault(s => !taken.Contains(s));
        return suggestion is null ? L["DuplicateMemberError", name] : L["DuplicateMemberErrorSuggest", name, suggestion];
    }

    private async Task<bool> AddNamedAsync(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return false;
        }

        _error = null;

        // Caught here first, so an expected duplicate is a message, not a logged exception.
        if ((_members ?? []).Any(m => string.Equals(m.Name.Trim(), name.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            _error = DuplicateMessage(name.Trim());
            return false;
        }

        try
        {
            await Sender.Send(new AddMemberCommand(GroupId, name));
            _newName = string.Empty;
            await LoadAsync();
            return true;
        }
        catch (CircleTools.SecretSanta.Core.Domain.DuplicateMemberNameException exception)
        {
            _error = DuplicateMessage(exception.Name);
        }
        catch (InvalidOperationException)
        {
            _error = L["MemberSaveFailed"];
        }

        return false;
    }

    private void BeginEdit(MemberDto member)
    {
        _editingId = member.Id;
        _editName = member.Name;
        _editGiftNote = member.GiftNote;
        _error = null;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEditAsync()
    {
        if (_editingId is not { } id)
        {
            return;
        }

        _error = null;
        try
        {
            await Sender.Send(new EditMemberCommand(GroupId, id, _editName));
            if (!_connected.KeepsOwnEntry(id))
            {
                await Sender.Send(new SetMemberGiftNoteCommand(GroupId, id, _editGiftNote));
            }
            _editingId = null;
            await LoadAsync();
        }
        catch (CircleTools.SecretSanta.Core.Domain.DuplicateMemberNameException exception)
        {
            _error = DuplicateMessage(exception.Name);
        }
        catch (InvalidOperationException)
        {
            _error = L["MemberSaveFailed"];
        }
    }

    // Confirm removal in a bottom sheet (FEAT-008 W4) rather than an inline warning that reflows the card.
    private async Task AskRemoveAsync(Guid memberId, string name)
    {
        _error = null;
        if (await Dialogs.ShowConfirmSheetAsync(L["ConfirmRemoveMember", name], L["ConfirmRemove"], L["Cancel"]))
        {
            await RemoveAsync(memberId);
        }
    }

    private async Task RemoveAsync(Guid memberId)
    {
        await Sender.Send(new RemoveMemberCommand(GroupId, memberId));
        await LoadAsync();
    }

    // A menu item that opens a sheet starts it only after the menu has closed: the item's handler returns at
    // once, so the menu is gone before the sheet slides in rather than staying open behind it (Q12).
    private void AfterMenu(Func<Task> action) => _ = InvokeAsync(async () =>
    {
        await Task.Yield();
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    });
}
