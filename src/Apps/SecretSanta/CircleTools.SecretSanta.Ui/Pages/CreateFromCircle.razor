@page "/groups/from-circle"
@using CircleTools.ApiClient
@using CircleTools.Circles.Contracts
@inject CreateFromCircleService Service
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject IEnumerable<CircleTools.Ui.Shared.SuiteAppLink> SuiteApps

@*
    Create a group from a circle (FR-027): pick a circle, everyone is pre-selected, name the group. The
    group is a snapshot — a later change to the circle never touches it. Account-backed people come in
    linked; a managed member, or a second person on the same account, comes in unlinked and is named.
*@

<PageTitle>@L["FromCircleTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["FromCircleTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["FromCircleLead"]</MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" role="status">@_error</MudAlert>
        }

        @if (_createdGroupId is { } createdId)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@L["FromCircleCreated"]</MudAlert>
            @if (_broughtInUnlinked.Count > 0)
            {
                @* The duplicate-account notice: a second person on the same account came in unlinked. *@
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" role="status">
                    @L["FromCircleDuplicateAccountNotice", string.Join(", ", _broughtInUnlinked)]
                </MudAlert>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreated">
                @L["FromCircleOpenGroup"]
            </MudButton>
        }
        else if (_circles is null)
        {
            <MudText>@L["Loading"]</MudText>
        }
        else if (_circles.Count == 0)
        {
            @* No app is named here: on the phone there is no "account app" (Q36). Circles are managed on the web. *@
            <MudText Class="mud-text-secondary">@L["FromCircleNoCircles"]</MudText>
            <MudButton Href="@CirclesUrl" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Class="mt-2"
                       EndIcon="@Icons.Material.Filled.OpenInNew" id="manage-circles">@L["FromCircleManageOnWeb"]</MudButton>
        }
        else if (_detail is null)
        {
            <MudText Typo="Typo.subtitle2" GutterBottom="true">@L["FromCircleChooseLabel"]</MudText>
            <MudStack Spacing="1">
                @foreach (var circle in _circles)
                {
                    <MudButton FullWidth="true" Variant="Variant.Outlined" Class="justify-space-between pa-3"
                               OnClick="() => ChooseAsync(circle.Id)" Disabled="@_busy">
                        <span><strong>@circle.Name</strong> <span class="mud-text-secondary ml-2">@circle.Label</span></span>
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@PeopleCount(circle.PeopleCount)</MudChip>
                    </MudButton>
                }
            </MudStack>
        }
        else
        {
            <MudTextField @bind-Value="_groupName" Immediate="true" Label="@L["FromCircleGroupNameLabel"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudText Class="mud-text-secondary mb-1">@PeopleCount(_detail.People.Count)</MudText>
            <MudStack Spacing="1" Class="mb-3">
                @foreach (var person in _detail.People)
                {
                    <MudPaper Elevation="1" Class="pa-2">
                        <MudCheckBox T="bool" Value="_selected.Contains(person.MembershipId)"
                                     ValueChanged="on => Toggle(person.MembershipId, on)">
                            @person.DisplayName
                            @if (person.IsManaged)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Class="ml-2">@L["FromCircleManagedBadge"]</MudChip>
                            }
                            else if (person.AccountId is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Class="ml-2">@L["FromCircleLinkedBadge"]</MudChip>
                            }
                        </MudCheckBox>
                    </MudPaper>
                }
            </MudStack>

            <div class="d-flex gap-1 align-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync"
                           Disabled="@(_busy || _selectedCount == 0 || string.IsNullOrWhiteSpace(_groupName))">
                    @L["FromCircleCreate"]
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="Back" Disabled="@_busy">@L["FromCircleBack"]</MudButton>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<CircleSummaryResponse>? _circles;
    private CircleDetailResponse? _detail;
    private readonly HashSet<Guid> _selected = [];
    private string _groupName = string.Empty;
    private bool _busy;
    private string? _error;
    private Guid? _createdGroupId;
    private IReadOnlyList<string> _broughtInUnlinked = [];

    private int _selectedCount => _selected.Count;

    // Circles live in the suite's account app on the web; the device heads register no suite links, so fall
    // back to the production origin.
    private string CirclesUrl =>
        (SuiteApps.FirstOrDefault(a => !a.IsCurrent)?.Url ?? "https://circletools.ch").TrimEnd('/') + "/circles";

    protected override async Task OnInitializedAsync() => await LoadCirclesAsync();

    private async Task LoadCirclesAsync()
    {
        var result = await Service.GetCirclesAsync();
        if (result.IsSuccess)
        {
            _circles = result.Value;
        }
        else
        {
            _circles = [];
            _error = result.Error!.Failure == ApiFailure.Unreachable ? L["FromCircleOffline"] : L["FromCircleReadFailed"];
        }
    }

    private async Task ChooseAsync(Guid circleId)
    {
        _busy = true;
        _error = null;
        var result = await Service.GetCircleAsync(circleId);
        _busy = false;

        if (result.IsSuccess)
        {
            // The circle's people alphabetically (LO-1), as the group's member list will show them.
            _detail = result.Value! with { People = DisplayOrder.ByName(result.Value!.People, p => p.DisplayName) };
            _groupName = _detail!.Name;
            _selected.Clear();
            // Everyone is pre-selected — the common case is "bring the whole circle in".
            foreach (var person in _detail.People)
            {
                _selected.Add(person.MembershipId);
            }
        }
        else
        {
            _error = result.Error!.Failure == ApiFailure.Unreachable ? L["FromCircleOffline"] : L["FromCircleReadFailed"];
        }
    }

    private void Toggle(Guid id, bool on)
    {
        if (on)
        {
            _selected.Add(id);
        }
        else
        {
            _selected.Remove(id);
        }
    }

    private async Task CreateAsync()
    {
        if (_busy || _detail is null || _selected.Count == 0 || string.IsNullOrWhiteSpace(_groupName))
        {
            return;
        }

        _busy = true;
        try
        {
            var chosen = _detail.People.Where(p => _selected.Contains(p.MembershipId)).ToList();
            var result = await Service.CreateAsync(_detail.Id, _groupName, chosen);

            // Surface the duplicate-account notice before leaving; navigate straight through when there
            // is nothing to say.
            _broughtInUnlinked = result.BroughtInUnlinkedNames;
            if (_broughtInUnlinked.Count == 0)
            {
                Navigation.NavigateTo($"groups/{result.GroupId}");
                return;
            }

            _createdGroupId = result.GroupId;
            _detail = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Back() => _detail = null;

    private void OpenCreated()
    {
        if (_createdGroupId is { } id)
        {
            Navigation.NavigateTo($"groups/{id}");
        }
    }

    // The count-at-one string is a distinct key, not "{0} people" with a swapped number: at one the
    // noun is singular in every language this app speaks (the M2 "1 Personen" trap; a picker shows one
    // person often).
    private string PeopleCount(int count) =>
        count == 1 ? L["FromCirclePeopleCountSingular", count] : L["FromCirclePeopleCountPlural", count];
}
