@page "/my-links"
@using CircleTools.ApiClient
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ILinkingApi Linking
@inject IStringLocalizer<AppStrings> L

@*
    Resolve a member-link request (FR-028): an organizer asked to link you to a member of their group.
    Accepting means you own that member's wishlist and see your own assignment. Declining is silent —
    the organizer cannot tell a decline from a request that simply expired.
*@

<PageTitle>@L["MyLinksTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["MyLinksTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["MyLinksLead"]</MudText>

        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" role="status">@_message</MudAlert>
        }

        @if (_pending is null)
        {
            <MudText>@L["Loading"]</MudText>
        }
        else if (_pending.Count == 0)
        {
            <MudText Class="mud-text-secondary">@L["MyLinksNone"]</MudText>
        }
        else
        {
            <MudStack Spacing="1">
                @foreach (var request in _pending)
                {
                    <MudPaper Elevation="1" Class="d-flex justify-space-between align-center flex-wrap gap-2 pa-3">
                        <MudText>@L["MyLinksRequestText", request.MemberDisplayName, request.GroupName]</MudText>
                        <div class="d-flex gap-1">
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       OnClick="() => AcceptAsync(request)" Disabled="@_busy">
                                @L["MyLinksAccept"]
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       OnClick="() => DeclineAsync(request)" Disabled="@_busy">
                                @L["MyLinksDecline"]
                            </MudButton>
                        </div>
                    </MudPaper>
                }
            </MudStack>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<PendingMemberLinkResponse>? _pending;
    private bool _busy;
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Linking.GetPendingAsync();
        _pending = result.IsSuccess ? result.Value : [];
        if (!result.IsSuccess && result.Error!.Failure == ApiFailure.Unreachable)
        {
            _message = L["MyLinksOffline"];
        }
    }

    private async Task AcceptAsync(PendingMemberLinkResponse request)
    {
        _busy = true;
        _message = null;

        var result = await Linking.AcceptAsync(request.Id);
        _busy = false;

        _message = result.IsSuccess
            ? result.Value!.Outcome switch
            {
                AcceptMemberLinkOutcome.Linked => L["MyLinksAccepted", request.GroupName],
                AcceptMemberLinkOutcome.AlreadyLinked => L["MyLinksAlreadyLinked", request.GroupName],
                _ => L["MyLinksManagedRefused"],
            }
            : L["MyLinksActionFailed"];

        await LoadAsync();
    }

    private async Task DeclineAsync(PendingMemberLinkResponse request)
    {
        _busy = true;
        _message = null;

        var result = await Linking.DeclineAsync(request.Id);
        _busy = false;
        _message = result.IsSuccess ? L["MyLinksDeclined"] : L["MyLinksActionFailed"];

        await LoadAsync();
    }
}
