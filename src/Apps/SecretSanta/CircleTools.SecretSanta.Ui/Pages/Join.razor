@page "/join"
@using System.Security.Claims
@using CircleTools.ApiClient
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Online
@using CircleTools.Ui.Account.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject IOnlineGroupApi Api
@inject OnlineGroupSync Online
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject PendingJoinLink Pending
@inject IGroupRecordStore Records
@inject SessionAccount Session
@inject IStringLocalizer<AppStrings> L
@implements IDisposable

@*
    Taking part through a join link (ADR-0086, FR-041): pick who you are — or add yourself under a new name — and
    whether to take part with your account (all your devices) or this device only. Either way you become the same
    kind of participant: you see your own assignment and keep your own wishlist and gift note.
*@

<PageTitle>@L["JoinTitle"]</PageTitle>

@if (!_loaded)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_preview is null)
{
    <div class="d-flex flex-column align-center text-center gap-3 pa-6" id="join-notfound">
        <MudIcon Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h6">@L["JoinNotFoundTitle"]</MudText>
        <MudText Class="mud-text-secondary">@L["JoinNotFoundBody"]</MudText>
    </div>
}
else if (_held is not null)
{
    @* This device already holds the group — as its organizer or taking part, through the account or a device key.
       Joining again would give the same person a second spot (S24 device test, 2026-10-25): open it instead. *@
    <MudText Typo="Typo.overline">@L["JoinInvitedTo"]</MudText>
    <MudText Typo="Typo.h4" GutterBottom="true">@_preview.GroupName</MudText>
    <MudPaper Outlined="true" Class="pa-4 mt-2" id="join-already-in">
        <MudText Typo="Typo.h6" GutterBottom="true">@L["JoinAlreadyInTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-3">
            @(_held.Document is not null || _held.View is null ? L["JoinAlreadyOrganizing"] : L["JoinAlreadyInAs", _held.View.MemberName])
        </MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" id="join-open-group"
                   OnClick="@(() => Navigation.NavigateTo(_held.Document is not null || _held.View is null ? $"groups/{_held.Id}" : $"groups/{_held.Id}/me"))">
            @L["JoinOpenGroup"]
        </MudButton>
    </MudPaper>
}
else
{
    <MudText Typo="Typo.overline">@L["JoinInvitedTo"]</MudText>
    <MudText Typo="Typo.h4" GutterBottom="true">@_preview.GroupName</MudText>

    <MudPaper Outlined="true" Class="pa-4 mt-2" id="join-panel">
        <MudText Typo="Typo.h6" GutterBottom="true">@L["JoinWhoAreYou"]</MudText>
        <MudText Class="mud-text-secondary mb-3">@L["JoinWhoAreYouHint"]</MudText>

        @if (AllTaken)
        {
            @* Nobody left to be (Q6): say so; adding oneself under a new name still works. *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" id="join-all-taken">@L["JoinAllTaken"]</MudAlert>
        }

        <MudRadioGroup T="Guid" Value="_selectedMemberId" ValueChanged="Pick">
            @* One member per line: the group lays its children out in a wrapping row, which put a name beside
               another member's chip on a phone (ST-5). *@
            <div class="d-flex flex-column" id="join-members">
                @foreach (var member in _preview.Members)
                {
                    <div class="d-flex align-center">
                        <MudRadio T="Guid" Value="@member.MemberId" Color="Color.Primary" Dense="true" Disabled="@member.Taken">
                            @member.Name
                        </MudRadio>
                        @if (member.Taken)
                        {
                            @* An open invitation reserves the name, but nobody has joined yet (ST-3). *@
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                @(member.Invited ? L["MemberInvitedBadge"] : L["JoinAlreadyTaken"])
                            </MudChip>
                        }
                    </div>
                }
            </div>
        </MudRadioGroup>

        <MudTextField T="string" Value="_newName" ValueChanged="TypeNewName" Immediate="true" Class="mt-2" id="join-new-name"
                      Label="@L["JoinNewNameLabel"]" HelperText="@L["JoinNewNameHint"]" Variant="Variant.Outlined" Margin="Margin.Dense" />

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" GutterBottom="true">@L["JoinRememberTitle"]</MudText>
        <MudRadioGroup T="bool" @bind-Value="_withAccount">
            <MudRadio T="bool" Value="false" Color="Color.Primary" Dense="true">
                <span class="ct-mode-title">@L["JoinRememberDevice"]</span>
                <span class="ct-mode-hint">@L["JoinRememberDeviceHint"]</span>
            </MudRadio>
            <MudRadio T="bool" Value="true" Color="Color.Primary" Dense="true" Disabled="@(!_signedIn)">
                <span class="ct-mode-title">@L["JoinRememberAccount"]</span>
                <span class="ct-mode-hint">
                    @if (_signedIn)
                    {
                        @(string.IsNullOrEmpty(_email) ? L["JoinRememberAccountHint"] : L["JoinRememberAccountHintFor", _email])
                    }
                    else
                    {
                        @L["JoinRememberAccountSignInHint"]
                    }
                </span>
            </MudRadio>
        </MudRadioGroup>

        @if (!_signedIn)
        {
            @* Signing in returns here with the invitation intact (Q7). *@
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Login" Class="mt-1"
                       OnClick="SignInToJoin" id="join-sign-in">@L["JoinSignInToKeep"]</MudButton>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true" role="alert" id="join-error">@_error</MudAlert>
        }

        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-4" id="join-continue"
                   OnClick="ContinueAsync" Disabled="@(_busy || !CanContinue)">
            @L["JoinContinue"]
        </MudButton>
    </MudPaper>
}

@code {
    private bool _loaded;
    private bool _busy;
    private bool _signedIn;
    private Guid? _accountId;
    private string? _email;
    private string? _token;
    private JoinPreview? _preview;
    private GroupRecord? _held;
    private Guid _selectedMemberId;
    private string _newName = string.Empty;
    private bool _withAccount;
    private string? _error;

    private bool AllTaken => _preview is not null && _preview.Members.All(m => m.Taken);

    private bool CanContinue => _selectedMemberId != Guid.Empty || !string.IsNullOrWhiteSpace(_newName);

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var id = state.User.UserId();
        _signedIn = id != Guid.Empty;
        _accountId = _signedIn ? id : null;
        _email = state.User.FindFirst(ClaimTypes.Email)?.Value;

        // Signed in, the durable choice is the sensible default: the group then follows the account to its other
        // devices (Q7). Signed out, only this device is possible.
        _withAccount = _signedIn;

        // Back from signing in to join: the token was parked, not carried in the URL.
        _token = ReadToken() ?? Pending.Token;
        Pending.Token = null;
        await LoadPreviewAsync();
        _loaded = true;

        // A second join link can arrive while this page is open (an App Link on the phone): the route is the same,
        // so the router reuses this component and OnInitialized does not run again — the page kept showing the
        // first group (S24 device test, 2026-10-25). Re-read the link on every navigation, as the reveal page does.
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('#', '?')[0].TrimEnd('/');
        if (!string.Equals(path, "join", StringComparison.OrdinalIgnoreCase) || ReadToken() is not { } token || token == _token)
        {
            return;
        }

        _token = token;
        _selectedMemberId = Guid.Empty;
        _newName = string.Empty;
        _error = null;
        await LoadPreviewAsync();
        StateHasChanged();
    });

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task LoadPreviewAsync()
    {
        if (string.IsNullOrEmpty(_token))
        {
            return;
        }

        var preview = await Api.PreviewJoinAsync(_token);
        _preview = preview.IsSuccess ? preview.Value : null;
        _held = _preview is null ? null : await HeldAsync(_preview.GroupId);
    }

    // The group as this device already holds it, for the account shown (or a link / device key), if it does.
    private async Task<GroupRecord?> HeldAsync(Guid groupId)
    {
        var account = await Session.CurrentAsync();
        try
        {
            return (await Records.LoadAsync()).Records.FirstOrDefault(r => r.Id == groupId && r.IsVisibleTo(account));
        }
        catch (StorageUnavailableException)
        {
            return null;
        }
    }

    // Picking a member and typing a new name are alternatives: choosing one clears the other.
    private void Pick(Guid memberId)
    {
        _selectedMemberId = memberId;
        _newName = string.Empty;
    }

    private void TypeNewName(string name)
    {
        _newName = name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            _selectedMemberId = Guid.Empty;
        }
    }

    // The token rides the link fragment ("the link is the secret"), so it never reaches the server as a query
    // string: .../join#t=<token>.
    private string? ReadToken()
    {
        var fragment = new Uri(Navigation.Uri).Fragment.TrimStart('#');
        foreach (var pair in fragment.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "t")
            {
                return Uri.UnescapeDataString(kv[1]);
            }
        }

        return null;
    }

    private void SignInToJoin()
    {
        Pending.Token = _token;
        Navigation.NavigateTo("account/login?returnUrl=join");
    }

    private async Task ContinueAsync()
    {
        if (_token is null || !CanContinue)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var request = _selectedMemberId != Guid.Empty
                ? new JoinRequest(_selectedMemberId, null, _withAccount && _signedIn)
                : new JoinRequest(null, _newName.Trim(), _withAccount && _signedIn);
            var result = await Online.JoinAsync(_token, request, _accountId);
            if (result.IsSuccess)
            {
                Navigation.NavigateTo($"groups/{result.Value!.GroupId}/me");
                return;
            }

            if (result.Error!.Failure == ApiFailure.Conflict)
            {
                // Taken meanwhile, or that name is already on the list: refresh so it greys out.
                _error = L["JoinAlreadyClaimedError"];
                _selectedMemberId = Guid.Empty;
                await LoadPreviewAsync();
            }
            else
            {
                _error = L["JoinFailedError"];
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
