@page "/groups/{GroupId:guid}/events/{EventId:guid}/wishlists"
@inject ISender Sender
@inject IStringLocalizer<AppStrings> L
@inject IServiceProvider Services
@inject ISyncSignals SyncSignals
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>@L["WishlistsTitle"]</PageTitle>

<EventBackNav GroupId="GroupId" EventId="EventId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["WishlistsTitle"]</MudText>

@if (_event is null)
{
    <MudText>@(_loaded ? L["EventNotFound"] : L["Loading"])</MudText>
}
else if (_readOnly)
{
    <MudText Class="mud-text-secondary">@L["ParticipantReadOnlyNote"]</MudText>
}
else if (_event.Wishlists.Count == 0)
{
    <MudText Class="mud-text-secondary mb-4">@L["WishlistsLead"]</MudText>
    <MudText Class="mud-text-secondary">@L["NoMembers"]</MudText>
}
else
{
    <MudText Class="mud-text-secondary mb-4">@L["WishlistsLead"]</MudText>
    <MudStack Spacing="2">
        @foreach (var editor in _editors)
        {
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle1" GutterBottom="true"><strong>@editor.MemberName</strong></MudText>
                    @* A joined member keeps their own wishlist (ADR-0080): shown, not editable here — filled and with a
                       lock, so it does not look like the editable fields around it (S24 device test, 2026-10-25). *@
                    @* Saved as you type and when leaving the field, like "My wishlists" — no Save button (Q29).
                       Every keystroke reaches the model (no MudBlazor DebounceInterval): that debounce held the
                       value back, so leaving the field within the pause saved the old text and the edit was lost
                       behind a "Saved ✓" (2026-10-17 browser pass). The pause is the page's own timer instead. *@
                    <MudTextField T="string" Value="editor.Text" ValueChanged="value => OnEditorChanged(editor, value)"
                                  Label="@L["WishlistLabel"]" Variant="@(editor.OwnedByMember ? Variant.Filled : Variant.Outlined)"
                                  Adornment="@(editor.OwnedByMember ? Adornment.End : Adornment.None)"
                                  AdornmentIcon="@Icons.Material.Outlined.Lock"
                                  Margin="Margin.Dense" Lines="3" ReadOnly="editor.OwnedByMember" Immediate="true"
                                  OnBlur="() => FlushAsync(editor)"
                                  HelperText="@(editor.OwnedByMember ? L["MemberKeepsOwnEntry", editor.MemberName].Value : null)" />
                    @if (!editor.OwnedByMember && editor.Status is { } status)
                    {
                        <MudText Typo="Typo.caption" Class="mt-1 d-block" role="status"
                                 Color="@(status == EditorStatus.Failed ? Color.Error : status == EditorStatus.Saved ? Color.Success : Color.Default)">
                            @(status switch
                            {
                                EditorStatus.Saving => L["Saving"],
                                EditorStatus.Saved => L["SavedCheck"],
                                _ => L["WishlistSaveFailed"],
                            })
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@code {
    // How long typing must pause before an autosave. Leaving the field (blur) or the page saves at once.
    private static readonly TimeSpan SavePause = TimeSpan.FromMilliseconds(700);

    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    /// <summary>The event whose wishlists are edited.</summary>
    [Parameter]
    public Guid EventId { get; set; }

    private sealed class WishlistEditor
    {
        public Guid MemberId { get; init; }
        public string MemberName { get; init; } = string.Empty;
        public string Text { get; set; } = string.Empty;
        public EditorStatus? Status { get; set; }
        public bool OwnedByMember { get; init; }

        // The text last stored, so a blur right after an autosave does not save again — and the text a
        // pulled sync may replace only while nothing typed here is still unsaved.
        public string SavedText { get; set; } = string.Empty;

        // The autosave waiting for the typing pause; cancelled by more typing or by a blur that saves at once.
        public CancellationTokenSource? Pending { get; set; }

        // The text before this visit to the field changed it — what "Undo" restores once the field is left.
        public string? Baseline { get; set; }

        public bool HasUnsavedText => Text != SavedText;
    }

    private enum EditorStatus
    {
        Saving,
        Saved,
        Failed,
    }

    // One save at a time. Each save rewrites the whole group in local storage (load → change → store), so two
    // overlapping saves — one member's blur and the next member's autosave — could otherwise write over each
    // other with a stale copy of the group.
    private readonly SemaphoreSlim _saveLock = new(1, 1);

    private EventDto? _event;
    private bool _loaded;
    private bool _disposed;
    // Only a device that may write the document edits wishlists (ADR-0086); someone taking part edits their own
    // on their group page instead.
    private bool _readOnly;
    private List<WishlistEditor> _editors = [];

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    // A background sync (ADR-0044) may have pulled newer wishlists — a co-organizer's or another device's edit,
    // or a member's own entry merged in by the server (ADR-0086) — into the local store. Reload so the page does not keep showing (and then
    // save over) the old text. A field with unsaved typing keeps what was typed; it is saved as usual.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        if (_disposed)
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        var access = await GroupAccess.ForAsync(Services, GroupId);
        _readOnly = access.ReadOnly;
        _event = await Sender.Send(new GetEventQuery(GroupId, EventId));
        _loaded = true;

        var group = await Sender.Send(new GetGroupQuery(GroupId));
        var connected = group is null ? ConnectedMembers.None : await ConnectedMembers.ForAsync(Services, group);
        var previous = _editors.ToDictionary(e => e.MemberId);
        _editors = _event is null
            ? []
            : DisplayOrder.ByName(_event.Wishlists, w => w.MemberName)
                .Select(w => previous.TryGetValue(w.MemberId, out var typing) && (typing.HasUnsavedText || typing.Baseline is not null)
                    ? typing
                    : new WishlistEditor
                    {
                        MemberId = w.MemberId,
                        MemberName = w.MemberName,
                        Text = string.Join('\n', w.Items),
                        SavedText = string.Join('\n', w.Items),
                        OwnedByMember = connected.KeepsOwnEntry(w.MemberId),
                        Status = previous.TryGetValue(w.MemberId, out var shown) ? shown.Status : null,
                    })
                .ToList();
    }

    private static IReadOnlyList<string> ParseWishlist(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // Typing makes the shown status "Saving…" at once, so "Saved ✓" always means the latest text is saved —
    // not just the first change (2026-10-16 feedback). The autosave after the pause then confirms it.
    private void OnEditorChanged(WishlistEditor editor, string value)
    {
        if (editor.OwnedByMember)
        {
            return;
        }

        editor.Baseline ??= editor.Text;
        editor.Text = value ?? string.Empty;
        editor.Status = EditorStatus.Saving;
        editor.Pending = Restart(editor.Pending, token => SaveAfterPauseAsync(() => SaveAsync(editor), token));
    }

    // Cancels the waiting autosave and starts a new one, so only the last pause in a burst of typing saves.
    private static CancellationTokenSource Restart(CancellationTokenSource? pending, Func<CancellationToken, Task> start)
    {
        pending?.Cancel();
        pending?.Dispose();
        var next = new CancellationTokenSource();
        _ = start(next.Token);
        return next;
    }

    private async Task SaveAfterPauseAsync(Func<Task> save, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(SavePause, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await save();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    // Leaving the field saves at once instead of waiting for the pause, and offers to undo the visit's change.
    private async Task FlushAsync(WishlistEditor editor)
    {
        editor.Pending?.Cancel();
        await SaveAsync(editor);

        var before = editor.Baseline;
        editor.Baseline = null;
        if (before is not null && before != editor.Text && editor.Status == EditorStatus.Saved)
        {
            UndoLastEdit.Offer(Snackbar, L, () => UndoAsync(editor, before));
        }
    }

    private async Task UndoAsync(WishlistEditor editor, string before)
    {
        editor.Pending?.Cancel();
        editor.Text = before;
        await SaveAsync(editor);
        await RefreshAsync();
    }

    // The undo runs from the snackbar, which outlives this page: re-render only while the page is still shown.
    private Task RefreshAsync() => _disposed ? Task.CompletedTask : InvokeAsync(StateHasChanged);

    // A failed save keeps the text in the field and says so; the next keystroke or blur tries again.
    private async Task SaveAsync(WishlistEditor editor)
    {
        await _saveLock.WaitAsync();
        try
        {
            if (editor.OwnedByMember || !editor.HasUnsavedText)
            {
                if (editor.Status == EditorStatus.Saving)
                {
                    editor.Status = EditorStatus.Saved; // typed, then put it back as it was
                }

                return;
            }

            var text = editor.Text;
            editor.Status = EditorStatus.Saving;
            try
            {
                await Sender.Send(new SetMemberWishlistCommand(GroupId, EventId, editor.MemberId, ParseWishlist(text)));
                editor.SavedText = text;

                // Typing that arrived while this save was running is still waiting for its own save.
                editor.Status = editor.HasUnsavedText ? EditorStatus.Saving : EditorStatus.Saved;
            }
            catch (Exception)
            {
                editor.Status = EditorStatus.Failed;
            }
        }
        finally
        {
            _saveLock.Release();
        }
    }

    // Navigating away within the typing pause must not drop the edit: save whatever is still unsaved.
    public async ValueTask DisposeAsync()
    {
        SyncSignals.SyncCompleted -= OnSyncCompleted;
        _disposed = true;

        foreach (var editor in _editors)
        {
            editor.Pending?.Cancel();
            if (editor.HasUnsavedText)
            {
                await SaveAsync(editor);
            }
        }
    }
}
