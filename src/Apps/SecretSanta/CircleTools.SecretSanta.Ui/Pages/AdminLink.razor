@page "/admin"
@using CircleTools.SecretSanta.LocalStore.Online
@inject OnlineGroupSync Online
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

@*
    Opening a management link (ADR-0086, decision D1): /admin#g=<group>&t=<token>. A working link puts the group on
    this device, organized by that link, and opens it. A link that was replaced, or whose group an account took
    over, no longer works; it says so without telling the holder anything else.
*@

<PageTitle>@L["AdminLink"]</PageTitle>

@if (!_resolved)
{
    <MudText>@L["Loading"]</MudText>
}
else
{
    @* Successful adoption redirects, so this only shows on failure. *@
    <div class="d-flex flex-column align-center text-center gap-3 pa-6" id="admin-notfound">
        <MudIcon Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h6">@L["JoinNotFoundTitle"]</MudText>
        <MudText Class="mud-text-secondary">@L["JoinNotFoundBody"]</MudText>
    </div>
}

@code {
    private bool _resolved;

    protected override async Task OnInitializedAsync()
    {
        var fragment = ReadFragment();
        if (fragment.TryGetValue("g", out var group) && Guid.TryParse(group, out var groupId)
            && fragment.TryGetValue("t", out var token) && !string.IsNullOrEmpty(token)
            && await Online.AdoptOrganizerLinkAsync(groupId, token))
        {
            Navigation.NavigateTo($"groups/{groupId}");
            return;
        }

        _resolved = true;
    }

    // The link's parts ride the fragment ("the link is the secret"), so they never reach a server log.
    private Dictionary<string, string> ReadFragment()
    {
        var parts = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var pair in new Uri(Navigation.Uri).Fragment.TrimStart('#').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2)
            {
                parts[kv[0]] = Uri.UnescapeDataString(kv[1]);
            }
        }

        return parts;
    }
}
