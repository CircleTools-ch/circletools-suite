@page "/admin"
@using CircleTools.SecretSanta.LocalStore
@inject ISharedGroupApi Api
@inject SharedSyncService Shared
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["AdminLink"]</PageTitle>

@if (!_resolved)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_retiredByName is not null)
{
    <div class="d-flex flex-column align-center text-center gap-3 pa-6" id="admin-retired">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h6">@L["AdminRetiredTitle"]</MudText>
        <MudText Class="mud-text-secondary">@L["AdminRetiredBody", _retiredByName]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["AdminRetiredJoinHint"]</MudText>
    </div>
}
else
{
    @* Unresolvable token (wrong or deleted). Successful adoption redirects, so this only shows on failure. *@
    <div class="d-flex flex-column align-center text-center gap-3 pa-6" id="admin-notfound">
        <MudIcon Icon="@Icons.Material.Filled.LinkOff" Color="Color.Error" Size="Size.Large" />
        <MudText Typo="Typo.h6">@L["JoinNotFoundTitle"]</MudText>
        <MudText Class="mud-text-secondary">@L["JoinNotFoundBody"]</MudText>
    </div>
}

@code {
    private bool _resolved;
    private string? _retiredByName;

    protected override async Task OnInitializedAsync()
    {
        var token = ReadToken();
        if (!string.IsNullOrEmpty(token))
        {
            var view = await Api.GetAsync(token);
            if (view is { IsSuccess: true, Value: not null })
            {
                if (view.Value.AdminRetired)
                {
                    // An account has claimed admin — tell the holder who took over.
                    _retiredByName = view.Value.AdminClaimedByName ?? L["Someone"];
                }
                else
                {
                    // A live admin link: adopt it on this device (co-organizer) and open the group.
                    var groupId = await Shared.AdoptAdminAsync(token);
                    if (groupId is { } id)
                    {
                        Navigation.NavigateTo($"groups/{id}");
                        return;
                    }
                }
            }
        }

        _resolved = true;
    }

    private string? ReadToken()
    {
        var fragment = new Uri(Navigation.Uri).Fragment.TrimStart('#');
        foreach (var pair in fragment.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "t")
            {
                return Uri.UnescapeDataString(kv[1]);
            }
        }

        return null;
    }
}
