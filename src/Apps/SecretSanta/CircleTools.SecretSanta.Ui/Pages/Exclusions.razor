@page "/groups/{GroupId:guid}/exclusions"
@inject ISender Sender
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["ExclusionsTitle"]</PageTitle>

<GroupNav GroupId="GroupId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["ExclusionsTitle"]</MudText>
<MudText Class="mud-text-secondary mb-4">@L["ExclusionHint"]</MudText>

@if (_group is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_group.Members.Count < 2)
{
    <MudText>@L["NeedTwoMembersForExclusion"]</MudText>
}
else
{
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Class="mb-2">
        <MudSelect T="string" @bind-Value="_giverId" Label="@L["GiverLabel"]" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Class="flex-grow-1">
            <MudSelectItem T="string" Value="@("")">--</MudSelectItem>
            @foreach (var member in _group.Members)
            {
                <MudSelectItem T="string" Value="@member.Id.ToString()">@member.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_recipientId" Label="@L["RecipientLabel"]" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Class="flex-grow-1">
            <MudSelectItem T="string" Value="@("")">--</MudSelectItem>
            @foreach (var member in _group.Members)
            {
                <MudSelectItem T="string" Value="@member.Id.ToString()">@member.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-1"
                   OnClick="AddAsync" Disabled="@(!CanAdd)">@L["AddExclusion"]</MudButton>
    </MudStack>

    @* A disabled button alone leaves the organizer guessing why nothing happens. *@
    @if (ValidationMessage is { } message)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@message</MudAlert>
    }

    @if (_group.Exclusions.Count == 0)
    {
        <MudText Class="mud-text-secondary">@L["NoExclusions"]</MudText>
    }
    else
    {
        <MudStack Spacing="1">
            @foreach (var exclusion in _group.Exclusions)
            {
                <MudPaper Elevation="1" Class="d-flex justify-space-between align-center pa-3">
                    <MudText>@NameOf(exclusion.GiverMemberId) &rarr; @NameOf(exclusion.RecipientMemberId)</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="() => RemoveAsync(exclusion.GiverMemberId, exclusion.RecipientMemberId)">
                        @L["Remove"]
                    </MudButton>
                </MudPaper>
            }
        </MudStack>
    }
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private GroupDto? _group;
    private string _giverId = string.Empty;
    private string _recipientId = string.Empty;

    private bool CanAdd =>
        Guid.TryParse(_giverId, out var giver) &&
        Guid.TryParse(_recipientId, out var recipient) &&
        giver != recipient;

    /// <summary>Explains why <see cref="CanAdd"/> is false, or <see langword="null"/> when it is true.</summary>
    private string? ValidationMessage
    {
        get
        {
            if (CanAdd)
            {
                return null;
            }

            var giverChosen = Guid.TryParse(_giverId, out var giver);
            var recipientChosen = Guid.TryParse(_recipientId, out var recipient);

            if (giverChosen && recipientChosen && giver == recipient)
            {
                return L["ExclusionSelfNotAllowed"].Value;
            }

            // Nothing picked yet is the initial state, not a mistake worth nagging about.
            return giverChosen || recipientChosen ? L["ExclusionPickBoth"].Value : null;
        }
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync() => _group = await Sender.Send(new GetGroupQuery(GroupId));

    private string NameOf(Guid memberId) =>
        _group?.Members.FirstOrDefault(m => m.Id == memberId)?.Name ?? memberId.ToString();

    private async Task AddAsync()
    {
        if (!CanAdd)
        {
            return;
        }

        await Sender.Send(new AddExclusionCommand(GroupId, Guid.Parse(_giverId), Guid.Parse(_recipientId)));
        _giverId = string.Empty;
        _recipientId = string.Empty;
        await LoadAsync();
    }

    private async Task RemoveAsync(Guid giverId, Guid recipientId)
    {
        await Sender.Send(new RemoveExclusionCommand(GroupId, giverId, recipientId));
        await LoadAsync();
    }
}
