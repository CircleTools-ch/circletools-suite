@page "/groups/{GroupId:guid}/exclusions"
@inject ISender Sender
@inject IStringLocalizer<AppStrings> L
@inject ISyncSignals SyncSignals
@inject IServiceProvider Services
@implements IDisposable

<PageTitle>@L["ExclusionsTitle"]</PageTitle>

<GroupBackNav GroupId="GroupId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["ExclusionsTitle"]</MudText>
<MudText Class="mud-text-secondary mb-4">@L["ExclusionHint"]</MudText>

@if (_group is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_readOnly)
{
    @* A join-link participant sees the rules but only the organizer changes them (ADR-0058). *@
    <MudAlert Severity="Severity.Normal" Class="mb-4" Dense="true">@L["ParticipantReadOnlyNote"]</MudAlert>
    @if (_group.Exclusions.Count == 0)
    {
        <MudText Class="mud-text-secondary">@L["NoExclusions"]</MudText>
    }
    else
    {
        <MudStack Spacing="1">
            @foreach (var exclusion in _group.Exclusions)
            {
                <MudPaper Elevation="1" Class="pa-3">
                    <MudText>
                        @(exclusion.Mutual
                            ? L["ExclusionRowMutual", NameOf(exclusion.GiverMemberId), NameOf(exclusion.RecipientMemberId)]
                            : L["ExclusionRow", NameOf(exclusion.GiverMemberId), NameOf(exclusion.RecipientMemberId)])
                    </MudText>
                </MudPaper>
            }
        </MudStack>
    }
}
else if (_group.Members.Count < 2)
{
    @* Same recovery as the Draw page (OB-4): offer the way to add members instead of a dead-end line. *@
    <MudStack Spacing="3" AlignItems="AlignItems.Start">
        <MudText>@L["NeedTwoMembersForExclusion"]</MudText>
        <MudButton Href="@($"groups/{GroupId}/members")" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd">@L["GoToMembers"]</MudButton>
    </MudStack>
}
else
{
    @* One full-width field per line (UX review U1): side by side, the labels truncated ("Giv…") on a
       phone, and the button jumped to the next line once both were chosen, so a tap where it had been
       opened a select instead. The order reads as the sentence it builds: [giver] must not give to
       [recipient] (both ways). The selects show member names via ToStringFunc — without it MudSelect
       rendered the raw member id once the filtered recipient list was rebuilt (B7). *@
    <MudPaper Outlined="true" Class="pa-3 mb-4">
        <MudStack Spacing="2">
            <MudSelect T="Guid?" Value="_giverId" ValueChanged="OnGiverChanged" Label="@L["GiverLabel"]"
                       Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="MemberName"
                       Placeholder="@L["ExclusionPickPerson"]">
                @foreach (var member in _group.Members)
                {
                    <MudSelectItem T="Guid?" Value="@member.Id">@member.Name</MudSelectItem>
                }
            </MudSelect>
            @* The giver is left out of the recipient list: a person is never drawn for themselves, so
               excluding them from themselves is meaningless. *@
            <MudSelect T="Guid?" @bind-Value="_recipientId" Label="@L["RecipientLabel"]"
                       Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="MemberName"
                       Placeholder="@L["ExclusionPickPerson"]">
                @foreach (var member in _group.Members.Where(m => m.Id != _giverId))
                {
                    <MudSelectItem T="Guid?" Value="@member.Id">@member.Name</MudSelectItem>
                }
            </MudSelect>
            @* Mutual is the default: a couple normally should not be drawn for each other in either direction. *@
            <MudCheckBox @bind-Value="_mutual" Dense="true" Color="Color.Primary">@L["ExclusionBothWays"]</MudCheckBox>
            <div>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Block"
                           OnClick="AddAsync" Disabled="@(!CanAdd)">@L["AddExclusion"]</MudButton>
            </div>
        </MudStack>
    </MudPaper>

    @* A disabled button alone leaves the organizer guessing why nothing happens. *@
    @if (ValidationMessage is { } message)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@message</MudAlert>
    }

    @if (_group.Exclusions.Count == 0)
    {
        <MudText Class="mud-text-secondary">@L["NoExclusions"]</MudText>
    }
    else
    {
        <MudStack Spacing="1">
            @foreach (var exclusion in _group.Exclusions)
            {
                <MudPaper Elevation="1" Class="d-flex justify-space-between align-center flex-wrap gap-2 pa-3">
                    <MudText>
                        @(exclusion.Mutual
                            ? L["ExclusionRowMutual", NameOf(exclusion.GiverMemberId), NameOf(exclusion.RecipientMemberId)]
                            : L["ExclusionRow", NameOf(exclusion.GiverMemberId), NameOf(exclusion.RecipientMemberId)])
                    </MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="() => RemoveAsync(exclusion.GiverMemberId, exclusion.RecipientMemberId)">
                        @L["Remove"]
                    </MudButton>
                </MudPaper>
            }
        </MudStack>
    }
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private GroupDto? _group;
    private bool _readOnly;
    private Guid? _giverId;
    private Guid? _recipientId;

    // Two-way by default: a couple normally should not gift each other in either direction.
    private bool _mutual = true;

    private bool CanAdd => _giverId is { } giver && _recipientId is { } recipient && giver != recipient;

    /// <summary>Explains why <see cref="CanAdd"/> is false, or <see langword="null"/> when it is true.</summary>
    private string? ValidationMessage
    {
        get
        {
            if (CanAdd)
            {
                return null;
            }

            var giverChosen = _giverId is not null;
            var recipientChosen = _recipientId is not null;

            if (giverChosen && recipientChosen && _giverId == _recipientId)
            {
                return L["ExclusionSelfNotAllowed"].Value;
            }

            // Nothing picked yet is the initial state, not a mistake worth nagging about.
            return giverChosen || recipientChosen ? L["ExclusionPickBoth"].Value : null;
        }
    }

    // Changing the giver drops a recipient that would now equal it, so the pair can never be self→self.
    private void OnGiverChanged(Guid? value)
    {
        _giverId = value;
        if (_recipientId == _giverId)
        {
            _recipientId = null;
        }
    }

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    // A background sync may have pulled a co-organizer's roster/exclusion edits into the local store
    // (shared-by-link, FEAT-013); reload so they appear without a manual refresh. The giver/recipient
    // selection is separate state, so an in-progress pick is not disturbed.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncSignals.SyncCompleted -= OnSyncCompleted;

    private async Task LoadAsync()
    {
        _readOnly = (await GroupAccess.ForAsync(Services, GroupId)).ReadOnly;
        _group = await Sender.Send(new GetGroupQuery(GroupId));
    }

    private string MemberName(Guid? memberId) =>
        memberId is { } id ? NameOf(id) : string.Empty;

    private string NameOf(Guid memberId) =>
        _group?.Members.FirstOrDefault(m => m.Id == memberId)?.Name ?? memberId.ToString();

    private async Task AddAsync()
    {
        if (!CanAdd)
        {
            return;
        }

        await Sender.Send(new AddExclusionCommand(GroupId, _giverId!.Value, _recipientId!.Value, _mutual));
        _giverId = null;
        _recipientId = null;
        await LoadAsync();
    }

    private async Task RemoveAsync(Guid giverId, Guid recipientId)
    {
        await Sender.Send(new RemoveExclusionCommand(GroupId, giverId, recipientId));
        await LoadAsync();
    }
}
