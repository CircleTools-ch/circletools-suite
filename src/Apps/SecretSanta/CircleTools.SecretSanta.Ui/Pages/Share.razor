@page "/groups/{GroupId:guid}/events/{EventId:guid}/share"
@using CircleTools.SecretSanta.Core.Reveal
@inject ISender Sender
@inject IJSRuntime JS
@inject IShareService ShareService
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L
@inject ISyncSignals SyncSignals
@implements IDisposable

<PageTitle>@L["ShareTitle"]</PageTitle>

<EventBackNav GroupId="GroupId" EventId="EventId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["ShareTitle"]</MudText>
<MudText Class="mud-text-secondary mb-4">@L["ShareHint"]</MudText>

@* The draw is kept even after the roster changes (ADR-0052), so its links stay available here — but
   they are from a draw that no longer matches the current roster, so warn before the organizer shares
   them as if current. *@
@if (_drawInvalidated)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" role="alert">@L["DrawInvalidatedNotice"]</MudAlert>
}

@if (_links is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_links.Count == 0)
{
    <MudText Class="mud-text-secondary">@L["NoDrawYet"]</MudText>
}
else
{
    <MudStack Spacing="2">
        @foreach (var link in _links)
        {
            <MudCard Elevation="1">
                <MudCardContent class="pb-2">
                    <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                        <MudText><strong>@L["ForLabel"]:</strong> @link.ForLabel</MudText>
                        @* Share is the primary action where the platform has a share sheet (the phone,
                           and mobile browsers): one tap into WhatsApp / Messages / e-mail. Copy stays
                           for every platform, and is the only action on a desktop browser. *@
                        <div class="d-flex gap-2">
                            @if (_canShare)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Share" OnClick="() => ShareAsync(link)">
                                    @L["Share"]
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="() => CopyAsync(link.Url)">
                                @(_copiedUrl == link.Url ? L["Copied"] : L["Copy"])
                            </MudButton>
                            @* A QR code the recipient scans off the organizer's screen — no messaging app
                               needed. Available on every platform (the code is generated client-side). *@
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.QrCode2" OnClick="() => ShowQrAsync(link)">
                                @L["ShowQr"]
                            </MudButton>
                        </div>
                    </div>
                    @* Copy is the primary action; the raw encoded URL is long and alarming, so keep it
                       collapsed but available for anyone who wants to inspect or paste it manually. *@
                    <details class="mt-1">
                        <summary class="mud-text-secondary" style="cursor:pointer;font-size:0.85rem;">@L["ShowLink"]</summary>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1" Style="word-break:break-all;">@link.Url</MudText>
                    </details>
                    @if (RevealLinkBuilder.ExceedsRecommendedLength(link.Url))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1 d-block" role="alert">@L["ShareLinkTooLong"]</MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    /// <summary>The event whose reveal links are shown.</summary>
    [Parameter]
    public Guid EventId { get; set; }

    private IReadOnlyList<RevealLinkDto>? _links;
    private string? _copiedUrl;
    private bool _drawInvalidated;
    private bool _canShare;

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _links = await Sender.Send(new GetRevealLinksQuery(GroupId, EventId));
        var occasion = await Sender.Send(new GetEventQuery(GroupId, EventId));
        _drawInvalidated = occasion?.DrawInvalidatedByMembershipChange ?? false;
    }

    // A background sync may have pulled a co-organizer's re-draw or roster change into the local store
    // (shared-by-link, FEAT-013); reload so the reveal links and the stale-draw warning are current
    // without a manual refresh.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncSignals.SyncCompleted -= OnSyncCompleted;

    // Decide up front whether this platform can present a share sheet (and, on the browser, warm the
    // JS module so the later share() runs inside the click's user activation). Done after first render
    // because the browser implementation touches the JS runtime.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canShare = await ShareService.IsSupportedAsync();
            if (_canShare)
            {
                StateHasChanged();
            }
        }
    }

    private async Task ShareAsync(RevealLinkDto link)
    {
        // Carry the link in the message body (not only the url field): some share targets read only the
        // text, so this guarantees the reveal link reaches WhatsApp / SMS / e-mail.
        var text = $"{L["ShareMessage"]}\n{link.Url}";
        await ShareService.ShareAsync(L["AppName"], text, link.Url);
    }

    private Task ShowQrAsync(RevealLinkDto link) =>
        Dialogs.ShowQrDialogAsync(link.ForLabel, link.Url, L["QrHint"], L["Close"]);

    private async Task CopyAsync(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedUrl = url;
        }
        catch (JSException)
        {
            _copiedUrl = null;
        }
    }
}
