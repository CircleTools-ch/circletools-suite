@page "/groups/{GroupId:guid}/events/{EventId:guid}/share"
@using CircleTools.SecretSanta.Core.Reveal
@using CircleTools.SecretSanta.LocalStore
@inject ISender Sender
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject IShareService ShareService
@inject IDialogService Dialogs
@inject IStringLocalizer<AppStrings> L
@inject ISyncSignals SyncSignals
@inject HandoutProgressService Handout
@inject ILocalSyncStore Local
@inject RevealSlicePublisher RevealPublisher
@implements IDisposable

<PageTitle>@L["ShareTitle"]</PageTitle>

<EventBackNav GroupId="GroupId" EventId="EventId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["ShareTitle"]</MudText>
<MudText Class="mud-text-secondary mb-4">@L["ShareHint"]</MudText>

@* The draw is kept even after the roster changes (ADR-0052), so its links stay available here — but
   they are from a draw that no longer matches the current roster, so warn before the organizer shares
   them as if current. *@
@if (_drawInvalidated)
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" role="alert">@L["DrawInvalidatedNotice"]</MudAlert>
}

@* The reveal links carry the wishlist and event details as a snapshot (ADR-0014). If they changed after
   the organizer handed some out, the copies already sent are stale — so prompt a re-share (FR-045). *@
@if (_linksChanged)
{
    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" role="alert" id="links-changed-notice">@L["LinksChangedNotice"]</MudAlert>
}

@if (_links is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_links.Count == 0)
{
    <MudText Class="mud-text-secondary">@L["NoDrawYet"]</MudText>
}
else
{
    @* Guided hand-out (MNF-7): hand each participant their own link without forgetting anyone. *@
    <MudPaper Outlined="true" Class="pa-3 mb-3 d-flex flex-wrap align-center justify-space-between gap-2">
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["HandoutProgress", _done.Count, _links.Count]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Outbox"
                   OnClick="OpenHandoutAsync" id="hand-out-links">@L["HandOutLinks"]</MudButton>
    </MudPaper>

    <MudStack Spacing="2">
        @foreach (var link in _links)
        {
            <MudCard Elevation="1">
                <MudCardContent class="pb-2">
                    <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                        <MudText>
                            <strong>@L["ForLabel"]:</strong> @link.ForLabel
                            @if (_done.Contains(HandoutProgressService.MemberKey(link.Url)))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.CheckCircle" Class="ml-1">@L["HandedOut"]</MudChip>
                            }
                        </MudText>
                        @* Per-person actions are quiet (outlined / text) so "Hand out links" above stays the one
                           primary action on the screen (UX review P5); every card used to carry a filled button.
                           Share is first where the platform has a share sheet (the phone, mobile browsers):
                           one tap into WhatsApp / Messages / e-mail. Copy works everywhere and is the only
                           messaging action on a desktop browser. Using any of them marks the person as handed
                           out, so the counter and the check mark follow what the organizer actually did. *@
                        <div class="d-flex flex-wrap gap-1">
                            @if (_canShare)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Share" OnClick="() => ShareAsync(link)">
                                    @L["Share"]
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="() => CopyAsync(link)">
                                @(_copiedUrl == link.Url ? L["Copied"] : L["Copy"])
                            </MudButton>
                            @* A QR code the recipient scans off the organizer's screen — no messaging app
                               needed. Available on every platform (the code is generated client-side). *@
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.QrCode2" OnClick="() => ShowQrAsync(link)">
                                @L["ShowQr"]
                            </MudButton>
                        </div>
                    </div>
                    @* The raw encoded URL is intentionally not shown — Share, Copy and QR cover every way
                       to hand it out, and displaying the long opaque link only alarms (it is not meant to be
                       read or typed). *@
                    @if (RevealLinkBuilder.ExceedsRecommendedLength(link.Url))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1 d-block" role="alert">@L["ShareLinkTooLong"]</MudText>
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    /// <summary>The event whose reveal links are shown.</summary>
    [Parameter]
    public Guid EventId { get; set; }

    private IReadOnlyList<RevealLinkDto>? _links;
    private HashSet<string> _done = [];
    private string? _copiedUrl;
    private bool _drawInvalidated;
    private bool _linksChanged;
    private bool _canShare;

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // The draw and everyone's reveal links are the organizer's (ADR-0058): a join-link participant is sent
        // back to the event, which offers their own assignment instead.
        if ((await GroupAccess.ForAsync(Services, GroupId)).ReadOnly)
        {
            Navigation.NavigateTo($"groups/{GroupId}/events/{EventId}", replace: true);
            return;
        }

        // Ensure this backend-backed group's reveal slices are published and its per-giver reveal tokens
        // exist, so each link can carry rt= (ADR-0068). Best-effort and a no-op for a local-only or
        // join-only group.
        await RevealPublisher.PublishAsync(GroupId);

        var revealTokens = (await Local.LoadGroupsAsync())
            .FirstOrDefault(r => r.State.Id == GroupId)?.Tokens?.RevealTokens?
            .Where(t => t.EventId == EventId)
            .ToDictionary(t => t.MemberId, t => t.Token) ?? [];

        // For a backend-backed group, append the giver's reveal token so the link fetches the live slice
        // (the d= snapshot stays as the offline fallback). Local-only links are unchanged.
        var baseLinks = await Sender.Send(new GetRevealLinksQuery(GroupId, EventId));
        _links = [.. baseLinks.Select(l => revealTokens.TryGetValue(l.GiverMemberId, out var rt)
            ? l with { Url = $"{l.Url}&rt={Uri.EscapeDataString(rt)}" }
            : l)];

        var occasion = await Sender.Send(new GetEventQuery(GroupId, EventId));
        _drawInvalidated = occasion?.DrawInvalidatedByMembershipChange ?? false;

        // Which participants have already been handed their link (MNF-7); resets by itself on a re-draw.
        var urls = _links.Select(l => l.Url).ToList();
        _done = await Handout.GetDoneAsync(GroupId, EventId, urls);

        // If links were handed out and have since changed (wishlist/event edit or re-draw), the sent
        // copies are stale — prompt the organizer to re-share the updated links (#1, FR-045).
        _linksChanged = await Handout.LinksChangedSinceHandoutAsync(GroupId, EventId, urls);
    }

    // The guided one-at-a-time hand-out; reload progress when it closes so the ✓ marks and count are current.
    private async Task OpenHandoutAsync()
    {
        if (_links is null || _links.Count == 0)
        {
            return;
        }

        var parameters = new DialogParameters<HandoutDialog>
        {
            { x => x.GroupId, GroupId },
            { x => x.EventId, EventId },
            { x => x.Links, _links },
        };

        var dialog = await Dialogs.ShowAsync<HandoutDialog>(L["HandOutLinks"], parameters);
        await dialog.Result;
        await LoadAsync();
        StateHasChanged();
    }

    // A background sync may have pulled a co-organizer's re-draw or roster change into the local store
    // (shared-by-link, FEAT-013); reload so the reveal links and the stale-draw warning are current
    // without a manual refresh.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncSignals.SyncCompleted -= OnSyncCompleted;

    // Decide up front whether this platform can present a share sheet (and, on the browser, warm the
    // JS module so the later share() runs inside the click's user activation). Done after first render
    // because the browser implementation touches the JS runtime.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canShare = await ShareService.IsSupportedAsync();
            if (_canShare)
            {
                StateHasChanged();
            }
        }
    }

    private async Task ShareAsync(RevealLinkDto link)
    {
        // Carry the link in the message body (not only the url field): some share targets read only the
        // text, so this guarantees the reveal link reaches WhatsApp / SMS / e-mail.
        var text = $"{L["ShareMessage"]}\n{link.Url}";

        // Only a share that went somewhere counts as handed out (D5): closing the sheet sends nothing. A
        // platform that cannot tell keeps the old behaviour and counts it.
        if (await ShareService.ShareAsync(L["AppName"], text, link.Url) != ShareOutcome.Dismissed)
        {
            await MarkHandedOutAsync(link);
        }
    }

    private async Task ShowQrAsync(RevealLinkDto link)
    {
        var dialog = await Dialogs.ShowQrDialogAsync(link.ForLabel, link.Url, L["QrHint"], L["Close"]);
        await dialog.Result;
        await MarkHandedOutAsync(link);
    }

    private async Task CopyAsync(RevealLinkDto link)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link.Url);
            _copiedUrl = link.Url;
            await MarkHandedOutAsync(link);
        }
        catch (JSException)
        {
            _copiedUrl = null;
        }
    }

    // Record that this person's link went out (MNF-7), the same mark the guided hand-out sets.
    private async Task MarkHandedOutAsync(RevealLinkDto link)
    {
        if (_links is null)
        {
            return;
        }

        _done = await Handout.SetDoneAsync(
            GroupId, EventId, [.. _links.Select(l => l.Url)], HandoutProgressService.MemberKey(link.Url), done: true);
    }
}
