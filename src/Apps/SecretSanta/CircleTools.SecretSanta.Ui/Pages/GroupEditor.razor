@page "/groups/{GroupId:guid}"
@using CircleTools.SecretSanta.LocalStore.Online
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject TimeProvider Time
@inject IDialogService Dialogs
@inject IGroupRecordStore Records
@inject ISyncSignals SyncSignals
@inject IServiceProvider Services
@inject GroupRemoval Removal
@inject BookmarkService Bookmarks
@implements IDisposable

@* Group hub (ADR-0055 group level): the group's landing screen. The occasions (events) are the primary
   content; Members and Exclusions are section rows below, mirroring the event hub. The group name is
   edited from the header's overflow menu (a rename sheet) rather than an always-visible text field. *@

<PageTitle>@(_group?.Name ?? L["GroupEditorTitle"])</PageTitle>

<div class="d-flex align-center flex-wrap gap-2 mb-2">
    <MudButton OnClick="GoToAllGroups" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Variant="Variant.Text">
        @L["AllGroups"]
    </MudButton>
</div>

@if (_group is null)
{
    <MudText>@(_loaded ? L["GroupNotFound"] : L["Loading"])</MudText>
}
else
{
    @* The name takes the free width and wraps (also inside one long word); the chip and the menu keep theirs, so a
       long family name no longer squeezes the "Online" chip (2026-10-28). *@
    <div class="d-flex align-center gap-1 mb-4">
        <MudText Typo="Typo.h4" Class="flex-grow-1 ct-wrap-anywhere" id="group-name">@_group.Name</MudText>
        @* Place chip (ADR-0086): a glanceable "is this group online?", tapping through to Sharing & sync. Only
           shown for an online group, so a local group stays uncluttered. *@
        @if (_kind == StorageKind.Online)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="flex-shrink-0"
                     Icon="@StorageModeDisplay.Icon(StorageKind.Online)" OnClick="GoToSharing" id="mode-chip">@L["ModeChipOnline"]</MudChip>
        }
        @* The rename field is tucked into an overflow menu (opens a rename sheet) so the hub leads with
           the occasions, not a text box. *@
        @if (!_readOnly)
        {
            @* The same actions as the group list's menu (Q34). *@
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" AriaLabel="@L["MoreActions"]" Class="flex-shrink-0"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" id="group-menu">
                <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => AfterMenu(RenameAsync)">@L["Rename"]</MudMenuItem>
                <AuthorizeView>
                    <Authorized>
                        <MudMenuItem Icon="@(_isPinned ? Icons.Material.Filled.StarBorder : Icons.Material.Filled.Star)"
                                     OnClick="TogglePinAsync">@(_isPinned ? L["UnpinGroup"] : L["PinGroup"])</MudMenuItem>
                    </Authorized>
                </AuthorizeView>
                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="GoToSharing">@L["SharingRow"]</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy"
                             OnClick="@(() => Navigation.NavigateTo($"?template={GroupId}"))">@L["UseAsTemplate"]</MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => AfterMenu(DeleteAsync)">@L["Delete"]</MudMenuItem>
            </MudMenu>
        }
        else
        {
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default" AriaLabel="@L["MoreActions"]" Class="flex-shrink-0"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" id="group-menu">
                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="GoToSharing">@L["SharingRow"]</MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="() => AfterMenu(DeleteAsync)">@L["LeaveGroup"]</MudMenuItem>
            </MudMenu>
        }
    </div>

    @* Getting-started checklist (FEAT-019, OB-8): guides the empty→drawn sequence — add members → add an
       event → draw names — and supersedes the one-line first-run hint. The component self-hides once the
       group is set up or the organizer skips it. *@
    @* A join-link participant may look but not change the group (ADR-0058): say so, and offer none of the
       editing affordances below. *@
    @if (_readOnly)
    {
        <MudAlert Severity="Severity.Normal" Class="mb-4" Dense="true" id="participant-read-only">@L["ParticipantReadOnlyNote"]</MudAlert>
    }
    else
    {
        <GettingStartedChecklist Group="_group" OnAddEvent="AddEventViaFabAsync" />
    }

    @* Events (occasions): the roster and exclusions are shared, but each event has its own draw,
       wishlists, budget and date (ADR-0042). *@
    <MudText Typo="Typo.h5" GutterBottom="true">@L["NavEvents"]</MudText>

    @* Inline add-event field on wide screens; on a phone it moves behind the "+" FAB so the occasions
       list leads. *@
    @if (!_readOnly)
    {
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="d-flex gap-2 align-start flex-wrap mb-4">
                @* The localized default ("Christmas 2026") is the placeholder, not a pre-filled value: typing
                   starts a fresh name instead of appending to the suggestion, and an empty field adds the default. *@
                <MudTextField @bind-Value="_newEventName" Immediate="true" OnKeyDown="OnNewEventKeyDown"
                              Label="@L["EventNameLabel"]" Placeholder="@DefaultEventName()"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:12rem;" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddEventAsync"
                           StartIcon="@Icons.Material.Filled.Add" Class="mt-1">@L["AddEvent"]</MudButton>
            </div>
        </MudHidden>
    }

    @* Shown once there are members but still no event (the brand-new 0/0 case is covered by the
       getting-started checklist above, so this doesn't double up). The labelled "Add event" FAB is the action. *@
    @if (_group.Events.Count == 0 && _group.Members.Count > 0 && !_readOnly)
    {
        <MudAlert Severity="Severity.Normal" Class="mb-2" role="note">@L["NoEventsYet"]</MudAlert>
    }

    <MudStack Spacing="2">
        @* Upcoming first, then undated, past ones last and muted (I5). *@
        @foreach (var occasion in OrderedEvents)
        {
            <MudCard Elevation="1" Class="@(IsPast(occasion) ? "ct-past" : null)">
                <MudCardContent Class="py-2">
                    @if (_editingId == occasion.Id)
                    {
                        <div class="d-flex gap-2 align-center flex-wrap">
                            <MudTextField @bind-Value="_editName" Label="@L["EventNameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEventNameAsync"
                                       Disabled="@string.IsNullOrWhiteSpace(_editName)">@L["Save"]</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _editingId = null">@L["Cancel"]</MudButton>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-space-between align-center gap-2">
                            @* The whole row opens the occasion (one big tap target); a separate "Open"
                               button only repeated it. The chevron says the row navigates. *@
                            <div class="ct-openable flex-grow-1" role="button" tabindex="0" style="min-width:0;"
                                 aria-label="@L["OpenNamed", EventLabel(occasion.Name)]"
                                 @onclick="() => Open(occasion.Id)" @onkeydown="@(e => OpenOnEnter(e, occasion.Id))">
                                <div class="d-flex align-center flex-wrap gap-2">
                                    <MudText Typo="Typo.subtitle1"><strong>@EventLabel(occasion.Name)</strong></MudText>
                                    @if (occasion.DrawInvalidatedByMembershipChange)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawInvalidatedBadge"]</MudChip>
                                    }
                                    else if (occasion.DrawBreaksExclusions)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawBreaksExclusionsBadge"]</MudChip>
                                    }
                                    else if (occasion.HasCurrentDraw)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["DrawCompleteBadge"]</MudChip>
                                    }
                                </div>
                                @* The facts at a glance (Q22/I5): when, how long to go, and how far the wishlists are. *@
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" id="@($"event-facts-{occasion.Id}")">@EventFacts(occasion)</MudText>
                            </div>
                            <div class="d-flex align-center gap-1">
                                @* Rename/Remove fold into an overflow menu so the row stays a single tap
                                   target + one kebab on a phone rather than crowded small buttons. *@
                                @if (!_readOnly)
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Default"
                                             AriaLabel="@L["MoreActions"]" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                     OnClick="() => BeginEdit(occasion.Id, occasion.Name)">@L["Rename"]</MudMenuItem>
                                        @if (_group.Events.Count > 1)
                                        {
                                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                                         OnClick="() => AskRemove(occasion.Id)">@L["Remove"]</MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="ct-openable"
                                         @onclick="() => Open(occasion.Id)" />
                            </div>
                        </div>

                        @if (_pendingRemoveId == occasion.Id)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true" role="alert">
                                <MudText Class="mb-2">@L["ConfirmRemoveEvent", EventLabel(occasion.Name)]</MudText>
                                <div class="d-flex gap-1">
                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                               OnClick="() => RemoveEventAsync(occasion.Id)">@L["ConfirmRemove"]</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _pendingRemoveId = null">@L["Cancel"]</MudButton>
                                </div>
                            </MudAlert>
                        }
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>

    @* Add an occasion on phones: an inline button right under the occasions it adds to (the wide screens'
       inline field owns it there). It replaced a floating button that covered the section rows below
       (UX review P2). *@
    @if (!_readOnly)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddEventViaFabAsync" Class="mt-3" id="add-event-btn">@L["AddEvent"]</MudButton>
        </MudHidden>
    }

    @* Shared group sections (ADR-0055 group level): the roster and exclusions apply across every
       occasion, so they sit below the events as their own destinations rather than as tabs. *@
    <MudDivider Class="my-6" />
    <MudStack Spacing="2">
        @* The organizer who is also in the roster sees their own assignment like any participant (ADR-0086). *@
        @if (_hasOwnView)
        {
            <MudPaper Outlined="true" Class="ct-hub-row" role="button" tabindex="0" id="my-assignment-row"
                      aria-label="@L["MyAssignmentRow"]"
                      @onclick="@(() => Go($"groups/{GroupId}/me"))" @onkeydown="@(e => GoOnEnter(e, $"groups/{GroupId}/me"))">
                <div class="d-flex align-center gap-3 pa-3">
                    <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Primary" />
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.subtitle1">@L["MyAssignmentRow"]</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["MyAssignmentRowHint"]</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                </div>
            </MudPaper>
        }
        <MudPaper Outlined="true" Class="ct-hub-row" role="button" tabindex="0" id="members-row"
                  aria-label="@($"{L["NavMembers"]}, {_group.Members.Count}")"
                  @onclick="@(() => Go($"groups/{GroupId}/members"))" @onkeydown="@(e => GoOnEnter(e, $"groups/{GroupId}/members"))">
            <div class="d-flex align-center gap-3 pa-3">
                <MudIcon Icon="@Icons.Material.Filled.Group" Color="Color.Primary" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.subtitle1">@L["NavMembers"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_group.Members.Count</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
            </div>
        </MudPaper>
        <MudPaper Outlined="true" Class="ct-hub-row" role="button" tabindex="0" id="exclusions-row"
                  aria-label="@($"{L["NavExclusions"]}, {_group.Exclusions.Count}")"
                  @onclick="@(() => Go($"groups/{GroupId}/exclusions"))" @onkeydown="@(e => GoOnEnter(e, $"groups/{GroupId}/exclusions"))">
            <div class="d-flex align-center gap-3 pa-3">
                <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Primary" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.subtitle1">@L["NavExclusions"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_group.Exclusions.Count</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
            </div>
        </MudPaper>
        @* Sharing & sync (ADR-0058, FEAT-013): choose where the group lives and manage its links. *@
        <MudPaper Outlined="true" Class="ct-hub-row" role="button" tabindex="0" id="sharing-row"
                  aria-label="@($"{L["SharingRow"]}, {SharingSubtitle()}")"
                  @onclick="GoToSharing" @onkeydown="@(e => GoOnEnter(e, $"groups/{GroupId}/sharing"))">
            <div class="d-flex align-center gap-3 pa-3">
                <MudIcon Icon="@Icons.Material.Filled.Share" Color="Color.Primary" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.subtitle1">@L["SharingRow"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@SharingSubtitle()</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
            </div>
        </MudPaper>
    </MudStack>

}

@code {
    /// <summary>The group being edited.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private GroupDto? _group;
    private bool _loaded;
    private bool _joinLinkOn;
    private bool _hasOwnView;
    private StorageKind _kind;
    private bool _readOnly;
    private string _newEventName = string.Empty;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private Guid? _pendingRemoveId;

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    // A background sync may have pulled a co-organizer's edits (events, roster, mode) into the local store
    // (shared-by-link, FEAT-013); reload so the hub reflects them without a manual refresh. The inline
    // add-event and rename fields are separate state, so in-progress typing is not disturbed.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncSignals.SyncCompleted -= OnSyncCompleted;

    private async Task LoadAsync()
    {
        try
        {
            _isPinned = (await Bookmarks.GetPinnedAsync()).Contains(GroupId);
        }
        catch (Exception)
        {
            _isPinned = false; // a convenience only
        }

        _group = await Sender.Send(new GetGroupQuery(GroupId));
        _loaded = true;

        // The place lives in the group record, not the domain group (ADR-0086) — read it here for the chip and the
        // Sharing & sync row's subtitle.
        var record = (await Records.LoadAsync()).Records.FirstOrDefault(r => r.Id == GroupId);
        _kind = record is null ? StorageKind.Device : StorageModeDisplay.KindOf(record);
        _joinLinkOn = record?.Access?.JoinToken is not null;
        _hasOwnView = record?.View is not null;
        _readOnly = (await GroupAccess.ForAsync(Services, GroupId)).ReadOnly;
    }

    // "Weihnachten 2026" / "Christmas 2026" / "Noël 2026" — the localized default gift-exchange occasion
    // for the current year. A format string per culture keeps the word and word order translatable.
    private string DefaultEventName() => string.Format(
        System.Globalization.CultureInfo.CurrentCulture, L["DefaultEventNameFormat"], Time.GetLocalNow().Year);

    // Upcoming (soonest first), then undated, then past (latest first).
    private IEnumerable<EventSummaryDto> OrderedEvents =>
        (_group?.Events ?? []).OrderBy(e => e.Date is null ? 1 : IsPast(e) ? 2 : 0)
            .ThenBy(e => IsPast(e) ? -(e.Date?.Ticks ?? 0) : e.Date?.Ticks ?? 0);

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().Date);

    private bool IsPast(EventSummaryDto occasion) =>
        occasion.Date is { } date && DateOnly.FromDateTime(date.Date) < Today;

    // "24.12.2026 · in 69 days · Wishlists 2/4" — the parts that are known.
    private string EventFacts(EventSummaryDto occasion)
    {
        var parts = new List<string>(3);
        if (occasion.Date is { } date)
        {
            var day = DateOnly.FromDateTime(date.Date);
            parts.Add(day.ToString("d", System.Globalization.CultureInfo.CurrentCulture));
            var days = day.DayNumber - Today.DayNumber;
            if (days >= 0)
            {
                parts.Add(days switch { 0 => L["CountdownToday"], 1 => L["CountdownTomorrow"], _ => L["CountdownDays", days] });
            }
        }
        else
        {
            parts.Add(L["EventNoDate"]);
        }

        if (_group is { Members.Count: > 0 } && !IsPast(occasion))
        {
            parts.Add(L["EventWishlistProgress", occasion.WishlistsFilled, _group.Members.Count]);
        }

        return string.Join(" · ", parts);
    }

    private string EventLabel(string name) => string.IsNullOrWhiteSpace(name) ? L["DefaultEventName"] : name;

    private void GoToSharing() => Navigation.NavigateTo($"groups/{GroupId}/sharing");

    private string SharingSubtitle() => _kind switch
    {
        StorageKind.Online => _joinLinkOn ? L["SharingSubtitleOnlineJoin"] : L["SharingSubtitleOnline"],
        _ => L["SharingSubtitleLocal"],
    };
    // Rename the group from a bottom sheet pre-filled with the current name (ADR-0055 group level),
    // instead of an always-visible text field on the hub.
    private bool _isPinned;

    private async Task TogglePinAsync()
    {
        try
        {
            await Bookmarks.ToggleAsync(GroupId);
            _isPinned = (await Bookmarks.GetPinnedAsync()).Contains(GroupId);
        }
        catch (Exception)
        {
            // Pinning is a convenience; a failure leaves it as it was.
        }
    }

    // Delete (or leave a joined group) after asking; back to the list once it is gone (Q34).
    private async Task DeleteAsync()
    {
        if (_group is not null && await Removal.AskAndRemoveAsync(GroupId, _group.Name))
        {
            Navigation.NavigateTo(string.Empty, replace: true);
        }
    }

    private async Task RenameAsync()
    {
        var name = await Dialogs.ShowTextInputSheetAsync(L["Rename"], L["NameLabel"], L["Save"], L["Cancel"], _group?.Name);
        if (!string.IsNullOrWhiteSpace(name))
        {
            await Sender.Send(new RenameGroupCommand(GroupId, name));
            await LoadAsync();
        }
    }

    private void Go(string href) => Navigation.NavigateTo(href);

    private void GoOnEnter(KeyboardEventArgs args, string href)
    {
        if (args.Key is "Enter" or " ")
        {
            Go(href);
        }
    }

    // Empty string navigates to the app root (the groups list); NavigationManager resolves it against the
    // base URI, unlike a bare href="" which would stay on the current page.
    private void GoToAllGroups() => Navigation.NavigateTo(string.Empty);

    private async Task OnNewEventKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddEventAsync();
        }
    }

    // The inline field (wide screens) adds from the bound value. Once the group has an occasion, adding a
    // second one offers carry-forward (FR-035); the very first occasion has nothing to carry, so it stays
    // the plain name-only add.
    private Task AddEventAsync()
    {
        var name = string.IsNullOrWhiteSpace(_newEventName) ? DefaultEventName() : _newEventName;
        return AddEventWithCarryForwardAsync(name);
    }

    // The phone FAB collects the name in a bottom sheet (pre-filled with the default) for the first
    // occasion, or the carry-forward dialog once occasions exist.
    // Every add goes through the one dialog: name, optional date (Q22), and carry-forward once there is
    // something to carry.
    private Task AddEventViaFabAsync() => AddEventWithCarryForwardAsync(DefaultEventName());

    // Add a new occasion, optionally carrying forward wishlists, budget and the no-repeat draw baseline
    // from a chosen previous occasion (FR-035 / UC-SS-014).
    private async Task AddEventWithCarryForwardAsync(string initialName)
    {
        if (_group is null)
        {
            return;
        }

        var choice = await Dialogs.ShowCarryForwardEventDialogAsync(L["AddEvent"], _group.Events, initialName);
        if (choice is null)
        {
            return;
        }

        var id = await Sender.Send(new AddEventCommand(GroupId, choice.Name, choice.SourceEventId));
        if (choice.Date is { } date)
        {
            // Stored like the details page stores it: the calendar day at midnight, offset zero.
            await Sender.Send(new SetEventDetailsCommand(
                GroupId, id, new DateTimeOffset(date.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero), null, null));
        }

        _newEventName = string.Empty;
        Open(id);
    }

    private void BeginEdit(Guid eventId, string name)
    {
        _editingId = eventId;
        _editName = name;
        _pendingRemoveId = null;
    }

    private async Task SaveEventNameAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName))
        {
            return;
        }

        if (_editingId is { } id)
        {
            await Sender.Send(new RenameEventCommand(GroupId, id, _editName));
            _editingId = null;
            await LoadAsync();
        }
    }

    private void AskRemove(Guid eventId)
    {
        _pendingRemoveId = eventId;
        _editingId = null;
    }

    private async Task RemoveEventAsync(Guid eventId)
    {
        _pendingRemoveId = null;
        await Sender.Send(new RemoveEventCommand(GroupId, eventId));
        await LoadAsync();
    }

    private void Open(Guid eventId) => Navigation.NavigateTo($"groups/{GroupId}/events/{eventId}");

    // Keyboard parity for the clickable name (Enter or Space opens, like the Open button).
    private void OpenOnEnter(KeyboardEventArgs args, Guid eventId)
    {
        if (args.Key is "Enter" or " ")
        {
            Open(eventId);
        }
    }

    // A menu item that opens a sheet starts it only after the menu has closed: the item's handler returns at
    // once, so the menu is gone before the sheet slides in rather than staying open behind it (Q12). Running outside
    // the item's event handler, it renders itself when done: freeing a spot left "Connected" on screen until the
    // next sync otherwise (S24 device test, 2026-10-25).
    private void AfterMenu(Func<Task> action) => _ = InvokeAsync(async () =>
    {
        await Task.Yield();
        try
        {
            await action();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    });
}
