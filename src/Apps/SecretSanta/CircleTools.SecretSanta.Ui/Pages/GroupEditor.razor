@page "/groups/{GroupId:guid}"
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject TimeProvider Time

<PageTitle>@L["GroupEditorTitle"]</PageTitle>

<GroupNav GroupId="GroupId" />

@if (_group is null)
{
    <MudText>@(_loaded ? L["GroupNotFound"] : L["Loading"])</MudText>
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">@_group.Name</MudText>

    <div class="d-flex gap-2 align-start flex-wrap mb-4">
        <MudTextField @bind-Value="_name" Immediate="true" Label="@L["NameLabel"]" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:12rem;" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveNameAsync" Class="mt-1"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">@L["Save"]</MudButton>
    </div>

    @* Events (occasions): the roster and exclusions are shared, but each event has its own draw,
       wishlists, budget and date (ADR-0042). *@
    <MudText Typo="Typo.h5" GutterBottom="true">@L["NavEvents"]</MudText>

    <div class="d-flex gap-2 align-start flex-wrap mb-4">
        <MudTextField @bind-Value="_newEventName" Immediate="true" OnKeyDown="OnNewEventKeyDown"
                      Label="@L["EventNameLabel"]" Placeholder="@L["EventNamePlaceholder"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:12rem;" />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddEventAsync"
                   StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
                   Disabled="@string.IsNullOrWhiteSpace(_newEventName)">@L["AddEvent"]</MudButton>
    </div>

    @if (_group.Events.Count == 0)
    {
        <MudAlert Severity="Severity.Normal" Class="mb-2" role="note">@L["NoEventsYet"]</MudAlert>
    }

    <MudStack Spacing="2">
        @foreach (var occasion in _group.Events)
        {
            <MudCard Elevation="1">
                <MudCardContent Class="pb-2">
                    @if (_editingId == occasion.Id)
                    {
                        <div class="d-flex gap-2 align-center flex-wrap">
                            <MudTextField @bind-Value="_editName" Label="@L["EventNameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveEventNameAsync"
                                       Disabled="@string.IsNullOrWhiteSpace(_editName)">@L["Save"]</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _editingId = null">@L["Cancel"]</MudButton>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                            <div class="d-flex align-center flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle1"><strong>@EventLabel(occasion.Name)</strong></MudText>
                                @if (occasion.DrawInvalidatedByMembershipChange)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@L["DrawInvalidatedBadge"]</MudChip>
                                }
                                else if (occasion.HasCurrentDraw)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@L["DrawCompleteBadge"]</MudChip>
                                }
                            </div>
                            <div class="d-flex align-center gap-1">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           OnClick="() => Open(occasion.Id)">@L["Open"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           OnClick="() => BeginEdit(occasion.Id, occasion.Name)">@L["Rename"]</MudButton>
                                @if (_group.Events.Count > 1)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                               OnClick="() => AskRemove(occasion.Id)">@L["Remove"]</MudButton>
                                }
                            </div>
                        </div>

                        @if (_pendingRemoveId == occasion.Id)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true" role="alert">
                                <MudText Class="mb-2">@L["ConfirmRemoveEvent", EventLabel(occasion.Name)]</MudText>
                                <div class="d-flex gap-1">
                                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled"
                                               OnClick="() => RemoveEventAsync(occasion.Id)">@L["ConfirmRemove"]</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _pendingRemoveId = null">@L["Cancel"]</MudButton>
                                </div>
                            </MudAlert>
                        }
                    }
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

@code {
    /// <summary>The group being edited.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private GroupDto? _group;
    private bool _loaded;
    private string _name = string.Empty;
    private string _newEventName = string.Empty;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private Guid? _pendingRemoveId;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _group = await Sender.Send(new GetGroupQuery(GroupId));
        _loaded = true;
        if (_group is not null)
        {
            _name = _group.Name;

            // Offer a sensible default the user can accept or edit (item: default event name). Only
            // pre-fill when the field is untouched, so a name the user is typing is never clobbered.
            if (string.IsNullOrEmpty(_newEventName))
            {
                _newEventName = DefaultEventName();
            }
        }
    }

    // "Weihnachten 2026" / "Christmas 2026" / "Noël 2026" — the localized default gift-exchange occasion
    // for the current year. A format string per culture keeps the word and word order translatable.
    private string DefaultEventName() => string.Format(
        System.Globalization.CultureInfo.CurrentCulture, L["DefaultEventNameFormat"], Time.GetLocalNow().Year);

    private string EventLabel(string name) => string.IsNullOrWhiteSpace(name) ? L["DefaultEventName"] : name;

    private async Task SaveNameAsync()
    {
        await Sender.Send(new RenameGroupCommand(GroupId, _name));
        await LoadAsync();
    }

    private async Task OnNewEventKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddEventAsync();
        }
    }

    private async Task AddEventAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEventName))
        {
            return;
        }

        var id = await Sender.Send(new AddEventCommand(GroupId, _newEventName));
        _newEventName = DefaultEventName();
        Open(id);
    }

    private void BeginEdit(Guid eventId, string name)
    {
        _editingId = eventId;
        _editName = name;
        _pendingRemoveId = null;
    }

    private async Task SaveEventNameAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName))
        {
            return;
        }

        if (_editingId is { } id)
        {
            await Sender.Send(new RenameEventCommand(GroupId, id, _editName));
            _editingId = null;
            await LoadAsync();
        }
    }

    private void AskRemove(Guid eventId)
    {
        _pendingRemoveId = eventId;
        _editingId = null;
    }

    private async Task RemoveEventAsync(Guid eventId)
    {
        _pendingRemoveId = null;
        await Sender.Send(new RemoveEventCommand(GroupId, eventId));
        await LoadAsync();
    }

    private void Open(Guid eventId) => Navigation.NavigateTo($"groups/{GroupId}/events/{eventId}");
}
