@page "/r"
@using System.Globalization
@using CircleTools.SecretSanta.Core.Reveal
@inject RevealLinkCodec Codec
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject IHapticFeedback Haptics

<PageTitle>@L["RevealTitle"]</PageTitle>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@L["RevealMalformed"]</MudAlert>
}
else if (_payload is not null)
{
    <MudText Typo="Typo.h4" GutterBottom="true">@L["RevealGreeting", _label]</MudText>

    @if (_payload.BudgetAmount is { } amount)
    {
        <MudText Class="mb-1"><strong>@L["RevealBudgetLabel"]:</strong> @BudgetDisplay.Format(_payload.BudgetMin, amount, _payload.BudgetCurrency)</MudText>
    }

    @if (HasEvent)
    {
        @* Razor strips the whitespace between these elements, so the separators must be explicit. *@
        <MudText Class="mb-1">
            <strong>@L["RevealEventLabel"]:</strong>
            @if (_eventDate is { } date)
            {
                <span>&nbsp;@date.ToString("d", CultureInfo.CurrentCulture)</span>
            }
            @if (!string.IsNullOrWhiteSpace(_payload.EventLocation))
            {
                @if (_eventDate is not null)
                {
                    <span>,</span>
                }
                <span>&nbsp;@_payload.EventLocation</span>
            }
        </MudText>
        @if (!string.IsNullOrWhiteSpace(_payload.EventNotes))
        {
            <MudText Class="mb-1">@_payload.EventNotes</MudText>
        }
    }

    @if (_revealed)
    {
        <MudAlert Severity="Severity.Success" Class="mt-3">
            <MudText Class="mb-1">@L["RevealRecipientLabel"]:</MudText>
            <MudText Typo="Typo.h5" Class="mb-3">@_payload.RecipientName</MudText>
            <MudText Class="mb-1"><strong>@L["RevealWishlistLabel"]:</strong></MudText>
            @if (_payload.Wishlist.Count == 0)
            {
                <MudText>@L["RevealNoWishlist"]</MudText>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var item in _payload.Wishlist)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </MudAlert>
    }
    else
    {
        <MudText Class="mud-text-secondary my-3">@L["RevealSpoilerNote"]</MudText>
        <MudButton Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CardGiftcard" OnClick="RevealAsync">@L["RevealButton"]</MudButton>
    }
}

@code {
    private RevealPayload? _payload;
    private string _label = string.Empty;
    private DateTimeOffset? _eventDate;
    private bool _revealed;
    private bool _error;

    // A small confirmation buzz as the giftee is shown (FEAT-008 W3); a no-op on the web head.
    private async Task RevealAsync()
    {
        _revealed = true;
        await Haptics.TapAsync();
    }

    private bool HasEvent =>
        _eventDate is not null ||
        !string.IsNullOrWhiteSpace(_payload?.EventLocation) ||
        !string.IsNullOrWhiteSpace(_payload?.EventNotes);

    protected override void OnInitialized()
    {
        try
        {
            var fragment = new Uri(Navigation.Uri).Fragment;
            var (label, blob) = RevealLinkBuilder.ParseFragment(fragment);
            _label = label;
            _payload = Codec.Decode(blob);
            if (DateTimeOffset.TryParse(
                    _payload.EventDate, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed))
            {
                _eventDate = parsed;
            }
        }
        catch (FormatException)
        {
            _error = true;
        }
    }
}
