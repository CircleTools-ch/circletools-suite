@page "/r"
@using System.Globalization
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.Core.Reveal
@using CircleTools.SecretSanta.LocalStore
@inject RevealLinkCodec Codec
@inject ISharedGroupApi RevealApi
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject IHapticFeedback Haptics
@implements IDisposable

<PageTitle>@L["RevealTitle"]</PageTitle>

@if (_error)
{
    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@L["RevealMalformed"]</MudAlert>
}
else if (_payload is not null)
{
    <MudText Typo="Typo.h4" GutterBottom="true">@L["RevealGreeting", _label]</MudText>

    @* Freshness indicator (ADR-0068, FEAT-020): a backend-backed link shows whether the details are the
       latest (fetched live) or a saved copy (offline fallback). A local-only link has no live source, so
       it shows no indicator — its snapshot is all there is. *@
    @if (_backendBacked)
    {
        @if (_live)
        {
            <MudText Typo="Typo.caption" Color="Color.Success" Class="d-block mb-2" id="reveal-live">@L["RevealLiveHint"]</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mb-2" id="reveal-snapshot">@L["RevealSnapshotHint"]</MudText>
        }
    }

    @if (_payload.BudgetAmount is { } amount)
    {
        <MudText Class="mb-1"><strong>@L["RevealBudgetLabel"]:</strong> @BudgetDisplay.Format(_payload.BudgetMin, amount, _payload.BudgetCurrency)</MudText>
    }

    @if (HasEvent)
    {
        @* Razor strips the whitespace between these elements, so the separators must be explicit. *@
        <MudText Class="mb-1">
            <strong>@L["RevealEventLabel"]:</strong>
            @if (_eventDate is { } date)
            {
                <span>&nbsp;@date.ToString("d", CultureInfo.CurrentCulture)</span>
            }
            @if (!string.IsNullOrWhiteSpace(_payload.EventLocation))
            {
                @if (_eventDate is not null)
                {
                    <span>,</span>
                }
                <span>&nbsp;@_payload.EventLocation</span>
            }
        </MudText>
        @if (!string.IsNullOrWhiteSpace(_payload.EventNotes))
        {
            <MudText Class="mb-1">@_payload.EventNotes</MudText>
        }
    }

    @* Add this occasion to the phone calendar (MNF-6) — offered once it has a date. The reopen link is
       the reveal link itself, since a raw-link holder need not have the group. *@
    @if (_calendarEvent is not null)
    {
        <div class="my-3">
            <AddToCalendarButton CalendarEvent="_calendarEvent" />
        </div>
    }

    @if (_revealed)
    {
        <MudAlert Severity="Severity.Success" Class="mt-3">
            <MudText Class="mb-1">@L["RevealRecipientLabel"]:</MudText>
            <MudText Typo="Typo.h5" Class="mb-3">@_payload.RecipientName</MudText>
            @if (!string.IsNullOrWhiteSpace(_payload.GiftNote))
            {
                @* The recipient's stable gift note — allergies, dietary/lifestyle, do-not-gift (FR-037). *@
                <MudText Class="mb-3"><strong>@L["RevealGiftNoteLabel"]:</strong> @_payload.GiftNote</MudText>
            }
            <MudText Class="mb-1"><strong>@L["RevealWishlistLabel"]:</strong></MudText>
            @if (_payload.Wishlist.Count == 0)
            {
                <MudText>@L["RevealNoWishlist"]</MudText>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var item in _payload.Wishlist)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </MudAlert>
    }
    else
    {
        @* Recipient-side primer (OB-10): a family member may open this link with no context (it arrived by
           message), so say plainly what it is and that it is private before the reveal. *@
        <MudText Class="mud-text-secondary mt-3">@L["RevealPrimer"]</MudText>
        <MudText Class="mud-text-secondary mb-3">@L["RevealSpoilerNote"]</MudText>
        <MudButton Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.CardGiftcard" OnClick="RevealAsync">@L["RevealButton"]</MudButton>
    }
}

@code {
    private RevealPayload? _payload;
    private string _label = string.Empty;
    private DateTimeOffset? _eventDate;
    private CalendarEvent? _calendarEvent;
    private bool _revealed;
    private bool _error;
    private bool _backendBacked;
    private bool _live;

    // A small confirmation buzz as the giftee is shown (FEAT-008 W3); a no-op on the web head.
    private async Task RevealAsync()
    {
        _revealed = true;
        await Haptics.TapAsync();
    }

    private bool HasEvent =>
        _eventDate is not null ||
        !string.IsNullOrWhiteSpace(_payload?.EventLocation) ||
        !string.IsNullOrWhiteSpace(_payload?.EventNotes);

    protected override async Task OnInitializedAsync()
    {
        // A reveal link can arrive while this page is already open: the native deep-link handler navigates
        // to /r with a new #fragment, but the route (/r) is unchanged, so the router reuses this component
        // and OnInitialized does NOT run again. Re-parse on every navigation so a second reveal link
        // replaces the first instead of silently keeping the old one shown (the warm-start device deep
        // link the user hit — "it doesn't show a link if another link is already displayed" — and the web).
        Navigation.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        // Only re-handle while this is still the reveal route; navigating away disposes the component.
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('#', '?')[0].TrimEnd('/');
        if (!string.Equals(path, "r", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        // Reset first, so re-opening over an existing reveal never leaks the previous link's state — above
        // all _revealed, so the new recipient stays hidden behind the reveal button until it is tapped.
        _payload = null;
        _label = string.Empty;
        _eventDate = null;
        _calendarEvent = null;
        _revealed = false;
        _error = false;
        _backendBacked = false;
        _live = false;

        try
        {
            var fragment = new Uri(Navigation.Uri).Fragment;
            var (label, blob) = RevealLinkBuilder.ParseFragment(fragment);
            _label = label;

            // The embedded snapshot always decodes — it is what makes the reveal work offline (ADR-0014).
            _payload = Codec.Decode(blob);

            // A backend-backed link (ADR-0068) carries a reveal token: try to load the live slice so the
            // wishlist and event details are current. A fetch failure (offline, revoked) keeps the
            // snapshot; a local-only link has no token and stays on the snapshot with no indicator.
            var revealToken = RevealLinkBuilder.ParseRevealToken(fragment);
            _backendBacked = revealToken is not null;
            if (revealToken is not null)
            {
                _live = await TryLoadLiveAsync(revealToken);
            }

            if (DateTimeOffset.TryParse(
                    _payload.EventDate, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed))
            {
                _eventDate = parsed;
            }

            _calendarEvent = BuildCalendarEvent();
        }
        catch (FormatException)
        {
            _error = true;
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    // Fetch the live per-giver slice and swap it in for the snapshot when it loads. Returns false on any
    // failure (offline, revoked token, malformed slice) so the caller keeps showing the embedded snapshot.
    private async Task<bool> TryLoadLiveAsync(string revealToken)
    {
        try
        {
            var result = await RevealApi.GetRevealSliceAsync(revealToken);
            if (result is { IsSuccess: true, Value: { } view }
                && view.Body.Deserialize(RevealJsonContext.Default.RevealPayload) is { } fresh)
            {
                _payload = fresh;
                return true;
            }
        }
        catch (JsonException)
        {
            // A malformed live slice is no better than none — fall back to the snapshot.
        }

        return false;
    }

    // The reveal page's calendar entry: a generic title (the payload has no event name), the date/location/
    // notes/budget it carries, and the reveal link itself as the reopen URL (a raw-link holder need not
    // have the group). Null when there is no date. Never includes the recipient — that is the secret.
    private CalendarEvent? BuildCalendarEvent()
    {
        if (_eventDate is not { } date || _payload is null)
        {
            return null;
        }

        var budget = _payload.BudgetAmount is { } amount
            ? new BudgetDto(amount, _payload.BudgetCurrency ?? string.Empty, _payload.BudgetMin)
            : null;

        return new CalendarEvent(
            Uid: RevealUid(),
            Title: L["AppName"],
            Date: DateOnly.FromDateTime(date.Date),
            Location: string.IsNullOrWhiteSpace(_payload.EventLocation) ? null : _payload.EventLocation,
            Notes: CalendarEventFactory.ComposeNotes(_payload.EventNotes, budget, L["RevealBudgetLabel"]),
            Url: Navigation.Uri);
    }

    // A stable id derived from the link, so re-adding the same reveal does not duplicate the entry.
    private string RevealUid()
    {
        var hash = SHA256.HashData(Encoding.UTF8.GetBytes(Navigation.Uri));
        return $"secretsanta-reveal-{Convert.ToHexString(hash)[..16].ToLowerInvariant()}@circletools.ch";
    }
}
