@page "/r"
@using System.Globalization
@using CircleTools.SecretSanta.Core.Reveal
@inject RevealLinkCodec Codec
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["RevealTitle"]</PageTitle>

@if (_error)
{
    <div class="alert alert-danger" role="alert">@L["RevealMalformed"]</div>
}
else if (_payload is not null)
{
    <h1>@L["RevealGreeting", _label]</h1>

    @if (_payload.BudgetAmount is { } amount)
    {
        <p><strong>@L["RevealBudgetLabel"]:</strong> @amount.ToString("0.##", CultureInfo.CurrentCulture) @_payload.BudgetCurrency</p>
    }

    @if (HasEvent)
    {
        @* Razor strips the whitespace between these elements, so the separators must be explicit. *@
        <p>
            <strong>@L["RevealEventLabel"]:</strong>
            @if (_eventDate is { } date)
            {
                <span>&nbsp;@date.ToString("d", CultureInfo.CurrentCulture)</span>
            }
            @if (!string.IsNullOrWhiteSpace(_payload.EventLocation))
            {
                @if (_eventDate is not null)
                {
                    <span>,</span>
                }
                <span>&nbsp;@_payload.EventLocation</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(_payload.EventNotes))
        {
            <p>@_payload.EventNotes</p>
        }
    }

    @if (_revealed)
    {
        <div class="alert alert-success">
            <p class="mb-1">@L["RevealRecipientLabel"]:</p>
            <h2 class="mb-3">@_payload.RecipientName</h2>
            <p class="mb-1"><strong>@L["RevealWishlistLabel"]:</strong></p>
            @if (_payload.Wishlist.Count == 0)
            {
                <p class="mb-0">@L["RevealNoWishlist"]</p>
            }
            else
            {
                <ul class="mb-0">
                    @foreach (var item in _payload.Wishlist)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        </div>
    }
    else
    {
        <p class="text-muted">@L["RevealSpoilerNote"]</p>
        <button class="btn btn-lg btn-primary" @onclick="() => _revealed = true">@L["RevealButton"]</button>
    }
}

@code {
    private RevealPayload? _payload;
    private string _label = string.Empty;
    private DateTimeOffset? _eventDate;
    private bool _revealed;
    private bool _error;

    private bool HasEvent =>
        _eventDate is not null ||
        !string.IsNullOrWhiteSpace(_payload?.EventLocation) ||
        !string.IsNullOrWhiteSpace(_payload?.EventNotes);

    protected override void OnInitialized()
    {
        try
        {
            var fragment = new Uri(Navigation.Uri).Fragment;
            var (label, blob) = RevealLinkBuilder.ParseFragment(fragment);
            _label = label;
            _payload = Codec.Decode(blob);
            if (DateTimeOffset.TryParse(
                    _payload.EventDate, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed))
            {
                _eventDate = parsed;
            }
        }
        catch (FormatException)
        {
            _error = true;
        }
    }
}
