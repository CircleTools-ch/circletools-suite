@page "/settings"
@using Microsoft.Extensions.DependencyInjection
@using CircleTools.SecretSanta.LocalStore
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<SharedStrings> LS
@inject ThemeState Theme
@inject NotificationPreferences NotificationPrefs
@inject StorageModePreferences StoragePrefs
@inject INotificationScheduler Notifications
@inject IReminderRescheduler Reminders
@inject IServiceProvider Services
@implements IDisposable

@*
    Settings (MCN-3): the app-chrome controls gathered into one screen — appearance (System/Light/Dark),
    language, and the build version — instead of a top-bar toggle and drawer odds-and-ends. The same
    screen serves web and the device heads (ADR-0040 shell). Appearance and language are dropdowns so
    they read the same; both write through the shared ThemeState / ICultureProvider, so the whole app
    follows without a reload.
*@

<PageTitle>@L["SettingsTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["SettingsTitle"]</MudText>

<MudStack Spacing="5" Class="mt-2" Style="max-width:28rem;">
    <MudSelect T="ThemeMode" Value="Theme.Mode" ValueChanged="OnThemeChangedAsync"
               Label="@LS["ThemeAppearance"]" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
               Adornment="Adornment.Start" AdornmentIcon="@CurrentThemeIcon">
        <MudSelectItem T="ThemeMode" Value="ThemeMode.System">@LS["ThemeSystem"]</MudSelectItem>
        <MudSelectItem T="ThemeMode" Value="ThemeMode.Light">@LS["ThemeLight"]</MudSelectItem>
        <MudSelectItem T="ThemeMode" Value="ThemeMode.Dark">@LS["ThemeDark"]</MudSelectItem>
    </MudSelect>

    <div>
        <CultureSelector />
        @* Signed in, the picker is device-local; the account language is the synced one and reverts this
           on the next reconcile (ADR-0035). Say so and point at the Profile page (the durable path). *@
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
                    @L["NavLanguageDeviceNote"]
                    <MudLink Href="/account/profile" Typo="Typo.caption">@L["NavLanguageProfileLink"]</MudLink>
                </MudText>
            </Authorized>
        </AuthorizeView>
    </div>

    @* Default storage for new groups (FR-048, ADR-0071): a device-local preference that seeds the create
       picker and the phone "+" FAB. Changeable per group later in Sharing & sync. "My account" is
       disabled while signed out. *@
    <div>
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["SettingsDefaultStorageTitle"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["SettingsDefaultStorageHint"]</MudText>
        <StorageModePicker Value="_defaultMode" ValueChanged="OnDefaultModeChangedAsync" AccountEnabled="_signedIn" />
    </div>

    @* Device-local reminders (MNF-8): opt-in per kind, off by default; phone-only. *@
    <div>
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["NotificationsTitle"]</MudText>
        @if (!_notificationsSupported)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["NotificationsUnavailableWeb"]</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["NotificationsHint"]</MudText>

            @* Blocked in the OS (Q8): say so and open the app's system settings; coming back re-checks. *@
            @if (_permission == NotificationAccess.Denied && (_wanted.Count > 0 || _enabled.Count > 0))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" id="notifications-blocked">
                    <div class="d-flex flex-column gap-2">
                        <span>@L["NotificationsBlocked"]</span>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" Style="align-self:flex-start;"
                                   StartIcon="@Icons.Material.Filled.Settings" OnClick="OpenSystemSettingsAsync">@L["OpenSystemSettings"]</MudButton>
                    </div>
                </MudAlert>
            }

            <MudStack Spacing="1">
                @foreach (var kind in ReminderKinds)
                {
                    var on = _enabled.Contains(kind);
                    <div class="d-flex flex-wrap align-center gap-2" style="min-height:3rem;">
                        @* Re-created after a refused permission, so a switch MudBlazor already flipped falls back to off. *@
                        <MudSwitch @key="(kind, _switchEpoch)" T="bool" Value="on" Color="Color.Primary"
                                   ValueChanged="v => ToggleAsync(kind, v)" Label="@KindLabel(kind)" Class="flex-grow-1" />
                        @if (on)
                        {
                            <MudSelect T="int" Value="_settings.Lead.For(kind)" ValueChanged="d => SetLeadAsync(kind, d)"
                                       Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:11rem;"
                                       Label="@L["ReminderLeadLabel"]">
                                @foreach (var days in ReminderLeadTimes.Choices)
                                {
                                    <MudSelectItem T="int" Value="days">@LeadText(days)</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </div>
                }

                @if (_enabled.Count > 0)
                {
                    <MudSelect T="TimeOnly" Value="_settings.TimeOfDay" ValueChanged="SetTimeAsync" Label="@L["ReminderTimeLabel"]"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2" Style="max-width:11rem;" id="reminder-time">
                        @foreach (var t in TimeChoices)
                        {
                            <MudSelectItem T="TimeOnly" Value="t">@t.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)</MudSelectItem>
                        }
                    </MudSelect>
                }
            </MudStack>
        }
    </div>

    @* "Your data" (FEAT-017): only the web head keeps groups in evictable, invisible browser storage, so
       the transparency + backup controls are shown there only. Gating here (not inside the component)
       keeps its services from resolving on the device heads. *@
    @if (OperatingSystem.IsBrowser())
    {
        <DataStorageSection />
    }

    <div>
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["SettingsAbout"]</MudText>
        <AppVersion />
    </div>
</MudStack>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly ReminderKind[] ReminderKinds = [ReminderKind.DrawNotDone, ReminderKind.EventTomorrow, ReminderKind.MyWishlistEmpty];

    // Every half hour from 06:00 to 22:00 — a reminder at a civil hour.
    private static readonly IReadOnlyList<TimeOnly> TimeChoices =
        [.. Enumerable.Range(12, 33).Select(i => new TimeOnly(i / 2, i % 2 * 30))];

    private bool _notificationsSupported;
    private HashSet<ReminderKind> _enabled = [];
    private ReminderSettings _settings = ReminderSettings.Default;
    private NotificationAccess _permission = NotificationAccess.Unknown;

    // Kinds the user switched on while notifications were blocked: applied once they are allowed (Q8).
    // Kinds asked for while notifications were blocked; stored, so the wish survives a trip to the system
    // settings even when this page is gone (R15).
    private IReadOnlySet<ReminderKind> _wanted = new HashSet<ReminderKind>();
    private int _switchEpoch;
    private IAppForeground? _foreground;
    private StorageMode _defaultMode = StorageMode.OnThisDevice;
    private bool _signedIn;

    protected override void OnInitialized() => Theme.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        _notificationsSupported = await Notifications.IsSupportedAsync();
        _enabled = new HashSet<ReminderKind>(await NotificationPrefs.GetEnabledAsync());
        _wanted = await NotificationPrefs.GetWantedAsync();
        _settings = await NotificationPrefs.GetSettingsAsync();
        if (_notificationsSupported)
        {
            _permission = await Notifications.GetPermissionAsync();
            _foreground = Services.GetService<IAppForeground>();
            if (_foreground is not null)
            {
                _foreground.Changed += OnForegroundChanged;
            }
        }
        _defaultMode = await StoragePrefs.GetDefaultAsync();
        _signedIn = AuthState is not null && (await AuthState).User.UserId() != Guid.Empty;
    }

    // Remember the chosen default storage mode for new groups (FR-048). Device-local, best-effort.
    private async Task OnDefaultModeChangedAsync(StorageMode mode)
    {
        _defaultMode = mode;
        await StoragePrefs.SetDefaultAsync(mode);
    }

    // Turning a reminder on for the first time is where we ask the OS for notification permission; if it is
    // refused, the switch stays off. Any change reschedules so the reminders match the new choice.
    private async Task ToggleAsync(ReminderKind kind, bool enabled)
    {
        if (enabled && !await Notifications.RequestPermissionAsync())
        {
            // Refused (or blocked for good): the switch stays off, the note explains it, and the choice is kept
            // so it applies once notifications are allowed (Q8, R15).
            await NotificationPrefs.AddWantedAsync(kind);
            _wanted = await NotificationPrefs.GetWantedAsync();
            _permission = NotificationAccess.Denied;
            _switchEpoch++;
            return;
        }

        if (enabled)
        {
            _permission = NotificationAccess.Granted;
        }

        // Also drops a wish for this kind left from a blocked attempt.
        await NotificationPrefs.SetEnabledAsync(kind, enabled);
        _enabled = new HashSet<ReminderKind>(await NotificationPrefs.GetEnabledAsync());
        _wanted = await NotificationPrefs.GetWantedAsync();
        await Reminders.ReconcileAsync();
    }

    private async Task SetLeadAsync(ReminderKind kind, int days)
    {
        _settings = _settings with { Lead = _settings.Lead.With(kind, days) };
        await NotificationPrefs.SetSettingsAsync(_settings);
        await Reminders.ReconcileAsync();
    }

    private async Task SetTimeAsync(TimeOnly time)
    {
        _settings = _settings with { TimeOfDay = time };
        await NotificationPrefs.SetSettingsAsync(_settings);
        await Reminders.ReconcileAsync();
    }

    private Task OpenSystemSettingsAsync() => Notifications.OpenSettingsAsync().AsTask();

    // Back from the system settings: if notifications are now allowed, apply what the user wanted.
    private void OnForegroundChanged(bool foreground)
    {
        if (!foreground)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            _permission = await Notifications.GetPermissionAsync();
            if (_permission == NotificationAccess.Granted && (await NotificationPrefs.ApplyWantedAsync()).Count > 0)
            {
                _switchEpoch++;
                await Reminders.ReconcileAsync();
            }

            // Re-read either way: the app-wide reminder scheduler may have applied the wish first.
            _enabled = new HashSet<ReminderKind>(await NotificationPrefs.GetEnabledAsync());
            _wanted = await NotificationPrefs.GetWantedAsync();

            StateHasChanged();
        });
    }

    private string KindLabel(ReminderKind kind) => kind switch
    {
        ReminderKind.DrawNotDone => L["ReminderDrawLabel"],
        ReminderKind.EventTomorrow => L["ReminderTomorrowLabel"],
        _ => L["ReminderWishlistLabel"],
    };

    private string LeadText(int days) => days == 1 ? L["ReminderLeadOneDay"] : L["ReminderLeadDays", days];

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private Task OnThemeChangedAsync(ThemeMode mode) => Theme.SetModeAsync(mode);

    private string CurrentThemeIcon => Theme.Mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    public void Dispose()
    {
        Theme.Changed -= OnChanged;
        if (_foreground is not null)
        {
            _foreground.Changed -= OnForegroundChanged;
        }
    }
}
