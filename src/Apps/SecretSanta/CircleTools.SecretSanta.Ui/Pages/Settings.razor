@page "/settings"
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<SharedStrings> LS
@inject ThemeState Theme
@inject NotificationPreferences NotificationPrefs
@inject INotificationScheduler Notifications
@inject IReminderRescheduler Reminders
@implements IDisposable

@*
    Settings (MCN-3): the app-chrome controls gathered into one screen — appearance (System/Light/Dark),
    language, and the build version — instead of a top-bar toggle and drawer odds-and-ends. The same
    screen serves web and the device heads (ADR-0040 shell). Appearance and language are dropdowns so
    they read the same; both write through the shared ThemeState / ICultureProvider, so the whole app
    follows without a reload.
*@

<PageTitle>@L["SettingsTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["SettingsTitle"]</MudText>

<MudStack Spacing="5" Class="mt-2" Style="max-width:28rem;">
    <MudSelect T="ThemeMode" Value="Theme.Mode" ValueChanged="OnThemeChangedAsync"
               Label="@LS["ThemeAppearance"]" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
               Adornment="Adornment.Start" AdornmentIcon="@CurrentThemeIcon">
        <MudSelectItem T="ThemeMode" Value="ThemeMode.System">@LS["ThemeSystem"]</MudSelectItem>
        <MudSelectItem T="ThemeMode" Value="ThemeMode.Light">@LS["ThemeLight"]</MudSelectItem>
        <MudSelectItem T="ThemeMode" Value="ThemeMode.Dark">@LS["ThemeDark"]</MudSelectItem>
    </MudSelect>

    <div>
        <CultureSelector />
        @* Signed in, the picker is device-local; the account language is the synced one and reverts this
           on the next reconcile (ADR-0035). Say so and point at the Profile page (the durable path). *@
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block">
                    @L["NavLanguageDeviceNote"]
                    <MudLink Href="/account/profile" Typo="Typo.caption">@L["NavLanguageProfileLink"]</MudLink>
                </MudText>
            </Authorized>
        </AuthorizeView>
    </div>

    @* Device-local reminders (MNF-8): opt-in per kind, off by default; phone-only. *@
    <div>
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["NotificationsTitle"]</MudText>
        @if (!_notificationsSupported)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["NotificationsUnavailableWeb"]</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["NotificationsHint"]</MudText>
            <MudStack Spacing="0">
                <MudSwitch T="bool" Value="_enabled.Contains(ReminderKind.DrawNotDone)" Color="Color.Primary"
                           ValueChanged="v => ToggleAsync(ReminderKind.DrawNotDone, v)" Label="@L["ReminderDrawLabel"]" />
                <MudSwitch T="bool" Value="_enabled.Contains(ReminderKind.EventTomorrow)" Color="Color.Primary"
                           ValueChanged="v => ToggleAsync(ReminderKind.EventTomorrow, v)" Label="@L["ReminderTomorrowLabel"]" />
                <MudSwitch T="bool" Value="_enabled.Contains(ReminderKind.MyWishlistEmpty)" Color="Color.Primary"
                           ValueChanged="v => ToggleAsync(ReminderKind.MyWishlistEmpty, v)" Label="@L["ReminderWishlistLabel"]" />
            </MudStack>
        }
    </div>

    <div>
        <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["SettingsAbout"]</MudText>
        <AppVersion />
    </div>
</MudStack>

@code {
    private bool _notificationsSupported;
    private HashSet<ReminderKind> _enabled = [];

    protected override void OnInitialized() => Theme.Changed += OnChanged;

    protected override async Task OnInitializedAsync()
    {
        _notificationsSupported = await Notifications.IsSupportedAsync();
        _enabled = new HashSet<ReminderKind>(await NotificationPrefs.GetEnabledAsync());
    }

    // Turning a reminder on for the first time is where we ask the OS for notification permission; if it is
    // refused, the switch stays off. Any change reschedules so the reminders match the new choice.
    private async Task ToggleAsync(ReminderKind kind, bool enabled)
    {
        if (enabled && !await Notifications.RequestPermissionAsync())
        {
            return; // permission refused — leave the switch off
        }

        await NotificationPrefs.SetEnabledAsync(kind, enabled);
        _enabled = new HashSet<ReminderKind>(await NotificationPrefs.GetEnabledAsync());
        await Reminders.ReconcileAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private Task OnThemeChangedAsync(ThemeMode mode) => Theme.SetModeAsync(mode);

    private string CurrentThemeIcon => Theme.Mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    public void Dispose() => Theme.Changed -= OnChanged;
}
