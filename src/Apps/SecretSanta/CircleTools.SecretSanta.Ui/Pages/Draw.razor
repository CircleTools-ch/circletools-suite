@page "/groups/{GroupId:guid}/events/{EventId:guid}/draw"
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject IHapticFeedback Haptics
@inject IDialogService Dialogs
@inject ISyncSignals SyncSignals
@implements IDisposable

<PageTitle>@L["DrawTitle"]</PageTitle>

<EventBackNav GroupId="GroupId" EventId="EventId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["DrawTitle"]</MudText>

@if (_event is null)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_memberCount < 2)
{
    @* Not a dead end (UX-council #4): the draw needs members, so offer the one-tap way to add them
       instead of a bare sentence with no way forward. *@
    <MudStack Spacing="3" AlignItems="AlignItems.Start">
        <MudText>@L["NeedTwoMembersToDraw"]</MudText>
        <MudButton Href="@($"groups/{GroupId}/members")" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd">@L["GoToMembers"]</MudButton>
    </MudStack>
}
else
{
    @if (_result is null && _event.DrawInvalidatedByMembershipChange)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" role="alert">@L["DrawInvalidatedNotice"]</MudAlert>
    }

    @* What is about to be drawn, before the button (UX review U2): who takes part, how many exclusions
       apply, and that nobody - the organizer included - sees the pairings here. *@
    @if (!Drawn)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-3" id="draw-summary">
            <MudText><strong>@L["DrawSummary", _memberCount, _exclusionCount]</strong></MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@_memberNames</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@L["DrawBeforeNote"]</MudText>
        </MudPaper>
    }

    @if (_result is not null && !_result.Success)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@FailureMessage(_result.FailureReason)</MudAlert>
        @* Escape hatch (FR-035 5a): if the failure is because carrying forward left no room to avoid
           last time's pairings, let the organizer draw anyway, ignoring that one constraint. *@
        @if (_event.HasCarriedForwardBaseline)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mb-3"
                       OnClick="() => RunAsync(ignoreBaseline: true)" Disabled="@_busy">@L["DrawIgnoreBaseline"]</MudButton>
        }
    }

    @if (Drawn)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">
            @if (_result is { Success: true })
            {
                <MudText>@L["DrawSuccess"]</MudText>
                <MudText>@L["DrawAssignmentCount", _result.AssignmentCount]</MudText>
            }
            <MudText>@L["DrawSpoilerNote"]</MudText>
        </MudAlert>
        @* Once drawn, the next step is handing out the links, so that is the primary action; drawing again
           is the rare, destructive one and steps back to an outlined button (UX review U2). *@
        <div class="d-flex flex-wrap gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Share"
                       OnClick="GoToShare" id="go-share">@L["NavShare"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Casino"
                       OnClick="OnDrawClickedAsync" Disabled="@_busy" id="redraw-btn">@L["DrawAgain"]</MudButton>
        </div>
    }
    else
    {
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Casino" OnClick="OnDrawClickedAsync" Disabled="@_busy" id="draw-btn">@L["RunDraw"]</MudButton>
    }
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    /// <summary>The event to draw.</summary>
    [Parameter]
    public Guid EventId { get; set; }

    private EventDto? _event;
    private int _memberCount;
    private int _exclusionCount;
    private string _memberNames = string.Empty;
    private RunDrawResultDto? _result;
    private bool _busy;

    protected override void OnInitialized() => SyncSignals.SyncCompleted += OnSyncCompleted;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    // A background sync may have pulled a co-organizer's edits (roster changes that stale the draw, or a
    // draw they ran) into the local store (shared-by-link, FEAT-013); reload so the draw state is current
    // without a manual refresh. A just-run local result is separate state and is not disturbed.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => SyncSignals.SyncCompleted -= OnSyncCompleted;

    private async Task LoadAsync()
    {
        _event = await Sender.Send(new GetEventQuery(GroupId, EventId));
        var group = await Sender.Send(new GetGroupQuery(GroupId));
        _memberCount = group?.Members.Count ?? 0;
        _exclusionCount = group?.Exclusions.Count ?? 0;
        _memberNames = string.Join(", ", group?.Members.Select(m => m.Name) ?? []);
    }

    // A current, valid draw exists (just run here, or from before) — the page then leads with sharing.
    private bool Drawn => _result is { Success: true } || (_result is null && _event?.HasCurrentDraw == true);

    /// <summary>
    /// Re-drawing silently invalidates links the organizer may already have sent (ADR-0014 links
    /// are self-contained, so they cannot be revoked), which is why the second draw asks first.
    /// </summary>
    private async Task OnDrawClickedAsync()
    {
        // Re-drawing invalidates links already sent, so confirm it first — now in a bottom sheet
        // (FEAT-008 W4) rather than an inline warning.
        if (_event?.HasCurrentDraw == true &&
            !await Dialogs.ShowConfirmSheetAsync(L["RedrawWarning"], L["RedrawConfirm"], L["Cancel"]))
        {
            return;
        }

        await RunAsync();
    }

    private async Task RunAsync(bool ignoreBaseline = false)
    {
        _busy = true;
        try
        {
            _result = await Sender.Send(new RunDrawCommand(GroupId, EventId, ignoreBaseline));
            // A confirmation buzz when the draw actually lands (FEAT-008 W3); a no-op on the web head.
            if (_result.Success)
            {
                await Haptics.TapAsync();
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string FailureMessage(string? reason) => reason switch
    {
        nameof(CircleTools.SecretSanta.Core.Domain.DrawFailureReason.TwoMemberReciprocalImpossible) => L["DrawFailedTwoMember"],
        _ => L["DrawFailedOverConstrained"],
    };

    private void GoToShare() => Navigation.NavigateTo($"groups/{GroupId}/events/{EventId}/share");
}
