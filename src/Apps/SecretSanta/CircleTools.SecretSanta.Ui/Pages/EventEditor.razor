@page "/groups/{GroupId:guid}/events/{EventId:guid}/details"
@using Microsoft.Extensions.DependencyInjection
@inject ISender Sender
@inject IStringLocalizer<AppStrings> L
@inject IDialogService Dialogs
@inject IServiceProvider Services

<PageTitle>@L["EventDetailsTitle"]</PageTitle>

<EventBackNav GroupId="GroupId" EventId="EventId" />

@* Leaving with unsaved edits used to drop them silently (UX review B5): ask first. Covers in-app links, the
   app bar and the Android Back gesture (a history navigation); a full page unload gets the browser prompt. *@
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@IsDirty" />
<MudText Typo="Typo.h4" GutterBottom="true">@L["NavEventDetails"]</MudText>

@if (_event is null)
{
    <MudText>@(_loaded ? L["EventNotFound"] : L["Loading"])</MudText>
}
else
{
    @* One form, one Save (ADR/UX: a single save button per screen). Name, budget and details are all
       persisted together by SaveAsync — the three separate per-section Save buttons were consolidated. *@
    <MudStack Spacing="4">
        <MudTextField ReadOnly="_readOnly" @bind-Value="_name" Label="@L["EventNameLabel"]" Placeholder="@L["EventNamePlaceholder"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />

        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["BudgetLabel"]</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                    @* Explicit widths + hidden spinners so the budget row doesn't fragment on a narrow phone
                       (the numeric spin buttons otherwise eat the little horizontal space there is). The
                       optional minimum is a lower bound on the maximum (FR-036); leave it blank for a bare
                       maximum, which is the prior behaviour. *@
                    <MudNumericField ReadOnly="_readOnly" @bind-Value="_budgetMinAmount" Label="@L["BudgetMinLabel"]" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Step="0.01M" Min="0" HideSpinButtons="true" Style="max-width:9rem;" />
                    <MudNumericField ReadOnly="_readOnly" @bind-Value="_budgetAmount" Label="@L["BudgetMaxLabel"]" Variant="Variant.Outlined"
                                     Margin="Margin.Dense" Step="0.01M" Min="0" HideSpinButtons="true" Style="max-width:9rem;" />
                    <MudTextField ReadOnly="_readOnly" @bind-Value="_budgetCurrency" Label="@L["CurrencyLabel"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="3" Immediate="true" Style="max-width:7rem;" />
                    @* Clears both amounts locally; the budget is removed when the form is saved with no maximum.
                       Only offered when there is a budget to remove (UX review P4). *@
                    @if (!_readOnly && (_budgetAmount is not null || _budgetMinAmount is not null))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ClearBudget">@L["ClearBudget"]</MudButton>
                    }
                </MudStack>
                @if (_budgetError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" role="alert">@_budgetError</MudAlert>
                }
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" GutterBottom="true">@L["EventLabel"]</MudText>
                <MudStack Spacing="2">
                    @* The date control differs per head. In the browser (OperatingSystem.IsBrowser() is true
                       only under the WASM runtime) MudBlazor's date picker is used: it is themed and formats
                       by the app culture, where the native <input type="date"> is unstyled and locale-fixed.
                       On the device head a native input drives the OS picker instead — the Mud calendar clips
                       and loses focus in the phone WebView (late-month days unreachable). The native value is
                       the invariant "yyyy-MM-dd" string the input expects (EventDateText adapts it). *@
                    @if (OperatingSystem.IsBrowser())
                    {
                        <TypedDatePicker @ref="_datePicker" ReadOnly="_readOnly" @bind-Date="_eventDate" Label="@L["DateLabel"]" />
                    }
                    else
                    {
                        <MudTextField ReadOnly="_readOnly" @bind-Value="EventDateText" Label="@L["DateLabel"]" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" InputType="InputType.Date"
                                      Class="@(_eventDate is null ? "ct-date-field ct-date-empty" : "ct-date-field")"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />
                    }
                    <MudTextField ReadOnly="_readOnly" @bind-Value="_eventLocation" Label="@L["LocationLabel"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                    <MudTextField ReadOnly="_readOnly" @bind-Value="_eventDescription" Label="@L["DescriptionLabel"]" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Lines="3" />
                </MudStack>
            </MudCardContent>
        </MudCard>

        @if (_readOnly)
        {
            <MudAlert Severity="Severity.Normal" Dense="true">@L["ParticipantReadOnlyNote"]</MudAlert>
        }
        else
        {
            <div>
                <MudButton Color="Color.Primary" Variant="@(IsDirty ? Variant.Filled : Variant.Outlined)"
                           OnClick="SaveAsync" id="save-event">@L["Save"]</MudButton>
            </div>
        }

        @if (_status is not null)
        {
            <MudAlert Severity="Severity.Success" Dense="true" role="status">@_status</MudAlert>
        }

        @* This occasion's own reminder (FR-046 amendment): as in Settings, its own lead, or off. Device-local,
           so it is offered to participants too; only where the device can schedule. *@
        @if (_remindersSupported)
        {
            <MudSelect T="string" Value="_reminderChoice" ValueChanged="SetReminderAsync" Label="@L["EventReminderLabel"]"
                       Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:18rem;" id="event-reminder">
                <MudSelectItem T="string" Value="@("default")">@L["EventReminderDefault"]</MudSelectItem>
                @foreach (var days in ReminderLeadTimes.Choices)
                {
                    <MudSelectItem T="string" Value="@days.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @(days == 1 ? L["ReminderLeadOneDay"] : L["ReminderLeadDays", days])
                    </MudSelectItem>
                }
                <MudSelectItem T="string" Value="@("off")">@L["EventReminderOff"]</MudSelectItem>
            </MudSelect>
        }
    </MudStack>
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    /// <summary>The event being edited.</summary>
    [Parameter]
    public Guid EventId { get; set; }

    private EventDto? _event;
    private bool _loaded;
    // A join-link participant sees the details but only the organizer changes them (ADR-0058).
    private bool _readOnly;
    private bool _remindersSupported;
    private string _reminderChoice = "default";
    private string _name = string.Empty;
    private decimal? _budgetAmount;
    private decimal? _budgetMinAmount;
    private string _budgetCurrency = "CHF";
    // The event date; null for no date. The browser binds this directly (TypedDatePicker); the device head's
    // native <input type="date"> binds EventDateText, which adapts it to/from the invariant string format.
    private DateTime? _eventDate;
    private TypedDatePicker? _datePicker;
    private string _eventLocation = string.Empty;
    private string _eventDescription = string.Empty;
    private string? _status;
    private string? _budgetError;
    // The form as last loaded/saved, to tell whether there are unsaved edits (B5).
    private string _savedSnapshot = string.Empty;

    private string Snapshot() =>
        string.Join('|', _name, _budgetAmount, _budgetMinAmount, _budgetCurrency, EventDateText, _eventLocation, _eventDescription);

    private bool IsDirty => _event is not null && Snapshot() != _savedSnapshot;

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (IsDirty && !await Dialogs.ShowConfirmSheetAsync(L["UnsavedChangesWarning"], L["DiscardChanges"], L["KeepEditing"]))
        {
            context.PreventNavigation();
        }
    }

    // Adapts the DateTime? model to the invariant "yyyy-MM-dd" string a native <input type="date"> uses
    // (device head only). Empty string clears the date.
    private string EventDateText
    {
        get => _eventDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
        set => _eventDate = DateTime.TryParseExact(
            value, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var parsed)
            ? parsed
            : null;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task SetReminderAsync(string choice)
    {
        _reminderChoice = choice;
        if (Services.GetService<NotificationPreferences>() is not { } prefs)
        {
            return;
        }

        var settings = await prefs.GetSettingsAsync();
        var overrides = new Dictionary<Guid, EventReminderOverride>(settings.Overrides);
        if (choice == "default")
        {
            overrides.Remove(EventId);
        }
        else
        {
            overrides[EventId] = choice == "off"
                ? new EventReminderOverride(true, null)
                : new EventReminderOverride(false, int.Parse(choice, System.Globalization.CultureInfo.InvariantCulture));
        }

        await prefs.SetSettingsAsync(settings with { Overrides = overrides });
        if (Services.GetService<IReminderRescheduler>() is { } reminders)
        {
            await reminders.ReconcileAsync();
        }
    }

    private async Task LoadAsync()
    {
        _readOnly = (await GroupAccess.ForAsync(Services, GroupId)).ReadOnly;
        _event = await Sender.Send(new GetEventQuery(GroupId, EventId));
        if (Services.GetService<INotificationScheduler>() is { } notifications
            && Services.GetService<NotificationPreferences>() is { } prefs)
        {
            _remindersSupported = await notifications.IsSupportedAsync();
            var own = (await prefs.GetSettingsAsync()).Overrides.GetValueOrDefault(EventId);
            _reminderChoice = own switch
            {
                { Off: true } => "off",
                { EventLeadDays: { } days } => days.ToString(System.Globalization.CultureInfo.InvariantCulture),
                _ => "default",
            };
        }
        _loaded = true;
        if (_event is null)
        {
            return;
        }

        _name = _event.Name;
        _budgetAmount = _event.Budget?.Amount;
        _budgetMinAmount = _event.Budget?.MinAmount;
        _budgetCurrency = _event.Budget?.Currency ?? "CHF";
        _eventDate = _event.Details?.Date?.DateTime;
        _eventLocation = _event.Details?.Location ?? string.Empty;
        _eventDescription = _event.Details?.Description ?? string.Empty;
        _savedSnapshot = Snapshot();
    }

    // Clears the amount locally only; the budget is actually removed when the form is saved with no
    // amount (SaveAsync sends a null budget in that case), keeping a single persistence path.
    private void ClearBudget()
    {
        _budgetError = null;
        _budgetAmount = null;
        _budgetMinAmount = null;
    }

    // The screen's single Save: persists the name, budget and details together.
    private async Task SaveAsync()
    {
        _budgetError = null;

        // The field shows a text that is no date, so saving would store something else than it shows (PR-14).
        // It already says why; an earlier "Saved" must not stay beside it.
        if (_datePicker is { HasUnreadableText: true })
        {
            _status = null;
            return;
        }

        // A budget is optional: no maximum clears it. A set maximum must be positive with a valid currency.
        // The minimum is an optional lower bound (FR-036): blank or non-positive means "no minimum", and a
        // set minimum must not exceed the maximum.
        decimal? budgetAmount = null;
        string? budgetCurrency = null;
        decimal? budgetMinAmount = null;
        if (_budgetAmount is { } amount)
        {
            if (amount <= 0)
            {
                _budgetError = L["BudgetAmountInvalid"];
                return;
            }

            // Currencies are 3-letter ISO codes (CHF, EUR, …); normalize case and reject anything else.
            var currency = (_budgetCurrency ?? string.Empty).Trim().ToUpperInvariant();
            if (currency.Length != 3 || !currency.All(char.IsLetter))
            {
                _budgetError = L["CurrencyInvalid"];
                return;
            }

            if (_budgetMinAmount is { } min && min > 0)
            {
                if (min > amount)
                {
                    _budgetError = L["BudgetMinExceedsMax"];
                    return;
                }

                budgetMinAmount = min;
            }

            _budgetCurrency = currency;
            budgetAmount = amount;
            budgetCurrency = currency;
        }

        DateTimeOffset? date = _eventDate is { } value ? new DateTimeOffset(value, TimeSpan.Zero) : null;

        await Sender.Send(new RenameEventCommand(GroupId, EventId, _name));
        await Sender.Send(new SetBudgetCommand(GroupId, EventId, budgetAmount, budgetCurrency, budgetMinAmount));
        await Sender.Send(new SetEventDetailsCommand(GroupId, EventId, date, _eventLocation, _eventDescription));
        await Reload();
    }

    private async Task Reload()
    {
        await LoadAsync();
        _status = L["Saved"];
    }
}
