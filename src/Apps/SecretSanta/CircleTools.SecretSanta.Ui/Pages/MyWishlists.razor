@page "/my-wishlists"
@using CircleTools.ApiClient
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ILinkingApi Linking
@inject IStringLocalizer<AppStrings> L
@inject TimeProvider Time
@inject IDialogService Dialogs

@*
    Edit my own wishlist (FR-030). A linked member owns their wishlist per membership. In-app reveal is
    always current; a giver holding an already-issued reveal link keeps seeing the old text until it is
    re-issued — the member is told so here. A new membership can copy a previous wishlist.
    Every change saves itself (UX review B5): adding, removing or copying saves at once and an edited line
    saves when the field loses focus, so there is no separate Save step to forget. A wish typed but not yet
    added, or a save that failed, guards navigation away.
*@

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@AnyUnsaved" />

<PageTitle>@L["MyWishlistsTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["MyWishlistsTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-2">@L["MyWishlistsLead"]</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-4" role="note">@L["MyWishlistsRevealLinkCaveat"]</MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" role="status">@_error</MudAlert>
        }

        @if (_editors is null)
        {
            <MudText>@L["Loading"]</MudText>
        }
        else if (_editors.Count == 0)
        {
            <MudText Class="mud-text-secondary">@L["MyWishlistsNoMemberships"]</MudText>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var editor in _editors)
                {
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" GutterBottom="true">@editor.GroupName — @EventLabel(editor.EventName)</MudText>

                            @if (editor.Items.Count == 0 && _copyableFrom(editor).Any())
                            {
                                <div class="d-flex align-center flex-wrap gap-1 mb-2">
                                    <MudText Typo="Typo.body2" Class="mr-2">@L["MyWishlistsCopyOfferLabel"]</MudText>
                                    @foreach (var source in _copyableFrom(editor))
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="() => CopyFrom(editor, source)">
                                            @source.GroupName · @EventLabel(source.EventName)
                                        </MudButton>
                                    }
                                </div>
                            }

                            <MudStack Spacing="1" Class="mb-2">
                                @for (var i = 0; i < editor.Items.Count; i++)
                                {
                                    var index = i;
                                    <div class="d-flex align-center gap-2">
                                        <MudTextField @bind-Value="editor.Items[index]" Immediate="true"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                                                      OnBlur="() => SaveIfChangedAsync(editor)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       Size="Size.Small" OnClick="() => RemoveItemAsync(editor, index)"
                                                       aria-label="@L["RemoveNamed", editor.Items[index]]" />
                                    </div>
                                }
                            </MudStack>

                            <div class="d-flex gap-2 align-start mb-2">
                                <MudTextField @bind-Value="editor.NewItem" Immediate="true"
                                              Placeholder="@L["MyWishlistsAddPlaceholder"]" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Class="flex-grow-1"
                                              OnKeyDown="args => OnAddKeyDown(args, editor)" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-1"
                                           OnClick="() => AddItem(editor)" Disabled="@string.IsNullOrWhiteSpace(editor.NewItem)">
                                    @L["MyWishlistsAdd"]
                                </MudButton>
                            </div>

                            <div class="d-flex align-center gap-2" style="min-height:2.25rem;">
                                @if (editor.Busy)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else if (editor.SaveError is not null)
                                {
                                    <MudText Color="Color.Error" Typo="Typo.body2" role="alert">@editor.SaveError</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="() => SaveAsync(editor)">@L["Retry"]</MudButton>
                                }
                                else if (editor.Saved)
                                {
                                    <MudText Color="Color.Success" Typo="Typo.body2" role="status">@L["MyWishlistsSaved"]</MudText>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private sealed class WishlistEditor
    {
        public Guid GroupId { get; init; }
        public string GroupName { get; init; } = string.Empty;
        public Guid EventId { get; init; }
        public string EventName { get; init; } = string.Empty;
        public List<string> Items { get; init; } = [];
        // The items as last stored on the server, to tell whether an edit still needs saving.
        public List<string> SavedItems { get; set; } = [];
        public bool Unsaved => !Items.SequenceEqual(SavedItems) || !string.IsNullOrWhiteSpace(NewItem);
        public string NewItem { get; set; } = string.Empty;
        public bool Busy { get; set; }
        public bool Saved { get; set; }
        public string? SaveError { get; set; }
    }

    private List<WishlistEditor>? _editors;
    private string? _error;

    private string EventLabel(string name) => string.IsNullOrWhiteSpace(name) ? L["DefaultEventName"] : name;

    // An undated event has no past to hide; a dated one is kept while its calendar day is today or later.
    private bool NotPast(MyMembership m) =>
        m.EventDate is not { } date || date.Date >= Time.GetLocalNow().Date;

    protected override async Task OnInitializedAsync()
    {
        var memberships = await Linking.GetMyMembershipsAsync();
        var wishlists = await Linking.GetMyWishlistsAsync();

        if (!memberships.IsSuccess)
        {
            _editors = [];
            _error = memberships.Error!.Failure == ApiFailure.Unreachable ? L["MyWishlistsOffline"] : L["MyWishlistsReadFailed"];
            return;
        }

        // A membership is per (group, event) now (ADR-0042): key existing wishlists the same way.
        var existing = wishlists.IsSuccess
            ? wishlists.Value!.Wishlists.ToDictionary(w => (w.GroupId, w.EventId), w => w.Items)
            : new Dictionary<(Guid, Guid), IReadOnlyList<string>>();

        _editors = memberships.Value!.Memberships
            // Only present and future occasions get a wishlist slot: a past event's gifts have been
            // given, so it drops off (an undated or today's event stays). FR-030.
            .Where(NotPast)
            .Select(m => new WishlistEditor
            {
                GroupId = m.GroupId,
                GroupName = m.GroupName,
                EventId = m.EventId,
                EventName = m.EventName,
                Items = existing.TryGetValue((m.GroupId, m.EventId), out var items) ? [.. items] : [],
                SavedItems = existing.TryGetValue((m.GroupId, m.EventId), out var saved) ? [.. saved] : [],
            })
            .ToList();
    }

    private IEnumerable<WishlistEditor> _copyableFrom(WishlistEditor target) =>
        _editors!.Where(e => (e.GroupId != target.GroupId || e.EventId != target.EventId) && e.Items.Count > 0);

    private Task CopyFrom(WishlistEditor target, WishlistEditor source)
    {
        target.Items.Clear();
        target.Items.AddRange(source.Items);
        return SaveAsync(target);
    }

    private Task OnAddKeyDown(KeyboardEventArgs args, WishlistEditor editor) =>
        args.Key == "Enter" ? AddItem(editor) : Task.CompletedTask;

    private Task AddItem(WishlistEditor editor)
    {
        if (string.IsNullOrWhiteSpace(editor.NewItem))
        {
            return Task.CompletedTask;
        }

        editor.Items.Add(editor.NewItem.Trim());
        editor.NewItem = string.Empty;
        return SaveAsync(editor);
    }

    private Task RemoveItemAsync(WishlistEditor editor, int index)
    {
        editor.Items.RemoveAt(index);
        return SaveAsync(editor);
    }

    private Task SaveIfChangedAsync(WishlistEditor editor) =>
        editor.Items.SequenceEqual(editor.SavedItems) ? Task.CompletedTask : SaveAsync(editor);

    private bool AnyUnsaved => _editors?.Any(e => e.Unsaved) ?? false;

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (AnyUnsaved && !await Dialogs.ShowConfirmSheetAsync(L["UnsavedChangesWarning"], L["DiscardChanges"], L["KeepEditing"]))
        {
            context.PreventNavigation();
        }
    }

    private async Task SaveAsync(WishlistEditor editor)
    {
        editor.Busy = true;
        editor.Saved = false;
        editor.SaveError = null;

        var result = await Linking.UpdateMyWishlistAsync(editor.GroupId, editor.EventId, new UpdateMyWishlistRequest(editor.EventName, [.. editor.Items]));
        editor.Busy = false;

        if (result.IsSuccess)
        {
            editor.Saved = true;
            editor.SavedItems = [.. editor.Items];
        }
        else
        {
            editor.SaveError = result.Error!.Failure == ApiFailure.Unreachable ? L["MyWishlistsOffline"] : L["MyWishlistsSaveFailed"];
        }
    }
}
