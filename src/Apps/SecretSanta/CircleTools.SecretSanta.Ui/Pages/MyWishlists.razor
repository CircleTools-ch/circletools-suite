@page "/my-wishlists"
@using CircleTools.ApiClient
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ILinkingApi Linking
@inject IStringLocalizer<AppStrings> L

@*
    Edit my own wishlist (FR-030). A linked member owns their wishlist per membership. In-app reveal is
    always current; a giver holding an already-issued reveal link keeps seeing the old text until it is
    re-issued — the member is told so here. A new membership can copy a previous wishlist.
*@

<PageTitle>@L["MyWishlistsTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>@L["MyWishlistsTitle"]</h1>
        <p class="text-body-secondary">@L["MyWishlistsLead"]</p>
        <div class="alert alert-secondary small" role="note">@L["MyWishlistsRevealLinkCaveat"]</div>

        @if (_error is not null)
        {
            <div class="alert alert-warning" role="status">@_error</div>
        }

        @if (_editors is null)
        {
            <p>@L["Loading"]</p>
        }
        else if (_editors.Count == 0)
        {
            <p>@L["MyWishlistsNoMemberships"]</p>
        }
        else
        {
            @foreach (var editor in _editors)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 card-title">@editor.GroupName</h2>

                        @if (editor.Items.Count == 0 && _copyableFrom(editor).Any())
                        {
                            <div class="mb-2">
                                <span class="me-2">@L["MyWishlistsCopyOfferLabel"]</span>
                                @foreach (var source in _copyableFrom(editor))
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1"
                                            @onclick="() => CopyFrom(editor, source)">
                                        @source.GroupName
                                    </button>
                                }
                            </div>
                        }

                        <ul class="list-group mb-2">
                            @for (var i = 0; i < editor.Items.Count; i++)
                            {
                                var index = i;
                                <li class="list-group-item d-flex align-items-center">
                                    <input class="form-control me-2" @bind="editor.Items[index]" @bind:event="oninput" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => editor.Items.RemoveAt(index)">
                                        @L["Remove"]
                                    </button>
                                </li>
                            }
                        </ul>

                        <div class="input-group mb-2">
                            <input class="form-control" placeholder="@L["MyWishlistsAddPlaceholder"]"
                                   @bind="editor.NewItem" @bind:event="oninput"
                                   @onkeydown="args => OnAddKeyDown(args, editor)" />
                            <button class="btn btn-outline-primary" @onclick="() => AddItem(editor)"
                                    disabled="@string.IsNullOrWhiteSpace(editor.NewItem)">
                                @L["MyWishlistsAdd"]
                            </button>
                        </div>

                        <button class="btn btn-primary" @onclick="() => SaveAsync(editor)" disabled="@editor.Busy">
                            @L["MyWishlistsSave"]
                        </button>
                        @if (editor.Saved)
                        {
                            <span class="text-success ms-2" role="status">@L["MyWishlistsSaved"]</span>
                        }
                        else if (editor.SaveError is not null)
                        {
                            <span class="text-danger ms-2" role="alert">@editor.SaveError</span>
                        }
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private sealed class WishlistEditor
    {
        public Guid GroupId { get; init; }
        public string GroupName { get; init; } = string.Empty;
        public List<string> Items { get; init; } = [];
        public string NewItem { get; set; } = string.Empty;
        public bool Busy { get; set; }
        public bool Saved { get; set; }
        public string? SaveError { get; set; }
    }

    private List<WishlistEditor>? _editors;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var memberships = await Linking.GetMyMembershipsAsync();
        var wishlists = await Linking.GetMyWishlistsAsync();

        if (!memberships.IsSuccess)
        {
            _editors = [];
            _error = memberships.Error!.Failure == ApiFailure.Unreachable ? L["MyWishlistsOffline"] : L["MyWishlistsReadFailed"];
            return;
        }

        var existing = wishlists.IsSuccess
            ? wishlists.Value!.Wishlists.ToDictionary(w => w.GroupId, w => w.Items)
            : new Dictionary<Guid, IReadOnlyList<string>>();

        _editors = memberships.Value!.Memberships
            .Select(m => new WishlistEditor
            {
                GroupId = m.GroupId,
                GroupName = m.GroupName,
                Items = existing.TryGetValue(m.GroupId, out var items) ? [.. items] : [],
            })
            .ToList();
    }

    private IEnumerable<WishlistEditor> _copyableFrom(WishlistEditor target) =>
        _editors!.Where(e => e.GroupId != target.GroupId && e.Items.Count > 0);

    private void CopyFrom(WishlistEditor target, WishlistEditor source)
    {
        target.Items.Clear();
        target.Items.AddRange(source.Items);
    }

    private void OnAddKeyDown(KeyboardEventArgs args, WishlistEditor editor)
    {
        if (args.Key == "Enter")
        {
            AddItem(editor);
        }
    }

    private void AddItem(WishlistEditor editor)
    {
        if (!string.IsNullOrWhiteSpace(editor.NewItem))
        {
            editor.Items.Add(editor.NewItem.Trim());
            editor.NewItem = string.Empty;
        }
    }

    private async Task SaveAsync(WishlistEditor editor)
    {
        editor.Busy = true;
        editor.Saved = false;
        editor.SaveError = null;

        var result = await Linking.UpdateMyWishlistAsync(editor.GroupId, new UpdateMyWishlistRequest([.. editor.Items]));
        editor.Busy = false;

        if (result.IsSuccess)
        {
            editor.Saved = true;
        }
        else
        {
            editor.SaveError = result.Error!.Failure == ApiFailure.Unreachable ? L["MyWishlistsOffline"] : L["MyWishlistsSaveFailed"];
        }
    }
}
