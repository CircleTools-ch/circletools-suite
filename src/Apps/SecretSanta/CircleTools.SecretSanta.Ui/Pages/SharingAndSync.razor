@page "/groups/{GroupId:guid}/sharing"
@using CircleTools.SecretSanta.Core.Application
@using CircleTools.SecretSanta.Core.Reveal
@using CircleTools.SecretSanta.LocalStore.Online
@using CircleTools.Ui.Account.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject ISender Sender
@inject IGroupRecordStore Records
@inject OnlineGroupSync Online
@inject RevealLinkOptions RevealOptions
@inject IDialogService Dialogs
@inject IShareService ShareService
@inject IJSRuntime JS
@inject TimeProvider Time
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> L
@inject AutoSyncService AutoSync
@inject GroupRemoval Removal
@inject NavigationManager Navigation

@*
    Where a group lives and who can get in (ADR-0086): on this device or online; for an online group, the join link
    as an on/off setting, and who organizes it — an account, or a management link this device keeps. What a device
    may do here follows the permissions the server reported, never a role name.
*@

<PageTitle>@L["SharingTitle"]</PageTitle>

<GroupBackNav GroupId="GroupId" />

<MudText Typo="Typo.h4" GutterBottom="true">@L["SharingTitle"]</MudText>

@if (!_loaded)
{
    <MudText>@L["Loading"]</MudText>
}
else if (_record is null)
{
    <MudText>@L["GroupNotFound"]</MudText>
}
else if (_record.Document is null)
{
    @* Someone taking part doesn't choose where the group lives or manage its links; they can leave. *@
    <MudAlert Severity="Severity.Info" Class="mb-3" id="participant-sharing">
        @(_record.View?.MemberName is { } name ? L["YouAreMember", name] : L["ParticipantReadOnlyNote"])
    </MudAlert>
    <MudText Class="mud-text-secondary mb-4">@L["ParticipantSharingLead"]</MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout"
               OnClick="LeaveAsync" Disabled="_busy" id="leave-group">@L["LeaveGroup"]</MudButton>
}
else
{
    <MudText Class="mud-text-secondary mb-4">@L["SharingLead"]</MudText>

    <div class="mb-2"><MudText Typo="Typo.overline">@L["StorageModeLabel"]</MudText></div>
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-2" Style="@(_busy || !CanChangePlace ? "opacity:0.6;pointer-events:none" : null)">
        <StorageModePicker Value="_record.Place" ValueChanged="OnPlaceChosenAsync" AccountEnabled="_signedIn" />
    </MudPaper>
    @if (_busy)
    {
        <div class="d-flex align-center gap-2 mb-2" id="mode-busy">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["StorageModeChanging"]</MudText>
        </div>
    }

    @if (_record is { Place: GroupPlace.Online, Access: { } access })
    {
        @if (access.Principal == AccessPrincipal.Account)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" id="account-owned">@L["AccountOwnedNote"]</MudAlert>
        }

        @if (access.Can(OnlinePermissions.ManageLinks))
        {
            <MudCard Elevation="1" Class="mb-3" id="join-link-card">
                <MudCardContent class="pb-2">
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1"><strong>@L["JoinLink"]</strong></MudText>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["JoinLinkHint"]</MudText>
                    <MudSwitch T="bool" Value="@(access.JoinToken is not null)" ValueChanged="SetJoinLinkAsync" Disabled="_busy"
                               Color="Color.Primary" Label="@L["JoinLinkSwitch"]" id="join-link-switch" />
                    @if (access.JoinToken is { } joinToken)
                    {
                        @LinkActions(JoinUrl(joinToken), L["JoinLink"])
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Autorenew" Class="mt-1"
                                   OnClick="RotateJoinLinkAsync" Disabled="_busy" id="rotate-join">@L["RotateJoinLink"]</MudButton>
                    }
                </MudCardContent>
            </MudCard>
        }

        @if (access.Principal == AccessPrincipal.OrganizerLink)
        {
            @* Organized without an account (ADR-0086, decision D1): signed in, offer to keep it in the account. *@
            @if (_signedIn)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" id="keep-in-account">
                    <div class="d-flex flex-wrap align-center gap-2">
                        <span>@L["LinkNotInAccountNote"]</span>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   OnClick="TakeOverAsync" Disabled="_busy">@L["KeepInAccount"]</MudButton>
                    </div>
                </MudAlert>
            }

            @if (access.Secret is { } organizerToken)
            {
                <MudCard Elevation="1" Class="mb-3" id="admin-link-card">
                    <MudCardContent class="pb-2">
                        <div class="d-flex align-center gap-2 mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Error" />
                            <MudText Typo="Typo.subtitle1"><strong>@L["AdminLink"]</strong></MudText>
                        </div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["AdminLinkHint"]</MudText>
                        @LinkActions(AdminUrl(organizerToken), L["AdminLink"])
                        <MudDivider Class="my-2" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Autorenew"
                                   OnClick="RotateOrganizerLinkAsync" Disabled="_busy" id="rotate-admin">@L["DisableRegenerate"]</MudButton>
                    </MudCardContent>
                </MudCard>
            }
        }
        else if (access.Can(OnlinePermissions.ManageRoles))
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyOff"
                       OnClick="HandOverAsync" Disabled="_busy" id="release-to-link">@L["ReleaseToLinkAction"]</MudButton>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">@L["ReleaseToLinkActionHint"]</MudText>
        }
    }
}

@code {
    /// <summary>The group whose sharing is managed.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private bool _loaded;
    private bool _busy;
    private bool _signedIn;
    private Guid _accountId;
    private GroupRecord? _record;
    private string? _copiedUrl;
    private bool _canShare;

    // Leaving a device group needs nothing; making an online group local needs the delete permission.
    private bool CanChangePlace => _record is { Place: GroupPlace.Device }
        || _record?.Access?.Can(OnlinePermissions.DeleteGroup) == true;

    protected override async Task OnParametersSetAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _accountId = state.User.UserId();
        _signedIn = _accountId != Guid.Empty;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _record = (await Records.LoadAsync()).Records.FirstOrDefault(r => r.Id == GroupId);
        _loaded = true;
    }

    private string Base => RevealOptions.BaseUrl.TrimEnd('/');

    private string AdminUrl(string token) => $"{Base}/admin#g={GroupId}&t={token}";

    private string JoinUrl(string token) => $"{Base}/join#t={token}";

    private async Task OnPlaceChosenAsync(GroupPlace place)
    {
        if (_record is null || place == _record.Place || _busy)
        {
            return;
        }

        if (place == GroupPlace.Online)
        {
            var question = _signedIn ? L["MakeOnlineConfirm"] : L["MakeOnlineSignedOutConfirm"];
            if (await Dialogs.ShowConfirmSheetAsync(question, L["MakeOnlineConfirmYes"], L["Cancel"], Color.Primary))
            {
                await RunAsync(async () => (await Online.MakeOnlineAsync(GroupId, _signedIn ? _accountId : null, joinEnabled: false)).IsSuccess);
            }
        }
        else if (await Dialogs.ShowConfirmSheetAsync(L["KeepOnDeviceConfirm"], L["KeepOnDeviceConfirmYes"], L["Cancel"]))
        {
            await RunAsync(async () => (await Online.KeepOnDeviceAsync(GroupId)).IsSuccess);
        }

        await LoadAsync();
    }

    private Task SetJoinLinkAsync(bool enabled) =>
        RunAsync(async () => (await Online.SetJoinLinkAsync(GroupId, enabled)).IsSuccess);

    private async Task RotateJoinLinkAsync()
    {
        if (await Dialogs.ShowConfirmSheetAsync(L["RotateJoinConfirm"], L["RotateJoinConfirmYes"], L["Cancel"], Color.Primary))
        {
            await RunAsync(async () => (await Online.SetJoinLinkAsync(GroupId, enabled: true, rotate: true)).IsSuccess);
        }
    }

    // A group organized by its management link, while signed in: keep it in the account (the link stops working).
    private async Task TakeOverAsync()
    {
        if (await Dialogs.ShowConfirmSheetAsync(L["ClaimAdminConfirm"], L["ClaimAdminConfirmYes"], L["Cancel"], Color.Primary))
        {
            await RunAsync(async () => (await Online.TakeOverAsync(GroupId, _accountId)).IsSuccess);
        }
    }

    // Hand an account-owned group over to a management link, so co-organizers can use it (ADR-0058, Q15).
    private async Task HandOverAsync()
    {
        if (await Dialogs.ShowConfirmSheetAsync(L["ReleaseToLinkConfirm"], L["ReleaseToLinkConfirmYes"], L["Cancel"], Color.Primary))
        {
            await RunAsync(async () => (await Online.HandOverAsync(GroupId)).IsSuccess);
        }
    }

    private async Task RotateOrganizerLinkAsync()
    {
        if (await Dialogs.ShowConfirmSheetAsync(L["RotateAdminConfirm"], L["RotateAdminConfirmYes"], L["Cancel"], Color.Primary))
        {
            await RunAsync(async () =>
            {
                var rotated = await Online.RotateOrganizerLinkAsync(GroupId);
                return rotated.IsSuccess;
            });
        }
    }

    private async Task LeaveAsync()
    {
        if (await Removal.AskAndRemoveAsync(GroupId, _record?.View?.GroupName ?? string.Empty))
        {
            Navigation.NavigateTo(string.Empty);
        }
    }

    // Runs a change with a visible busy state and a success/failure snackbar: an unreachable server is a failed
    // result, not an exception, so a silent revert would look like "nothing happened". Reloads afterwards so the
    // page shows what actually persisted.
    private async Task RunAsync(Func<Task<bool>> action)
    {
        _busy = true;
        StateHasChanged();
        var succeeded = false;
        try
        {
            succeeded = await action();
        }
        catch (Exception)
        {
            succeeded = false;
        }
        finally
        {
            _busy = false;
            await LoadAsync();
            StateHasChanged();
        }

        if (succeeded)
        {
            AutoSync.RequestSync();
        }

        Snackbar.Add(
            succeeded ? L["StorageModeChanged"] : L["StorageModeChangeFailed"],
            succeeded ? Severity.Success : Severity.Error);
    }

    private RenderFragment LinkActions(string url, string label) =>@<div>
        <div class="d-flex flex-wrap gap-2">
            @if (_canShare)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Share" OnClick="() => ShareAsync(url)">@L["Share"]</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="() => CopyAsync(url)">
                @(_copiedUrl == url ? L["Copied"] : L["Copy"])
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.QrCode2" OnClick="() => ShowQrAsync(label, url)">@L["ShowQr"]</MudButton>
        </div>
    </div>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _canShare = await ShareService.IsSupportedAsync();
            if (_canShare)
            {
                StateHasChanged();
            }
        }
    }

    private Task ShowQrAsync(string label, string url) =>
        Dialogs.ShowQrDialogAsync(label, url, L["ShareGroupQrHint"], L["Close"]);

    private async Task ShareAsync(string url)
    {
        await ShareService.ShareAsync(L["ActivityName"], $"{L["ShareGroupMessage"]}\n{url}", url);
    }

    private async Task CopyAsync(string url)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            _copiedUrl = url;
            StateHasChanged();
            if (await CopiedFeedback.ExpireAsync(Time, () => _copiedUrl, url))
            {
                _copiedUrl = null;
            }
        }
        catch (JSException)
        {
            _copiedUrl = null;
        }
    }
}
