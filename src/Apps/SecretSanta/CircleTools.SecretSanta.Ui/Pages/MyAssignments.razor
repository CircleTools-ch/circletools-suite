@page "/my-assignments"
@using System.Globalization
@using CircleTools.ApiClient
@using CircleTools.SecretSanta.Contracts
@using CircleTools.SecretSanta.LocalStore.Linking
@inject ILinkingApi Linking
@inject IStringLocalizer<AppStrings> L
@inject TimeProvider Time
@inject IHapticFeedback Haptics

@*
    See my assignment while signed in (FR-029). The server returns only the caller's own pairing, one
    per group. Each is kept behind the same deliberate reveal step as the reveal page — a shared screen
    should not spoil a gift by accident. The recipient's free-text wishlist is shown untranslated.
*@

<PageTitle>@L["MyAssignmentsTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["MyAssignmentsTitle"]</MudText>
        <MudText Class="mud-text-secondary">@L["MyAssignmentsLead"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@L["MyAssignmentsOperatorPrivacyNote"]</MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" role="status">@_error</MudAlert>
        }

        @if (_assignments is null)
        {
            <MudText>@L["Loading"]</MudText>
        }
        else if (_assignments.Count == 0)
        {
            <MudText Class="mud-text-secondary">@L["MyAssignmentsNone"]</MudText>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var assignment in _assignments)
                {
                    <MudCard Elevation="1">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" GutterBottom="true">@assignment.GroupName — @EventLabel(assignment.EventName)</MudText>

                            @if (assignment.Budget is { } budget)
                            {
                                <MudText Class="mb-1"><strong>@L["RevealBudgetLabel"]:</strong>
                                    @BudgetDisplay.Format(budget.MinAmount, budget.Amount, budget.Currency)</MudText>
                            }
                            @if (assignment.Event is { } ev && HasEvent(ev))
                            {
                                <MudText Class="mb-1">
                                    <strong>@L["RevealEventLabel"]:</strong>
                                    @if (ev.Date is { } date)
                                    {
                                        <span>&nbsp;@date.ToString("d", CultureInfo.CurrentCulture)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ev.Location))
                                    {
                                        @if (ev.Date is not null)
                                        {
                                            <span>,</span>
                                        }
                                        <span>&nbsp;@ev.Location</span>
                                    }
                                </MudText>
                            }

                            @if (_revealed.Contains((assignment.GroupId, assignment.EventId)))
                            {
                                <MudAlert Severity="Severity.Success" Class="mt-2">
                                    <MudText Class="mb-1">@L["RevealRecipientLabel"]:</MudText>
                                    <MudText Typo="Typo.h5" Class="mb-3">@assignment.RecipientName</MudText>
                                    <MudText Class="mb-1"><strong>@L["RevealWishlistLabel"]:</strong></MudText>
                                    @if (assignment.RecipientWishlist.Count == 0)
                                    {
                                        <MudText>@L["RevealNoWishlist"]</MudText>
                                    }
                                    else
                                    {
                                        <ul class="mb-0">
                                            @foreach (var item in assignment.RecipientWishlist)
                                            {
                                                <li>@item</li>
                                            }
                                        </ul>
                                    }
                                </MudAlert>
                            }
                            else
                            {
                                <MudText Class="mud-text-secondary mt-2 mb-2">@L["RevealSpoilerNote"]</MudText>
                                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.CardGiftcard"
                                           OnClick="() => RevealAsync((assignment.GroupId, assignment.EventId))">
                                    @L["RevealButton"]
                                </MudButton>
                            }
                        </MudCardContent>
                    </MudCard>
                }
            </MudStack>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<MyAssignmentResponse>? _assignments;
    private readonly HashSet<(Guid GroupId, Guid EventId)> _revealed = [];
    private string? _error;

    private string EventLabel(string name) => string.IsNullOrWhiteSpace(name) ? L["DefaultEventName"] : name;

    // A small confirmation buzz as the giftee is shown (FEAT-008 W3), matching the reveal page; a no-op
    // on the web head.
    private async Task RevealAsync((Guid GroupId, Guid EventId) key)
    {
        _revealed.Add(key);
        await Haptics.TapAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Linking.GetMyAssignmentsAsync();
        if (result.IsSuccess)
        {
            // Only present and future occasions: a past event's gift has been given, so it drops off
            // the list (an undated or today's event stays).
            _assignments = result.Value!.Assignments.Where(NotPast).ToList();
        }
        else
        {
            _assignments = [];
            _error = result.Error!.Failure == ApiFailure.Unreachable ? L["MyAssignmentsOffline"] : L["MyAssignmentsReadFailed"];
        }
    }

    private static bool HasEvent(EventDetailsDto ev) =>
        ev.Date is not null || !string.IsNullOrWhiteSpace(ev.Location) || !string.IsNullOrWhiteSpace(ev.Description);

    // An undated event has no past to hide; a dated one is kept while its calendar day is today or later.
    private bool NotPast(MyAssignmentResponse a) =>
        a.Event?.Date is not { } date || date.Date >= Time.GetLocalNow().Date;
}
