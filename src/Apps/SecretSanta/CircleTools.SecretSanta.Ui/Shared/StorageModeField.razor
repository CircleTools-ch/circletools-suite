@using CircleTools.SecretSanta.LocalStore.Online
@inject IStringLocalizer<AppStrings> L

@*
    The place affordance for group creation (ADR-0086, ADR-0071 amendment). Compact: it shows WHERE the group
    will be kept — the same icon the list uses — with a "Change" menu to override it for this one group. The first
    time a device creates a group it is Expanded instead: both options with their one-line explanation, so the
    choice is explained where it is made.
*@

@if (Expanded)
{
    <MudText Typo="Typo.body2" Class="mb-1"><strong>@L["StorageWhereTitle"]</strong></MudText>
    <MudRadioGroup T="GroupPlace" Value="Value" ValueChanged="SetAsync" Class="ct-mode-picker" id="storage-expanded">
        @foreach (var place in StorageModeDisplay.Choices)
        {
            <MudRadio T="GroupPlace" Value="@place" Color="Color.Primary" Dense="true">
                <div class="ct-mode-opt">
                    <span class="ct-mode-title">@L[StorageModeDisplay.LabelKey(place)]</span>
                    <span class="ct-mode-hint">@L[StorageModeDisplay.HintKey(place, AccountEnabled)]</span>
                </div>
            </MudRadio>
        }
    </MudRadioGroup>
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@L["OnboardingStoragePerGroupNote"]</MudText>
}
else
{
    <div class="d-flex align-center flex-wrap gap-1">
        <MudIcon Icon="@StorageModeDisplay.Icon(Value)" Size="Size.Small" Class="mud-text-secondary" aria-hidden="true" />
        <MudText Typo="Typo.body2">@LabelText.WithColon(L["StorageStoredAs"]) <strong>@L[StorageModeDisplay.LabelKey(Value)]</strong></MudText>
        @* Each option says what it means in one line (as Settings does) and the current one is checked
           (UX review U3). The menu opens upward, so the dialog's Create button stays visible below it. *@
        <MudMenu Label="@L["StorageChange"]" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                 EndIcon="@Icons.Material.Filled.ArrowDropDown"
                 AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
            @foreach (var place in StorageModeDisplay.Choices)
            {
                <MudMenuItem OnClick="@(() => SetAsync(place))"
                             aria-checked="@(place == Value ? "true" : "false")" role="menuitemradio">
                    <div class="d-flex align-start gap-3" style="max-width:20rem; white-space:normal;">
                        <MudIcon Icon="@StorageModeDisplay.Icon(place)" Size="Size.Small" Class="mt-1" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body1">@L[StorageModeDisplay.LabelKey(place)]</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L[StorageModeDisplay.HintKey(place, AccountEnabled)]</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                                 Class="mt-1" Style="@(place == Value ? null : "visibility:hidden;")" aria-hidden="true" />
                    </div>
                </MudMenuItem>
            }
        </MudMenu>
    </div>
}

@code {
    /// <summary>The selected place.</summary>
    [Parameter] public GroupPlace Value { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter] public EventCallback<GroupPlace> ValueChanged { get; set; }

    /// <summary>Whether someone is signed in (it changes what "online" means).</summary>
    [Parameter] public bool AccountEnabled { get; set; } = true;

    /// <summary>Show both options with their explanation (the first group a device creates).</summary>
    [Parameter] public bool Expanded { get; set; }

    private Task SetAsync(GroupPlace place) => ValueChanged.InvokeAsync(place);
}
