@using CircleTools.SecretSanta.LocalStore
@inject IStringLocalizer<AppStrings> L

@*
    Compact storage-mode affordance for group creation (ADR-0073). Instead of an always-open radio picker,
    it shows HOW the group will be stored — the same icon the list uses — with a "Change" menu to override
    the mode for this one group. The default (onboarding/Settings) is the source of truth; this just shows
    it. "My account" is disabled while signed out (no account to sync to). Used by the inline wide-screen
    create and by the phone "New group" sheet.
*@

<div class="d-flex align-center flex-wrap gap-1">
    <MudIcon Icon="@StorageModeDisplay.Icon(Value)" Size="Size.Small" Class="mud-text-secondary" aria-hidden="true" />
    <MudText Typo="Typo.body2">@L["StorageStoredAs"]: <strong>@L[StorageModeDisplay.LabelKey(Value)]</strong></MudText>
    @* Each option says what it means in one line (as Settings does) and the current one is checked
       (UX review U3). The menu opens upward, so the dialog's Create button stays visible below it. *@
    <MudMenu Label="@L["StorageChange"]" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
             EndIcon="@Icons.Material.Filled.ArrowDropDown"
             AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft">
        @foreach (var mode in Modes)
        {
            var enabled = mode != StorageMode.Account || AccountEnabled;
            <MudMenuItem Disabled="@(!enabled)" OnClick="@(() => SetAsync(mode))"
                         aria-checked="@(mode == Value ? "true" : "false")" role="menuitemradio">
                <div class="d-flex align-start gap-3" style="max-width:20rem; white-space:normal;">
                    <MudIcon Icon="@StorageModeDisplay.Icon(mode)" Size="Size.Small" Class="mt-1" />
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1">@L[StorageModeDisplay.LabelKey(mode)]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Hint(mode, enabled)</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                             Class="mt-1" Style="@(mode == Value ? null : "visibility:hidden;")" aria-hidden="true" />
                </div>
            </MudMenuItem>
        }
    </MudMenu>
</div>

@code {
    /// <summary>The selected storage mode.</summary>
    [Parameter] public StorageMode Value { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter] public EventCallback<StorageMode> ValueChanged { get; set; }

    /// <summary>Whether "My account" is selectable (a session is live).</summary>
    [Parameter] public bool AccountEnabled { get; set; } = true;

    private static readonly StorageMode[] Modes = [StorageMode.OnThisDevice, StorageMode.SharedByLink, StorageMode.Account];

    private string Hint(StorageMode mode, bool enabled) => mode switch
    {
        StorageMode.SharedByLink => L["ModeSharedHint"],
        StorageMode.Account => enabled ? L["ModeAccountHint"] : L["ModeAccountSignInHint"],
        _ => L["ModeLocalHint"],
    };

    private Task SetAsync(StorageMode mode) => ValueChanged.InvokeAsync(mode);
}
