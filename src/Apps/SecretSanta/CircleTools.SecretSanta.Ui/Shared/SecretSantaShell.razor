@using CircleTools.SecretSanta.LocalStore.Linking
@inject IStringLocalizer<AppStrings> L
@inject ThemeState Theme
@inject AppBranding Branding
@inject ISender Sender
@inject BookmarkService Bookmarks
@inject AutoSyncService AutoSync
@inject ReminderScheduler Reminders
@inject ILinkingApi Linking
@inject RecentAccessService Recent
@inject VisibleGroupsService VisibleGroups
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ForegroundSyncTrigger ForegroundSync
@implements IDisposable

@*
    The Secret-Santa app shell (ADR-0040): a MudBlazor layout shared by both heads (WebApp + MAUI).
    Wide screens get a persistent drawer; narrow screens get a bottom navigation bar with a "More"
    entry that opens the drawer. The MudThemeProvider is driven by ThemeState (the System/Light/Dark
    switch), persisted via IKeyValueStore.
*@

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="Theme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Offers a "Reload" snackbar when a new version has been deployed (ADR-0048). Renders nothing. *@
<UpdatePrompt />

@* Owns the sign-in reconciliation of offline data and the account-scoped visibility switch (ADR-0044).
   Renders nothing; mounted once for the whole app so it catches every sign-in. *@
<SignInReconciler />
<SessionNoticeHost />

<MudLayout>
    <MudAppBar Elevation="1">
        @* Menu button — always shown (ADR-0070 amendment, 2026-10-02). The top-left hamburger is the
           universal, discoverable entry to the drawer (Groups, quick-access, pinned, Settings). Even in
           the native app where the bottom bar is present, "More" at the bottom-right does not read as the
           menu — especially on iPad — so the hamburger stays. The bottom bar's "More" still opens the same
           drawer; two entry points is the lesser evil over a hidden menu. (FEAT-008 W2, ADR-0054, ADR-0070) *@
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="menu" />
        @if (!string.IsNullOrEmpty(Branding.LogoUrl))
        {
            <img src="@Branding.LogoUrl" alt="" class="ct-appbar-logo ml-2" />
        }
        <MudText Typo="Typo.h6" Class="ml-2">@L["AppName"]</MudText>
        <MudSpacer />
        @* Keep the app bar to the essentials (title + account). The theme switch moved into the Settings
           screen (MCN-3) — a native-mobile placement, and it declutters the bar on web too. The cross-app
           switcher is web-only and rarely used (it self-hides on the device heads anyway), so drop it on
           narrow viewports to stop the trailing controls crowding the title. *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <AppSwitcher />
        </MudHidden>
        <AccountMenu />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="1">
      <div class="ct-drawer">
        <MudNavMenu Class="ct-drawer-main">
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Groups">@L["NavGroups"]</MudNavLink>

            @* Quick access (R2-5): the most recently opened groups, each expanding to its most recent
               occasions, so the common destinations are one tap away — especially on mobile. Recency is
               device-local; the current group's submenu is expanded. *@
            @foreach (var g in _quickAccess)
            {
                <MudNavGroup Title="@g.Name" Icon="@Icons.Material.Filled.Groups" Expanded="@(g.Id == _currentGroupId)">
                    @foreach (var occasion in g.Events)
                    {
                        <MudNavLink Href="@($"groups/{g.Id}/events/{occasion.Id}")" Icon="@Icons.Material.Filled.Event">@EventLabel(occasion.Name)</MudNavLink>
                    }
                    <MudNavLink Href="@($"groups/{g.Id}")" Icon="@Icons.Material.Filled.MoreHoriz">@L["NavMoreEllipsis"]</MudNavLink>
                </MudNavGroup>
            }
            @* No separate "All groups" entry: it pointed at the same route as "Groups" above, so both were
               highlighted at once (UX review P1). "Groups" is the way to the full list. *@

            <AuthorizeView>
                <Authorized>
                    @* Pinned groups for quick access (FR-033): a per-account preference, shown right under
                       Groups. Only groups still held on this device are listed. *@
                    @if (_pinned.Count > 0)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Class="px-4 mud-text-secondary">@L["NavPinned"]</MudText>
                        @foreach (var pin in _pinned)
                        {
                            <MudNavLink Href="@($"groups/{pin.Id}")" Icon="@Icons.Material.Filled.Star">@pin.Name</MudNavLink>
                        }
                    }

                    @* Personal destinations, shown only when they are not dead ends (UX-005): the
                       link inbox when a request is actually waiting, and the assignment/wishlist
                       screens only for a linked member (server-authoritative, so it also covers a
                       member of someone else's group whose group document never syncs here). *@
                    @if (_hasPendingLinks || _isLinkedMember)
                    {
                        <MudDivider Class="my-2" />
                        @if (_hasPendingLinks)
                        {
                            <MudNavLink Href="my-links" Icon="@Icons.Material.Filled.Link">@L["NavMyLinks"]</MudNavLink>
                        }
                        @if (_isLinkedMember)
                        {
                            <MudNavLink Href="my-assignments" Icon="@Icons.Material.Filled.AssignmentInd">@L["NavMyAssignments"]</MudNavLink>
                            <MudNavLink Href="my-wishlists" Icon="@Icons.Material.Filled.CardGiftcard">@L["NavMyWishlists"]</MudNavLink>
                        }
                    }

                    @* Passive sync status. Sign-in/out and the account itself live in the top-bar
                       account menu now; the background sync (ADR-0044) surfaces its last outcome here. *@
                    @if (_syncStatus is not null)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption" Class="px-4 mud-text-secondary"
                                 role="@(_syncStatus == SyncStatus.StorageUnavailable ? "alert" : "status")">
                            @SyncStatusText
                        </MudText>
                    }
                </Authorized>
            </AuthorizeView>
        </MudNavMenu>

        @* Settings gathers appearance (theme), language and the build version into one screen (MCN-3).
           It is pinned to the very bottom of the drawer (the space above stays empty when there are few
           groups/events), so it reads as an app-level control, not another list item. *@
        <MudNavMenu Class="ct-drawer-bottom">
            <MudDivider Class="mb-1" />
            <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">@L["SettingsTitle"]</MudNavLink>
        </MudNavMenu>
      </div>
    </MudDrawer>

    <MudMainContent>
        @* A pending account can sign in (RequireConfirmedEmail=false, ADR-0009) but its address is not yet
           proven, so account actions like member-linking silently do nothing. Surface that here — the same
           banner the Main app shows — so the state is visible with a one-tap resend, not a silent trap. *@
        <VerificationBanner />
        @* Reserve bottom-bar clearance only where the bar exists — the native heads (ADR-0070). The
           ct-has-bottomnav padding is itself scoped to narrow width, so it is a no-op on wide (iPad
           landscape); on the web there is no bottom bar, so no clearance is reserved. *@
        @* ct-page grows to fill the viewport so the legal footer rests at the bottom of a short page instead
           of floating mid-screen (UX review P3). *@
        <MudContainer MaxWidth="MaxWidth.Medium" Class="@($"py-4 ct-main ct-main-fill{(_bottomNavEnabled ? " ct-has-bottomnav" : "")}")">
            <div class="ct-page">
                @ChildContent
            </div>
            <LegalFooter />
        </MudContainer>
    </MudMainContent>
</MudLayout>

@* Pull-to-refresh (FEAT-008 W3): a top-of-page pull triggers the same silent background sync the other
   triggers do (ADR-0044). Renders only a fixed spinner overlay; the gesture is touch-only, so it is inert
   on desktop. Mounted once for the whole app. *@
<PullToRefresh OnRefresh="OnPullToRefreshAsync" />

@* Bottom navigation — the native app's primary navigation on narrow viewports (phone, iPad portrait),
   signed in or out (ADR-0070), so it has one consistent, one-handed layout whatever the account state.
   Disabled on the web, where a fixed bottom bar collides with the browser's own bottom chrome (the drawer
   + hamburger lead there); and hidden on wide native viewports (iPad landscape uses the persistent
   drawer). It always carries Groups (leftmost) + "More" (rightmost, opens the drawer); a signed-in linked
   member also gets their personal tabs in between. Two evenly-spaced tabs (Groups + More) read fine —
   flex:1 gives each half the width. (FEAT-008 W2, ADR-0054) *@
@if (_bottomNavEnabled)
{
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <BottomNav Items="_bottomNav" OnMore="ToggleDrawer"
                   MoreIcon="@Icons.Material.Filled.Menu" MoreLabel="@L["NavMore"]" />
    </MudHidden>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Drives the bottom bar: signed-in visitors also get their personal screens as tabs; signed out,
    // Groups (the one always-available destination) + More.
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private MudThemeProvider _themeProvider = default!;
    private MudTheme _theme = CircleToolsTheme.Instance;
    private bool _drawerOpen = true;
    private SyncStatus? _syncStatus;

    // The bottom bar is the native app's primary navigation on narrow viewports (phone, iPad portrait),
    // signed in or out (ADR-0070): Groups + "More" at minimum, plus the linked member's personal tabs. It
    // is disabled on the web — a fixed bottom bar collides with the browser's own bottom chrome (URL bar,
    // toolbar, gesture area) — where the drawer + hamburger lead instead. On a wide native viewport (iPad
    // landscape) the <MudHidden MdAndUp> keeps it to narrow, so landscape uses the persistent drawer. This
    // flag also drives the app-bar hamburger and the content's bottom-bar clearance padding.
    private readonly bool _bottomNavEnabled = !OperatingSystem.IsBrowser();

    private IReadOnlyList<NavItem> _bottomNav = [];

    private IReadOnlyList<(Guid Id, string Name)> _pinned = [];

    // Whether the signed-in account is a linked member somewhere (owns a wishlist / has assignments)
    // and whether a member-link request is waiting. Both drive whether the personal nav destinations
    // are shown at all (UX-005). Server-authoritative, recomputed when the account changes and after
    // each sync; false when signed out or unreachable (the destinations then stay hidden until sync).
    private Guid _accountId;
    private bool _accountKnown;
    private bool _isLinkedMember;
    private bool _hasPendingLinks;

    // Quick access (R2-5): the most recently opened, still-visible groups, each with its most recent
    // occasions. Device-local recency; recomputed on navigation, sign-in change and sync.
    private const int MaxQuickGroups = 3;
    private const int MaxQuickEvents = 2;
    private IReadOnlyList<QuickGroup> _quickAccess = [];
    private Guid _currentGroupId;

    private sealed record QuickGroup(Guid Id, string Name, IReadOnlyList<(Guid Id, string Name)> Events);

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        // Surface the outcome of each silent background sync (ADR-0044) in the drawer's status line;
        // there is no manual "Sync now" button any more (the account menu owns sign-in/out).
        AutoSync.SyncCompleted += OnSyncCompleted;
        // Re-read the quick-access shortcuts whenever local data changes (e.g. a group deleted while
        // signed out) — SyncCompleted only fires for a signed-in cycle, so it would miss that (ADR-0044).
        AutoSync.LocalChanged += OnLocalChanged;
        // Tell the user once when a group moved out of the account elsewhere was kept here because of
        // unsynced edits (ADR-0073 Amendment 2).
        AutoSync.KeptAsLocalCopy += OnKeptAsLocalCopy;
        // Re-read the quick-access shortcuts as the user navigates (opening a group/event changes recency).
        Navigation.LocationChanged += OnLocationChanged;
        _currentGroupId = CurrentGroupId();
        // The per-app app-bar colour lives in a theme built once from the injected branding (ADR-0040
        // amendment); every other surface stays the neutral suite palette.
        _theme = CircleToolsTheme.ForApp(Branding);
    }

    // The cascading auth state re-runs this on every sign-in and sign-out. Recompute the account-scoped
    // view (personal-nav gates, pinned groups, bottom bar) only when the account actually changed.
    protected override async Task OnParametersSetAsync()
    {
        var accountId = AuthState is null ? Guid.Empty : (await AuthState).User.UserId();
        var changed = !_accountKnown || accountId != _accountId;
        _accountId = accountId;
        _accountKnown = true;

        if (changed)
        {
            await RefreshAccountViewAsync();
        }
    }

    // Recompute everything the drawer and bottom bar show for the current account. The two personal-nav
    // gates are server-authoritative (a linked member of someone else's group has no local group to read
    // from); an unreachable server leaves them hidden until the next sync re-runs this.
    private async Task RefreshAccountViewAsync()
    {
        var signedIn = _accountId != Guid.Empty;

        _isLinkedMember = signedIn && await HasMembershipAsync();
        _hasPendingLinks = signedIn && await HasPendingLinksAsync();
        _pinned = signedIn ? await LoadPinnedAsync() : [];
        BuildBottomNav(signedIn);
    }

    private async Task<bool> HasMembershipAsync()
    {
        var result = await Linking.GetMyMembershipsAsync();
        return result.IsSuccess && result.Value!.Memberships.Count > 0;
    }

    private async Task<bool> HasPendingLinksAsync()
    {
        var result = await Linking.GetPendingAsync();
        return result.IsSuccess && result.Value!.Count > 0;
    }

    // Bottom bar (narrow viewports): Groups is always there; the linked-member's personal tabs appear
    // only when they would (UX-005), matching the drawer.
    private void BuildBottomNav(bool signedIn)
    {
        var items = new List<NavItem> { new("", L["NavGroups"], Icons.Material.Filled.Groups, Exact: true) };
        if (signedIn && _isLinkedMember)
        {
            items.Add(new NavItem("my-wishlists", L["NavMyWishlists"], Icons.Material.Filled.CardGiftcard));
            items.Add(new NavItem("my-assignments", L["NavMyAssignments"], Icons.Material.Filled.AssignmentInd));
        }

        _bottomNav = items;
    }

    // Resolve the account's pinned group ids to (id, name) for the quick-access nav (FR-033). Only groups
    // still held on this device are shown; a storage failure or an id with no matching group is dropped.
    private async Task<IReadOnlyList<(Guid Id, string Name)>> LoadPinnedAsync()
    {
        try
        {
            var ids = await Bookmarks.GetPinnedAsync();
            if (ids.Count == 0)
            {
                return [];
            }

            var groups = await Sender.Send(new GetGroupsQuery());
            var names = groups.ToDictionary(g => g.Id, g => g.Name);
            return ids.Where(names.ContainsKey).Select(id => (id, names[id])).ToList();
        }
        catch (StorageUnavailableException)
        {
            return [];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var systemIsDark = await _themeProvider.GetSystemDarkModeAsync();
            await Theme.InitializeAsync(systemIsDark);
            await _themeProvider.WatchSystemDarkModeAsync(OnSystemPreferenceChanged);

            // Start the connectivity watch and, if a session was restored at startup, run the silent
            // app-start sync (ADR-0044). Best-effort: a failure here must not break the first paint.
            await AutoSync.InitializeAsync();
            await ForegroundSync.InitializeAsync();

            // Reconcile device-local reminders (MNF-8) on start and on every later local change. A no-op on
            // the web head (unsupported) and best-effort, so it never affects the first paint.
            await Reminders.InitializeAsync();

            await RefreshQuickAccessAsync();
            StateHasChanged();
        }
    }

    // Rebuilds the quick-access shortcuts: the recently opened (and still visible) groups, newest first,
    // each with its most recent occasions (dated newest-first, then undated by last-opened). Best-effort —
    // a storage or read failure just leaves the section empty; it never blocks navigation.
    private async Task RefreshQuickAccessAsync()
    {
        try
        {
            var visible = await VisibleGroups.GetVisibleAsync();
            if (visible.Count == 0)
            {
                _quickAccess = [];
                return;
            }

            var names = visible.ToDictionary(g => g.Id, g => g.Name);
            var recentGroupIds = await Recent.GetRecentGroupsAsync();

            // Recently opened (still visible) first, then any remaining visible groups newest-first
            // (GuidV7 ids are time-ordered), de-duplicated.
            var ordered = recentGroupIds.Where(names.ContainsKey)
                .Concat(visible.Select(g => g.Id).OrderByDescending(id => id))
                .Distinct()
                .ToList();

            var shown = ordered.Take(MaxQuickGroups).ToList();

            var recentEventIds = await Recent.GetRecentEventsAsync();
            var eventRank = new Dictionary<Guid, int>();
            for (var i = 0; i < recentEventIds.Count; i++)
            {
                eventRank[recentEventIds[i]] = i;
            }

            var result = new List<QuickGroup>();
            foreach (var gid in shown)
            {
                var full = await Sender.Send(new GetGroupQuery(gid));
                if (full is null)
                {
                    continue;
                }

                var events = full.Events
                    .OrderByDescending(e => e.Date.HasValue)
                    .ThenByDescending(e => e.Date ?? DateTimeOffset.MinValue)
                    .ThenBy(e => eventRank.TryGetValue(e.Id, out var r) ? r : int.MaxValue)
                    .Take(MaxQuickEvents)
                    .Select(e => (e.Id, e.Name))
                    .ToList();

                result.Add(new QuickGroup(gid, names[gid], events));
            }

            _quickAccess = result;
        }
        catch (StorageUnavailableException)
        {
            _quickAccess = [];
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        _currentGroupId = CurrentGroupId();
        await RefreshQuickAccessAsync();
        StateHasChanged();
    });

    // A local mutation (create/delete/rename, signed in or out) may have changed which groups/events
    // exist; re-read the quick-access so a deleted group leaves the drawer at once.
    private void OnLocalChanged() => _ = InvokeAsync(async () =>
    {
        await RefreshQuickAccessAsync();
        StateHasChanged();
    });

    private Guid CurrentGroupId()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var match = System.Text.RegularExpressions.Regex.Match(path, "^groups/([0-9a-fA-F-]{36})");
        return match.Success && Guid.TryParse(match.Groups[1].Value, out var id) ? id : Guid.Empty;
    }

    private string EventLabel(string name) => string.IsNullOrWhiteSpace(name) ? L["DefaultEventName"] : name;

    private Task OnSystemPreferenceChanged(bool isDark)
    {
        Theme.SystemPreferenceChanged(isDark);
        return InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // Pull-to-refresh (FEAT-008 W3): fire the same debounced background sync the other triggers use.
    // Signed out it resolves to a no-op at fire time (ADR-0044); the pulled-list data, if any, arrives
    // through the ordinary SyncCompleted re-render. Best-effort, never blocks.
    private Task OnPullToRefreshAsync()
    {
        AutoSync.RequestSync();
        return Task.CompletedTask;
    }

    // The background sync raises this on its task continuation, off the render context; marshal on before
    // reading the last outcome and repainting the status line.
    private void OnSyncCompleted() => _ = InvokeAsync(async () =>
    {
        _syncStatus = AutoSync.LastStatus;
        // A cycle may have produced a new membership or pulled in a link request; re-evaluate the
        // personal-nav gates so they appear (or clear) without a manual reload.
        if (_accountId != Guid.Empty)
        {
            await RefreshAccountViewAsync();
        }

        // A cycle may also have pulled in new groups/events; refresh the quick-access shortcuts too.
        await RefreshQuickAccessAsync();

        StateHasChanged();
    });

    // Every outcome is phrased as a fact. Only a storage failure reads as an alert (TP-004).
    private string SyncStatusText => _syncStatus switch
    {
        SyncStatus.Synced => L["SyncStatusSynced"],
        SyncStatus.Offline => L["SyncStatusOffline"],
        SyncStatus.StorageUnavailable => L["SyncStatusStorageUnavailable"],
        _ => L["SyncStatusFailed"],
    };

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        AutoSync.SyncCompleted -= OnSyncCompleted;
        AutoSync.LocalChanged -= OnLocalChanged;
        AutoSync.KeptAsLocalCopy -= OnKeptAsLocalCopy;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private void OnKeptAsLocalCopy(IReadOnlyList<string> names) => _ = InvokeAsync(() =>
    {
        foreach (var name in names)
        {
            Snackbar.Add(L["KeptAsLocalCopySingular", name], Severity.Info);
        }
    });
}
