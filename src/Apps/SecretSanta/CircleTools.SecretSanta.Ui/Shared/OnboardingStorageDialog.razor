@using CircleTools.SecretSanta.LocalStore
@inject IStringLocalizer<AppStrings> L

@*
    One-time storage onboarding (FR-048, ADR-0071): explains the three storage modes and lets the user
    set the default for new groups, noting it is changeable per group. Reuses StorageModePicker. Unlike
    the create/Settings pickers, "My account" is SELECTABLE here even when signed out — picking it on
    Save takes the user to sign in / register (the caller handles the navigation). Shown once by the
    groups screen; resolve with OnboardingStorageDialogExtensions.ShowStorageOnboardingAsync — Save
    returns the chosen mode, "Not now" cancels (keep the current default).
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["OnboardingStorageTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["OnboardingStorageIntro"]</MudText>
        @* Account is always enabled in onboarding so it can be chosen up front; if the user is signed out,
           the note below says they'll be asked to sign in, and the caller routes them there on Save. *@
        <StorageModePicker Value="_mode" ValueChanged="@(m => _mode = m)" AccountEnabled="true" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-3">@L["OnboardingStoragePerGroupNote"]</MudText>
        @if (!SignedIn && _mode == StorageMode.Account)
        {
            <MudText Typo="Typo.caption" Color="Color.Primary" Class="d-block mt-1">@L["OnboardingStorageAccountNote"]</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Skip">@L["OnboardingStorageSkip"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@L["OnboardingStorageSave"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The initially selected mode (the current default).</summary>
    [Parameter] public StorageMode Value { get; set; }

    /// <summary>Whether a session is live. When false and "My account" is chosen, the caller routes the
    /// user to sign in / register on Save.</summary>
    [Parameter] public bool SignedIn { get; set; }

    private StorageMode _mode;

    protected override void OnInitialized() => _mode = Value;

    // Save returns the chosen mode; "Not now" cancels (keep the existing default). Either way the caller
    // marks onboarding as shown, so it never reappears.
    private void Save() => Dialog.Close(DialogResult.Ok(_mode));

    private void Skip() => Dialog.Cancel();
}
