@inject IStringLocalizer<AppStrings> L
@inject NavigationManager Navigation
@inject ISender Sender
@inject RecentAccessService Recent

@* Event-level sub-navigation within a group (ADR-0042): a back link to the group's events list plus the
   event's name, then a Material tab strip for the event's sections (details, wishlists, draw, share).
   Mirrors GroupNav; the tabs carry no panel content — each section is its own route rendered below. *@
<div class="d-flex align-center flex-wrap gap-2 mb-2">
    <MudButton Href="@($"groups/{GroupId}")" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Variant="Variant.Text">
        @(string.IsNullOrEmpty(_groupName) ? L["AllGroups"] : _groupName)
    </MudButton>
    <MudText Typo="Typo.h6">@EventLabel</MudText>
</div>

<div class="ct-group-tabs mb-4">
    <MudTabs Rounded="true" MinimumTabWidth="0" ActivePanelIndex="_activeIndex"
             ActivePanelIndexChanged="OnTabChanged" ScrollIconColor="Color.Primary">
        @foreach (var tab in Tabs)
        {
            <MudTabPanel Text="@tab.Label" />
        }
    </MudTabs>
</div>

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    /// <summary>The event the sub-navigation is scoped to.</summary>
    [Parameter]
    public Guid EventId { get; set; }

    private string? _groupName;
    private string _eventName = string.Empty;
    private int _activeIndex;

    private sealed record Tab(string Href, string Label, bool Exact = false);

    private IReadOnlyList<Tab> Tabs =>
    [
        new($"groups/{GroupId}/events/{EventId}", L["NavEventDetails"], Exact: true),
        new($"groups/{GroupId}/events/{EventId}/wishlists", L["NavWishlists"]),
        new($"groups/{GroupId}/events/{EventId}/draw", L["NavDraw"]),
        new($"groups/{GroupId}/events/{EventId}/share", L["NavShare"]),
    ];

    private string EventLabel => string.IsNullOrWhiteSpace(_eventName) ? L["DefaultEventName"] : _eventName;

    protected override async Task OnParametersSetAsync()
    {
        _activeIndex = ActiveIndexFromRoute();

        // Opening any of an event's pages counts as opening both the event and its group: record recency
        // for the nav quick access (the event id orders undated occasions; the group id keeps the group near the top).
        await Recent.RecordEventAsync(EventId);
        await Recent.RecordGroupAsync(GroupId);

        // The group and event names are a nicety in the header; a read failure just leaves them at their
        // fallbacks and the tabs still work, so it is not worth surfacing an error.
        var group = await Sender.Send(new GetGroupQuery(GroupId));
        _groupName = group?.Name;
        _eventName = group?.Events.FirstOrDefault(e => e.Id == EventId)?.Name ?? string.Empty;
    }

    // The tabs overlap by prefix, so the exact details entry is checked first and the rest by prefix.
    private int ActiveIndexFromRoute()
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        for (var i = 0; i < Tabs.Count; i++)
        {
            var target = Tabs[i].Href.TrimEnd('/');
            var match = Tabs[i].Exact
                ? string.Equals(current, target, StringComparison.OrdinalIgnoreCase)
                : current.StartsWith(target, StringComparison.OrdinalIgnoreCase);
            if (match)
            {
                return i;
            }
        }

        return 0;
    }

    private void OnTabChanged(int index)
    {
        if (index == _activeIndex)
        {
            return;
        }

        _activeIndex = index;
        Navigation.NavigateTo(Tabs[index].Href);
    }
}
