@using CircleTools.SecretSanta.LocalStore
@inject IStringLocalizer<AppStrings> L

@*
    The three-way storage-mode chooser (ADR-0058, FR-038): On this device (default) / Shared by link /
    My account, each with a one-line explanation. Used at group creation and in Sharing & sync. "My
    account" is disabled while signed out — there is no account to sync to.
*@

<MudRadioGroup T="StorageMode" Value="Value" ValueChanged="OnChangedAsync" Class="ct-mode-picker">
    <MudRadio T="StorageMode" Value="@StorageMode.OnThisDevice" Color="Color.Primary" Dense="true" id="mode-local">
        <div class="ct-mode-opt">
            <span class="ct-mode-title">@L["ModeLocalTitle"]</span>
            <span class="ct-mode-hint">@L["ModeLocalHint"]</span>
            @* On the web head "this device" is browser storage, which can be cleared (FEAT-017). Say so
               where the user chooses it; the installed app stores natively, so the caveat is web-only. *@
            @if (OperatingSystem.IsBrowser())
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">@L["ModeLocalWebWarning"]</MudText>
            }
        </div>
    </MudRadio>
    <MudRadio T="StorageMode" Value="@StorageMode.SharedByLink" Color="Color.Primary" Dense="true" id="mode-shared">
        <div class="ct-mode-opt">
            <span class="ct-mode-title">@L["ModeSharedTitle"]</span>
            <span class="ct-mode-hint">@L["ModeSharedHint"]</span>
        </div>
    </MudRadio>
    <MudRadio T="StorageMode" Value="@StorageMode.Account" Color="Color.Primary" Dense="true" Disabled="@(!AccountEnabled)" id="mode-account">
        <div class="ct-mode-opt">
            <span class="ct-mode-title">@L["ModeAccountTitle"]</span>
            <span class="ct-mode-hint">@(AccountEnabled ? L["ModeAccountHint"] : L["ModeAccountSignInHint"])</span>
        </div>
    </MudRadio>
</MudRadioGroup>

@code {
    /// <summary>The selected storage mode.</summary>
    [Parameter]
    public StorageMode Value { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter]
    public EventCallback<StorageMode> ValueChanged { get; set; }

    /// <summary>Whether the "My account" option is selectable (i.e. a session is live).</summary>
    [Parameter]
    public bool AccountEnabled { get; set; } = true;

    private Task OnChangedAsync(StorageMode mode) => ValueChanged.InvokeAsync(mode);
}
