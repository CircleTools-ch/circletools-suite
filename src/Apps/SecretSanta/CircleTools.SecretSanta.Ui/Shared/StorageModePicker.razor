@using CircleTools.SecretSanta.LocalStore.Online
@inject IStringLocalizer<AppStrings> L

@*
    The place chooser (ADR-0086, FR-038): on this device, or online — each with a one-line explanation. Online
    means "in your account" while signed in and "organized by a link this device keeps" while signed out, so both
    choices are always available. Used in Settings for the default place of new groups.
*@

<MudRadioGroup T="GroupPlace" Value="Value" ValueChanged="OnChangedAsync" Class="ct-mode-picker">
    @foreach (var place in StorageModeDisplay.Choices)
    {
        <MudRadio T="GroupPlace" Value="@place" Color="Color.Primary" Dense="true" id="@Id(place)">
            <div class="ct-mode-opt">
                <span class="ct-mode-title">@L[StorageModeDisplay.LabelKey(place)]</span>
                <span class="ct-mode-hint">@L[StorageModeDisplay.HintKey(place, AccountEnabled)]</span>
                @* On the web head "this device" is browser storage, which can be cleared (FEAT-017). Say so
                   where the user chooses it; the installed app stores natively, so the caveat is web-only. *@
                @if (place == GroupPlace.Device && OperatingSystem.IsBrowser())
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mt-1">@L["ModeLocalWebWarning"]</MudText>
                }
            </div>
        </MudRadio>
    }
</MudRadioGroup>

@code {
    /// <summary>The selected place.</summary>
    [Parameter]
    public GroupPlace Value { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter]
    public EventCallback<GroupPlace> ValueChanged { get; set; }

    /// <summary>Whether someone is signed in (it changes what "online" means).</summary>
    [Parameter]
    public bool AccountEnabled { get; set; } = true;

    private static string Id(GroupPlace place) => place == GroupPlace.Online ? "mode-online" : "mode-local";

    private Task OnChangedAsync(GroupPlace place) => ValueChanged.InvokeAsync(place);
}
