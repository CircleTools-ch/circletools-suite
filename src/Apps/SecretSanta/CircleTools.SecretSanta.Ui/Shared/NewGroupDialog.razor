@using CircleTools.SecretSanta.LocalStore.Online
@inject IStringLocalizer<AppStrings> L

@*
    The phone "+" create flow (ADR-0073, ADR-0086): a small sheet that collects the group name AND shows where it
    will be kept (StorageModeField), so the place is visible and changeable right where the group is named. Resolve with
    NewGroupDialogExtensions.ShowNewGroupDialogAsync.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["CreateGroup"]</MudText>
    </TitleContent>
    <DialogContent>
        @if (FromTemplate)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["TemplateExplainer"]</MudText>
        }
        <MudTextField @ref="_field" @bind-Value="_name" Immediate="true" OnKeyDown="OnKeyDown" AutoFocus="true"
                      Label="@L["NewGroupPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <div class="mt-3">
            <StorageModeField Value="_place" ValueChanged="@(p => _place = p)" AccountEnabled="AccountEnabled"
                              Expanded="ExplainStorage" />
        </div>
        @* A secondary way in, only when the account has a circle with 2+ people (T1). *@
        @if (OfferCircle)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.GroupAdd" OnClick="FromCircle" id="from-circle-link">@L["CreateFromCircleAction"]</MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Create"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">@L["CreateGroup"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The initially selected place (the current default).</summary>
    [Parameter] public GroupPlace Place { get; set; }

    /// <summary>Whether someone is signed in (it changes what "online" means).</summary>
    [Parameter] public bool AccountEnabled { get; set; }

    /// <summary>Show the storage options expanded with their explanations (the device's first group).</summary>
    [Parameter] public bool ExplainStorage { get; set; }

    /// <summary>Offer "Take members from a circle" (the account has a circle with two or more people).</summary>
    [Parameter] public bool OfferCircle { get; set; }

    /// <summary>A prefilled name (e.g. when starting from a template).</summary>
    [Parameter] public string? InitialName { get; set; }

    /// <summary>Starting from another group: say that its members and exclusions come along (Q34).</summary>
    [Parameter] public bool FromTemplate { get; set; }

    private MudTextField<string> _field = default!;
    private string _name = string.Empty;
    private GroupPlace _place;

    protected override void OnInitialized()
    {
        _place = Place;
        _name = InitialName ?? string.Empty;
    }

    // Same focus dance as TextInputSheet: AutoFocus fires before the dialog transition settles on a phone,
    // so the field never took focus and the keyboard stayed closed (UX review B8). Focus once it has appeared.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(150);
            await _field.FocusAsync();
        }
    }

    private void Create()
    {
        if (!string.IsNullOrWhiteSpace(_name))
        {
            Dialog.Close(DialogResult.Ok(new NewGroupResult(_name.Trim(), _place)));
        }
    }

    private void Cancel() => Dialog.Cancel();

    private void FromCircle() => Dialog.Close(DialogResult.Ok(new NewGroupResult(_name.Trim(), _place, FromCircle: true)));

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            Create();
        }
    }
}
