@inject IStringLocalizer<AppStrings> L
@inject NavigationManager Navigation
@inject ISender Sender

@* Sub-navigation for a single group (ADR-0040): a back link to the group list plus the group's name,
   then a native Material tab strip for the group's sections. The tab matching the current route is
   selected, so the organizer always sees where they are; selecting another tab navigates to it. The
   tabs carry no panel content — each section is its own route/page rendered below this component — so
   the (empty) MudTabs content area is hidden in GroupNav.razor.css. *@
<div class="d-flex align-center flex-wrap gap-2 mb-2">
    <MudButton Href="" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Variant="Variant.Text">
        @L["AllGroups"]
    </MudButton>
    @if (!string.IsNullOrEmpty(_groupName))
    {
        <MudText Typo="Typo.h6">@_groupName</MudText>
    }
</div>

<div class="ct-group-tabs mb-4">
    <MudTabs Rounded="true" MinimumTabWidth="0" ActivePanelIndex="_activeIndex"
             ActivePanelIndexChanged="OnTabChanged" ScrollIconColor="Color.Primary">
        @foreach (var tab in Tabs)
        {
            <MudTabPanel Text="@tab.Label" />
        }
    </MudTabs>
</div>

@code {
    /// <summary>The group the sub-navigation is scoped to.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private string? _groupName;
    private int _activeIndex;

    private sealed record Tab(string Href, string Label, bool Exact = false);

    private IReadOnlyList<Tab> Tabs =>
    [
        new($"groups/{GroupId}", L["NavEvents"], Exact: true),
        new($"groups/{GroupId}/members", L["NavMembers"]),
        new($"groups/{GroupId}/exclusions", L["NavExclusions"]),
    ];

    protected override async Task OnParametersSetAsync()
    {
        _activeIndex = ActiveIndexFromRoute();

        // The group name is a nicety in the header; a read failure just leaves it blank and the tabs
        // still work, so it is not worth surfacing an error for.
        var group = await Sender.Send(new GetGroupQuery(GroupId));
        _groupName = group?.Name;
    }

    // The tabs overlap by prefix ("…/members" starts with "…"), so the exact editor entry is checked
    // first and the rest by prefix, matching the original active-state logic.
    private int ActiveIndexFromRoute()
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        for (var i = 0; i < Tabs.Count; i++)
        {
            var target = Tabs[i].Href.TrimEnd('/');
            var match = Tabs[i].Exact
                ? string.Equals(current, target, StringComparison.OrdinalIgnoreCase)
                : current.StartsWith(target, StringComparison.OrdinalIgnoreCase);
            if (match)
            {
                return i;
            }
        }

        return 0;
    }

    private void OnTabChanged(int index)
    {
        if (index == _activeIndex)
        {
            return;
        }

        _activeIndex = index;
        Navigation.NavigateTo(Tabs[index].Href);
    }
}
