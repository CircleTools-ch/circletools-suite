@implements IDisposable
@inject IDialogService Dialog
@inject ClaimableGroupsService Claimable
@inject SyncService Sync
@inject ISender Sender
@inject AutoSyncService AutoSync
@inject KeptLocalGroups KeptLocal
@inject SignInReconciliation Reconciliation
@inject IStringLocalizer<AppStrings> L

@*
    Sign-in reconciliation of offline data (ADR-0044). No visual output of its own: on an interactive sign-in
    that finds account-free groups on the device, it asks the user to Import them into the account, Keep them
    on this device, or Discard them. With no offline groups it simply lets the background sync run. A
    restored session (silent startup refresh) is not a sign-in and is never prompted.

    Which sign-in still needs an answer lives in the SignInReconciliation service, not here (amendment
    2026-10-15). Signing in can switch the UI language, and the culture boundary then rebuilds this
    component and the dialog provider. The rebuilt reconciler picks the request up and asks again, in the
    account's language. The prompt is a bottom sheet only its buttons close.
*@

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private bool _busy;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await Reconciliation.InitializeAsync();
        Reconciliation.PendingChanged += OnPendingChanged;
    }

    // A sign-in pending from before a rebuild (the language switch) is picked up on the first render.
    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender ? TryReconcileAsync() : Task.CompletedTask;

    private void OnPendingChanged() => _ = InvokeAsync(TryReconcileAsync);

    private async Task TryReconcileAsync()
    {
        if (_busy || _disposed || Reconciliation.Pending is not { } accountId)
        {
            return;
        }

        _busy = true;
        try
        {
            if (!await ReconcileAsync(accountId) && _disposed)
            {
                // The prompt was torn down with this component (the tree was rebuilt mid-question). Leave
                // the sign-in pending: the rebuilt reconciler asks again.
                return;
            }

            Reconciliation.Complete();
        }
        finally
        {
            _busy = false;
        }

        // Import, Discard, Keep, or nothing-to-reconcile: run the first cycle now to pull the account's data.
        AutoSync.RequestSync();
    }

    // Returns false when the prompt ended without an answer.
    private async Task<bool> ReconcileAsync(Guid accountId)
    {
        IReadOnlyList<Guid> ids;
        try
        {
            // Only groups the user has not already decided about: one they kept local at an earlier
            // sign-in, or created as "On this device" while signed in, is not asked about again.
            var kept = await KeptLocal.GetAsync();
            ids = [.. (await Claimable.GetAccountFreeAsync()).Select(g => g.Id).Where(id => !kept.Contains(id))];
        }
        catch (StorageUnavailableException)
        {
            ids = [];
        }

        if (ids.Count == 0)
        {
            return true;
        }

        switch (await AskAsync(ids.Count))
        {
            case ReconcileChoice.Import:
                await Sync.ClaimAsync(accountId, ids);
                return true;
            case ReconcileChoice.Discard:
                foreach (var id in ids)
                {
                    await Sender.Send(new DeleteGroupCommand(id));
                }

                return true;
            case ReconcileChoice.KeepLocal:
                // An explicit "keep on this device": remember it, so the next sign-in does not ask about
                // the same groups again. They stay importable per group from Sharing & sync.
                await KeptLocal.AddAsync(ids);
                return true;
            default:
                // No answer: decide nothing. The groups stay local; never end the session over it.
                return false;
        }
    }

    private Task<ReconcileChoice?> AskAsync(int count)
    {
        // Count-at-one is a distinct key, not "{0} things" with a swapped number: the noun is singular
        // in every language this app speaks.
        var body = count == 1 ? L["ReconcileBodySingular"] : L["ReconcileBodyPlural", count];

        return Dialog.ShowReconcileSheetAsync(
            L["ReconcileTitle"], body, L["ReconcileImport"], L["ReconcileKeepLocal"], L["ReconcileDiscard"], _lifetime.Token);
    }

    public void Dispose()
    {
        _disposed = true;
        Reconciliation.PendingChanged -= OnPendingChanged;

        // Close a sheet still open: the rebuilt reconciler asks again, in the new language.
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
