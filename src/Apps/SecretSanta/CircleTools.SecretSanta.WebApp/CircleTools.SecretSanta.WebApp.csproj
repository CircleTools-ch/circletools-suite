<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Asset fingerprinting is OFF because of the CSP (ADR-0021, ADR-0048), matching the Main head.
         Fingerprinting fills an inline <script type="importmap"> with the hashed asset names, and an
         import map is subject to script-src. With no 'unsafe-inline' the browser blocks it and the WASM
         runtime never boots (it can't resolve dotnet.js). Pinning the map's SHA-256 in the policy is no
         option: it changes every build. Cache-busting is not lost — service-worker-assets.js already
         carries a content hash per file. With this false, index.html must use the plain asset names
         (no #[.{fingerprint}] placeholder) and carry no import map. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Localization (ADR-0011) needs real culture data; the repo default is invariant. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleTools.SecretSanta.Ui\CircleTools.SecretSanta.Ui.csproj" />
    <ProjectReference Include="..\CircleTools.SecretSanta.LocalStore\CircleTools.SecretSanta.LocalStore.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\CircleTools.ApiClient\CircleTools.ApiClient.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\CircleTools.Ui.Account\CircleTools.Ui.Account.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\CircleTools.Ui.Web\CircleTools.Ui.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- MudBlazor (ADR-0040): referenced directly so the host serves its static assets and can call
         AddMudServices; the components themselves come from CircleTools.Ui.Shared. -->
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
