@page "/"
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["GroupsTitle"]</PageTitle>

<h1>@L["GroupsTitle"]</h1>

<div class="input-group mb-3">
    <input class="form-control" @bind="_newName" @bind:event="oninput" placeholder="@L["NewGroupPlaceholder"]"
           aria-label="@L["NewGroupPlaceholder"]" @onkeydown="OnNewNameKeyDown" />
    <button class="btn btn-primary" @onclick="CreateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">
        @L["CreateGroup"]
    </button>
</div>

@if (_groups is null)
{
    <p>@L["Loading"]</p>
}
else if (_groups.Count == 0)
{
    <p>@L["NoGroups"]</p>
}
else
{
    <ul class="list-group">
        @foreach (var group in _groups)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                    <span>
                        <strong>@group.Name</strong>
                        <span class="text-muted ms-2">@L["MembersColumn"]: @group.MemberCount</span>
                        @if (group.HasCurrentDraw)
                        {
                            <span class="badge bg-success ms-2">@L["DrawCompleteBadge"]</span>
                        }
                        else if (group.DrawInvalidatedByMembershipChange)
                        {
                            <span class="badge bg-warning text-dark ms-2">@L["DrawInvalidatedBadge"]</span>
                        }
                    </span>
                    <span>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Open(group.Id)">@L["Open"]</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => AskDelete(group.Id)">@L["Delete"]</button>
                    </span>
                </div>
                @if (_pendingDeleteId == group.Id)
                {
                    <div class="alert alert-warning mt-2 mb-0" role="alert">
                        <p class="mb-2">@L["ConfirmDeleteGroup", group.Name]</p>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(group.Id)">@L["ConfirmYes"]</button>
                        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelDelete">@L["Cancel"]</button>
                    </div>
                }
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<GroupSummaryDto>? _groups;
    private string _newName = string.Empty;
    private bool _busy;
    private Guid? _pendingDeleteId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _groups = await Sender.Send(new GetGroupsQuery());

    private async Task OnNewNameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await CreateAsync();
        }
    }

    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        _busy = true;
        try
        {
            var id = await Sender.Send(new CreateGroupCommand(_newName));
            _newName = string.Empty;
            Open(id);
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskDelete(Guid id) => _pendingDeleteId = id;

    private void CancelDelete() => _pendingDeleteId = null;

    private async Task DeleteAsync(Guid id)
    {
        _pendingDeleteId = null;
        await Sender.Send(new DeleteGroupCommand(id));
        await LoadAsync();
    }

    private void Open(Guid id) => Navigation.NavigateTo($"groups/{id}");
}
