@page "/my-assignments"
@using System.Globalization
@using AppSuite.ApiClient
@using AppSuite.SecretSanta.Contracts
@using AppSuite.SecretSanta.LocalStore.Linking
@inject ILinkingApi Linking
@inject IStringLocalizer<AppStrings> L

@*
    See my assignment while signed in (FR-029). The server returns only the caller's own pairing, one
    per group. Each is kept behind the same deliberate reveal step as the reveal page — a shared screen
    should not spoil a gift by accident. The recipient's free-text wishlist is shown untranslated.
*@

<PageTitle>@L["MyAssignmentsTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>@L["MyAssignmentsTitle"]</h1>
        <p class="text-body-secondary">@L["MyAssignmentsLead"]</p>
        <p class="small text-body-secondary">@L["MyAssignmentsOperatorPrivacyNote"]</p>

        @if (_error is not null)
        {
            <div class="alert alert-warning" role="status">@_error</div>
        }

        @if (_assignments is null)
        {
            <p>@L["Loading"]</p>
        }
        else if (_assignments.Count == 0)
        {
            <p>@L["MyAssignmentsNone"]</p>
        }
        else
        {
            @foreach (var assignment in _assignments)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5 card-title">@assignment.GroupName</h2>

                        @if (assignment.Budget is { } budget)
                        {
                            <p class="mb-1"><strong>@L["RevealBudgetLabel"]:</strong>
                                @budget.Amount.ToString("0.##", CultureInfo.CurrentCulture) @budget.Currency</p>
                        }
                        @if (assignment.Event is { } ev && HasEvent(ev))
                        {
                            <p class="mb-1">
                                <strong>@L["RevealEventLabel"]:</strong>
                                @if (ev.Date is { } date)
                                {
                                    <span>&nbsp;@date.ToString("d", CultureInfo.CurrentCulture)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(ev.Location))
                                {
                                    @if (ev.Date is not null)
                                    {
                                        <span>,</span>
                                    }
                                    <span>&nbsp;@ev.Location</span>
                                }
                            </p>
                        }

                        @if (_revealed.Contains(assignment.GroupId))
                        {
                            <div class="alert alert-success mt-2 mb-0">
                                <p class="mb-1">@L["RevealRecipientLabel"]:</p>
                                <h3 class="h4 mb-3">@assignment.RecipientName</h3>
                                <p class="mb-1"><strong>@L["RevealWishlistLabel"]:</strong></p>
                                @if (assignment.RecipientWishlist.Count == 0)
                                {
                                    <p class="mb-0">@L["RevealNoWishlist"]</p>
                                }
                                else
                                {
                                    <ul class="mb-0">
                                        @foreach (var item in assignment.RecipientWishlist)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mt-2 mb-2">@L["RevealSpoilerNote"]</p>
                            <button class="btn btn-primary" @onclick="() => _revealed.Add(assignment.GroupId)">
                                @L["RevealButton"]
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<MyAssignmentResponse>? _assignments;
    private readonly HashSet<Guid> _revealed = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Linking.GetMyAssignmentsAsync();
        if (result.IsSuccess)
        {
            _assignments = result.Value!.Assignments;
        }
        else
        {
            _assignments = [];
            _error = result.Error!.Failure == ApiFailure.Unreachable ? L["MyAssignmentsOffline"] : L["MyAssignmentsReadFailed"];
        }
    }

    private static bool HasEvent(EventDetailsDto ev) =>
        ev.Date is not null || !string.IsNullOrWhiteSpace(ev.Location) || !string.IsNullOrWhiteSpace(ev.Description);
}
