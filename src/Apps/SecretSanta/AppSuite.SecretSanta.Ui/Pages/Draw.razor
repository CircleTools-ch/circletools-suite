@page "/groups/{GroupId:guid}/draw"
@inject ISender Sender
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["DrawTitle"]</PageTitle>

<GroupNav GroupId="GroupId" />

<h1>@L["DrawTitle"]</h1>

@if (_group is null)
{
    <p>@L["Loading"]</p>
}
else if (_group.Members.Count < 2)
{
    <p>@L["NeedTwoMembersToDraw"]</p>
}
else
{
    @if (_result is null && _group.DrawInvalidatedByMembershipChange)
    {
        <div class="alert alert-warning" role="alert">@L["DrawInvalidatedNotice"]</div>
    }

    <button class="btn btn-primary mb-3" @onclick="OnDrawClickedAsync" disabled="@_busy">@L["RunDraw"]</button>

    @if (_confirmRedraw)
    {
        <div class="alert alert-warning" role="alert">
            <p class="mb-2">@L["RedrawWarning"]</p>
            <button class="btn btn-sm btn-danger" @onclick="RunAsync" disabled="@_busy">@L["RedrawConfirm"]</button>
            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelRedraw">@L["Cancel"]</button>
        </div>
    }

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div class="alert alert-success">
                <p class="mb-1">@L["DrawSuccess"]</p>
                <p class="mb-1">@L["DrawAssignmentCount", _result.AssignmentCount]</p>
                <p class="mb-0">@L["DrawSpoilerNote"]</p>
            </div>
            <button class="btn btn-outline-primary" @onclick="GoToShare">@L["NavShare"]</button>
        }
        else
        {
            <div class="alert alert-danger" role="alert">@FailureMessage(_result.FailureReason)</div>
        }
    }
    else if (_group.HasCurrentDraw)
    {
        <div class="alert alert-info">
            <p class="mb-0">@L["DrawSpoilerNote"]</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="GoToShare">@L["NavShare"]</button>
    }
}

@code {
    /// <summary>The group to draw.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private GroupDto? _group;
    private RunDrawResultDto? _result;
    private bool _busy;
    private bool _confirmRedraw;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync() => _group = await Sender.Send(new GetGroupQuery(GroupId));

    /// <summary>
    /// Re-drawing silently invalidates links the organizer may already have sent (ADR-0014 links
    /// are self-contained, so they cannot be revoked), which is why the second draw asks first.
    /// </summary>
    private async Task OnDrawClickedAsync()
    {
        if (_group?.HasCurrentDraw == true && !_confirmRedraw)
        {
            _confirmRedraw = true;
            return;
        }

        await RunAsync();
    }

    private void CancelRedraw() => _confirmRedraw = false;

    private async Task RunAsync()
    {
        _busy = true;
        try
        {
            _result = await Sender.Send(new RunDrawCommand(GroupId));
            _confirmRedraw = false;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private string FailureMessage(string? reason) => reason switch
    {
        nameof(AppSuite.SecretSanta.Core.Domain.DrawFailureReason.TwoMemberReciprocalImpossible) => L["DrawFailedTwoMember"],
        _ => L["DrawFailedOverConstrained"],
    };

    private void GoToShare() => Navigation.NavigateTo($"groups/{GroupId}/share");
}
