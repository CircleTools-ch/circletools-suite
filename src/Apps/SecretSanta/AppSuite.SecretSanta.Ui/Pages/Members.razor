@page "/groups/{GroupId:guid}/members"
@using AppSuite.SecretSanta.Contracts
@using AppSuite.SecretSanta.LocalStore.Linking
@inject ISender Sender
@inject ILinkingApi Linking
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["MembersTitle"]</PageTitle>

<GroupNav GroupId="GroupId" />

<h1>@L["MembersTitle"]</h1>

@if (_hasCurrentDraw)
{
    <div class="alert alert-warning" role="alert">@L["RemoveMemberVoidsDrawWarning"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="mb-2">
            <label class="form-label" for="new-member-name">@L["NameLabel"]</label>
            <input id="new-member-name" class="form-control" @bind="_newName" placeholder="@L["MemberNamePlaceholder"]" />
        </div>
        <div class="mb-2">
            <label class="form-label" for="new-member-wishlist">@L["WishlistLabel"]</label>
            <textarea id="new-member-wishlist" class="form-control" @bind="_newWishlist"></textarea>
        </div>
        <button class="btn btn-primary" @onclick="AddAsync" disabled="@string.IsNullOrWhiteSpace(_newName)">@L["AddMember"]</button>
        @if (_error is not null)
        {
            <p class="text-danger mt-2" role="alert">@_error</p>
        }
    </div>
</div>

@if (_members is null)
{
    <p>@L["Loading"]</p>
}
else if (_members.Count == 0)
{
    <p>@L["NoMembers"]</p>
}
else
{
    <ul class="list-group">
        @foreach (var member in _members)
        {
            <li class="list-group-item">
                @if (_editingId == member.Id)
                {
                    <div class="mb-2">
                        <input class="form-control" @bind="_editName" aria-label="@L["NameLabel"]" />
                    </div>
                    <div class="mb-2">
                        <textarea class="form-control" @bind="_editWishlist" aria-label="@L["WishlistLabel"]"></textarea>
                    </div>
                    <button class="btn btn-sm btn-primary" @onclick="SaveEditAsync" disabled="@string.IsNullOrWhiteSpace(_editName)">@L["Save"]</button>
                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelEdit">@L["Cancel"]</button>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@member.Name</strong>
                            @if (member.Wishlist.Count > 0)
                            {
                                <ul class="mb-0">
                                    @foreach (var item in member.Wishlist)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            }
                        </div>
                        <div>
                            @if (member.UserId is not null)
                            {
                                <span class="badge bg-info text-dark me-1" title="@L["MemberLinkedTitle"]">@L["MemberLinkedBadge"]</span>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => UnlinkAsync(member.Id)" disabled="@_linkBusy">@L["MemberUnlink"]</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-info" @onclick="() => BeginLink(member.Id)">@L["MemberLink"]</button>
                            }
                            <button class="btn btn-sm btn-outline-primary ms-1" @onclick="() => BeginEdit(member)">@L["Edit"]</button>
                            <button class="btn btn-sm btn-outline-danger ms-1" @onclick="() => AskRemove(member.Id)">@L["Remove"]</button>
                        </div>
                    </div>

                    @* Send a member-link request: the member owns their wishlist and sees their own
                       assignment once they accept. The response reveals nothing about the address. *@
                    @if (_linkingMemberId == member.Id)
                    {
                        <div class="alert alert-light border mt-2 mb-0">
                            <label class="form-label" for="link-email-@member.Id">@L["MemberLinkEmailLabel"]</label>
                            <div class="input-group">
                                <input id="link-email-@member.Id" class="form-control" type="email" @bind="_linkEmail" @bind:event="oninput" />
                                <button class="btn btn-primary" @onclick="() => SendLinkAsync(member)" disabled="@(_linkBusy || string.IsNullOrWhiteSpace(_linkEmail))">
                                    @L["MemberLinkSend"]
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="CancelLink">@L["Cancel"]</button>
                            </div>
                        </div>
                    }

                    @if (_linkMessageId == member.Id && _linkMessage is not null)
                    {
                        <div class="alert alert-info mt-2 mb-0" role="status">@_linkMessage</div>
                    }

                    @if (_pendingRemoveId == member.Id)
                    {
                        <div class="alert alert-warning mt-2 mb-0" role="alert">
                            <p class="mb-2">@L["ConfirmRemoveMember", member.Name]</p>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveAsync(member.Id)">@L["ConfirmRemove"]</button>
                            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="CancelRemove">@L["Cancel"]</button>
                        </div>
                    }
                }
            </li>
        }
    </ul>
}

@code {
    /// <summary>The owning group.</summary>
    [Parameter]
    public Guid GroupId { get; set; }

    private IReadOnlyList<MemberDto>? _members;
    private string _newName = string.Empty;
    private string _newWishlist = string.Empty;
    private string? _error;

    private Guid? _editingId;
    private string _editName = string.Empty;
    private string _editWishlist = string.Empty;
    private Guid? _pendingRemoveId;
    private bool _hasCurrentDraw;
    private string _groupName = string.Empty;

    private Guid? _linkingMemberId;
    private string _linkEmail = string.Empty;
    private bool _linkBusy;
    private Guid? _linkMessageId;
    private string? _linkMessage;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var group = await Sender.Send(new GetGroupQuery(GroupId));
        _members = group?.Members ?? [];
        _hasCurrentDraw = group?.HasCurrentDraw ?? false;
        _groupName = group?.Name ?? string.Empty;
    }

    private void BeginLink(Guid memberId)
    {
        _linkingMemberId = memberId;
        _linkEmail = string.Empty;
        _linkMessage = null;
    }

    private void CancelLink() => _linkingMemberId = null;

    private async Task SendLinkAsync(MemberDto member)
    {
        if (_linkBusy || string.IsNullOrWhiteSpace(_linkEmail))
        {
            return;
        }

        _linkBusy = true;
        var result = await Linking.SendMemberLinkAsync(
            new SendMemberLinkRequest(GroupId, _groupName, member.Id, member.Name, _linkEmail.Trim()));
        _linkBusy = false;
        _linkingMemberId = null;
        _linkMessageId = member.Id;

        // "Request sent" whether or not the address has an account (NFR-005). A self-link says so and
        // will apply on the next sync.
        _linkMessage = result.IsSuccess
            ? result.Value!.Outcome == MemberLinkOutcome.SelfLinked ? L["MemberLinkSelfLinked"] : L["MemberLinkRequestSent"]
            : L["MemberLinkFailed"];
    }

    private async Task UnlinkAsync(Guid memberId)
    {
        _linkBusy = true;
        _linkMessageId = memberId;

        // Tell the server (it clears the account's rows and emits the unlink resolution), then clear the
        // link locally now so the roster reflects it immediately; the resolution re-applies idempotently.
        var result = await Linking.UnlinkMemberAsync(GroupId, memberId);
        if (result.IsSuccess)
        {
            await Sender.Send(new UnlinkMemberCommand(GroupId, memberId));
            _linkMessage = L["MemberUnlinked"];
        }
        else
        {
            _linkMessage = L["MemberLinkFailed"];
        }

        _linkBusy = false;
        await LoadAsync();
    }

    private static IReadOnlyList<string> ParseWishlist(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private async Task AddAsync()
    {
        _error = null;
        try
        {
            await Sender.Send(new AddMemberCommand(GroupId, _newName, ParseWishlist(_newWishlist)));
            _newName = string.Empty;
            _newWishlist = string.Empty;
            await LoadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
    }

    private void BeginEdit(MemberDto member)
    {
        _editingId = member.Id;
        _editName = member.Name;
        _editWishlist = string.Join('\n', member.Wishlist);
        _error = null;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEditAsync()
    {
        if (_editingId is not { } id)
        {
            return;
        }

        _error = null;
        try
        {
            await Sender.Send(new EditMemberCommand(GroupId, id, _editName, ParseWishlist(_editWishlist)));
            _editingId = null;
            await LoadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
    }

    private void AskRemove(Guid memberId)
    {
        _pendingRemoveId = memberId;
        _error = null;
    }

    private void CancelRemove() => _pendingRemoveId = null;

    private async Task RemoveAsync(Guid memberId)
    {
        _pendingRemoveId = null;
        await Sender.Send(new RemoveMemberCommand(GroupId, memberId));
        await LoadAsync();
    }
}
