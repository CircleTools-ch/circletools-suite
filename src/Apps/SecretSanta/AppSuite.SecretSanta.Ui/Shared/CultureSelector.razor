@using System.Globalization
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<label class="form-label visually-hidden" for="culture-selector">@L["LanguageLabel"]</label>
<select id="culture-selector" class="form-select form-select-sm"
        aria-label="@L["LanguageLabel"]"
        value="@_current"
        @onchange="OnChangedAsync">
    @foreach (var culture in AppCultures.Supported)
    {
        <option value="@culture">@AppCultures.DisplayName(culture)</option>
    }
</select>

@code {
    private string _current = AppCultures.DefaultCulture;

    protected override void OnInitialized() =>
        _current = AppCultures.Resolve(CultureInfo.CurrentUICulture.Name).Name;

    /// <summary>
    /// Persists the choice and reloads. A full reload is the simplest correct way to apply a new
    /// culture: the resource lookups and formatters already resolved by rendered components are not
    /// re-evaluated when <see cref="CultureInfo"/> defaults change underneath them.
    /// </summary>
    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var chosen = AppCultures.Resolve(args.Value?.ToString()).Name;
        if (chosen == _current)
        {
            return;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", AppCultures.StorageKey, chosen);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
