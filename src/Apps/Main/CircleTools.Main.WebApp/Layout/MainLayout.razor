@inherits LayoutComponentBase
@inject IStringLocalizer<AppStrings> L

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="circletools-topbar__user">@context.User.DisplayName()</span>
                </Authorized>
                <NotAuthorized>
                    <a href="account/login">@L["NavSignIn"]</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @* Sits above every page, not only the account ones: a pending account can sign in but
           nothing account-scoped works until the address is proven (FR-007), and the banner is the
           only thing that explains why. *@
        <VerificationBanner />

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
