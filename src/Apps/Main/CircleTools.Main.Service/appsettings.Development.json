{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "maindb": "Host=localhost;Port=5432;Database=maindb;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7080"
    ]
  },
  "Auth": {
    "Jwt": {
      "Issuer": "circletools",
      "Audience": "circletools-api",
      "//SigningKey": "DEVELOPMENT ONLY. Production supplies this from user-secrets or the environment; a committed key would let anyone mint a session for any account.",
      "SigningKey": "dev-only-signing-key-not-for-production-use-32b+"
    },
    "TokenLifetimes": {
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "30.00:00:00",
      "RefreshReplayGraceWindow": "00:00:30"
    }
  },
  "Mail": {
    "//": "Host/Port are supplied by the Aspire AppHost (Mail__Host, Mail__Port) pointing at the Mailpit container — ADR-0023.",
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "no-reply@circletools.test",
    "FromName": "CircleTools",
    "ClientBaseUrl": "https://localhost:7080"
  },
  "Outbox": {
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 5
  }
}
