@inject IStringLocalizer<AppStrings> L
@inject AccountSession Session
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AppSuite</a>
        <button title="@L["NavMenu"]" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @L["NavDashboard"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="heartbeat">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @L["NavHeartbeat"]
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <hr class="appsuite-nav__rule" />
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="circles">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> @L["NavCircles"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="invitations">
                        <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span> @L["InvitationsTitle"]
                    </NavLink>
                </div>
                <hr class="appsuite-nav__rule" />
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/profile">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @L["NavProfile"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/security">
                        <span class="bi bi-lock-fill-nav-menu" aria-hidden="true"></span> @L["NavSecurity"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/data">
                        <span class="bi bi-download-nav-menu" aria-hidden="true"></span> @L["NavData"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <button type="button" class="nav-link appsuite-nav__button" @onclick="SignOutAsync">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> @L["NavSignOut"]
                    </button>
                </div>
            </Authorized>
            <NotAuthorized>
                <hr class="appsuite-nav__rule" />
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/login">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @L["NavSignIn"]
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account/register">
                        <span class="bi bi-person-plus-nav-menu" aria-hidden="true"></span> @L["NavRegister"]
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>

    <div class="px-3 py-3 appsuite-nav__culture">
        <CultureSelector />
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    // Sign-out lands on the dashboard rather than the sign-in form: the suite is usable signed out
    // (ADR-0005 local-first), so demanding credentials straight after leaving would be backwards.
    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("");
    }
}
