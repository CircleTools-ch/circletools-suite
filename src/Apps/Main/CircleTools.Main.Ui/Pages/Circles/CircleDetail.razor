@page "/circles/{CircleId:guid}"
@inject IStringLocalizer<AppStrings> L
@inject CirclesApiClient Api
@inject NavigationManager Nav

@* The whole of FR-019 through FR-022 for one circle. It is one page rather than five because every
   action here is a change to the same aggregate and the same people list: splitting them across
   routes would mean reloading the circle to answer "who is in it" on each one. *@

<PageTitle>@(_circle?.Name ?? L["CirclesTitle"].Value)</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudButton Href="circles" StartIcon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                   Variant="Variant.Text" Class="mb-3">@L["CircleBackToCircles"]</MudButton>

        <ProblemAlert Message="@_error" />
        <ConnectivityRequired Message="@(_offline ? L["CircleOfflineNotice"].Value : null)" />

        @if (_gone)
        {
            <MudText Class="mud-text-secondary">@_goneMessage</MudText>
        }
        else if (_offline)
        {
            @* Online-only (ADR-0033); the notice above is the whole screen while offline. *@
        }
        else if (_circle is null)
        {
            <MudText Class="mud-text-secondary">@L["CircleLoading"]</MudText>
        }
        else
        {
            <MudText Typo="Typo.h4">@_circle.Name</MudText>
            <MudText Class="mud-text-secondary mb-4">@_circle.Label</MudText>

            <ProblemAlert Message="@_actionError" />
            @if (_notice is { Length: > 0 })
            {
                <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@_notice</MudAlert>
            }

            <MudText Typo="Typo.h6" GutterBottom="true">@L["CircleDetailPeople"]</MudText>
            <MudStack Spacing="1" Class="mb-6">
                @foreach (var person in _circle.People)
                {
                    <MudPaper Elevation="1" Class="pa-3 person-row">
                        <div class="d-flex justify-space-between align-start flex-wrap gap-2">
                            <div class="d-flex align-center flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle1"><strong>@person.DisplayName</strong></MudText>
                                @if (RoleBadge(person.Role) is { } badge)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@badge</MudChip>
                                }
                                @if (person.IsManaged)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">@L["CircleManagedBadge"]</MudChip>
                                }
                                @if (person.IsYou)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@L["CircleYouBadge"]</MudChip>
                                }
                            </div>

                            <div class="d-flex flex-wrap gap-1">
                                @* Role changes are the owner's alone, and never apply to the
                                   owner's own membership (FR-020). *@
                                @if (IsOwner && !person.IsYou && !person.IsManaged)
                                {
                                    @if (IsAdminRole(person.Role))
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="@(() => MakeMemberAsync(person))">
                                            @L["CircleMakeMember"]
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="@(() => MakeAdminAsync(person))">
                                            @L["CircleMakeAdmin"]
                                        </MudButton>
                                    }

                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="@(() => Ask(ConfirmKind.Transfer, person))">
                                        @L["CircleTransfer"]
                                    </MudButton>
                                }

                                @if (person.IsManaged && CanAdminister)
                                {
                                    @* The convenient way to promote an offline person: invite them
                                       straight from their own row, and the invitation is aimed at
                                       this profile so accepting takes it over rather than adding a
                                       duplicate (FR-019). *@
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               OnClick="@(() => StartInvite(person))">
                                        @L["CircleInviteToJoin"]
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="@(() => StartEdit(person))">
                                        @L["CircleManagedEdit"]
                                    </MudButton>
                                }

                                @* An admin may remove members but not other admins; only the
                                   owner can do that. The owner is never removable (FR-020). *@
                                @if (CanRemove(person))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                               OnClick="@(() => Ask(ConfirmKind.Remove, person))">
                                        @L["CircleRemove"]
                                    </MudButton>
                                }
                            </div>
                        </div>

                        @if (_editing?.MembershipId == person.MembershipId)
                        {
                            <form class="mt-3" @onsubmit="SaveManagedAsync" @onsubmit:preventDefault="true">
                                <MudStack Spacing="3">
                                    <MudTextField @bind-Value="_managedName" Immediate="true" Label="@L["CircleManagedName"]"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                                    <MudSelect T="string" @bind-Value="_managedLanguage" Label="@L["CircleManagedLanguage"]"
                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem T="string" Value="@("")">@L["CircleManagedLanguageNone"]</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("de-CH")">Deutsch</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("en")">English</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("fr-CH")">Français</MudSelectItem>
                                    </MudSelect>
                                    <div class="d-flex gap-2 align-center">
                                        <BusyButton Label="@L["CircleManagedSave"]" Busy="_busy"
                                                    Disabled="@(_managedName.Trim().Length == 0)" />
                                        <MudButton Variant="Variant.Text" OnClick="@(() => _editing = null)">
                                            @L["CircleManagedCancel"]
                                        </MudButton>
                                    </div>
                                </MudStack>
                            </form>
                        }

                        @if (_invitingPerson?.MembershipId == person.MembershipId)
                        {
                            <form class="mt-3" @onsubmit="SubmitRowInviteAsync" @onsubmit:preventDefault="true">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                                    @string.Format(CultureInfo.CurrentCulture, L["CircleInviteAsLead"], person.DisplayName)
                                </MudText>
                                <ProblemAlert Message="@_rowInviteError" />
                                <MudStack Spacing="3" Style="max-width:26rem;">
                                    <MudTextField @bind-Value="_rowInviteEmail" Immediate="true" InputType="InputType.Email"
                                                  Label="@L["CircleInviteEmail"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                  Required="true" autocomplete="off" />
                                    <div class="d-flex gap-2 align-center">
                                        <BusyButton Label="@L["CircleInviteSubmit"]" Busy="_inviting"
                                                    Disabled="@(_rowInviteEmail.Trim().Length == 0)" />
                                        <MudButton Variant="Variant.Text" OnClick="@(() => _invitingPerson = null)">
                                            @L["CircleManagedCancel"]
                                        </MudButton>
                                    </div>
                                </MudStack>
                            </form>
                        }

                        @if (_confirming is { } pending && pending.Person.MembershipId == person.MembershipId)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true" role="alert">
                                <MudText Class="mb-2">@pending.Question</MudText>
                                <div class="d-flex gap-2 align-center">
                                    <BusyButton Type="button" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                                Label="@L["CircleConfirmYes"]" Busy="_busy" OnClick="ConfirmAsync" />
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _confirming = null)">
                                        @L["CircleConfirmNo"]
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                    </MudPaper>
                }
            </MudStack>

            @if (CanAdminister)
            {
                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6">@L["CircleInviteTitle"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["CircleInviteLead"]</MudText>

                    <form @onsubmit="InviteAsync" @onsubmit:preventDefault="true">
                        <ProblemAlert Message="@_inviteError" />
                        @if (_inviteSent)
                        {
                            @* Says the same thing whether a mail went out, the address is
                               already in the circle, or a decline is still in its cooldown.
                               That is the point (NFR-005). *@
                            <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" role="status">@L["CircleInviteSent"]</MudAlert>
                        }

                        <MudStack Spacing="3" Style="max-width:26rem;">
                            <MudTextField @ref="_inviteEmailField" @bind-Value="_inviteEmail" Immediate="true" InputType="InputType.Email"
                                          Label="@L["CircleInviteEmail"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Required="true" autocomplete="off" id="invite-email" />

                            @* Only shown when there is an offline person to promote. Left on "a new
                               person" it invites an ordinary newcomer; picking someone aims the
                               invitation at their profile so accepting takes it over (FR-019). *@
                            @if (OfflinePeople is { Count: > 0 } offline)
                            {
                                <MudSelect T="Guid?" @bind-Value="_inviteTargetId" Label="@L["CircleInviteFor"]"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["CircleInviteForNew"]</MudSelectItem>
                                    @foreach (var offlinePerson in offline)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)offlinePerson.MembershipId)">
                                            @string.Format(CultureInfo.CurrentCulture, L["CircleInviteForPerson"], offlinePerson.DisplayName)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            <BusyButton Label="@L["CircleInviteSubmit"]" Busy="_inviting"
                                        Disabled="@(_inviteEmail.Trim().Length == 0)" />
                        </MudStack>
                    </form>

                    <MudText Typo="Typo.subtitle2" Class="mt-4" GutterBottom="true">@L["CirclePendingTitle"]</MudText>
                    @if (_pending is null or { Count: 0 })
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["CirclePendingEmpty"]</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            @foreach (var invitation in _pending)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="d-flex justify-space-between align-center flex-wrap gap-2 pa-3">
                                    <div class="d-flex align-center flex-wrap gap-2">
                                        <MudText>@invitation.InvitedEmail</MudText>
                                        @if (invitation.ManagedDisplayName is { Length: > 0 } targetName)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                                @string.Format(CultureInfo.CurrentCulture, L["CirclePendingAsTarget"], targetName)
                                            </MudChip>
                                        }
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            @string.Format(
                                                CultureInfo.CurrentCulture,
                                                L["CirclePendingExpires"],
                                                invitation.ExpiresAt.ToLocalTime().ToString("d", CultureInfo.CurrentCulture))
                                        </MudText>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="@(() => ResendAsync(invitation.Id))">
                                            @L["CircleInviteResend"]
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                   OnClick="@(() => RevokeAsync(invitation.Id))">
                                            @L["CircleInviteRevoke"]
                                        </MudButton>
                                    </div>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudPaper>

                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6">@L["CircleManagedTitle"]</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["CircleManagedLead"]</MudText>

                    <form @onsubmit="AddManagedAsync" @onsubmit:preventDefault="true">
                        <MudStack Spacing="3" Style="max-width:26rem;">
                            <MudTextField @ref="_newManagedNameField" @bind-Value="_newManagedName" Immediate="true" Label="@L["CircleManagedName"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" id="managed-name" />
                            <BusyButton Variant="Variant.Outlined" Label="@L["CircleManagedAdd"]" Busy="_busy"
                                        Disabled="@(_newManagedName.Trim().Length == 0)" />
                        </MudStack>
                    </form>
                </MudPaper>

                <MudPaper Elevation="1" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" GutterBottom="true">@L["CircleSettingsTitle"]</MudText>

                    <form @onsubmit="RenameAsync" @onsubmit:preventDefault="true">
                        <MudStack Spacing="3" Style="max-width:26rem;">
                            <MudTextField @bind-Value="_editName" Immediate="true" Label="@L["CircleNameField"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                            <MudTextField @bind-Value="_editLabel" Immediate="true" Label="@L["CircleLabelField"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <BusyButton Label="@L["CircleRenameSubmit"]" Busy="_busy"
                                        Disabled="@(_editName.Trim().Length == 0)" />
                        </MudStack>
                    </form>
                </MudPaper>
            }

            <div class="mb-6">
                <MudButton Variant="Variant.Outlined" OnClick="@(() => Ask(ConfirmKind.Leave, person: null))">
                    @L["CircleLeave"]
                </MudButton>

                @if (_confirming is { Kind: ConfirmKind.Leave } leaving)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true" role="alert">
                        <MudText class="mb-2">@leaving.Question</MudText>

                        @* FR-021 requires the confirmation to say what leaving does *not* take.
                           The fear at this moment is losing the groups and draws you organised,
                           and they live in a different app entirely — so the reassurance has to
                           be here, where the decision is made. *@
                        <MudText Typo="Typo.body2" Class="mb-2">@L["CircleLeaveKeeps"]</MudText>

                        <div class="d-flex gap-2 align-center">
                            <BusyButton Type="button" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                        Label="@L["CircleConfirmYes"]" Busy="_busy" OnClick="ConfirmAsync" />
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _confirming = null)">
                                @L["CircleConfirmNo"]
                            </MudButton>
                        </div>
                    </MudAlert>
                }
            </div>

            @if (IsOwner)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 circletools-danger" Style="border-color:var(--mud-palette-error);">
                    <MudText Typo="Typo.h6" Color="Color.Error">@L["CircleDeleteTitle"]</MudText>

                    @* FR-022 asks this confirmation to be specific rather than merely stern: the
                       circle by name, how many people lose access, and every managed member by
                       name — they are the only data here nobody else can recreate. The counts
                       come from the response, never from a cached number. *@
                    <MudText Typo="Typo.body2" Class="mt-1">
                        @string.Format(CultureInfo.CurrentCulture, L["CircleDeleteNames"], _circle.Name)
                    </MudText>
                    <MudText Typo="Typo.body2">@LosesAccessSentence</MudText>

                    @if (ManagedNames is { Length: > 0 } managedNames)
                    {
                        @* The names are appended as data rather than substituted into the
                           sentence. A managed member's name is user data in the same way the
                           label is, and keeping it out of the format string is what guarantees
                           it is rendered verbatim in every language. *@
                        <MudText Typo="Typo.body2">
                            @L["CircleDeleteManagedNamed"] <span>@managedNames</span>
                        </MudText>
                    }

                    <MudText Typo="Typo.body2">@L["CircleDeleteLead"]</MudText>
                    <MudText Typo="Typo.body2" Class="mb-3">@L["CircleDeleteKeeps"]</MudText>

                    <form @onsubmit="DeleteAsync" @onsubmit:preventDefault="true">
                        <MudStack Spacing="3" Style="max-width:26rem;">
                            @* No password here. The threat is the misclick, and a hijacker who
                               wants to hurt you deletes the account, which is guarded already (FR-022). *@
                            <MudTextField @bind-Value="_confirmedName" Immediate="true" Label="@L["CircleDeleteConfirmPrompt"]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" autocomplete="off" id="confirm-name" />
                            <BusyButton Variant="Variant.Outlined" Color="Color.Error"
                                        Label="@L["CircleDeleteSubmit"]" Busy="_busy" Disabled="@(!NameTypedBack)" />
                        </MudStack>
                    </form>
                </MudPaper>
            }
        }
    </Authorized>
    <NotAuthorized>
        @* Guarded like AccountData's: leaving or deleting makes this branch true a moment before the
           page re-renders, and an unguarded redirect would bounce the user to sign-in mid-sentence. *@
        @if (!_gone)
        {
            <RedirectToLogin />
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    /// <summary>The circle being viewed.</summary>
    [Parameter]
    public Guid CircleId { get; set; }

    private enum ConfirmKind { Remove, Transfer, Leave }

    private sealed record PendingConfirm(ConfirmKind Kind, CirclePersonResponse Person, string Question);

    private CircleDetailResponse? _circle;
    private IReadOnlyList<PendingInvitationResponse>? _pending;
    private PendingConfirm? _confirming;
    private CirclePersonResponse? _editing;
    private CirclePersonResponse? _invitingPerson;

    private string _inviteEmail = string.Empty;
    private MudTextField<string>? _inviteEmailField;
    private Guid? _inviteTargetId;
    private string _rowInviteEmail = string.Empty;
    private string? _rowInviteError;
    private string _newManagedName = string.Empty;
    private MudTextField<string>? _newManagedNameField;
    private string _managedName = string.Empty;
    private string _managedLanguage = string.Empty;
    private string _editName = string.Empty;
    private string _editLabel = string.Empty;
    private string _confirmedName = string.Empty;

    private string? _error;
    private string? _actionError;
    private string? _inviteError;
    private string? _notice;
    private string? _goneMessage;
    private bool _inviteSent;
    private bool _inviting;
    private bool _busy;
    private bool _gone;
    private bool _offline;

    private bool IsOwner => string.Equals(_circle?.Role, "Owner", StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The managed members, by name, for the deletion confirmation (FR-022). Empty when the circle
    /// has none, so the sentence naming them is left out rather than shown empty.
    /// </summary>
    private string ManagedNames => string.Join(
        ", ",
        _circle?.People.Where(person => person.IsManaged).Select(person => person.DisplayName) ?? []);

    /// <summary>
    /// How many people lose access when the circle is deleted (FR-022) — the account-backed people
    /// only. Managed members are deleted rather than losing access; they never had any.
    /// </summary>
    private int LosingAccess => _circle?.People.Count(person => !person.IsManaged) ?? 0;

    /// <summary>
    /// The sentence stating that count, singular or plural. Only the owner sees this section, so the
    /// count is never below one — and at one it is the owner themselves.
    /// </summary>
    /// <remarks>
    /// German, English and French all inflect both the noun and the verb here, so a single format
    /// string cannot serve both cases: it reads "1 Personen verlieren", "1 people will lose",
    /// "1 personnes en perdront". The app has no pluralization machinery and one circle-sized feature
    /// is the wrong place to introduce one, so the singular is its own resource entry — the same way
    /// a translator would write it. The singular carries no placeholder: "one" belongs to the
    /// sentence in every language, not beside it.
    /// </remarks>
    private string LosesAccessSentence => LosingAccess == 1
        ? L["CircleDeleteLosesAccessOne"].Value
        : string.Format(CultureInfo.CurrentCulture, L["CircleDeleteLosesAccess"], LosingAccess);

    private bool CanAdminister => IsOwner || IsAdminRole(_circle?.Role);

    // Compared against the stored name exactly, the same check the server makes (FR-022).
    private bool NameTypedBack =>
        _circle is not null && string.Equals(_confirmedName.Trim(), _circle.Name, StringComparison.Ordinal);

    private static bool IsAdminRole(string? role) =>
        string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync(CircleId);

        if (result.Value is { } circle)
        {
            _circle = circle;
            _editName = circle.Name;
            _editLabel = circle.Label;
            _error = null;
            _offline = false;

            if (CanAdminister)
            {
                var pending = await Api.GetPendingInvitationsAsync(CircleId);
                _pending = pending.Value;
            }

            return;
        }

        if (result.Error?.Failure == ApiFailure.Unreachable)
        {
            // Circles are online-only (ADR-0033): say the screen needs a connection.
            _offline = true;
            _error = null;
            _circle = null;
            return;
        }

        // A 404 here is both "no such circle" and "you are not in it" — the API refuses to say which
        // (NFR-006), and so does this page.
        _error = CircleErrorText.Describe(L, result.Error);
        _offline = false;
        _circle = null;
    }

    /// <summary>The circle's offline people (managed members), the ones an invitation can promote.</summary>
    private IReadOnlyList<CirclePersonResponse> OfflinePeople =>
        [.. _circle?.People.Where(person => person.IsManaged) ?? []];

    private async Task InviteAsync()
    {
        _inviting = true;
        ClearBanners();
        _inviteSent = false;

        var result = await Api.InviteAsync(CircleId, new InviteRequest(_inviteEmail.Trim(), _inviteTargetId));

        _inviting = false;

        if (result.IsSuccess)
        {
            _inviteSent = true;
            _inviteEmail = string.Empty;
            _inviteTargetId = null;
            // Emptied after a send, the touched field would otherwise show "Required" (BTP-3).
            StateHasChanged();
            await FieldValidation.ResetAsync(_inviteEmailField);
            await LoadAsync();
            return;
        }

        _inviteError = CircleErrorText.Describe(L, result.Error);
    }

    private void StartInvite(CirclePersonResponse person)
    {
        ClearBanners();
        _rowInviteError = null;
        _rowInviteEmail = string.Empty;
        _editing = null;
        _invitingPerson = person;
    }

    private async Task SubmitRowInviteAsync()
    {
        if (_invitingPerson is not { } person)
        {
            return;
        }

        _inviting = true;
        _rowInviteError = null;

        var result = await Api.InviteAsync(
            CircleId,
            new InviteRequest(_rowInviteEmail.Trim(), person.MembershipId));

        _inviting = false;

        if (result.IsSuccess)
        {
            _invitingPerson = null;
            _inviteSent = true;
            await LoadAsync();
            return;
        }

        _rowInviteError = CircleErrorText.Describe(L, result.Error);
    }

    private Task ResendAsync(Guid invitationId) => RunAsync(() => Api.ResendInvitationAsync(CircleId, invitationId));

    private Task RevokeAsync(Guid invitationId) => RunAsync(() => Api.RevokeInvitationAsync(CircleId, invitationId));

    private Task MakeAdminAsync(CirclePersonResponse person) => ChangeRoleAsync(person, "Admin");

    private Task MakeMemberAsync(CirclePersonResponse person) => ChangeRoleAsync(person, "Member");

    private Task ChangeRoleAsync(CirclePersonResponse person, string role) =>
        RunAsync(() => Api.ChangeRoleAsync(CircleId, person.MembershipId, new ChangeRoleRequest(role)));

    private Task AddManagedAsync() =>
        RunAsync(async () =>
        {
            ApiResult result = await Api.AddManagedMemberAsync(
                CircleId,
                new AddManagedMemberRequest(_newManagedName.Trim(), null));

            if (result.IsSuccess)
            {
                _newManagedName = string.Empty;
                // Emptied after an add, the touched field would otherwise show "Required" (BTP-3).
                StateHasChanged();
                await FieldValidation.ResetAsync(_newManagedNameField);
            }

            return result;
        });

    private Task SaveManagedAsync() =>
        RunAsync(async () =>
        {
            ApiResult result = await Api.UpdateManagedMemberAsync(
                CircleId,
                _editing!.MembershipId,
                new UpdateManagedMemberRequest(
                    _managedName.Trim(),
                    _managedLanguage.Length == 0 ? null : _managedLanguage));

            if (result.IsSuccess)
            {
                _editing = null;
            }

            return result;
        });

    private Task RenameAsync() =>
        RunAsync(async () =>
            await Api.UpdateAsync(CircleId, new UpdateCircleRequest(_editName.Trim(), _editLabel.Trim())));

    private void StartEdit(CirclePersonResponse person)
    {
        _invitingPerson = null;
        _editing = person;
        _managedName = person.DisplayName;
        _managedLanguage = string.Empty;
    }

    private void Ask(ConfirmKind kind, CirclePersonResponse? person)
    {
        ClearBanners();

        var question = kind switch
        {
            ConfirmKind.Remove => string.Format(CultureInfo.CurrentCulture, L["CircleRemoveConfirm"], person!.DisplayName),
            ConfirmKind.Transfer => string.Format(CultureInfo.CurrentCulture, L["CircleTransferConfirm"], person!.DisplayName),
            _ => L["CircleLeaveConfirm"].Value,
        };

        _confirming = new PendingConfirm(kind, person ?? Nobody, question);
    }

    private async Task ConfirmAsync()
    {
        if (_confirming is not { } pending)
        {
            return;
        }

        _busy = true;
        ClearBanners();

        var result = pending.Kind switch
        {
            ConfirmKind.Remove => await Api.RemoveAsync(CircleId, pending.Person.MembershipId),
            ConfirmKind.Transfer => await Api.TransferOwnershipAsync(CircleId, pending.Person.MembershipId),
            _ => await Api.LeaveAsync(CircleId),
        };

        _busy = false;
        _confirming = null;

        if (!result.IsSuccess)
        {
            // The owner's two refusals land here, and each names the way out (FR-021).
            _actionError = CircleErrorText.Describe(L, result.Error);
            return;
        }

        if (pending.Kind == ConfirmKind.Leave)
        {
            _gone = true;
            _goneMessage = L["CircleLeft"];
            _circle = null;
            return;
        }

        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        ClearBanners();

        var result = await Api.DeleteAsync(CircleId, new DeleteCircleRequest(_confirmedName.Trim()));

        _busy = false;

        if (!result.IsSuccess)
        {
            _actionError = CircleErrorText.Describe(L, result.Error);
            return;
        }

        _gone = true;
        _goneMessage = L["CircleDeleted"];
        _circle = null;
    }

    private bool CanRemove(CirclePersonResponse person)
    {
        if (person.IsYou || string.Equals(person.Role, "Owner", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // An admin may remove members and managed members, but only the owner removes an admin.
        return IsOwner || (IsAdminRole(_circle?.Role) && !IsAdminRole(person.Role));
    }

    private string? RoleBadge(string role) => role.ToUpperInvariant() switch
    {
        "OWNER" => L["CircleRoleOwner"].Value,
        "ADMIN" => L["CircleRoleAdmin"].Value,
        _ => null,
    };

    // Every banner on this page is about the action that just happened. One page carries several
    // actions, so each one clears what the previous left behind — otherwise "Saved" sits above an
    // unrelated invite, still claiming to describe it.
    private void ClearBanners()
    {
        _actionError = null;
        _inviteError = null;
        _inviteSent = false;
        _notice = null;
    }

    private async Task RunAsync(Func<Task<ApiResult>> action)
    {
        _busy = true;
        ClearBanners();

        var result = await action();

        _busy = false;

        if (result.IsSuccess)
        {
            _notice = L["CircleSaved"];
            await LoadAsync();
            return;
        }

        _actionError = CircleErrorText.Describe(L, result.Error);
    }

    // Stands in for the person a circle-wide confirmation has none of; never rendered.
    private static readonly CirclePersonResponse Nobody =
        new(Guid.Empty, string.Empty, "Member", false, false);
}
