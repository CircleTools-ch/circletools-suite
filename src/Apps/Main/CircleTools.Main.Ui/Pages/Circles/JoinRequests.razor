@page "/invitations"
@inject IStringLocalizer<AppStrings> L
@inject CirclesApiClient Api

@* The in-app half of FR-018. It carries no token from any mail: what admits the caller is that
   their verified address is the invited one, which is the same check the link path makes. *@

<PageTitle>@L["InvitationsTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["InvitationsTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["InvitationsLead"]</MudText>

        <ProblemAlert Message="@_error" />
        <ConnectivityRequired Message="@(_offline ? L["CircleOfflineNotice"].Value : null)" />

        @if (_notice is { Length: > 0 })
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@_notice</MudAlert>
        }

        @if (_offline)
        {
            @* Online-only (ADR-0033); the notice above is the whole screen while offline. *@
        }
        else if (_requests is null)
        {
            <MudText Class="mud-text-secondary">@L["CircleLoading"]</MudText>
        }
        else if (_requests.Count == 0)
        {
            <MudText Class="mud-text-secondary">@L["InvitationsEmpty"]</MudText>
        }
        else
        {
            <MudStack Spacing="1">
                @foreach (var request in _requests)
                {
                    <MudPaper Elevation="1" Class="pa-3">
                        <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                            <div>
                                <div class="d-flex align-center flex-wrap gap-2">
                                    <MudText Typo="Typo.subtitle1"><strong>@request.CircleName</strong></MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@request.CircleLabel</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @string.Format(
                                        CultureInfo.CurrentCulture,
                                        L["InvitationFrom"],
                                        request.InviterDisplayName)
                                </MudText>
                            </div>
                            <div class="d-flex gap-1">
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                           Disabled="@_busy" OnClick="@(() => StartAcceptAsync(request))">
                                    @L["InvitationAccept"]
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           Disabled="@_busy" OnClick="@(() => DeclineAsync(request))">
                                    @L["InvitationDecline"]
                                </MudButton>
                            </div>
                        </div>

                        @* The offline-profile choice, shown inline once the recipient chose to accept
                           and there is something to pick (FR-019). Nothing to choose accepts straight
                           away, so this only ever appears for a circle with offline people. *@
                        @if (_choosingFor?.InvitationId == request.InvitationId && _targets is not null)
                        {
                            <div class="mt-3">
                                <JoinAsChooser Targets="_targets" @bind-Value="_chosenTargetId" />
                                <div class="d-flex gap-2 align-center">
                                    <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                               Disabled="@_busy" OnClick="@(() => ConfirmAcceptAsync(request))">
                                        @L["InvitationJoinConfirm"]
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               Disabled="@_busy" OnClick="CancelChoosing">
                                        @L["CircleConfirmNo"]
                                    </MudButton>
                                </div>
                            </div>
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<JoinRequestResponse>? _requests;
    private JoinRequestResponse? _choosingFor;
    private JoinTargetsResponse? _targets;
    private Guid? _chosenTargetId;
    private string? _error;
    private string? _notice;
    private bool _busy;
    private bool _offline;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetJoinRequestsAsync();

        if (result.Value is { } requests)
        {
            _requests = requests;
            _error = null;
            _offline = false;
            return;
        }

        if (result.Error?.Failure == ApiFailure.Unreachable)
        {
            _offline = true;
            _error = null;
            return;
        }

        _error = CircleErrorText.Describe(L, result.Error);
        _offline = false;
    }

    /// <summary>
    /// First half of accepting: fetch the offline profiles this recipient may join as. When there is
    /// nothing to choose — the ordinary case of a circle with no offline people — accept immediately;
    /// otherwise reveal the inline chooser and wait for the recipient to confirm.
    /// </summary>
    private async Task StartAcceptAsync(JoinRequestResponse request)
    {
        _busy = true;
        _error = null;
        _notice = null;
        _chosenTargetId = null;

        var targets = await Api.GetJoinRequestTargetsAsync(request.CircleId, request.InvitationId);

        _busy = false;

        // A failed targets read (offline, or the invitation lapsed) should not block joining: fall
        // back to a plain accept, which surfaces the real error if there is one.
        var hasChoice = targets.Value is { } t
            && (t.PreselectedMembershipId is not null || t.Options.Count > 0);

        if (!hasChoice)
        {
            await AcceptAsync(request);
            return;
        }

        _targets = targets.Value;
        _choosingFor = request;
    }

    private Task ConfirmAcceptAsync(JoinRequestResponse request) => AcceptAsync(request);

    private void CancelChoosing()
    {
        _choosingFor = null;
        _targets = null;
        _chosenTargetId = null;
    }

    private Task AcceptAsync(JoinRequestResponse request) =>
        RespondAsync(
            () => Api.AcceptJoinRequestAsync(request.CircleId, request.InvitationId, _chosenTargetId),
            L["InvitationAccepted"]);

    private Task DeclineAsync(JoinRequestResponse request) =>
        RespondAsync(
            () => Api.DeclineJoinRequestAsync(request.CircleId, request.InvitationId),
            L["InvitationDeclined"]);

    private async Task RespondAsync(Func<Task<ApiResult>> action, string notice)
    {
        _busy = true;
        _error = null;
        _notice = null;

        var result = await action();

        _busy = false;

        if (result.IsSuccess)
        {
            _notice = notice;
            CancelChoosing();
            await LoadAsync();
            return;
        }

        _error = CircleErrorText.Describe(L, result.Error);
    }
}
