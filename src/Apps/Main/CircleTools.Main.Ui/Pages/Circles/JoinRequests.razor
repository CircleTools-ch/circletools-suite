@page "/invitations"
@inject IStringLocalizer<AppStrings> L
@inject CirclesApiClient Api

@* The in-app half of FR-018. It carries no token from any mail: what admits the caller is that
   their verified address is the invited one, which is the same check the link path makes. *@

<PageTitle>@L["InvitationsTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["InvitationsTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["InvitationsLead"]</MudText>

        <ProblemAlert Message="@_error" />
        <ConnectivityRequired Message="@(_offline ? L["CircleOfflineNotice"].Value : null)" />

        @if (_notice is { Length: > 0 })
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@_notice</MudAlert>
        }

        @if (_offline)
        {
            @* Online-only (ADR-0033); the notice above is the whole screen while offline. *@
        }
        else if (_requests is null)
        {
            <MudText Class="mud-text-secondary">@L["CircleLoading"]</MudText>
        }
        else if (_requests.Count == 0)
        {
            <MudText Class="mud-text-secondary">@L["InvitationsEmpty"]</MudText>
        }
        else
        {
            <MudStack Spacing="1">
                @foreach (var request in _requests)
                {
                    <MudPaper Elevation="1" Class="d-flex justify-space-between align-center flex-wrap gap-2 pa-3">
                        <div>
                            <div class="d-flex align-center flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle1"><strong>@request.CircleName</strong></MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@request.CircleLabel</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @string.Format(
                                    CultureInfo.CurrentCulture,
                                    L["InvitationFrom"],
                                    request.InviterDisplayName)
                            </MudText>
                        </div>
                        <div class="d-flex gap-1">
                            <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="@_busy" OnClick="@(() => AcceptAsync(request))">
                                @L["InvitationAccept"]
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       Disabled="@_busy" OnClick="@(() => DeclineAsync(request))">
                                @L["InvitationDecline"]
                            </MudButton>
                        </div>
                    </MudPaper>
                }
            </MudStack>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<JoinRequestResponse>? _requests;
    private string? _error;
    private string? _notice;
    private bool _busy;
    private bool _offline;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetJoinRequestsAsync();

        if (result.Value is { } requests)
        {
            _requests = requests;
            _error = null;
            _offline = false;
            return;
        }

        if (result.Error?.Failure == ApiFailure.Unreachable)
        {
            _offline = true;
            _error = null;
            return;
        }

        _error = CircleErrorText.Describe(L, result.Error);
        _offline = false;
    }

    private Task AcceptAsync(JoinRequestResponse request) =>
        RespondAsync(
            () => Api.AcceptJoinRequestAsync(request.CircleId, request.InvitationId),
            L["InvitationAccepted"]);

    private Task DeclineAsync(JoinRequestResponse request) =>
        RespondAsync(
            () => Api.DeclineJoinRequestAsync(request.CircleId, request.InvitationId),
            L["InvitationDeclined"]);

    private async Task RespondAsync(Func<Task<ApiResult>> action, string notice)
    {
        _busy = true;
        _error = null;
        _notice = null;

        var result = await action();

        _busy = false;

        if (result.IsSuccess)
        {
            _notice = notice;
            await LoadAsync();
            return;
        }

        _error = CircleErrorText.Describe(L, result.Error);
    }
}
