@page "/circles"
@inject IStringLocalizer<AppStrings> L
@inject CirclesApiClient Api
@inject NavigationManager Nav

<PageTitle>@L["CirclesTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["CirclesTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["CirclesLead"]</MudText>

        <ProblemAlert Message="@_error" />
        <ConnectivityRequired Message="@(_offline ? L["CircleOfflineNotice"].Value : null)" />

        @if (_offline)
        {
            @* Circles are online-only (ADR-0033); the notice above is the whole screen while offline. *@
        }
        else if (_circles is null)
        {
            <MudText Class="mud-text-secondary">@L["CircleLoading"]</MudText>
        }
        else if (_circles.Count == 0)
        {
            <MudText Class="mud-text-secondary">@L["CirclesEmpty"]</MudText>
        }
        else
        {
            <MudStack Spacing="1" Class="mb-4 circles-list">
                @foreach (var circle in _circles)
                {
                    <MudPaper Elevation="1" Class="d-flex justify-space-between align-center flex-wrap gap-2 pa-3">
                        <div class="d-flex align-center flex-wrap gap-2">
                            @* The label is user data, shown exactly as it was stored. It is never
                               looked up in a resource file - that would silently retranslate a
                               circle someone named themselves (FR-016). *@
                            <MudText Typo="Typo.subtitle1"><strong>@circle.Name</strong></MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@circle.Label</MudText>
                            @* A circle always holds at least the person reading this, and a circle
                               just created holds nobody else - so one is the count this list shows
                               most often, and it needs its own entry rather than "1 Personen". *@
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @(circle.PeopleCount == 1
                                    ? L["CirclesPeopleCountOne"].Value
                                    : string.Format(Culture, L["CirclesPeopleCount"], circle.PeopleCount))
                            </MudText>
                            @if (RoleBadge(circle.Role) is { } badge)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@badge</MudChip>
                            }
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   Href="@($"circles/{circle.Id}")">
                            @L["CirclesOpen"]
                        </MudButton>
                    </MudPaper>
                }
            </MudStack>
        }

        @if (!_offline)
        {
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Typo="Typo.h6" GutterBottom="true">@L["CirclesCreateTitle"]</MudText>

                <form @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                    <ProblemAlert Message="@_createError" />

                    <MudStack Spacing="3" Style="max-width:26rem;">
                        <MudTextField @bind-Value="_name" Immediate="true" Label="@L["CircleNameField"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" id="circle-name" />
                        <MudTextField @bind-Value="_label" Immediate="true" Label="@L["CircleLabelField"]"
                                      HelperText="@L["CircleLabelHint"]" Variant="Variant.Outlined" Margin="Margin.Dense" id="circle-label" />

                        <BusyButton Label="@L["CirclesCreateSubmit"]"
                                    Busy="_creating"
                                    Disabled="@(_name.Trim().Length == 0)" />
                    </MudStack>
                </form>
            </MudPaper>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<CircleSummaryResponse>? _circles;
    private string _name = string.Empty;
    private string _label = string.Empty;
    private string? _error;
    private string? _createError;
    private bool _creating;
    private bool _offline;

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    protected override async Task OnInitializedAsync()
    {
        // Prefilled from the current language, and only here. Once the circle exists its label is
        // user data: never re-defaulted, never re-translated (FR-016).
        _label = L["CircleLabelDefault"];

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetMineAsync();

        if (result.Value is { } circles)
        {
            _circles = circles;
            _error = null;
            _offline = false;
        }
        else if (result.Error?.Failure == ApiFailure.Unreachable)
        {
            // Circles are online-only (ADR-0033): say the screen needs a connection rather than
            // showing it as a generic failure.
            _offline = true;
            _error = null;
        }
        else
        {
            _error = CircleErrorText.Describe(L, result.Error);
            _offline = false;
        }
    }

    private async Task CreateAsync()
    {
        _creating = true;
        _createError = null;

        var result = await Api.CreateAsync(new CreateCircleRequest(_name.Trim(), _label.Trim()));

        _creating = false;

        if (result.Value is { } created)
        {
            Nav.NavigateTo($"circles/{created.Id}");
            return;
        }

        _createError = CircleErrorText.Describe(L, result.Error);
    }

    private string? RoleBadge(string role) => role.ToUpperInvariant() switch
    {
        // Owner and admin only. Badging all three roles makes the list noise; what matters at a
        // glance is who else can act (FEAT-003).
        "OWNER" => L["CircleRoleOwner"].Value,
        "ADMIN" => L["CircleRoleAdmin"].Value,
        _ => null,
    };
}
