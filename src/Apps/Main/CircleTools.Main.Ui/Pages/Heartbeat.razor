@page "/heartbeat"
@inject HttpClient Http

<PageTitle>Heartbeat</PageTitle>

<h1>Heartbeat</h1>
<p>A throwaway end-to-end sample: create a heartbeat and list the stored ones.</p>

<div>
    <input @bind="_note" placeholder="Note" aria-label="Note" />
    <button @onclick="CreateAsync" disabled="@_busy">Send heartbeat</button>
</div>

@if (_error is not null)
{
    <p role="alert">@_error</p>
}

@if (_heartbeats is null)
{
    <p>Loading...</p>
}
else if (_heartbeats.Count == 0)
{
    <p>No heartbeats yet.</p>
}
else
{
    <ul>
        @foreach (var heartbeat in _heartbeats)
        {
            <li>@heartbeat.CreatedAt.ToString("u") — @heartbeat.Note</li>
        }
    </ul>
}

@code {
    private const string Endpoint = "api/v1/heartbeats";

    private IReadOnlyList<HeartbeatDto>? _heartbeats;
    private string _note = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_note))
        {
            _error = "Note must not be empty.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(Endpoint, new CreateHeartbeatRequest(_note));
            response.EnsureSuccessStatusCode();
            _note = string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _heartbeats = await Http.GetFromJsonAsync<List<HeartbeatDto>>(Endpoint) ?? [];
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
            _heartbeats = [];
        }
    }
}
