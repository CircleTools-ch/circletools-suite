@page "/heartbeat"
@inject HttpClient Http

<PageTitle>Heartbeat</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Heartbeat</MudText>
<MudText Class="mud-text-secondary mb-4">A throwaway end-to-end sample: create a heartbeat and list the stored ones.</MudText>

<div class="d-flex gap-2 align-start flex-wrap mb-4">
    <MudTextField @bind-Value="_note" Immediate="true" Placeholder="Note" Label="Note"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" Style="min-width:12rem;" />
    <MudButton Color="Color.Primary" Variant="Variant.Filled" Class="mt-1"
               OnClick="CreateAsync" Disabled="@_busy">Send heartbeat</MudButton>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true" role="alert">@_error</MudAlert>
}

@if (_heartbeats is null)
{
    <MudText>Loading...</MudText>
}
else if (_heartbeats.Count == 0)
{
    <MudText class="mud-text-secondary">No heartbeats yet.</MudText>
}
else
{
    <MudList T="string" Dense="true">
        @foreach (var heartbeat in _heartbeats)
        {
            <MudListItem T="string">@heartbeat.CreatedAt.ToString("u") — @heartbeat.Note</MudListItem>
        }
    </MudList>
}

@code {
    private const string Endpoint = "api/v1/heartbeats";

    private IReadOnlyList<HeartbeatDto>? _heartbeats;
    private string _note = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_note))
        {
            _error = "Note must not be empty.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(Endpoint, new CreateHeartbeatRequest(_note));
            response.EnsureSuccessStatusCode();
            _note = string.Empty;
            await LoadAsync();
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _heartbeats = await Http.GetFromJsonAsync<List<HeartbeatDto>>(Endpoint) ?? [];
        }
        catch (HttpRequestException exception)
        {
            _error = exception.Message;
            _heartbeats = [];
        }
    }
}
