@inject ThemeState Theme
@inject IStringLocalizer<SharedStrings> L
@implements IDisposable

@*
    The System/Light/Dark switch (ADR-0040). It writes to ThemeState (persisted via IKeyValueStore);
    the shell's MudThemeProvider re-renders from ThemeState.Changed, so the whole app follows.
*@
<MudMenu Icon="@CurrentIcon" Color="Color.Inherit" AriaLabel="@L["ThemeAppearance"]" Dense="true">
    <MudMenuItem Icon="@Icons.Material.Filled.BrightnessAuto"
                 OnClick="@(() => SetAsync(ThemeMode.System))">@L["ThemeSystem"]</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.LightMode"
                 OnClick="@(() => SetAsync(ThemeMode.Light))">@L["ThemeLight"]</MudMenuItem>
    <MudMenuItem Icon="@Icons.Material.Filled.DarkMode"
                 OnClick="@(() => SetAsync(ThemeMode.Dark))">@L["ThemeDark"]</MudMenuItem>
</MudMenu>

@code {
    protected override void OnInitialized() => Theme.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private string CurrentIcon => Theme.Mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.BrightnessAuto,
    };

    private Task SetAsync(ThemeMode mode) => Theme.SetModeAsync(mode);

    public void Dispose() => Theme.Changed -= OnChanged;
}
