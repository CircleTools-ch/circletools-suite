@inject ICultureProvider Culture
@inject IStringLocalizer<SharedStrings> L

@*
    The language picker. Changing the selection re-renders the app in the new language rather than
    reloading the page (UC-MAIN-005) — see CultureBoundary, which is what makes that work.
*@

<MudSelect T="string" Value="Culture.CurrentCulture.Name" ValueChanged="OnChangedAsync"
           Label="@L["Language"]" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
           Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Language">
    @foreach (var culture in AppCultures.Supported)
    {
        <MudSelectItem T="string" Value="@culture">@AppCultures.DisplayName(culture)</MudSelectItem>
    }
</MudSelect>

@code {
    private async Task OnChangedAsync(string? value) =>
        await Culture.SetCultureAsync(value ?? AppCultures.DefaultCulture);
}
