@implements IDisposable
@inject ICultureProvider Culture
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.JSInterop

@*
    Rebuilds everything below it whenever the language changes.

    IStringLocalizer resolves CultureInfo.CurrentUICulture at lookup time, so a re-render is all a
    language switch needs — the obvious implementation reloads the whole page, which UC-MAIN-005
    explicitly rules out ("without a reload or a flash of the wrong language").

    It hands the culture name to its child content so the child can put an @key on the subtree. That
    is not belt-and-braces: calling StateHasChanged here alone does *not* reliably reach the layout,
    which hangs off Router → RouteView → LayoutView and re-renders on its own schedule. Verified in
    a browser: without the key, choosing a new language left the navigation and the page heading in
    the previous one until the next navigation. Keying rebuilds the subtree, so every component
    reads the new culture on its first render.
*@

@{
    // MAUI Blazor Hybrid runs render batches on a pool of threads, so the batch that rebuilds this
    // subtree after a language change can execute on a different thread than the one CultureProvider.Apply
    // set the thread-static CurrentUICulture on — which would leave the rebuilt tree resolving
    // IStringLocalizer strings under the STALE culture (the "switching language does nothing on Android"
    // bug). Re-assert both thread cultures here: the keyed subtree instantiates and first-renders in this
    // same synchronous render batch, so it reads what is set now. Harmless no-op on single-threaded WASM,
    // and still no page reload (UC-MAIN-005). Formatting stays on the device region (ADR-0056).
    CultureInfo.CurrentUICulture = Culture.CurrentCulture;
    CultureInfo.CurrentCulture = Culture.FormattingCulture;
}
@ChildContent(Culture.CurrentCulture.Name)

@code {
    /// <summary>The application tree, given the current culture name to key itself on.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment<string> ChildContent { get; set; } = default!;

    // The language <html lang> was last set to, so a re-render with the same language costs no JS call.
    private string? _documentLanguage;

    protected override void OnInitialized() => Culture.CultureChanged += OnCultureChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var language = Culture.CurrentCulture.Name;
        if (language == _documentLanguage)
        {
            return;
        }

        // index.html can only name one language, so this is what tells screen readers and the browser's
        // translation offer the real one (BTP-7), on start and on every switch.
        _documentLanguage = language;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/CircleTools.Ui.Shared/js/documentLanguage.js");
            await module.InvokeVoidAsync("setLanguage", language);
        }
        catch (JSException)
        {
            // No JS environment or the module is unavailable: the document keeps the language it had.
        }
    }

    private void OnCultureChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Culture.CultureChanged -= OnCultureChanged;
}
