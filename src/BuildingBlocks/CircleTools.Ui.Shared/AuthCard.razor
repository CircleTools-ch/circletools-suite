@*
    The centred card every account screen sits in, so sign-up, sign-in and reset read as one flow
    rather than three separately styled pages (ADR-0040: MudBlazor).
*@

<div class="d-flex justify-center">
    <MudPaper Elevation="2" Class="pa-6 my-4" Style="width:100%;max-width:26rem;">
        <MudText Typo="Typo.h5" GutterBottom="true">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Lead))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@Lead</MudText>
        }
        @ChildContent
    </MudPaper>
</div>
@if (Footer is not null)
{
    <div class="d-flex justify-center">
        <div class="mud-text-secondary mb-4" style="max-width:26rem;font-size:0.85rem;text-align:center;">
            @Footer
        </div>
    </div>
}

@code {
    /// <summary>The screen's heading. Rendered as the page's single h1.</summary>
    [Parameter]
    [EditorRequired]
    public string? Title { get; set; }

    /// <summary>An optional sentence under the heading explaining what happens next.</summary>
    [Parameter]
    public string? Lead { get; set; }

    /// <summary>The form itself.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Links out of this screen — "already have an account?" and the like.</summary>
    [Parameter]
    public RenderFragment? Footer { get; set; }
}
