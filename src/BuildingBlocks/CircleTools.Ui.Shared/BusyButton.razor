@inject IStringLocalizer<SharedStrings> L

@*
    A button that disables itself while its action is running (ADR-0040: MudBlazor). Every account page
    has one, and every one of them can be double-submitted without it — sign-up twice, delete twice.
*@

<MudButton ButtonType="@(Type == "submit" ? ButtonType.Submit : ButtonType.Button)"
           Variant="Variant" Color="Color" Size="Size" FullWidth="FullWidth"
           Disabled="@(Busy || Disabled)" OnClick="OnClick">
    @if (Busy)
    {
        <MudProgressCircular Class="mr-2" Size="MudBlazor.Size.Small" Indeterminate="true" />
        <span class="visually-hidden">@L["Working"]</span>
    }
    @Label
</MudButton>

@code {
    /// <summary>The button's caption, supplied by the page so the wording stays with its own resources.</summary>
    [Parameter]
    [EditorRequired]
    public string? Label { get; set; }

    /// <summary>Whether the action is currently running.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Whether the button is unavailable for reasons other than being busy.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>The HTML button type; <c>submit</c> by default, since these sit in forms.</summary>
    [Parameter]
    public string Type { get; set; } = "submit";

    /// <summary>The Mud button style; a filled primary button by default.</summary>
    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    /// <summary>The Mud button colour; primary by default.</summary>
    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    /// <summary>The Mud button size; medium by default.</summary>
    [Parameter]
    public Size Size { get; set; } = Size.Medium;

    /// <summary>Whether the button spans the full width of its container.</summary>
    [Parameter]
    public bool FullWidth { get; set; }

    /// <summary>Invoked on click, for buttons that are not form submits.</summary>
    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
}
