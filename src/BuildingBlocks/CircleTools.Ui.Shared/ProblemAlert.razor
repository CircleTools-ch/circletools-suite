@*
    Renders a failure the user needs to know about (ADR-0040: MudBlazor).

    role="alert" is required, not decorative: TP-002 makes it an accessibility criterion, so a screen
    reader announces the failure instead of leaving the user waiting on a form that silently refused.
*@

@if (!string.IsNullOrWhiteSpace(Message))
{
    <MudAlert Severity="Severity" Class="mb-3" Dense="true" role="alert">
        <div>@Message</div>
        @if (Details is { Count: > 0 })
        {
            <ul class="mb-0 mt-2" style="font-size:0.85rem;">
                @foreach (var detail in Details)
                {
                    <li>@detail</li>
                }
            </ul>
        }
    </MudAlert>
}

@code {
    /// <summary>The message to show. Nothing renders when this is empty.</summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>Per-field messages shown beneath the main one.</summary>
    [Parameter]
    public IReadOnlyList<string>? Details { get; set; }

    /// <summary>The alert severity; an error by default.</summary>
    [Parameter]
    public Severity Severity { get; set; } = Severity.Error;
}
