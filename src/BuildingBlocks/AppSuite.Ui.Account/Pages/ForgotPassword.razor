@page "/account/forgot-password"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api

<PageTitle>@L["ForgotTitle"]</PageTitle>

@if (_sent)
{
    @* Identical whether or not the address has an account (NFR-005). It also says the current
       password still works — requesting a reset must not lock anyone out, and a stranger who typed
       someone else's address should not be able to make them think it did. *@
    <AuthCard Title="@L["ForgotDoneTitle"]">
        <ChildContent>
            <p class="mb-0">@L["ForgotDoneText"]</p>
        </ChildContent>
    </AuthCard>
}
else
{
    <AuthCard Title="@L["ForgotTitle"]" Lead="@L["ForgotLead"]">
        <ChildContent>
            <form class="appsuite-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <ProblemAlert Message="@_error" />

                <div>
                    <label class="form-label" for="forgot-email">@L["FieldEmail"]</label>
                    <input id="forgot-email" type="email" class="form-control" required
                           autocomplete="email" @bind="_email" />
                </div>

                <BusyButton Label="@L["ForgotSubmit"]" Busy="_busy" />
            </form>
        </ChildContent>
        <Footer>
            <a href="account/login">@L["NavSignIn"]</a>
        </Footer>
    </AuthCard>
}

@code {
    private string _email = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Api.ForgotPasswordAsync(new ForgotPasswordRequest(_email));

        _busy = false;

        if (result.IsSuccess)
        {
            _sent = true;
            return;
        }

        _error = ApiErrorText.Describe(L, result.Error);
    }
}
