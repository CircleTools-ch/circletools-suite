<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The FR-007 breached-password corpus (ADR-0027). Without this the check silently passes
         every password, so EmbeddedBreachedPasswordList throws rather than degrade quietly. -->
    <EmbeddedResource Include="Passwords\BreachedPasswords.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppSuite.SharedKernel\AppSuite.SharedKernel.csproj" />
  </ItemGroup>

</Project>
