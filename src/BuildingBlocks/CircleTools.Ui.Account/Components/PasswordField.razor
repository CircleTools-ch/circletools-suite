@inject IStringLocalizer<AccountStrings> L

@*
    A password field with a show/hide toggle (PR-13): a typo in a masked password is invisible on a phone keyboard.
    Masked is the default, and a new instance starts masked, so reopening a page always hides the text.

    While the text shows, the input is an ordinary text input, so the attributes below keep the keyboard from
    correcting or capitalizing it and the browser from spell-checking it.
*@
<MudTextField @ref="_field" T="string" Value="Value" ValueChanged="ValueChanged" Label="@Label" HelperText="@HelperText"
              InputType="@(_visible ? InputType.Text : InputType.Password)" Immediate="Immediate"
              Variant="Variant.Outlined" Margin="Margin.Dense" Required="Required"
              Adornment="Adornment.End"
              AdornmentIcon="@(_visible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              AdornmentAriaLabel="@(_visible ? L["HidePassword"] : L["ShowPassword"])"
              OnAdornmentClick="Toggle"
              UserAttributes="_inputAttributes" />

@code {
    private MudTextField<string>? _field;
    private bool _visible;
    private Dictionary<string, object?> _inputAttributes = [];

    /// <summary>The password.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>Raised when the password changes.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>The field's label.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>The hint under the field.</summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>Whether the field is required.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Whether the value updates on every keystroke instead of when the field loses focus.</summary>
    [Parameter]
    public bool Immediate { get; set; }

    /// <summary>Attributes for the input, such as <c>id</c> and <c>autocomplete</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object?>? Attributes { get; set; }

    protected override void OnParametersSet() =>
        _inputAttributes = new Dictionary<string, object?>(Attributes ?? [], StringComparer.Ordinal)
        {
            ["autocapitalize"] = "none",
            ["autocorrect"] = "off",
            ["spellcheck"] = "false",
        };

    /// <summary>Masks the field again and clears its validation, for a form that has just emptied it.</summary>
    /// <returns>A task that completes when the field is reset.</returns>
    public async Task ResetAsync()
    {
        _visible = false;
        await FieldValidation.ResetAsync(_field);
        StateHasChanged();
    }

    private void Toggle() => _visible = !_visible;
}
