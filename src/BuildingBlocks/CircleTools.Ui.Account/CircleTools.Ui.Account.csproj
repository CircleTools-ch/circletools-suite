<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- The account/session client (ADR-0034): the shared UI for the Main service's account API, used by
       every frontend. Depends on the shared blocks plus CircleTools.Main.Contracts — the backend's account
       contract, the same cross-app edge CircleTools.SecretSanta.LocalStore already has for sync. Never the
       server, Identity or EF (see Ui.AccountLayeringTests). -->
  <ItemGroup>
    <ProjectReference Include="..\CircleTools.ApiClient\CircleTools.ApiClient.csproj" />
    <ProjectReference Include="..\CircleTools.Localization\CircleTools.Localization.csproj" />
    <ProjectReference Include="..\CircleTools.Ui.Abstractions\CircleTools.Ui.Abstractions.csproj" />
    <ProjectReference Include="..\CircleTools.Ui.Shared\CircleTools.Ui.Shared.csproj" />
    <ProjectReference Include="..\..\Apps\Main\CircleTools.Main.Contracts\CircleTools.Main.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

</Project>
