@page "/reset-password"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api
@inject AccountSession Session

@*
    Root-level route, fixed by the links in already-sent reset mails (MailTemplateRenderer).
*@

<PageTitle>@L["ResetTitle"]</PageTitle>

@if (_done)
{
    <AuthCard Title="@L["ResetDoneTitle"]">
        <ChildContent>
            <MudText>@L["ResetDoneText"]</MudText>
        </ChildContent>
        <Footer>
            <MudLink Href="account/login">@L["NavSignIn"]</MudLink>
        </Footer>
    </AuthCard>
}
else
{
    <AuthCard Title="@L["ResetTitle"]">
        <ChildContent>
            @if (!HasLink)
            {
                <ProblemAlert Message="@L["ResetInvalidLink"]" />
            }
            else
            {
                <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                    <ProblemAlert Message="@_error" Details="@_details" />

                    <MudStack Spacing="3">
                        <PasswordField @bind-Value="_password" Label="@L["FieldNewPassword"]" HelperText="@L["PasswordHint"]"
                                       Required="true" autocomplete="new-password" />

                        <BusyButton Label="@L["ResetSubmit"]" Busy="_busy" FullWidth="true" />
                    </MudStack>
                </form>
            }
        </ChildContent>
    </AuthCard>
}

@code {
    private string _password = string.Empty;
    private string? _error;
    private IReadOnlyList<string>? _details;
    private bool _busy;
    private bool _done;

    /// <summary>The account being reset, from the link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    /// <summary>The single-use token from the link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private bool HasLink => !string.IsNullOrWhiteSpace(UserId) && !string.IsNullOrWhiteSpace(Token);

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _details = null;

        var result = await Api.ResetPasswordAsync(new ResetPasswordRequest(UserId!, Token!, _password));

        _busy = false;

        if (!result.IsSuccess)
        {
            _error = ApiErrorText.Describe(L, result.Error);
            _details = ApiErrorText.Details(L, result.Error);
            return;
        }

        // Switch to the confirmation before clearing, for the same reason as the deletion page:
        // clearing publishes a new authentication state, and anything still on screen reacts to it.
        _done = true;

        // The server revoked every session, including any this browser was holding. Dropping the
        // local tokens without calling /logout keeps the two sides in step: leaving them would show
        // a signed-in menu backed by credentials the server has already thrown away.
        await Session.ForgetAsync();
    }
}
