@page "/account/security"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api
@inject IPasskeyCeremony Passkeys
@inject AccountSession Session
@inject NavigationManager Navigation

<PageTitle>@L["SecurityTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["SecurityTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["SecurityLead"]</MudText>

        @* Change password (FR-049, ADR-0079): this device stays signed in, every other session ends. *@
        <MudPaper Elevation="1" Class="pa-4 mb-4" id="change-password">
            <MudText Typo="Typo.h6">@L["ChangePasswordTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["ChangePasswordLead"]</MudText>

            @if (_passwordChanged)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@L["PasswordChanged"]</MudAlert>
            }

            <form @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
                <ProblemAlert Message="@_passwordError" Details="@_passwordDetails" />

                <MudStack Spacing="3" Style="max-width:26rem;">
                    <MudTextField @ref="_currentPasswordField" @bind-Value="_currentPassword" Label="@L["FieldCurrentPassword"]" InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  autocomplete="current-password" id="current-password" />
                    <MudTextField @ref="_newPasswordField" @bind-Value="_newPassword" Label="@L["FieldNewPassword"]" InputType="InputType.Password"
                                  HelperText="@L["PasswordHint"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" autocomplete="new-password" id="new-password" />
                    <MudTextField @ref="_repeatPasswordField" @bind-Value="_repeatPassword" Label="@L["FieldRepeatPassword"]" InputType="InputType.Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  autocomplete="new-password" id="repeat-password" />

                    <BusyButton Label="@L["ChangePasswordSubmit"]" Busy="_passwordBusy" />
                </MudStack>
            </form>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6">@L["PasskeysTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["PasskeysLead"]</MudText>

            <ProblemAlert Message="@_passkeyError" Details="@_passkeyDetails" />

            @if (_passkeyStatus is not null)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@_passkeyStatus</MudAlert>
            }

            @if (_passkeys.Count == 0)
            {
                <MudText Class="mud-text-secondary mb-3">@L["PasskeysEmpty"]</MudText>
            }
            else
            {
                <MudStack Spacing="1" Class="mb-3">
                    @foreach (var passkey in _passkeys)
                    {
                        <div class="d-flex justify-space-between align-center gap-2">
                            <div>
                                <MudText Typo="Typo.body1"><strong>@passkey.Label</strong></MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @L["PasskeyAddedOn", passkey.CreatedAt.ToLocalTime().ToString("d", Culture)]
                                </MudText>
                            </div>
                            <BusyButton Type="button"
                                        Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                        Label="@L["PasskeyRemove"]"
                                        Busy="@(_removing == passkey.CredentialId)"
                                        OnClick="@(() => RemoveAsync(passkey.CredentialId))" />
                        </div>
                    }
                </MudStack>
            }

            <MudTextField @bind-Value="_label" Label="@L["FieldPasskeyLabel"]" MaxLength="60"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Style="max-width:26rem;" />

            <BusyButton Type="button"
                        Label="@L["PasskeyAdd"]"
                        Busy="_adding"
                        OnClick="AddPasskeyAsync" />
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6">@L["ChangeEmailTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["ChangeEmailLead"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">@L["ChangeEmailCurrent", context.User.Email()]</MudText>

            @if (_emailSent)
            {
                <MudAlert Severity="Severity.Success" Dense="true" role="status">@L["ChangeEmailSent"]</MudAlert>
            }
            else
            {
                <form @onsubmit="ChangeEmailAsync" @onsubmit:preventDefault="true">
                    <ProblemAlert Message="@_emailError" Details="@_emailDetails" />

                    <MudStack Spacing="3" Style="max-width:26rem;">
                        <MudTextField @bind-Value="_newEmail" Label="@L["FieldNewEmail"]" InputType="InputType.Email"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                      autocomplete="email" />

                        <BusyButton Label="@L["ChangeEmailSubmit"]" Busy="_emailBusy" />
                    </MudStack>
                </form>
            }
        </MudPaper>

        @* The signed-in devices (ADR-0079 amendment, Q26): each live session, this one marked, and the others
           can be signed out one at a time — a lost phone no longer means signing out everywhere. *@
        <MudPaper Elevation="1" Class="pa-4 mt-4" id="signed-in-devices">
            <MudText Typo="Typo.h6">@L["DevicesTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["DevicesLead"]</MudText>
            @if (_sessions is null)
            {
                <MudText Typo="Typo.body2">@(_sessionsFailed ? L["DevicesLoadFailed"] : L["DevicesLoading"])</MudText>
            }
            else
            {
                <MudStack Spacing="1">
                    @foreach (var session in _sessions)
                    {
                        <div class="d-flex flex-wrap align-center justify-space-between gap-2 py-1" id="@($"session-{session.Id}")">
                            <div>
                                <MudText Typo="Typo.body1">
                                    @(string.IsNullOrEmpty(session.Device) ? L["DeviceUnknown"] : session.Device)
                                    @if (session.IsCurrent)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ml-1">@L["DeviceThis"]</MudChip>
                                    }
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @L["DeviceTimes", session.SignedInAt.ToLocalTime().ToString("g", Culture), session.LastActiveAt.ToLocalTime().ToString("g", Culture)]
                                </MudText>
                            </div>
                            @if (!session.IsCurrent)
                            {
                                <BusyButton Type="button" Variant="Variant.Text" Color="Color.Error" Label="@L["DeviceSignOut"]"
                                            Busy="@(_revoking == session.Id)" OnClick="() => SignOutDeviceAsync(session.Id)" />
                            }
                        </div>
                    }
                </MudStack>
            }
        </MudPaper>

        @* Sign out on all devices (FR-049, ADR-0079): sign-out itself ends only this device's session. The
           confirmation is inline rather than a dialog, so it shows on every head. *@
        <MudPaper Elevation="1" Class="pa-4 mt-4" id="sign-out-everywhere">
            <MudText Typo="Typo.h6">@L["SignOutEverywhereTitle"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["SignOutEverywhereLead"]</MudText>

            @if (_confirmSignOutEverywhere)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" role="alert">@L["SignOutEverywhereConfirm"]</MudAlert>
                <div class="d-flex flex-wrap gap-2">
                    <BusyButton Type="button" Color="Color.Error" Label="@L["SignOutEverywhereConfirmYes"]"
                                Busy="_signingOutEverywhere" OnClick="SignOutEverywhereAsync" />
                    <MudButton Variant="Variant.Text" OnClick="() => _confirmSignOutEverywhere = false">@L["ConfirmCancel"]</MudButton>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout"
                           OnClick="() => _confirmSignOutEverywhere = true" id="sign-out-everywhere-btn">@L["SignOutEverywhereButton"]</MudButton>
            }
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<PasskeyResponse> _passkeys = [];
    private string _label = string.Empty;
    private string? _passkeyError;
    private IReadOnlyList<string>? _passkeyDetails;
    private string? _passkeyStatus;
    private string? _removing;
    private bool _adding;

    private string _newEmail = string.Empty;
    private string? _emailError;
    private IReadOnlyList<string>? _emailDetails;
    private bool _emailBusy;
    private bool _emailSent;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _repeatPassword = string.Empty;
    private MudTextField<string>? _currentPasswordField;
    private MudTextField<string>? _newPasswordField;
    private MudTextField<string>? _repeatPasswordField;
    private string? _passwordError;
    private IReadOnlyList<string>? _passwordDetails;
    private bool _passwordBusy;
    private bool _passwordChanged;

    private bool _confirmSignOutEverywhere;
    private bool _signingOutEverywhere;

    private List<SessionInfoResponse>? _sessions;
    private bool _sessionsFailed;
    private Guid? _revoking;

    private async Task LoadSessionsAsync()
    {
        var result = await Session.ListSessionsAsync();
        _sessionsFailed = !result.IsSuccess;
        _sessions = result.IsSuccess ? result.Value : null;
    }

    private async Task SignOutDeviceAsync(Guid sessionId)
    {
        _revoking = sessionId;
        try
        {
            await Session.SignOutDeviceAsync(sessionId);
            await LoadSessionsAsync();
        }
        finally
        {
            _revoking = null;
        }
    }

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    /// <summary>
    /// Changes the password (FR-049). A mismatch between the two new entries is caught here, without a
    /// round trip; a wrong current password comes back like a failed sign-in.
    /// </summary>
    private async Task ChangePasswordAsync()
    {
        _passwordError = null;
        _passwordDetails = null;
        _passwordChanged = false;

        if (string.IsNullOrEmpty(_currentPassword) || string.IsNullOrEmpty(_newPassword))
        {
            _passwordError = L["ErrorValidation"];
            return;
        }

        if (!string.Equals(_newPassword, _repeatPassword, StringComparison.Ordinal))
        {
            _passwordError = L["PasswordsDoNotMatch"];
            return;
        }

        _passwordBusy = true;
        var result = await Session.ChangePasswordAsync(_currentPassword, _newPassword);
        _passwordBusy = false;

        if (!result.IsSuccess)
        {
            _passwordError = ApiErrorText.Describe(L, result.Error);
            _passwordDetails = ApiErrorText.Details(L, result.Error);
            return;
        }

        _currentPassword = _newPassword = _repeatPassword = string.Empty;
        _passwordChanged = true;
        // The cleared fields were touched, so they would show "Required" right under the success message (BTP-3).
        StateHasChanged();
        await FieldValidation.ResetAsync(_currentPasswordField, _newPasswordField, _repeatPasswordField);
    }

    /// <summary>Ends every session of the account, this one included (FR-049), and returns to the start.</summary>
    private async Task SignOutEverywhereAsync()
    {
        _signingOutEverywhere = true;
        await Session.SignOutEverywhereAsync();
        _signingOutEverywhere = false;
        Navigation.NavigateTo(string.Empty);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPasskeysAsync();
        await LoadSessionsAsync();
    }

    /// <summary>
    /// Registers a passkey (FR-010): ask the server for a challenge, let the authenticator answer
    /// it, hand the answer back for verification.
    /// </summary>
    /// <remarks>
    /// A dismissed prompt returns null and the page is left untouched — no message, no error
    /// styling (FR-011). Only a ceremony that actually broke says anything.
    /// </remarks>
    private async Task AddPasskeyAsync()
    {
        _adding = true;
        _passkeyError = null;
        _passkeyDetails = null;
        _passkeyStatus = null;

        var options = await Api.PasskeyCreationOptionsAsync();

        if (options.Value is not { } optionsJson)
        {
            _adding = false;
            _passkeyError = ApiErrorText.Describe(L, options.Error);
            return;
        }

        string? credential;

        try
        {
            credential = await Passkeys.CreateAsync(optionsJson);
        }
        catch (PasskeyCeremonyException)
        {
            _adding = false;
            _passkeyError = L["PasskeyUnsupported"];
            return;
        }

        if (credential is null)
        {
            _adding = false;
            return;
        }

        var label = string.IsNullOrWhiteSpace(_label) ? null : _label.Trim();
        var result = await Api.RegisterPasskeyAsync(new RegisterPasskeyRequest(credential, label));

        _adding = false;

        if (!result.IsSuccess)
        {
            _passkeyError = ApiErrorText.Describe(L, result.Error);
            _passkeyDetails = ApiErrorText.Details(L, result.Error);
            return;
        }

        _label = string.Empty;
        _passkeyStatus = L["PasskeyAdded"];
        await LoadPasskeysAsync();
    }

    private async Task RemoveAsync(string credentialId)
    {
        _removing = credentialId;
        _passkeyError = null;
        _passkeyStatus = null;

        var result = await Api.RemovePasskeyAsync(credentialId);

        _removing = null;

        if (!result.IsSuccess)
        {
            _passkeyError = ApiErrorText.Describe(L, result.Error);
            return;
        }

        _passkeyStatus = L["PasskeyRemoved"];
        await LoadPasskeysAsync();
    }

    private async Task LoadPasskeysAsync()
    {
        var result = await Api.ListPasskeysAsync();

        if (result.Value is { } passkeys)
        {
            _passkeys = passkeys;
            return;
        }

        _passkeyError = ApiErrorText.Describe(L, result.Error);
    }

    private async Task ChangeEmailAsync()
    {
        _emailBusy = true;
        _emailError = null;
        _emailDetails = null;

        var result = await Api.ChangeEmailAsync(new ChangeEmailRequest(_newEmail));

        _emailBusy = false;

        if (result.IsSuccess)
        {
            // Same answer whether or not the address is already taken (NFR-005), so there is
            // nothing more specific that could honestly be said here.
            _emailSent = true;
            return;
        }

        _emailError = ApiErrorText.Describe(L, result.Error);
        _emailDetails = ApiErrorText.Details(L, result.Error);
    }
}
