@page "/account/forgot-password"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api

<PageTitle>@L["ForgotTitle"]</PageTitle>

@if (_sent)
{
    @* Identical whether or not the address has an account (NFR-005). It also says the current
       password still works — requesting a reset must not lock anyone out, and a stranger who typed
       someone else's address should not be able to make them think it did. *@
    <AuthCard Title="@L["ForgotDoneTitle"]">
        <ChildContent>
            <MudText>@L["ForgotDoneText"]</MudText>
        </ChildContent>
    </AuthCard>
}
else
{
    <AuthCard Title="@L["ForgotTitle"]" Lead="@L["ForgotLead"]">
        <ChildContent>
            <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <ProblemAlert Message="@_error" />

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_email" Label="@L["FieldEmail"]" InputType="InputType.Email"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  autocomplete="email" id="forgot-email" />

                    <BusyButton Label="@L["ForgotSubmit"]" Busy="_busy" FullWidth="true" />
                </MudStack>
            </form>
        </ChildContent>
        <Footer>
            <MudLink Href="account/login">@L["NavSignIn"]</MudLink>
        </Footer>
    </AuthCard>
}

@code {
    private string _email = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Api.ForgotPasswordAsync(new ForgotPasswordRequest(_email));

        _busy = false;

        if (result.IsSuccess)
        {
            _sent = true;
            return;
        }

        _error = ApiErrorText.Describe(L, result.Error);
    }
}
