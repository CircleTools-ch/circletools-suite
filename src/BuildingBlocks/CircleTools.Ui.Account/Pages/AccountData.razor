@page "/account/data"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api
@inject AccountSession Session
@inject IFileSaver Files

<PageTitle>@L["DataTitle"]</PageTitle>

@if (_deleted)
{
    @* Rendered outside AuthorizeView: the account is gone, so the signed-in branch no longer
       applies and the user would otherwise be bounced to sign-in mid-sentence. *@
    <AuthCard Title="@L["DeleteDoneTitle"]">
        <ChildContent>
            <MudText>@L["DeleteDoneText"]</MudText>
        </ChildContent>
        <Footer>
            <MudLink Href="">@L["DeleteDoneHome"]</MudLink>
        </Footer>
    </AuthCard>
}
else
{
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.h4" GutterBottom="true">@L["DataTitle"]</MudText>
            <MudText Class="mud-text-secondary mb-4">@L["DataLead"]</MudText>

            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6">@L["ExportTitle"]</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["ExportLead"]</MudText>

                <ProblemAlert Message="@_exportError" />

                <BusyButton Type="button"
                            Label="@L["ExportDownload"]"
                            Busy="_exporting"
                            OnClick="ExportAsync" />
            </MudPaper>

            @* Destructive area: marked by colour *and* by its heading, never by colour alone (TP-002). *@
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 circletools-danger"
                      Style="border-color:var(--mud-palette-error);">
                <MudText Typo="Typo.h6" Color="Color.Error">@L["DeleteTitle"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">@L["DeleteLead"]</MudText>

                <form @onsubmit="DeleteAsync" @onsubmit:preventDefault="true">
                    <ProblemAlert Message="@_deleteError" Details="@_deleteDetails" />

                    <MudStack Spacing="3" Style="max-width:26rem;">
                        @* Only shown when the account actually owns shared-by-link groups (FR-043,
                           ADR-0058): the owner decides whether those online copies are handed back to
                           shared-by-link (default — everyone who joined keeps access) or deleted too. *@
                        @if (_ownedSharedGroups > 0)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3" id="delete-shared-disposition">
                                <MudText Typo="Typo.subtitle2">
                                    @L["DeleteSharedGroupsTitle"]
                                </MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                                    @string.Format(CultureInfo.CurrentCulture, L["DeleteSharedGroupsLead"], _ownedSharedGroups)
                                </MudText>
                                <MudRadioGroup @bind-Value="_deleteSharedGroups" T="bool">
                                    <MudRadio Value="false" Color="Color.Primary" Dense="true">
                                        @L["DeleteSharedGroupsHandOff"]
                                    </MudRadio>
                                    <MudRadio Value="true" Color="Color.Error" Dense="true">
                                        @L["DeleteSharedGroupsRemove"]
                                    </MudRadio>
                                </MudRadioGroup>
                            </MudPaper>
                        }

                        @* Bound on input, not on change: the button below is gated on this field, and
                           with the default change binding it only unlocks when the field loses focus —
                           so the user's first click lands on a button still disabled that does nothing. *@
                        <MudTextField @bind-Value="_password" Immediate="true" InputType="InputType.Password"
                                      Label="@L["DeletePasswordPrompt"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Required="true" autocomplete="current-password" id="delete-password" />

                        @* Not the primary style and not the first thing focused on the page: an
                           irreversible action should take a deliberate move to reach (TP-002). *@
                        <BusyButton Variant="Variant.Outlined" Color="Color.Error"
                                    Label="@L["DeleteSubmit"]"
                                    Busy="_deleting"
                                    Disabled="@(_password.Length == 0)" />
                    </MudStack>
                </form>
            </MudPaper>
        </Authorized>
        <NotAuthorized>
            @* Guarded, because deleting an account makes this branch true a moment before the page
               itself re-renders: clearing the session publishes the new authentication state
               synchronously, so an unguarded redirect fires first and the user is bounced to a
               sign-in form instead of being told their account is gone. *@
            @if (!_deleted)
            {
                <RedirectToLogin />
            }
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    private string _password = string.Empty;
    private string? _exportError;
    private string? _deleteError;
    private IReadOnlyList<string>? _deleteDetails;
    private bool _exporting;
    private bool _deleting;
    private bool _deleted;
    private int _ownedSharedGroups;
    private bool _deleteSharedGroups;

    protected override async Task OnInitializedAsync() =>
        _ownedSharedGroups = await Api.GetOwnedSharedGroupCountAsync();

    private async Task ExportAsync()
    {
        _exporting = true;
        _exportError = null;

        var result = await Api.ExportAsync();

        if (result.Value is { } export)
        {
            var json = JsonSerializer.Serialize(export, ExportJson);
            var stamp = export.ExportedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

            await Files.SaveAsync($"circletools-export-{stamp}.json", "application/json", json);
        }
        else
        {
            _exportError = ApiErrorText.Describe(L, result.Error);
        }

        _exporting = false;
    }

    private async Task DeleteAsync()
    {
        _deleting = true;
        _deleteError = null;
        _deleteDetails = null;

        var result = await Api.DeleteAccountAsync(new DeleteAccountRequest(_password, _deleteSharedGroups));

        _deleting = false;

        if (!result.IsSuccess)
        {
            // CircleErrorText, not ApiErrorText: the sole-owner guard (FR-015) refuses this with a
            // 409 carrying `circles_still_owned`, and the status alone would say only "there was a
            // conflict" — leaving the user with no idea that the way out is to hand a circle over.
            // Every other refusal here carries no circle code and falls through to the same
            // status-based sentence as before.
            _deleteError = CircleErrorText.Describe(L, result.Error);
            _deleteDetails = ApiErrorText.Details(L, result.Error);
            return;
        }

        // Set before clearing: the redirect guard above reads this, and clearing publishes the new
        // authentication state before this component gets a chance to re-render.
        _deleted = true;

        // The server revoked the sessions along with the account, so there is nothing to log out of.
        await Session.ForgetAsync();
    }

    // Indented, because a user opening their own export should be able to read it.
    private static readonly JsonSerializerOptions ExportJson =
        new(JsonSerializerDefaults.Web) { WriteIndented = true };
}
