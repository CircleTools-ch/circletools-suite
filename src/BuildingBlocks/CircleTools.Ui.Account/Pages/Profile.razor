@page "/account/profile"
@inject IStringLocalizer<AccountStrings> L
@inject IProfileWriter Profiles
@inject ICultureProvider Culture
@inject NavigationManager Navigation

<PageTitle>@L["ProfileTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h4" GutterBottom="true">@L["ProfileTitle"]</MudText>
        <MudText Class="mud-text-secondary mb-4">@L["ProfileLead"]</MudText>
        @* Which account this is, at the top (Q26): the e-mail is the sign-in identity. *@
        @if (!string.IsNullOrEmpty(context.User.Email()))
        {
            <MudText Class="mb-4" id="profile-email"><strong>@LabelText.WithColon(L["FieldEmail"])</strong> @context.User.Email()</MudText>
        }

        <ProblemAlert Message="@_error" Details="@_details" />

        @if (Saved)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" role="status">@L["ProfileSaved"]</MudAlert>
        }

        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <MudStack Spacing="3" Style="max-width:26rem;">
                <MudTextField @bind-Value="_displayName" Label="@L["FieldDisplayName"]" HelperText="@L["DisplayNameHint"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="100"
                              autocomplete="nickname" />

                <MudSelect T="string" @bind-Value="_language" Label="@L["FieldLanguage"]"
                           Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var culture in AppCultures.Supported)
                    {
                        <MudSelectItem T="string" Value="@culture">@AppCultures.DisplayName(culture)</MudSelectItem>
                    }
                </MudSelect>

                <BusyButton Label="@L["ActionSave"]" Busy="_busy" Disabled="@(!_loaded)" />
            </MudStack>
        </form>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _displayName = string.Empty;
    private string _language = AppCultures.DefaultCulture;
    private string? _error;
    private IReadOnlyList<string>? _details;
    private bool _busy;
    private bool _loaded;

    /// <summary>
    /// Whether to show the "saved" confirmation.
    /// </summary>
    /// <remarks>
    /// It comes from the query string rather than a field because saving a new language rebuilds the
    /// whole component tree (see <c>CultureBoundary</c>), which would take a field with it — leaving
    /// the one save that visibly changes the most as the only one with no confirmation.
    /// </remarks>
    [Parameter]
    [SupplyParameterFromQuery(Name = "saved")]
    public bool Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await Profiles.LoadAsync();

        if (result.Value is { } profile)
        {
            _displayName = profile.DisplayName;
            _language = AppCultures.Normalize(profile.Language);
            _loaded = true;
            return;
        }

        _error = ApiErrorText.Describe(L, result.Error);
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _details = null;

        var result = await Profiles.SaveAsync(new UpdateProfileRequest(_displayName, _language));

        _busy = false;

        if (result.Value is null)
        {
            _error = ApiErrorText.Describe(L, result.Error);
            _details = ApiErrorText.Details(L, result.Error);
            return;
        }

        // "true", not "1": Blazor parses a bool query parameter with bool.TryParse, and anything
        // else throws while binding rather than defaulting to false.
        Navigation.NavigateTo("account/profile?saved=true", replace: true);

        // The page the choice was made on has to change language immediately; saving a preference
        // that only takes effect on the next sign-in would read as the setting not working. This
        // comes after the navigation because it rebuilds the tree, and the new page instance reads
        // the confirmation back out of the URL.
        await Culture.SetCultureAsync(result.Value.Language);
    }
}
