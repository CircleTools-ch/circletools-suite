@page "/confirm-email-change"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api
@inject AuthenticationStateProvider AuthState

@*
    Root-level route, fixed by the links already sent (MailTemplateRenderer).

    The only mail link that needs a signed-in session: the server checks that the caller is the
    account the link names. That makes the two "wrong state" cases — arriving signed out, or signed
    in as someone else — ordinary and worth explaining, rather than a bare 401.
*@

<PageTitle>@Title</PageTitle>

<AuthCard Title="@Title">
    <ChildContent>
        @switch (_state)
        {
            case State.Working:
                <MudText>@L["VerifyWorking"]</MudText>
                break;

            case State.Confirmed:
                <MudText>@L["ConfirmEmailDoneText"]</MudText>
                break;

            case State.SignedOut:
                <MudText>@L["ConfirmEmailSignedOut"]</MudText>
                break;

            case State.WrongAccount:
                <MudText>@L["ConfirmEmailWrongAccount"]</MudText>
                break;

            default:
                <MudText>@L["ConfirmEmailFailed"]</MudText>
                break;
        }
    </ChildContent>
    <Footer>
        @if (_state == State.SignedOut)
        {
            <MudLink Href="account/login">@L["NavSignIn"]</MudLink>
        }
        else
        {
            <MudLink Href="account/security">@L["NavSecurity"]</MudLink>
        }
    </Footer>
</AuthCard>

@code {
    private enum State
    {
        Working,
        Confirmed,
        SignedOut,
        WrongAccount,
        Failed,
    }

    private State _state = State.Working;

    /// <summary>The account changing address, from the link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "userId")]
    public string? UserId { get; set; }

    /// <summary>The address being confirmed, from the link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "newEmail")]
    public string? NewEmail { get; set; }

    /// <summary>The single-use token from the link.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string Title => _state switch
    {
        State.Working => L["ConfirmEmailTitle"],
        State.Confirmed => L["ConfirmEmailDoneTitle"],
        _ => L["ConfirmEmailTitle"],
    };

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId)
            || string.IsNullOrWhiteSpace(NewEmail)
            || string.IsNullOrWhiteSpace(Token))
        {
            _state = State.Failed;
            return;
        }

        var user = (await AuthState.GetAuthenticationStateAsync()).User;

        if (user.Identity?.IsAuthenticated != true)
        {
            _state = State.SignedOut;
            return;
        }

        if (!Guid.TryParse(UserId, out var linkUserId) || user.UserId() != linkUserId)
        {
            // Checked here as well as on the server so the message can say which of the two
            // problems it is; a 401 alone cannot tell "signed out" from "signed in as someone else".
            _state = State.WrongAccount;
            return;
        }

        var result = await Api.ConfirmEmailChangeAsync(new ConfirmEmailChangeRequest(UserId, NewEmail, Token));

        _state = result.IsSuccess ? State.Confirmed : State.Failed;
    }
}
