@page "/account/login"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api
@inject AccountSession Session
@inject IPasskeyCeremony Passkeys
@inject NavigationManager Navigation
@inject ICultureProvider Culture

<PageTitle>@L["LoginTitle"]</PageTitle>

<AuthCard Title="@L["LoginTitle"]" Lead="@L["LoginLead"]">
    <ChildContent>
        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <ProblemAlert Message="@_error" Details="@_details" />

            <MudStack Spacing="3">
                <MudTextField @bind-Value="_email" Label="@L["FieldEmail"]" InputType="InputType.Email"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              autocomplete="email" />

                <MudTextField @bind-Value="_password" Label="@L["FieldPassword"]" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                              autocomplete="current-password" />

                <div>
                    <MudCheckBox @bind-Value="_staySignedIn" Dense="true">@L["LoginStaySignedIn"]</MudCheckBox>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@L["LoginStaySignedInHint"]</MudText>
                </div>

                <BusyButton Label="@L["LoginSubmit"]" Busy="_busy" FullWidth="true" />
            </MudStack>
        </form>

        <MudDivider Class="my-4" />
        <MudText Align="Align.Center" Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["LoginOr"]</MudText>

        <BusyButton Type="button"
                    Variant="Variant.Outlined" Color="Color.Default" FullWidth="true"
                    Label="@L["LoginPasskey"]"
                    Busy="_passkeyBusy"
                    OnClick="SignInWithPasskeyAsync" />

        @* Cross-app SSO (FR-031, ADR-0039). Renders only on a requesting app that registered SSO —
           nothing on the authority origin or a host without SSO (e.g. the MAUI head). *@
        <ContinueWithAccount />
    </ChildContent>
    <Footer>
        <div><MudLink Href="account/forgot-password">@L["LoginForgot"]</MudLink></div>
        <div>@L["LoginNoAccount"] <MudLink Href="account/register">@L["NavRegister"]</MudLink></div>
    </Footer>
</AuthCard>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _staySignedIn;
    private string? _error;
    private IReadOnlyList<string>? _details;
    private bool _busy;
    private bool _passkeyBusy;

    /// <summary>Where to go once signed in; defaults to the dashboard.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        Clear();

        // Give immediate feedback instead of a round-trip that can only come back "invalid".
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _error = L["LoginMissingCredentials"];
            return;
        }

        _busy = true;

        var result = await Session.SignInAsync(_email, _password, _staySignedIn);

        _busy = false;
        Complete(result);
    }

    /// <summary>
    /// Signs in with a passkey (FR-011): fetch a challenge, let the authenticator answer it, post
    /// the answer.
    /// </summary>
    /// <remarks>
    /// A dismissed prompt returns null and leaves the page exactly as it was — no message, no error
    /// styling. Cancelling is a decision, not a mistake, and telling someone off for changing their
    /// mind is the failure mode FR-011 names explicitly.
    /// </remarks>
    private async Task SignInWithPasskeyAsync()
    {
        _passkeyBusy = true;
        Clear();

        var options = await Api.PasskeyRequestOptionsAsync();

        if (options.Value is not { } optionsJson)
        {
            _passkeyBusy = false;
            _error = ApiErrorText.Describe(L, options.Error);
            return;
        }

        string? assertion;

        try
        {
            assertion = await Passkeys.AssertAsync(optionsJson);
        }
        catch (PasskeyCeremonyException)
        {
            _passkeyBusy = false;
            _error = L["LoginPasskeyUnsupported"];
            return;
        }

        if (assertion is null)
        {
            _passkeyBusy = false;
            return;
        }

        var result = await Session.SignInWithPasskeyAsync(assertion, _staySignedIn);

        _passkeyBusy = false;
        Complete(result);
    }

    private void Clear()
    {
        _error = null;
        _details = null;
    }

    private void Complete(ApiResult result)
    {
        if (result.IsSuccess)
        {
            // Signing in may have switched to the account's language. The UI culture is async-local, and it was
            // set inside the awaited sign-in, so this handler's flow still holds the previous one; without this
            // the page navigated to below would render in the old language until something re-rendered it.
            CultureInfo.CurrentUICulture = Culture.CurrentCulture;
            CultureInfo.CurrentCulture = Culture.FormattingCulture;

            // Only same-app paths are followed. An absolute returnUrl would let a crafted link
            // bounce a freshly signed-in user off-site (an open redirect), so anything that is not
            // a plain relative path falls back to the dashboard.
            Navigation.NavigateTo(IsLocal(ReturnUrl) ? ReturnUrl! : string.Empty);
            return;
        }

        _error = ApiErrorText.Describe(L, result.Error);
        _details = ApiErrorText.Details(L, result.Error);
    }

    private static bool IsLocal(string? url) =>
        !string.IsNullOrWhiteSpace(url)
        && !url.StartsWith('/')
        && !url.StartsWith("//", StringComparison.Ordinal)
        && !url.Contains("://", StringComparison.Ordinal);
}
