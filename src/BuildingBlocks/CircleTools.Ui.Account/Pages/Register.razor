@page "/account/register"
@inject IStringLocalizer<AccountStrings> L
@inject AccountApiClient Api
@inject ICultureProvider Culture

<PageTitle>@L["RegisterTitle"]</PageTitle>

@if (_sent)
{
    @* The same message whether or not the address was already registered. Saying anything else
       would turn sign-up into a way to discover who has an account (NFR-005). *@
    <AuthCard Title="@L["RegisterDoneTitle"]">
        <ChildContent>
            <MudText>@L["RegisterDoneText"]</MudText>
        </ChildContent>
    </AuthCard>
}
else
{
    <AuthCard Title="@L["RegisterTitle"]" Lead="@L["RegisterLead"]">
        <ChildContent>
            <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <ProblemAlert Message="@_error" Details="@_details" />

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_displayName" Label="@L["FieldDisplayName"]" HelperText="@L["DisplayNameHint"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" MaxLength="100"
                                  autocomplete="nickname" id="register-name" />

                    <MudTextField @bind-Value="_email" Label="@L["FieldEmail"]" InputType="InputType.Email"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Required="true"
                                  autocomplete="email" id="register-email" />

                    <MudTextField @bind-Value="_password" Label="@L["FieldPassword"]" InputType="InputType.Password"
                                  HelperText="@L["PasswordHint"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Required="true" autocomplete="new-password" id="register-password" />

                    <BusyButton Label="@L["RegisterSubmit"]" Busy="_busy" FullWidth="true" />
                </MudStack>
            </form>
        </ChildContent>
        <Footer>
            @L["RegisterHaveAccount"] <MudLink Href="account/login">@L["NavSignIn"]</MudLink>
        </Footer>
    </AuthCard>
}

@code {
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;
    private IReadOnlyList<string>? _details;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _details = null;

        // The language the form was filled in decides which language the verification mail arrives
        // in - there is no account yet to read a preference from.
        var request = new RegisterRequest(_displayName, _email, _password, Culture.CurrentCulture.Name);
        var result = await Api.RegisterAsync(request);

        _busy = false;

        if (result.IsSuccess)
        {
            _sent = true;
            return;
        }

        _error = ApiErrorText.Describe(L, result.Error);
        _details = ApiErrorText.Details(L, result.Error);
    }
}
