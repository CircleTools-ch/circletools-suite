# CircleTools reverse proxy / static host (ADR-0036, ADR-0046).
# Three origins on one Caddy: the Main hub, Secret-Santa, and the API. Caddy obtains and renews
# Let's Encrypt certificates automatically for each site name.
#
# ⚠️ Cloudflare caveat (ADR-0036): with the proxy (orange cloud) ON, Let's Encrypt HTTP-01 is
#    intercepted. Either issue certs with the site in "DNS only" (grey cloud) first, or switch Caddy
#    to the Cloudflare DNS-01 challenge (needs the caddy-dns/cloudflare build + a scoped API token).
#    Documented as a milestone-8 follow-up in deploy/README.md.

{
	# ACME account email; supplied via the environment (see deploy/.env.example). The default keeps
	# the config valid when the var is unset (e.g. `caddy validate` in CI).
	email {$ACME_EMAIL:dev@circletools.ch}
}

# --- Snippet: how a standalone Blazor WASM PWA is served -----------------------------------------
(wasm_pwa) {
	encode zstd gzip
	# Blazor ships .br/.gz siblings; serve them directly when the client accepts them.
	file_server {
		precompressed br gzip
	}
	# SPA fallback: unknown paths resolve to index.html so client-side routing and deep links work.
	try_files {path} /index.html

	header {
		# Baseline hardening. HSTS is safe once every origin is HTTPS-only (it is, behind Caddy).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Content-Security-Policy (ADR-0021, ADR-0040). Served here, not as a <meta> in each app's
		# index.html, because only the deployment knows its own API origin and because frame-ancestors
		# is honoured in a header but ignored in a meta tag. One policy fits both WASM PWAs:
		#   - 'wasm-unsafe-eval' lets the .NET runtime instantiate its WebAssembly (mandatory); it does
		#     NOT permit eval()/inline script, so script-src stays inline-free — the XSS mitigation.
		#   - style-src 'unsafe-inline' is MudBlazor's dynamic theme <style> (ADR-0040); styling only.
		#   - connect-src names the API origin; the SSO hand-off (ADR-0039) is a top-level navigation
		#     to the authority, not a fetch, so the authority origin does not belong here.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.circletools.ch; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}

	# Cache policy (ADR-0048). Asset fingerprinting is disabled for CSP reasons (ADR-0021), so the
	# WASM assets under /_framework have STABLE names whose content changes on each deploy — they must
	# NOT be cached immutably or a new build serves stale files. Everything revalidates (cheap ETag
	# 304s); offline is provided by the service worker's own content-hashed cache, not the HTTP cache,
	# and the worker drives the in-app "Reload" prompt on a new deploy.
	header Cache-Control "no-cache"
}

# --- Main hub (SSO authority) --------------------------------------------------------------------
circletools.ch {
	root * /srv/main
	import wasm_pwa
}

# --- Secret-Santa --------------------------------------------------------------------------------
secretsanta.circletools.ch {
	root * /srv/secretsanta
	import wasm_pwa
}

# --- API -----------------------------------------------------------------------------------------
api.circletools.ch {
	# Operational endpoints are INTERNAL-ONLY (ADR-0051): Prometheus scrapes /metrics over the Docker
	# network and the orchestrator hits /alive on localhost — neither should be reachable from the
	# internet. Deny them here before proxying everything else to the API.
	@internal path /metrics /metrics/* /alive
	respond @internal 404

	reverse_proxy api:8080
	header -Server
}

# --- Grafana (observability admin UI, ADR-0051) --------------------------------------------------
# Reverse-proxies the internal Grafana; Grafana enforces its own admin login (GF_SECURITY_ADMIN_PASSWORD)
# and sets its own CSP, so the strict wasm_pwa policy is deliberately NOT applied here. Prometheus and
# Loki have no site block at all — they are never exposed.
grafana.circletools.ch {
	encode zstd gzip
	reverse_proxy grafana:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
