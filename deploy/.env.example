# CircleTools deployment secrets & host config — TEMPLATE.
# Copy to deploy/.env on the host and fill in. deploy/.env is git-ignored and must NEVER be committed.
# Secrets management is decided in ADR-0050 (../docs/adr/0050-secrets-management.md): this .env (host,
# runtime) + GitHub Actions secrets (CI/deploy), authoritative copy in a password manager. This file
# documents WHICH values exist; the values themselves live in the vault and are derived onto the host.

# --- Postgres -------------------------------------------------------------------------------------
POSTGRES_USER=circletools
POSTGRES_PASSWORD=change-me-strong-random
# The API's connection string must match POSTGRES_USER / POSTGRES_PASSWORD above.
# Host is the compose service name `postgres`.
ConnectionStrings__maindb=Host=postgres;Port=5432;Database=maindb;Username=circletools;Password=change-me-strong-random

# --- Auth -----------------------------------------------------------------------------------------
# JWT signing key: >= 32 bytes of random. A leaked key lets anyone mint a session for any account.
#   generate: openssl rand -base64 48
Auth__Jwt__SigningKey=change-me-base64-48-bytes-of-randomness

# --- At-rest secret keys (ADR-0061 share tokens, ADR-0062 email hashing) --------------------------
# Both are durable, backed-up secrets: losing or rotating them strands data that was protected under
# the old value. There is no key baked into the app, so a boot without these fails closed.
# Share-token encryption: Base64 AES-256 key (exactly 32 bytes). A DB dump is useless without it.
#   generate: openssl rand -base64 32
SharedGroups__Security__TokenEncryptionKey=change-me-base64-32-bytes-aes256
# Email-hash HMAC: Base64 key (>= 32 bytes). Stable for the life of the data — changing it orphans
# every stored email hash (decline cooldowns, invitation matches).
#   generate: openssl rand -base64 48
Circles__Security__EmailHashKey=change-me-base64-48-bytes-of-randomness

# --- Transactional email (Brevo — ADR-0037) -------------------------------------------------------
# SMTP relay login + key from the Brevo dashboard. Host/port/from-address are in appsettings.Production.json.
Mail__Username=your-brevo-smtp-login@example.com
Mail__Password=your-brevo-smtp-key

# --- Observability (Grafana — ADR-0051) -----------------------------------------------------------
# Grafana admin password (the initial `admin` user). Grafana is the only observability service exposed
# (grafana.circletools.ch); Prometheus and Loki stay on the internal network. A leaked value grants
# full read access to logs/metrics dashboards, so make it strong.
#   generate: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=change-me-strong-random

# --- Backups (restic -> Infomaniak Swiss Backup, ADR-0036 / GL-5) ---------------------------------
# backup.sh streams pg_dump into an encrypted restic repo on Swiss Backup's S3 endpoint. Create an S3
# access in the Swiss Backup dashboard and fill the bucket/endpoint + credentials below.
# RESTIC_REPOSITORY: s3:<endpoint>/<bucket>[/<path>]  (Swiss Backup gives the S3 endpoint + bucket).
RESTIC_REPOSITORY=s3:https://s3.swiss-backup.infomaniak.com/your-bucket/circletools
# restic encryption password: a DURABLE, backed-up secret. Losing it makes every existing backup
# unrecoverable, so store it in the vault alongside the AES/HMAC keys above.
#   generate: openssl rand -base64 32
RESTIC_PASSWORD=change-me-restic-repo-password
# S3 credentials for the Swiss Backup access (used by restic's S3 backend).
AWS_ACCESS_KEY_ID=your-swiss-backup-s3-access-key
AWS_SECRET_ACCESS_KEY=your-swiss-backup-s3-secret-key

# --- Alerting (GL-11 backup failure, ADR-0088 mail capacity) -------------------------------------
# When the nightly backup fails, circletools-backup-failure@.service runs notify-failure.sh. Configure
# at least one channel below; with none set, the failure is still recorded in the journal only.
# Grafana's mail-capacity alerts always go to ALERT_EMAIL_TO (from ALERT_EMAIL_FROM), so it is REQUIRED.
# Email alert (reuses the Brevo SMTP login above — Mail__Username / Mail__Password):
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=no-reply@circletools.ch
ALERT_SMTP_URL=smtp://smtp-relay.brevo.com:587
# Optional webhook — a plain-text POST (an ntfy topic URL, healthchecks.io, or a chat webhook). Empty = skip.
# With the CircleTools ntfy server (below): https://ntfy.circletools.ch/circletools-alerts plus the backup token.
ALERT_WEBHOOK_URL=
# Optional Bearer token sent with the webhook (ntfy denies anonymous publishing). Empty = no header.
ALERT_WEBHOOK_TOKEN=

# --- Push notifications (ntfy) and the watchdog — ADR-0091 ----------------------------------------
# All REQUIRED: compose refuses to start without them (Grafana stops on an empty webhook URL or token).
# Shared operations infrastructure: CircleTools' alerts and the owner's private senders use the same ntfy
# server. Users, access and tokens are declared here only, so private topics never reach git.
#
# Single quotes are REQUIRED on the three NTFY_AUTH_* lines: bcrypt hashes contain dollar signs, which
# docker compose would otherwise try to expand. Entries are comma-separated. Generate the pieces with:
#   password hash:  docker run --rm -it binwiederhier/ntfy:v2.32.0 user hash        (prompts for the password)
#   token:          docker run --rm binwiederhier/ntfy:v2.32.0 token generate       (tk_ + 29 characters)
#
# Users (<name>:<bcrypt-hash>:<role>): "owner" is admin (reads and writes every topic; log in with it on the
# phone). "circletools" is the publisher for this server's alerts; it only ever uses tokens, so give it a
# long random password you never need. Add one publisher user per private sender (e.g. your home Grafana).
NTFY_AUTH_USERS='owner:$2a$10$replace-with-owner-hash:admin,circletools:$2a$10$replace-with-random-hash:user'
# Access (<user>:<topic-pattern>:<access>): publishers are write-only, on their own topic prefix.
NTFY_AUTH_ACCESS='circletools:circletools-*:wo'
# Tokens (<user>:<token>:<label>): one per sender, so each can be revoked alone.
NTFY_AUTH_TOKENS='circletools:tk_replace_with_grafana_token_00:grafana,circletools:tk_replace_with_backup_token_000:backup'
# The Grafana token again: the same value as the "grafana" entry in NTFY_AUTH_TOKENS.
NTFY_GRAFANA_TOKEN=tk_replace_with_grafana_token_00
# Optional: serve ntfy under another name than ntfy.circletools.ch (needs its own A record). Default if empty.
NTFY_HOST=
# Dead man's switch: the ping URL of a healthchecks.io check (period 5 min, grace 10 min). Grafana's watchdog
# rule pings it; when the pings stop, healthchecks.io alerts you from outside this server — by its own email,
# not through Brevo or this ntfy.
HEALTHCHECKS_PING_URL=https://hc-ping.com/your-check-uuid

# --- TLS / ACME -----------------------------------------------------------------------------------
# Email Let's Encrypt uses for expiry notices (a suite role address once the mailbox exists).
# TLS uses Caddy's default HTTP-01 challenge; DNS is at Infomaniak with no proxy in front (ADR-0063),
# so nothing else is needed here.
ACME_EMAIL=dev@circletools.ch

# --- Image tag (CD) -------------------------------------------------------------------------------
# Which pushed image the VM pulls. Every deploy.yml rollout overwrites this with the version it built
# (e.g. 1.0.30); a rollback dispatch sets an older one. `edge` = the last build from main; `stable` /
# `latest` = the last server release (ADR-0098), which our own server never runs on purpose.
IMAGE_TAG=edge
