<Project>

  <!--
    Central Package Management (CPM).
    All NuGet package versions are declared ONCE here; projects reference package
    names WITHOUT versions. Add a <PackageVersion .../> line before first use.
    See docs/guidelines/coding-guidelines.md > "Dependencies".
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- Audit only direct dependencies. Transitive framework packages are patched by the
         .NET runtime/SDK on its own cadence; auditing them here only turns third-party
         advisory churn into spurious build breaks under TreatWarningsAsErrors. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- Package sources are pinned to nuget.org in the repo-root NuGet.config. -->
  </PropertyGroup>

  <!-- Testing (used by *.Test projects). xUnit v2 per the generated templates. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <!-- Blazor component tests (bUnit) — used by *.Ui.Test projects. -->
  <ItemGroup>
    <PackageVersion Include="bunit" Version="1.40.0" />
  </ItemGroup>

  <!-- Architecture tests (enforce dependency direction) — xUnit v2 variant. -->
  <ItemGroup>
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
  </ItemGroup>

  <!-- Integration tests against a real Postgres (TP-002). Requires a container runtime. -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>

  <!-- Browser-driving end-to-end tests (WebAuthn ceremony via a CDP virtual authenticator,
       arc42 D4; ADR-0045). Drives real Chromium against the live Aspire stack. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Playwright" Version="1.55.0" />
  </ItemGroup>

  <!-- Application layer building blocks (hand-rolled CQRS, ADR-0006). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <!-- Concrete DI + logging (used by tests to build a real service provider). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

  <!-- Identity — ASP.NET Core Identity model & stores. ADR-0009, ADR-0021, FEAT-002. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <!-- Access-token issuance (ADR-0021). The API host adds JwtBearer for validation. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

  <!-- Outbound mail — SMTP adapter behind IMailSender. ADR-0023. -->
  <ItemGroup>
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <!-- Binds an options class to a configuration section (services.Configure<T>(section)).
         Reaches the Main host transitively via Identity/EF; the Circles repository references
         neither, so it takes the dependency directly. -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

  <!-- Persistence — EF Core for Postgres (server). ADR-0007, ADR-0008. -->
  <ItemGroup>
    <!-- Kept on the same 10.0.10 servicing band as ASP.NET Core Identity, which references
         EF Core 10.0.10 — a lower pin here fails the build with CS1705. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Npgsql 10.0.0 depends on EF Core Relational 10.0.0 while EF Core itself is on 10.0.10.
         Pinned (transitive pinning is on) so the two agree; without it, a project that references
         only Npgsql and EF Core binds Relational 10.0.0 as primary and MSB3277 fires. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <!-- API — Minimal APIs, URL-segment versioning, OpenAPI. ADR-0010. -->
  <ItemGroup>
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
  </ItemGroup>

  <!-- Blazor WebAssembly client + Razor Class Library. ADR-0005. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <!-- AuthorizeView / CascadingAuthenticationState against a custom AuthenticationStateProvider.
         The token model is bearer-in-WASM (ADR-0021), so none of the hosted-Blazor auth packages
         apply — only the component-level authorization primitives are needed. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
  </ItemGroup>

  <!-- Localization — RESX + IStringLocalizer, ADR-0011 (in-framework abstractions). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.10" />
  </ItemGroup>

  <!-- UI component library — Material Design for Blazor (ADR-0040, supersedes ADR-0024's Bootstrap).
       Rendered by Ui.Shared, so it reaches both WASM web hosts and the MAUI Blazor Hybrid head. -->
  <ItemGroup>
    <PackageVersion Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <!-- QR codes for reveal links (MNF-5). PngByteQRCode is pure managed (no System.Drawing), so it runs
       identically in the WASM web head and the MAUI Blazor Hybrid webview with no platform seam. Scoped
       to SecretSanta.Ui — the only app that shares reveal links today. -->
  <ItemGroup>
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- Secret-Santa (local-first): JS interop for browser localStorage; MAUI Blazor Hybrid head. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.JSInterop" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
  </ItemGroup>

  <!-- Aspire orchestration (AppHost). -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
  </ItemGroup>

  <!-- Automatic versioning from git history (ADR-0047). Referenced repo-wide by
       Directory.Build.props (except container builds), so every assembly is stamped from version.json
       + git height. PrivateAssets=all at the reference site: build-time only, never a runtime dep. -->
  <ItemGroup>
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.7.115" />
  </ItemGroup>

  <!-- ServiceDefaults — resilience, service discovery, OpenTelemetry. ADR-0012. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <!-- Prometheus scraping endpoint for production metrics (ADR-0051). Ships as beta; its dependency
         floor is below the 1.15.x SDK pinned here, so it composes with the exporters above. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

  <!--
    ============================================================================
    FUTURE / not yet referenced (kept here so the intended stack is discoverable;
    entries are inert until a project references them). Uncomment on first use.
    ============================================================================
    Device persistence (SQLite, local-first) — ADR-0007:
      <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    (Authentication + passkeys are no longer "future" — JwtBearer and
     Identity.EntityFrameworkCore are referenced above by FEAT-002.)
    Assertion / mocking helpers (currently hand-written fakes are used):
      <PackageVersion Include="FluentAssertions" Version="7.0.0" />
      <PackageVersion Include="NSubstitute" Version="5.3.0" />
    Localization uses the in-framework Microsoft.Extensions.Localization / IStringLocalizer
    (ADR-0011) — no extra package required.
  -->

</Project>
