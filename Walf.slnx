<Solution>
  <!--
    Walf app-suite solution (new .slnx format).
    Intentionally near-empty: the harness ships first, code projects are added
    during later ADR-gated phases. See docs/process/ways-of-working.md.

    "Walf" (We Are Like Family) is the suite brand and the namespace/project prefix.
    See CLAUDE.md > "Placeholder & naming convention".
  -->
  <Folder Name="/docs/">
    <File Path="README.md" />
    <File Path="CONTRIBUTING.md" />
    <File Path="CLAUDE.md" />
  </Folder>
  <Folder Name="/src/" />
  <Folder Name="/src/Apps/" />
  <Folder Name="/src/Apps/Main/">
    <Project Path="src/Apps/Main/Walf.Main.Contracts/Walf.Main.Contracts.csproj" />
    <Project Path="src/Apps/Main/Walf.Main.Service.Core/Walf.Main.Service.Core.csproj" />
    <Project Path="src/Apps/Main/Walf.Main.Service.Repository/Walf.Main.Service.Repository.csproj" />
    <Project Path="src/Apps/Main/Walf.Main.Service/Walf.Main.Service.csproj" />
    <Project Path="src/Apps/Main/Walf.Main.Ui/Walf.Main.Ui.csproj" />
    <Project Path="src/Apps/Main/Walf.Main.WebApp/Walf.Main.WebApp.csproj" />
  </Folder>
  <Folder Name="/src/Aspire/">
    <Project Path="src/Aspire/Walf.AppHost/Walf.AppHost.csproj" />
    <Project Path="src/Aspire/Walf.ServiceDefaults/Walf.ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/src/BuildingBlocks/">
    <Project Path="src/BuildingBlocks/Walf.Application/Walf.Application.csproj" />
    <Project Path="src/BuildingBlocks/Walf.SharedKernel/Walf.SharedKernel.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Walf.Architecture.Test/Walf.Architecture.Test.csproj" />
  </Folder>
  <Folder Name="/tests/Apps/" />
  <Folder Name="/tests/Apps/Main/">
    <Project Path="tests/Apps/Main/Walf.Main.Service.Test/Walf.Main.Service.Test.csproj" />
  </Folder>
</Solution>
