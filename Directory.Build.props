<Project>

  <!--
    Shared MSBuild properties applied to EVERY project in the solution.
    Keep this decision-light: language/compiler hygiene only. Architecture and
    package choices live in ADRs and Directory.Packages.props respectively.
  -->

  <PropertyGroup>
    <!-- Language & compiler hygiene -->
    <TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- The product is multilingual (de-CH / fr-CH / en, ADR-0011), so culture-aware
         formatting must work: invariant globalization stays OFF. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Quality gates -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>

    <!-- API documentation: feeds the DocFX API reference. CS1591 (missing XML
         comment) is relaxed to a warning so it does not block early scaffolding. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Reproducible restore -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The MAUI workload drops its own copies of the MAUI packages into <dotnet>/library-packs, which
         the SDK silently adds as a restore source. Those nupkgs lack nuget.org's repository signature,
         so their content hash differs from the nuget.org one in packages.lock.json (NU1403 on CI as soon
         as our MAUI version matches the workload's). Restore from nuget.org only, as nuget.config intends. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>

    <!-- Shared assembly metadata (brand: "CircleTools" — We Are Like Family) -->
    <Product>CircleTools</Product>
    <Company>CircleTools</Company>
    <Copyright>Copyright (c) 2026 CircleTools. All rights reserved.</Copyright>
    <Authors>CircleTools</Authors>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Test-project conventions: any project whose name ends in ".Test" is a
       test project. Central packages (xUnit, coverage, etc.) are declared in
       Directory.Packages.props and referenced from the test projects. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Test'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Automatic versioning from git history (ADR-0047, version.json at the repo root). nbgv stamps
       AssemblyInformationalVersion / FileVersion into every assembly for provenance.
       Excluded when ContainerBuild=true: the Docker context omits .git (deploy/.dockerignore), so nbgv
       cannot compute a height there; the deploy workflow passes the version in via /p:Version instead.
       CI must check out with fetch-depth: 0 or the height calculation fails on a shallow clone. -->
  <ItemGroup Condition="'$(ContainerBuild)' != 'true'">
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>

</Project>
