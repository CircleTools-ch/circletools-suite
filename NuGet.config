<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin package restore to nuget.org only. <clear/> drops any machine-level feeds so
    the repository restores identically on every machine and in CI (and avoids NU1507,
    which Central Package Management raises when multiple ambient sources are present).
    Add further sources here (with packageSourceMapping) only when genuinely needed.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
