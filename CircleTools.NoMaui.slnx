    <Project Path="src/BuildingBlocks/CircleTools.Localization/CircleTools.Localization.csproj" />
    <Project Path="src/BuildingBlocks/CircleTools.SharedKernel/CircleTools.SharedKernel.csproj" />
    <Project Path="src/BuildingBlocks/CircleTools.Ui.Abstractions/CircleTools.Ui.Abstractions.csproj" />
    <Project Path="src/BuildingBlocks/CircleTools.Ui.Account/CircleTools.Ui.Account.csproj" />
    <Project Path="src/BuildingBlocks/CircleTools.Ui.Shared/CircleTools.Ui.Shared.csproj" />
    <Project Path="src/BuildingBlocks/CircleTools.Ui.Web/CircleTools.Ui.Web.csproj" />
  </Folder>
  <Folder Name="/tests/">
