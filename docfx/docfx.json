{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "//": "Generates the C# API reference from XML doc comments. Scoped to the reusable LIBRARY projects (domain, application, contracts, repository) — app hosts and Blazor/WASM/Aspire projects are entry points, not API surface, and are not processable by DocFX's Roslyn workspace.",
      "src": [
        {
          "src": "..",
          "files": [
            "src/BuildingBlocks/**/*.csproj",
            "src/Apps/Main/Walf.Main.Contracts/*.csproj",
            "src/Apps/Main/Walf.Main.Service.Core/*.csproj",
            "src/Apps/Main/Walf.Main.Service.Repository/*.csproj"
          ],
          "exclude": [ "**/*.Test/**", "**/bin/**", "**/obj/**" ]
        }
      ],
      "dest": "../docs/api",
      "filter": "filterConfig.yml",
      "outputFormat": "mref",
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      {
        "//": "All conceptual docs + arc42 + ADRs + guidelines + process + product, plus the generated API reference (metadata writes it into ../docs/api). Maps docs/ to the site root, so docs/toc.yml becomes the top navbar.",
        "src": "../docs",
        "files": [ "**/*.md", "**/*.yml" ],
        "dest": "."
      }
    ],
    "resource": [
      {
        "src": "../docs",
        "files": [ "**/*.svg", "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.gif", "**/*.puml" ],
        "dest": "."
      }
    ],
    "output": "_site",
    "template": [ "default", "modern", "templates/walf" ],
    "globalMetadata": {
      "_appName": "Walf",
      "_appTitle": "Walf Documentation",
      "_enableSearch": true,
      "_disableContribution": false,
      "pdf": false
    },
    "postProcessors": [ "ExtractSearchIndex" ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
