<Solution>
  <!--
    AppSuite app-suite solution (new .slnx format).
    Projects are added phase by phase, each gated by an ADR.
    See docs/process/ways-of-working.md.

    "AppSuite" is a neutral working name — the namespace/project prefix and the
    placeholder in prose, not a brand. The brand is deliberately deferred.
    See CLAUDE.md > "Placeholder & naming convention".
  -->
  <Folder Name="/docs/">
    <File Path="README.md" />
    <File Path="CONTRIBUTING.md" />
    <File Path="CLAUDE.md" />
  </Folder>
  <Folder Name="/src/" />
