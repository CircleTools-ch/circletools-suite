{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "secretsanta-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Apps/SecretSanta/CircleTools.SecretSanta.WebApp", "--launch-profile", "http"],
      "port": 5081
    },
    {
      "name": "secretsanta-web-prodconfig",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set ASPNETCORE_ENVIRONMENT=Production&& set ASPNETCORE_URLS=http://localhost:5082&& dotnet run --project src/Apps/SecretSanta/CircleTools.SecretSanta.WebApp --no-launch-profile -p:WasmApplicationEnvironmentName=Production"],
      "port": 5082
    },
    {
      "name": "apphost",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Aspire/CircleTools.AppHost", "--launch-profile", "https"],
      "port": 17073,
      "url": "https://localhost:17073"
    },
    {
      "name": "docs-site",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["docfx", "serve", "docfx/_site", "--port", "8080"],
      "port": 8080
    }
  ]
}
