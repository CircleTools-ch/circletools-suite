# .NET build output
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/

# .NET / Visual Studio user & cache files
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.vscode/
*.rsuser

# Browser-driver / MCP verification artifacts (screenshots, console logs, page snapshots)
.playwright-mcp/

# Rider / JetBrains
.idea/

# Test results & coverage
[Tt]est[Rr]esult*/
[Cc]overage*/
*.coverage
*.coveragexml
*.trx

# NuGet
*.nupkg
*.snupkg
.nuget/
# Keep packages.lock.json (reproducible restore) — do NOT ignore it

# DocFX generated output
docfx/_site/
docfx/api/
docs/api/
**/api/.manifest
docfx/log.txt

# MAUI / mobile build artifacts
*.binlog
*.aab
*.apk
*.ipa
# macOS/iOS .app bundles are build output and already covered by bin/ and obj/. A bare "*.app/"
# pattern must not come back: git matches ignore patterns case-insensitively on Windows
# (core.ignorecase=true), so it also swallowed src/Apps/SecretSanta/CircleTools.SecretSanta.App/ —
# the entire MAUI head went untracked, and only on Windows.
Platforms/**/bin/
Platforms/**/obj/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Secrets — never commit local secrets
*.env
.env.*
appsettings.*.local.json
secrets.json
# ...but the committed deployment template is not a secret.
!deploy/.env.example
