# Normalize line endings: LF in the repo, auto on checkout
* text=auto

# Explicitly declare text files
*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.props     text
*.targets   text
*.json      text
*.md        text
*.yml       text
*.yaml      text
*.xml       text
*.editorconfig text

# Windows-specific scripts keep CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Shell scripts and systemd units keep LF (they run on the Linux VM)
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text
*.pdf       binary
*.woff      binary
*.woff2     binary
